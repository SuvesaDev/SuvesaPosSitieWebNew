<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SuvesaPosSitioAplicacion\SuvesaPosSitioAplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Se embebe la copia local: en CI solo se clona este repo (el del API no
         está como carpeta hermana). La copia se mantiene fresca con el target
         SincronizarSemillaSeguridad. -->
    <EmbeddedResource Include="Fixtures\seed-seguridad.json" LogicalName="SuvesaPosSitioAplicacion.Tests.Fixtures.seed-seguridad.json" />
  </ItemGroup>

  <!-- Fuente única: cuando el repo del API está como carpeta hermana (máquina de
       desarrollo), su semilla generada sobrescribe la copia local antes de
       compilar, para que no quede desincronizada. En CI el archivo no existe y
       este paso simplemente no hace nada. -->
  <Target Name="SincronizarSemillaSeguridad" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <SemillaApi>$(MSBuildProjectDirectory)\..\..\..\DevSuvesaPosWeb\ApiSuvesaPos\SecuritySystem\Seed\seed-seguridad.json</SemillaApi>
    </PropertyGroup>
    <Copy SourceFiles="$(SemillaApi)"
          DestinationFiles="$(MSBuildProjectDirectory)\Fixtures\seed-seguridad.json"
          SkipUnchangedFiles="true"
          Condition="Exists('$(SemillaApi)')" />
  </Target>

</Project>
