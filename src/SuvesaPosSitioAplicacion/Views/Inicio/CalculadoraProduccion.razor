@page "/initial/production-calculator"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.DTOs.Lotes
@using SuvesaPosSitioAplicacion.DTOs.Produccion
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IProduccionApiCliente Api
@inject ILotesApiCliente LotesApi
@inject IInventarioConsulta Inventario
@inject IServicioDialogos Dialogos
@inject IJSRuntime JS

<AppPantalla Pantalla="Calculadora de Producción" Codigo="INICIO.CALCULADORA_PRODUCCION" Icono="bi-calculator" Subtitulo="Formula, consumo por lote y bitácora" Nivel="NivelPantalla.Escritorio">
 <Acciones><button class="btn btn-sm btn-outline-primary" @onclick="CargarBitacora">Actualizar bitácora</button><button class="btn btn-sm btn-outline-secondary" @onclick="Exportar" disabled="@(!_bitacora.Any())">Exportar CSV</button></Acciones>
 <ChildContent>
  <div class="card mb-3"><div class="card-body row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Bodega <span class="text-danger">*</span></label><select class="form-select" @bind="_bodega" @bind:after="CambiarBodega"><option value="0">Seleccione...</option>@foreach(var b in _bodegas){<option value="@b.IdBodega">@b.NombreBodega</option>}</select></div><div class="col-md-7"><label class="form-label">Buscar producto terminado</label><div class="input-group"><input class="form-control" @bind="_texto" @bind:event="oninput" placeholder="Código o descripción"/><button class="btn btn-outline-primary" @onclick="CargarTerminados">Buscar</button></div></div></div></div>
  @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
  <div class="card mb-3"><div class="card-header">Productos terminados</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Código</th><th>Descripción</th><th>Fórmula</th><th></th></tr></thead><tbody>@foreach(var pt in _terminados){<tr class="@(_pt?.Codigo == pt.Codigo ? "table-primary" : "")"><td><code>@pt.CodArticulo</code></td><td>@pt.Descripcion</td><td>@(pt.TieneFormula ? "Sí" : "No")</td><td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="()=>Abrir(pt)">Abrir</button></td></tr>}@if(!_terminados.Any()){<tr><td colspan="4" class="text-secondary">No hay productos cargados.</td></tr>}</tbody></table></div></div>
  @if (_pt is not null) {
   <div class="card mb-3"><div class="card-header d-flex justify-content-between"><span>Fórmula: <strong>@_pt.CodArticulo — @_pt.Descripcion</strong></span><span class="badge text-bg-secondary">PT</span></div><div class="card-body">
    <div class="row g-2 mb-3"><div class="col-md-7"><label class="form-label">Buscar materia prima</label><div class="input-group"><input class="form-control" @bind="_textoInsumo" placeholder="Código o descripción"/><button class="btn btn-outline-secondary" @onclick="BuscarInsumos">Buscar</button></div>@if(_insumosEncontrados.Any()){<div class="list-group position-absolute shadow" style="z-index: 2; max-height: 14rem; overflow:auto">@foreach(var i in _insumosEncontrados){<button type="button" class="list-group-item list-group-item-action" @onclick="()=>ElegirInsumo(i)"><code>@i.Cod_Articulo</code> @i.Descripcion</button>}</div>}</div><div class="col-md-3"><label class="form-label">Cantidad por unidad</label><input type="number" class="form-control" @bind="_cantidadInsumo" min="0.0001" step="0.0001"/></div><div class="col-md-2 d-grid"><button class="btn btn-outline-primary align-self-end" @onclick="GuardarInsumo" disabled="@(_nuevoInsumo <= 0)">Agregar</button></div></div>
    <p class="form-text">El buscador sólo presenta artículos de tipo <strong>Materia prima</strong>; el API conserva la validación de autoridad.</p>
    <table class="table table-sm"><thead><tr><th>Insumo</th><th class="text-end">Cantidad/unidad</th><th></th></tr></thead><tbody>@foreach(var c in _formula){<tr><td><code>@c.CodArticulo</code> @c.Descripcion</td><td class="text-end">@c.CantidadPorUnidad.ToString("N3")</td><td class="text-end"><button class="btn btn-sm btn-link text-danger" @onclick="()=>QuitarInsumo(c)">Quitar</button></td></tr>}@if(!_formula.Any()){<tr><td colspan="3" class="text-secondary">Aún no hay componentes.</td></tr>}</tbody></table>
   </div></div>
   <div class="card mb-3"><div class="card-header">Consumo estricto</div><div class="card-body"><div class="row mb-3"><div class="col-md-4"><label class="form-label">Cantidad a producir <span class="text-danger">*</span></label><input type="number" min="1" class="form-control" @bind="_cantidadAProducir" @bind:after="InvalidarCalculo"/></div></div>
    @foreach(var c in _formula){ var disponibles = LotesDe(c.IdInsumo); <div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between"><strong>@c.CodArticulo — @c.Descripcion</strong><span class="@(InsumoCuadra(c) ? "text-success" : "text-danger")">@Seleccionado(c).ToString("N3") / @Requerido(c).ToString("N3")</span></div><div class="row g-2 mt-1"><div class="col-md-6"><select class="form-select" @bind="_loteElegido[c.IdInsumo]"><option value="0">Seleccione lote...</option>@foreach(var l in disponibles){var existencia = l.PorBodega.FirstOrDefault(x=>x.IdBodega==_bodega)?.Existencia ?? 0; <option value="@l.Id">@l.Numero · @existencia.ToString("N3")</option>}</select></div><div class="col-md-3"><input class="form-control" type="number" min="0.001" step="0.001" @bind="_cantidadLote[c.IdInsumo]"/></div><div class="col-md-3 d-grid"><button class="btn btn-outline-primary" @onclick="()=>AgregarLote(c)" disabled="@(_bodega==0 || LoteYaSeleccionado(c))">Agregar lote</button></div></div>
    @if (_seleccion.TryGetValue(c.IdInsumo, out var seleccion) && seleccion.Any()) {<table class="table table-sm mt-2 mb-0"><tbody>@foreach(var l in seleccion){<tr><td>@l.Numero</td><td class="text-end">@l.Cantidad.ToString("N3")</td><td class="text-end"><button class="btn btn-sm btn-link text-danger" @onclick="()=>QuitarLote(c.IdInsumo,l.IdStockLote)">Quitar</button></td></tr>}</tbody></table>}<small class="@(InsumoCuadra(c)?"text-success":"text-danger")">@(InsumoCuadra(c)?"Cantidad exacta seleccionada.":$"Faltan o sobran {Math.Abs(Requerido(c)-Seleccionado(c)):N3} unidades.")</small></div>}
    <button class="btn btn-primary" @onclick="Calcular" disabled="@(!TodoCuadra() || _calculando)">@(_calculando ? "Calculando..." : "Calcular disponibles")</button>
    @if(_calculo is not null){<div class="mt-3"><strong>Máximo a producir: @_calculo.MaximoAProducir</strong><table class="table table-sm mt-2"><thead><tr><th>Insumo</th><th class="text-end">Requerido</th><th class="text-end">Seleccionado</th><th class="text-end">Disponible</th></tr></thead><tbody>@foreach(var d in _calculo.Insumos){<tr><td>@d.Descripcion</td><td class="text-end">@d.RequeridoTotal.ToString("N3")</td><td class="text-end">@d.TotalSeleccionado.ToString("N3")</td><td class="text-end">@d.ExistenciaTotalDisponible.ToString("N3")</td></tr>}</tbody></table></div>}
   </div></div>
   <div class="card mb-3"><div class="card-header">Convertir</div><div class="card-body row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Lote del producto terminado <span class="text-danger">*</span></label><input class="form-control" @bind="_loteProducido"/></div><div class="col-md-4"><label class="form-label">Vencimiento <span class="text-danger">*</span></label><input type="date" class="form-control" @bind="_vencimientoProducido"/></div><div class="col-md-4 d-grid"><button class="btn btn-success" @onclick="Convertir" disabled="@(!PuedeConvertir)">Convertir inventario</button></div></div></div>
   @if(_reporte is not null){<div class="card mb-3"><div class="card-header text-bg-success">Producción registrada #@_reporte.Id</div><div class="card-body"><div class="row mb-2"><div class="col-md-4"><strong>Lote:</strong> @_reporte.NumeroLoteProducido</div><div class="col-md-4"><strong>Cantidad:</strong> @_reporte.CantidadProducida</div><div class="col-md-4"><strong>Costo total:</strong> @_reporte.CostoTotalInsumos.ToString("N2")</div></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Insumo</th><th>Lote</th><th class="text-end">Cantidad</th><th class="text-end">Costo línea</th></tr></thead><tbody>@foreach(var l in _reporte.Lineas){<tr><td><code>@l.CodArticuloInsumo</code> @l.DescripcionInsumo</td><td>@l.NumeroLote</td><td class="text-end">@l.CantidadConsumida.ToString("N3")</td><td class="text-end">@l.CostoLinea.ToString("N2")</td></tr>}</tbody></table></div></div></div>}
  }
  <div class="card"><div class="card-header">Bitácora de producción</div><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-3"><label class="form-label">Desde</label><input type="date" class="form-control" @bind="_desde"/></div><div class="col-md-3"><label class="form-label">Hasta</label><input type="date" class="form-control" @bind="_hasta"/></div><div class="col-md-3"><label class="form-label">Id artículo</label><input type="number" class="form-control" @bind="_filtroArticulo"/></div><div class="col-md-3 d-grid"><button class="btn btn-outline-primary" @onclick="CargarBitacora">Filtrar</button></div></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Fecha</th><th>PT</th><th>Lote</th><th class="text-end">Cantidad</th><th class="text-end">Costo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in _bitacora){<tr class="@(p.Anulada?"text-secondary text-decoration-line-through":"")"><td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><code>@p.CodArticuloTerminado</code> @p.DescripcionTerminado</td><td>@p.NumeroLoteProducido</td><td class="text-end">@p.CantidadProducida</td><td class="text-end">@p.CostoTotalInsumos.ToString("N2")</td><td>@(p.Anulada ? $"Anulada — {p.MotivoAnulacion} ({p.UsuarioAnulacion}, {p.FechaAnulacion:dd/MM/yyyy})" : "Activa")</td><td class="text-end">@if(!p.Anulada){<button class="btn btn-sm btn-outline-danger" @onclick="()=>PrepararAnulacion(p)">Anular</button>}</td></tr>}@if(!_bitacora.Any()){<tr><td colspan="7" class="text-secondary">Sin producciones para los filtros indicados.</td></tr>}</tbody></table></div></div></div>
 </ChildContent>
</AppPantalla>

<HxModal @ref="_modalAnular" Title="Anular producción"><BodyTemplate><label class="form-label">Motivo <span class="text-danger">*</span></label><textarea class="form-control" @bind="_motivoAnulacion"></textarea></BodyTemplate><FooterTemplate><button class="btn btn-secondary" @onclick="()=>_modalAnular.HideAsync()">Cancelar</button><button class="btn btn-danger" @onclick="ConfirmarAnulacion">Anular producción</button></FooterTemplate></HxModal>

@code {
 private List<Bodega> _bodegas=new(); private List<ProductoTerminado> _terminados=new(); private ProductoTerminado? _pt; private List<FormulaComponente> _formula=new(); private List<InventarioDTO> _insumosEncontrados=new(); private readonly Dictionary<long,List<LoteExistencia>> _lotes=new(); private readonly Dictionary<long,List<LoteSeleccionado>> _seleccion=new(); private readonly Dictionary<long,long> _loteElegido=new(); private readonly Dictionary<long,double> _cantidadLote=new(); private int _bodega,_cantidadAProducir=1; private long _nuevoInsumo; private double _cantidadInsumo=1; private string _texto="",_textoInsumo="",_loteProducido="",_error="",_motivoAnulacion=""; private DateOnly? _vencimientoProducido; private CalculoProduccion? _calculo; private ProduccionReporte? _reporte; private bool _calculando; private List<ProduccionReporte> _bitacora=new(); private DateTime? _desde,_hasta; private long? _filtroArticulo; private HxModal _modalAnular=default!; private ProduccionReporte? _anulando;
 protected override async Task OnInitializedAsync(){var r=await Api.BodegasAsync(); if(Ok(r)){_bodegas=r.Responses??new();} await CargarTerminados(); await CargarBitacora();}
 private static bool Ok<T>(LoteEnvelope<T> r)=>r.Status==ResponseStatus._0 && r.Responses is not null;
 private async Task Error<T>(LoteEnvelope<T> r,string alterno){_error=r.CurrentException ?? r.ValidationErrors?.FirstOrDefault() ?? alterno; await Dialogos.ErrorAsync(_error);}
 private async Task CargarTerminados(){var r=await Api.ProductosTerminadosAsync(string.IsNullOrWhiteSpace(_texto)?null:_texto.Trim());if(Ok(r))_terminados=r.Responses??new();else await Error(r,"No se pudieron cargar los productos terminados.");}
 private async Task Abrir(ProductoTerminado pt){_pt=pt;_seleccion.Clear();_lotes.Clear();_calculo=null;var r=await Api.FormulaAsync(pt.Codigo);if(Ok(r)){_formula=r.Responses??new();foreach(var c in _formula){_loteElegido[c.IdInsumo]=0;_cantidadLote[c.IdInsumo]=1;await CargarLotes(c.IdInsumo);}}else await Error(r,"No se pudo cargar la fórmula.");}
 private async Task CargarLotes(long id){var r=await LotesApi.ExistenciaConsolidadaAsync(id);if(Ok(r))_lotes[id]=(r.Responses?.Lotes??new()).Where(l=>!l.Vencido && !l.Bloqueado && (l.PorBodega.FirstOrDefault(x=>x.IdBodega==_bodega)?.Existencia??0)>0).ToList();}
 private async Task CambiarBodega(){_seleccion.Clear();_calculo=null;foreach(var c in _formula)await CargarLotes(c.IdInsumo);}
 private async Task BuscarInsumos(){if(string.IsNullOrWhiteSpace(_textoInsumo)){_insumosEncontrados=new();return;}var r=await Inventario.Buscar(_textoInsumo.Trim());_insumosEncontrados=r.EsCorrecta?(r.Responses??new List<InventarioDTO>()).Where(x=>x.TipoArticulo==2).ToList():new();if(!_insumosEncontrados.Any())await Dialogos.ErrorAsync("No se encontraron materias primas para esa búsqueda.");}
 private void ElegirInsumo(InventarioDTO item){_nuevoInsumo=item.Codigo;_textoInsumo=$"{item.Cod_Articulo} — {item.Descripcion}";_insumosEncontrados=new();}
 private async Task GuardarInsumo(){if(_pt is null||_nuevoInsumo<=0||_cantidadInsumo<=0){await Dialogos.ErrorAsync("Indique un insumo y una cantidad válida.");return;}var inventario=await Inventario.Uno(_nuevoInsumo);if(!inventario.EsCorrecta||inventario.Responses is null){await Dialogos.ErrorAsync("No existe el artículo indicado.");return;}if(inventario.Responses.TipoArticulo!=2){await Dialogos.ErrorAsync("Sólo puede agregar artículos de tipo Materia prima.");return;}var r=await Api.GuardarComponenteAsync(new(){IdArticuloTerminado=_pt.Codigo,IdInsumo=_nuevoInsumo,Cantidad=_cantidadInsumo});if(!Ok(r)){await Error(r,"No se pudo guardar el componente.");return;}await Abrir(_pt);_nuevoInsumo=0;_cantidadInsumo=1;}
 private async Task QuitarInsumo(FormulaComponente c){if(_pt is null||!await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este insumo de la fórmula?"))return;var r=await Api.GuardarComponenteAsync(new(){IdArticuloTerminado=_pt.Codigo,IdInsumo=c.IdInsumo,Activo=false});if(Ok(r))await Abrir(_pt);else await Error(r,"No se pudo quitar el componente.");}
 private List<LoteExistencia> LotesDe(long id)=>_lotes.TryGetValue(id,out var l)?l:new(); private double Requerido(FormulaComponente c)=>c.CantidadPorUnidad*_cantidadAProducir; private double Seleccionado(FormulaComponente c)=>_seleccion.TryGetValue(c.IdInsumo,out var l)?l.Sum(x=>x.Cantidad):0; private bool InsumoCuadra(FormulaComponente c)=>Math.Abs(Seleccionado(c)-Requerido(c))<1e-6; private bool TodoCuadra()=>_bodega>0&&_cantidadAProducir>=1&&_formula.Any()&&_formula.All(InsumoCuadra); private bool LoteYaSeleccionado(FormulaComponente c)=>_loteElegido.GetValueOrDefault(c.IdInsumo)>0&&_seleccion.TryGetValue(c.IdInsumo,out var lista)&&lista.Any(x=>x.IdStockLote==_loteElegido[c.IdInsumo]); private void InvalidarCalculo()=>_calculo=null;
 private async Task AgregarLote(FormulaComponente c){var id=_loteElegido.GetValueOrDefault(c.IdInsumo);var cantidad=_cantidadLote.GetValueOrDefault(c.IdInsumo);var lote=LotesDe(c.IdInsumo).FirstOrDefault(x=>x.Id==id);if(lote is null||cantidad<=0){await Dialogos.ErrorAsync("Seleccione un lote y una cantidad válida.");return;}var existencia=lote.PorBodega.FirstOrDefault(x=>x.IdBodega==_bodega)?.Existencia??0;var lista=_seleccion.GetValueOrDefault(c.IdInsumo)??new();if(lista.Any(x=>x.IdStockLote==id)){await Dialogos.ErrorAsync("Ese lote ya fue agregado para este insumo.");return;}if(cantidad>existencia){await Dialogos.ErrorAsync("La cantidad supera la existencia del lote en la bodega.");return;}_seleccion[c.IdInsumo]=lista;lista.Add(new(id,lote.Numero,cantidad));_loteElegido[c.IdInsumo]=0;_cantidadLote[c.IdInsumo]=1;_calculo=null;}
 private void QuitarLote(long insumo,long lote){if(_seleccion.TryGetValue(insumo,out var l))l.RemoveAll(x=>x.IdStockLote==lote);_calculo=null;}
 private CalculoProduccionRequest Solicitud(bool convertir=false)=>new(){IdArticuloTerminado=_pt!.Codigo,Bodega=_bodega,Convertir=convertir,CantidadAProducir=_cantidadAProducir,NumeroLoteProducido=_loteProducido.Trim(),VencimientoLoteProducido=_vencimientoProducido,Insumos=_formula.Select(c=>new ConsumoInsumo{IdArticuloInsumo=c.IdInsumo,Lotes=_seleccion.GetValueOrDefault(c.IdInsumo)?.Select(l=>new LoteConsumo{IdStockLote=l.IdStockLote,Cantidad=l.Cantidad}).ToList()??new()}).ToList()};
 private async Task Calcular(){if(!TodoCuadra())return;_calculando=true;var r=await Api.CalcularAsync(Solicitud());_calculando=false;if(Ok(r)&&r.Responses!.MaximoAProducir==_cantidadAProducir&&r.Responses.Insumos.All(x=>x.Cuadra))_calculo=r.Responses;else{_calculo=null;await Error(r,"La selección no permite producir la cantidad indicada.");}}
 private bool PuedeConvertir=>_calculo is not null&&TodoCuadra()&&!string.IsNullOrWhiteSpace(_loteProducido)&&_vencimientoProducido is not null;
 private async Task Convertir(){if(!PuedeConvertir)return;if(!await Dialogos.ConfirmarAsync($"Se descontarán los insumos y se creará el lote {_loteProducido.Trim()} del terminado con vencimiento {_vencimientoProducido:dd/MM/yyyy}.","Convertir producción","Convertir"))return;var r=await Api.ConvertirAsync(Solicitud(true));if(!Ok(r)){await Error(r,"No se pudo convertir la producción.");return;}_reporte=r.Responses;Dialogos.Exito("Producción registrada correctamente.");_seleccion.Clear();_calculo=null;_loteProducido="";_vencimientoProducido=null;await CargarBitacora();}
 private async Task CargarBitacora(){var r=await Api.ReportesAsync(new(){Desde=_desde,Hasta=_hasta,IdArticulo=_filtroArticulo});if(Ok(r))_bitacora=r.Responses??new();else await Error(r,"No se pudo cargar la bitácora.");}
 private async Task PrepararAnulacion(ProduccionReporte p){_anulando=p;_motivoAnulacion="";await _modalAnular.ShowAsync();} private async Task ConfirmarAnulacion(){if(_anulando is null||string.IsNullOrWhiteSpace(_motivoAnulacion)){await Dialogos.ErrorAsync("Indique el motivo de anulación.");return;}if(!await Dialogos.ConfirmarPeligroAsync("Se devolverán los insumos y se retirará el terminado del stock.","Anular producción"))return;var r=await Api.AnularAsync(new(){IdProduccion=_anulando.Id,Motivo=_motivoAnulacion.Trim()});if(Ok(r)){await _modalAnular.HideAsync();await CargarBitacora();}else await Error(r,"No se pudo anular la producción.");}
 private async Task Exportar(){var detalle=new List<ProduccionReporte>();foreach(var p in _bitacora){var r=await Api.ReporteAsync(p.Id);detalle.Add(Ok(r)?r.Responses!:p);}static string Q(string? x)=>"\""+(x??"").Replace("\"","\"\"")+"\"";var csv="CABECERAS\nId,Fecha,Codigo PT,Descripcion,Cantidad,Lote,Vencimiento,Bodega,Costo,Usuario,Estado,Motivo\n"+string.Join("\n",detalle.Select(p=>$"{p.Id},{p.Fecha:yyyy-MM-dd HH:mm},{Q(p.CodArticuloTerminado)},{Q(p.DescripcionTerminado)},{p.CantidadProducida},{Q(p.NumeroLoteProducido)},{p.VencimientoLoteProducido:yyyy-MM-dd},{p.Bodega},{p.CostoTotalInsumos},{Q(p.Usuario)},{(p.Anulada?"Anulada":"Activa")},{Q(p.MotivoAnulacion)}"))+"\n\nDETALLE\nId produccion,Codigo insumo,Descripcion,Lote,Cantidad,Costo unitario,Costo linea\n"+string.Join("\n",detalle.SelectMany(p=>p.Lineas.Select(l=>$"{p.Id},{Q(l.CodArticuloInsumo)},{Q(l.DescripcionInsumo)},{Q(l.NumeroLote)},{l.CantidadConsumida},{l.CostoUnitario},{l.CostoLinea}")));await JS.InvokeVoidAsync("seepos.descargarTexto","bitacora-produccion.csv",csv,"text/csv;charset=utf-8");}
 private sealed record LoteSeleccionado(long IdStockLote,string Numero,double Cantidad);
}
