    /// <summary>
    /// true si el API devuelve el listado completo sin termino (carga al abrir).
    /// false si exige un termino: entonces la pantalla funciona por busqueda.
    /// </summary>
    private bool _modoBusqueda;

    // Plazos del catálogo (ConfiguracionPlazos). La ficha del cliente los elige de la
    // lista; se guarda la cantidad de días en PlazoCredito y el API la traduce al
    // IdPlazo al facturar.
    private List<SuvesaPosSitioAplicacion.DTOs.Fiscal.ConfiguracionPlazoFiscalDTO> _plazosCredito = new();

    protected override async Task OnInitializedAsync()
    {
        await RecargarDesdeApi();
        var rp = await Plazos.Obtener();
        if (rp.EsCorrecta && rp.Responses is not null)
            _plazosCredito = rp.Responses
                .Where(p => p.Activo)
                .OrderBy(p => p.CantidadDias)
                .ToList();
    }

    /// <summary>
    /// Al abrir (y con "Buscar" sin termino) intenta traer el listado completo.
    /// Si el API lo rechaza, cae a modo busqueda sin molestar con un error.
    /// </summary>
    private async Task RecargarDesdeApi()
    {
        _buscando = true;
        StateHasChanged();

        var r = await Api.Listar();
        if (r.EsCorrecta && r.Responses is not null)
        {
            _todos = r.Responses.ToList();
            _modoBusqueda = false;
        }
        else
        {
            _todos = new List<FiltranClienteDTO>();
            _modoBusqueda = true;
        }

        _buscando = false;
        Refiltrar();
    }

    /// <summary>Boton Buscar del panel: lista completa si se puede, si no busca por el texto.</summary>
    private async Task Buscar()
    {
        if (!_modoBusqueda)
        {
            await RecargarDesdeApi();
            return;
        }

        if (Helpers.Texto.Normalizar(_texto).Length < 2)
        {
            Dialogos.Advertencia("Escriba al menos dos caracteres para buscar.");
            return;
        }

        _buscando = true;
        StateHasChanged();

        _todos = (await Respuestas.DatoAsync(await Api.Buscar(_texto), "buscar clientes"))
                 ?.ToList() ?? new List<FiltranClienteDTO>();

        _buscando = false;
        Refiltrar();
    }

    private void AlEscribir(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? string.Empty;
        Refiltrar();
    }

    private void LimpiarFiltros()
    {
        _texto = string.Empty;
        _estado = "A";
        Refiltrar();
    }

    private void Refiltrar()
    {
        var t = Helpers.Texto.Normalizar(_texto);
        IEnumerable<FiltranClienteDTO> q = _todos;

        if (_estado == "A") q = q.Where(c => !c.Anulado);
        else if (_estado == "I") q = q.Where(c => c.Anulado);

        if (t.Length > 0)
            q = q.Where(c => Helpers.Texto.Normalizar(c.Nombre).Contains(t)
                          || Helpers.Texto.Normalizar(c.Cedula).Contains(t)
                          || Helpers.Texto.Normalizar(c.Telefono_01).Contains(t));

        _resultados = q.ToList();
        _rejilla?.RefrescarAsync();
        StateHasChanged();
    }

    private string ResumenConteo()
        => _resultados.Count == 0 ? "Sin resultados"
           : $"{_resultados.Count} de {_todos.Count} cliente{(_todos.Count == 1 ? "" : "s")}";

    private Task<GridDataProviderResult<FiltranClienteDTO>> Servir(
        GridDataProviderRequest<FiltranClienteDTO> peticion)
        => Task.FromResult(peticion.ApplyTo(_resultados));

    private async Task Ver(FiltranClienteDTO cliente)
    {
        _elegido = cliente;
        _adjuntos = new List<ClienteAdjuntoDTO>();
        _adjuntosNuevos = new List<ClienteAdjuntoDTO>();
        _cargandoAdjuntos = true;
        _carta = null;
        _cargandoCarta = true;
        await _detalle.ShowAsync();
        await CargarAdjuntos(cliente.Identificacion);
        await CargarCarta(cliente.Cedula);
    }

    private async Task Agregar()
    {
        _esNuevo = true;
        _elegido = null;
        _edicion = new ClienteDTO
        {
            Cedula = string.Empty,
            Nombre = string.Empty,
            EMail = string.Empty,
            Direccion = string.Empty,
            Tipoprecio = 1,
            CodMonedaCredito = 1,
            Estado = true,
            // El DTO generado no trae valor por defecto (queda null); sin esto el API
            // recibe datosSucursal:null y "request.DatosSucursal.Count" revienta con
            // NullReferenceException al crear un cliente sin varias sucursales.
            DatosSucursal = new List<ClienteDatosSucursalDTO>()
        };
        _datosSucursalEdicion = new ClienteDatosSucursalDTO();
        _datosSucursalOriginal = null;
        _adjuntos = new List<ClienteAdjuntoDTO>();
        _adjuntosNuevos = new List<ClienteAdjuntoDTO>();
        _cargandoAdjuntos = false;
        _pestanaEdicion = "generales";
        _variasSucursales = false;
        _cantones = new List<CantonDTO>();
        _distritos = new List<DistritoDTO>();
        _actividadesClienteHacienda = new List<ActividadesEmpresaDTO>();
        _actCodigoCliente = _actDescripcionCliente = string.Empty;
        await CargarProvincias();
        await CargarTiposIdentificacion();
        await _modal.ShowAsync();
    }

    private async Task Editar(FiltranClienteDTO cliente)
    {
        _esNuevo = false;
        _elegido = cliente;
        _edicion = ACliente(cliente);
        _edicion.DatosSucursal = (await Respuestas.DatoAsync(
            await Api.DatosSucursal(cliente.Identificacion), "consultar los datos de facturación"))?.ToList()
            ?? new List<ClienteDatosSucursalDTO>();
        _edicion.Actividades = (await Respuestas.DatoAsync(
            await Api.Actividades(cliente.Identificacion), "consultar las actividades económicas"))?.ToList()
