@page "/initial/customers"
@using MudBlazor
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.DTOs.Tarifas
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IClientesConsulta Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject ICartasExoneracion Cartas
@inject IGeografia Geografia
@inject IEmpresas Empresas
@inject ICatalogoBonificacion CatalogoBonificacion
@inject IClienteBonificacion ClienteBonificacion
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IConfiguracionPlazosFiscales Plazos
@inject IRelojEquipo RelojEquipo
@inject IRutasComerciales RutasApi
@inject ITarifasPrecio TarifasApi
@inject IClienteUnificacion Unificacion
@inject IJSRuntime JS

@*  RUTA DEL MENU, no una propia.
    Esta pantalla ocupa la ruta del sistema actual, asi que a partir de aqui el menu
    llega al sitio nuevo y ya no al iframe de la SPA React.

    Ya incorpora alta, edicion y cambio de estado (cerrado en la Ola 4); no hace
    falta entrar por la SPA React para mantener estos registros.
*@

@*  OLA 1 — replica del ARQUETIPO 02 (consulta de nivel A, movil primero).
    Misma estructura que Views/Inventario/Consulta.razor: una consulta alimenta dos
    presentaciones, busqueda con espera y cancelacion, detalle en panel lateral.
    Solo cambian el proxy, los campos de la tarjeta y las columnas.
*@

<AppPantalla Pantalla="@Titulo" Icono="bi-people-fill" Subtitulo="Consulta y alta de clientes y sus mascotas" Nivel="NivelPantalla.Movil">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportarCsv" disabled="@(_resultados.Count == 0)">
            <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Exportar CSV
        </button>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button type="button" class="btn btn-sm btn-primary" @onclick="Agregar">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
            </button>
        }
    </Acciones>
    <ChildContent>
        <section class="seepos-clientes">

        <AppFiltros AlBuscar="Buscar" AlLimpiar="LimpiarFiltros" Buscando="_buscando"
                    Resumen="@ResumenConteo()">
            <div class="col-12 col-md-6">
                <label class="form-label" for="fCliTexto">Cédula, nombre, sucursal o nombre comercial</label>
                <input id="fCliTexto" type="search" class="form-control" placeholder="Escriba para filtrar..."
                       value="@_texto" @oninput="AlEscribir" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="fCliEstado">Estado</label>
                <select id="fCliEstado" class="form-select" @bind="_estado" @bind:after="Refiltrar">
                    <option value="A">Activos</option>
                    <option value="I">Inactivos</option>
                    <option value="T">Todos</option>
                </select>
            </div>
        </AppFiltros>

        @if (_buscando)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando</span>
                </div>
            </div>
        }
        else
        {
            @* Movil: tarjetas. *@
            <div class="d-md-none d-flex flex-column gap-2">
                @if (_resultados.Count == 0)
                {
                    <p class="text-secondary small text-center py-4 mb-0">
                        @(_modoBusqueda && _todos.Count == 0
                            ? "Escriba y pulse Buscar."
                            : "Ningún cliente coincide.")
                    </p>
                }
                @foreach (var c in _resultados)
                {
                    <button type="button" class="card text-start border-0 shadow-sm p-0"
                            @onclick="() => Ver(c)">
                        <div class="card-body py-2 px-3">
                            <div class="fw-semibold small">@c.Nombre</div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                <code class="small text-secondary">@c.Cedula</code>
                                @if (!string.IsNullOrWhiteSpace(c.Telefono_01))
                                {
                                    <span class="small text-secondary">@c.Telefono_01</span>
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>

            @* Escritorio y tableta: rejilla. *@
            <div class="d-none d-md-block">
                <MudIsla>
                    <MudDataGrid T="FiltranClienteDTO" Items="_resultados" Dense="true" Hover="true" Striped="true"
                                 Filterable="true" SortMode="SortMode.Multiple" Groupable="false"
                                 FixedHeader="true" Height="60vh" Class="seepos-mud-grid">
                        <NoRecordsContent><div class="text-secondary small py-4">@(_modoBusqueda && _todos.Count == 0 ? "Escriba y pulse Buscar." : "Ningún cliente coincide.")</div></NoRecordsContent>
                        <Columns>
                            <PropertyColumn Property="c => c.Cedula" Title="Cédula" />
                            <PropertyColumn Property="c => c.Nombre" Title="Nombre" />
                            <PropertyColumn Property="c => c.Telefono_01" Title="Teléfono" />
                            <PropertyColumn Property="c => c.E_Mail" Title="Correo" />
                            <PropertyColumn Property="c => c.Tipoprecio" Title="Precio" CellClass="justify-center" HeaderClass="justify-center"><CellTemplate>@NombreCategoriaPrecio(context.Item.Tipoprecio)</CellTemplate></PropertyColumn>
                            <PropertyColumn Property="c => c.Max_Credito" Title="Crédito" CellClass="justify-end" HeaderClass="justify-end"><CellTemplate>@Formato.Importe(context.Item.Max_Credito)</CellTemplate></PropertyColumn>
                            <TemplateColumn Title="Acciones" Sortable="false" Filterable="false"><CellTemplate><div class="d-flex gap-1"><button class="btn btn-sm btn-success" title="Ver detalle" aria-label="Ver detalle" @onclick="() => Ver(context.Item)"><i class="bi bi-eye"></i></button> @if (Sesion.Puede(Titulo, AccionPantalla.Modificar)) { <button class="btn btn-sm btn-outline-success" title="Editar cliente" aria-label="Editar cliente" @onclick="() => Editar(context.Item)"><i class="bi bi-pencil"></i></button> }</div></CellTemplate></TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="FiltranClienteDTO" PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
                    </MudDataGrid>
                </MudIsla>
            </div>
        }
        </section>

    </ChildContent>
</AppPantalla>

<AppModal @ref="_modalUnificar" Titulo="Unificar clientes" Subtitulo="@(_origenUnificar?.Nombre)" Tamano="ModalSize.Large"
          AlGuardar="Unificar" Guardando="_unificando" PuedeGuardar="@(_vistaUnificar is not null && _confirmoUnificar)"
          TextoGuardar="Unificar" Peligro="true">
    <ChildContent>
        @if (_origenUnificar is not null)
        {
            <div class="alert alert-warning" role="alert">
                Todo el historial de <strong>@_origenUnificar.Nombre</strong> (@_origenUnificar.Cedula) —facturas, cobros, saldos, pedidos y su ficha—
                pasará al cliente que usted elija. <strong>@_origenUnificar.Nombre</strong> quedará inactivo. Las facturas electrónicas ya emitidas
                no cambian; el cliente que queda conserva su límite de crédito, plazo y tipo de precio.
            </div>

            <label class="form-label" for="unificar-destino">Cliente que queda</label>
            <div class="input-group">
                <input id="unificar-destino" class="form-control" placeholder="Cédula o nombre" @bind="_textoDestinoUnificar"
                       @bind:event="oninput" @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await BuscarDestinoUnificar(); })" />
                <button type="button" class="btn btn-outline-primary" @onclick="BuscarDestinoUnificar">Buscar</button>
            </div>
            @if (_candidatosUnificar.Count > 0)
            {
                <div class="list-group mt-1">
                    @foreach (var c in _candidatosUnificar)
                    {
                        <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirDestinoUnificar(c)">
                            <span class="text-secondary me-2">@c.Cedula</span>@c.Nombre
                        </button>
                    }
                </div>
            }

            @if (_destinoUnificar is not null && _vistaUnificar is not null)
            {
                <div class="mt-3">
                    <div class="mb-2">Pasará a <strong>@_destinoUnificar.Nombre</strong> (@_destinoUnificar.Cedula): @_vistaUnificar.TotalFilas registro(s).</div>
                    @if (_vistaUnificar.Filas.Count == 0)
                    {
                        <div class="text-secondary small">El cliente no tiene registros que pasar; solo quedará inactivo.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-2">
                            <thead><tr><th>Registro</th><th class="text-end">Cantidad</th></tr></thead>
                            <tbody>
                                @foreach (var f in _vistaUnificar.Filas)
                                {
                                    <tr><td>@f.Tabla @(f.EsHistorial ? "" : "(ficha)")</td><td class="text-end">@f.Filas</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="form-check">
                        <input id="unificar-confirmo" class="form-check-input" type="checkbox" @bind="_confirmoUnificar" />
                        <label class="form-check-label" for="unificar-confirmo">Entiendo que esta acción no se puede deshacer.</label>
                    </div>
                </div>
            }

            @if (_errorUnificar is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@_errorUnificar</div>
            }
        }
    </ChildContent>
</AppModal>

<HxOffcanvas @ref="_detalle" Title="@(_elegido?.Nombre ?? "Cliente")"
             Placement="OffcanvasPlacement.End">
    <BodyTemplate>
        @if (_elegido is not null)
        {
            <div class="seepos-cliente-detalle-hero mb-3"><div><span class="small text-secondary d-block">Cliente</span><strong>@_elegido.Nombre</strong></div><span class="badge @(_elegido.Anulado ? "text-bg-secondary" : "text-bg-success")">@(_elegido.Anulado ? "Inactivo" : "Activo")</span></div>
            <h3 class="seepos-detalle-seccion">Información de contacto</h3>
            <dl class="row small mb-0 seepos-cliente-datos">
                <dt class="col-5 fw-normal text-secondary">Cedula</dt>
                <dd class="col-7"><code>@_elegido.Cedula</code></dd>

                <dt class="col-5 fw-normal text-secondary">Nombre comercial</dt>
                <dd class="col-7">@NombreComercialVisible</dd>

                <dt class="col-5 fw-normal text-secondary">Telefono</dt>
                <dd class="col-7">@(_elegido.Telefono_01 ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Telefono 2</dt>
                <dd class="col-7">@(_elegido.Telefono_02 ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Correo</dt>
                <dd class="col-7">@(_elegido.E_Mail ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Direccion</dt>
                <dd class="col-7">@(_elegido.Direccion ?? "—")</dd>
            </dl>

            <hr />
            <h3 class="seepos-detalle-seccion">Condiciones comerciales</h3>
            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Credito maximo</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Max_Credito)</dd>

                <dt class="col-5 fw-normal text-secondary">Plazo</dt>
                <dd class="col-7 seepos-importe">@_elegido.Plazo_Credito dias</dd>

                <dt class="col-5 fw-normal text-secondary">Impuesto</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Impuesto)</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_elegido.Observaciones))
            {
                <hr />
                <p class="small text-secondary mb-0">@_elegido.Observaciones</p>
            }

            <hr />
            <h3 class="h6 mb-2">Sucursales y datos de facturación</h3>
            @if (_cargandoDatosSucursal)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Cargando sucursales</span>
                </div>
            }
            else if (_datosSucursalesDetalle.Count == 0)
            {
                <p class="small text-secondary mb-0">Este cliente no tiene sucursales o nombres comerciales adicionales registrados.</p>
            }
            else
            {
                <div class="table-responsive seepos-cliente-sucursales">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sucursal</th>
                                <th>Nombre comercial</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sucursal in _datosSucursalesDetalle)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(sucursal.Sucursal) ? "—" : sucursal.Sucursal)</td>
                                    <td>@(string.IsNullOrWhiteSpace(sucursal.NombreComercial) ? "—" : sucursal.NombreComercial)</td>
                                    <td>@(string.IsNullOrWhiteSpace(sucursal.Contacto) ? "—" : sucursal.Contacto)</td>
                                    <td class="text-nowrap">@(string.IsNullOrWhiteSpace(sucursal.Telefono) ? "—" : sucursal.Telefono)</td>
                                    <td>@(string.IsNullOrWhiteSpace(sucursal.Email) ? "—" : sucursal.Email)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex gap-2 border-top pt-3 mt-3 seepos-detalle-acciones">
                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => Editar(_elegido)">Editar</button>
                }
                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                {
                    <button class="btn btn-sm @( _elegido.Anulado ? "btn-outline-success" : "btn-outline-danger")"
                            @onclick="() => CambiarEstado(_elegido)">
                        @(_elegido.Anulado ? "Activar" : "Desactivar")
                    </button>
                    <button class="btn btn-sm btn-outline-danger" disabled="@(_estadoEliminacion is not { PuedeEliminar: true })"
                            title="@(_estadoEliminacion?.Mensaje ?? "Elimina la ficha definitivamente")" @onclick="() => Eliminar(_elegido)">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar
                    </button>
                }
                @if (PuedeUnificar)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirUnificar(_elegido)">Unificar con otro…</button>
                }
            </div>
            @if (_estadoEliminacion is { PuedeEliminar: false, Mensaje: not null })
            {
                <div class="form-text mt-2">@_estadoEliminacion.Mensaje</div>
            }

            <hr />
            <h3 class="h6">Carta de exoneración</h3>
            @if (_cargandoCarta)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando carta</span></div>
            }
            else if (_carta is null)
            {
                <p class="small text-secondary mb-2">El cliente no tiene una carta de exoneración vigente.</p>
                @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="NuevaCarta">Agregar carta</button>
                }
            }
            else
            {
                <dl class="row small mb-2">
                    <dt class="col-6 fw-normal text-secondary">Documento</dt><dd class="col-6">@_carta.NumeroDocumento</dd>
                    <dt class="col-6 fw-normal text-secondary">Vence</dt><dd class="col-6">@_carta.FechaVence.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-6 fw-normal text-secondary">Exoneración</dt><dd class="col-6">@_carta.PorcentajeCompra.ToString("N2")%</dd>
                    <dt class="col-6 fw-normal text-secondary">Crédito fiscal</dt><dd class="col-6">@(_carta.ReglaCreditoVenta switch { "CON_DERECHO" => "Da derecho", "SIN_DERECHO" => "No da derecho", _ => "Regla del cliente" })</dd>
                </dl>
                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="EditarCarta">Editar carta</button>
                }
            }

            <hr />
            <h3 class="h6">Adjuntos</h3>
            @if (_cargandoAdjuntos)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando adjuntos</span></div>
            }
            else
            {
                <InputFile class="form-control form-control-sm" OnChange="AgregarAdjunto" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp" />
                <p class="form-text">PDF, Word o imágenes; máximo 10 MB por archivo.</p>

                @if (_adjuntos.Count == 0 && _adjuntosNuevos.Count == 0)
                {
                    <p class="small text-secondary mb-0">No hay adjuntos.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var adjunto in _adjuntos)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                <span class="text-truncate">@adjunto.Extencion</span>
                                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarAdjunto(adjunto)">Eliminar</button>
                                }
                            </li>
                        }
                        @foreach (var adjunto in _adjuntosNuevos)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                <span class="text-truncate">@adjunto.Extencion <span class="text-secondary">(pendiente)</span></span>
                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => _adjuntosNuevos.Remove(adjunto)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button>
                            </li>
                        }
                    </ul>
                    @if (_adjuntosNuevos.Count > 0)
                    {
                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="GuardarAdjuntos" disabled="@_guardandoAdjuntos">@(_guardandoAdjuntos ? "Guardando..." : "Guardar adjuntos")</button>
                    }
                }
            }
        }
    </BodyTemplate>
</HxOffcanvas>

<HxModal @ref="_modalCarta" Title="@(_cartaEsNueva ? "Nueva carta de exoneración" : "Editar carta de exoneración")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_cartaEdicion is not null)
        {
            <EditForm Model="_cartaEdicion" OnValidSubmit="GuardarCarta" id="formCarta">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Número de documento" @bind-Valor="_cartaEdicion.NumeroDocumento" /></div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-tipo">Tipo de exoneración</label>
                        <input id="carta-tipo" type="number" min="1" class="form-control" @bind="_cartaEdicion.IdTipoExoneracion" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-emision">Fecha de emisión</label>
                        <input id="carta-emision" type="date" class="form-control" @bind="_cartaEdicion.FechaEmision" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-vence">Fecha de vencimiento</label>
                        <input id="carta-vence" type="date" class="form-control" @bind="_cartaEdicion.FechaVence" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-porcentaje">Porcentaje de compra</label>
                        <input id="carta-porcentaje" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_cartaEdicion.PorcentajeCompra" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-impuesto">Impuesto</label>
                        <input id="carta-impuesto" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_cartaEdicion.Impuesto" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-regla-credito">Crédito fiscal de lo exonerado</label>
                        <select id="carta-regla-credito" class="form-select" value="@(_cartaEdicion.ReglaCreditoVenta ?? "")" @onchange="e => _cartaEdicion.ReglaCreditoVenta = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                            <option value="">Usar la regla del cliente</option>
                            <option value="CON_DERECHO">Da derecho a crédito</option>
                            <option value="SIN_DERECHO">No da derecho a crédito</option>
                        </select>
                        <div class="form-text">Prorrata del IVA: la carta manda sobre la regla del cliente.</div>
                    </div>
                    <div class="col-12"><AppCampoTexto Etiqueta="Nota" @bind-Valor="_cartaEdicion.Nota" /></div>
                </div>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modalCarta.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formCarta" disabled="@_guardandoCarta">@(_guardandoCarta ? "Guardando..." : "Guardar")</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modal" Title="@(_esNuevo ? "Nuevo cliente" : "Editar cliente")" Size="ModalSize.Large" Scrollable="true">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnSubmit="GuardarDesdeFormulario" id="formCliente" class="seepos-cliente-editor">
                <nav class="mb-3 seepos-editor-tabs" aria-label="Secciones del cliente">
                    <div class="nav nav-pills flex-wrap gap-2">
                        <button type="button" class="btn btn-sm @ClaseGenerales" @onclick="AbrirGenerales">Datos generales</button>
                        <button type="button" class="btn btn-sm @ClaseCredito" @onclick="AbrirCredito">Crédito y descuento</button>
                        @if (!Sesion.EsCostaPets)
                        {
                            <button type="button" class="btn btn-sm @ClaseCarta" @onclick="AbrirCarta">Carta exoneración</button>
                        }
                        @if (Sesion.EsCostaPets)
                        {
                            <button type="button" class="btn btn-sm @ClaseAdjuntos" @onclick="AbrirAdjuntos">Documentos adjuntos</button>
                        }
                        @if (Sesion.EsCostaPets && _variasSucursales)
                        {
                            <button type="button" class="btn btn-sm @ClaseFacturacion" @onclick="AbrirFacturacion">Datos facturación</button>
                        }
                        @if (Sesion.EsCostaPets && _edicion.TieneBonificacion && !_esNuevo)
                        {
                            <button type="button" class="btn btn-sm @ClaseBonificacion" @onclick="AbrirBonificacion">Bonificación</button>
                        }
                    </div>
                </nav>

                @if (_pestanaEdicion == "generales")
                {
                    <div class="row g-3">
                        <div class="col-12 seepos-form-seccion">Identificación</div>
                        <div class="col-12 col-md-5"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_edicion.Nombre" Requerido="true" /></div>
                        <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Cédula" @bind-Valor="_edicion.Cedula" Deshabilitado="@(!_esNuevo)" Requerido="true" /></div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-tipo-identificacion">Tipo de identificación</label>
                            <select id="cliente-tipo-identificacion" class="form-select" @bind="_edicion.IdTipoIdentificacion">
                                <option value="0">Seleccione...</option>
                                @foreach (var tipo in _tiposIdentificacion) { <option value="@tipo.Id">@tipo.Descripcion</option> }
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ConsultarHacienda" disabled="@(_consultandoHacienda || string.IsNullOrWhiteSpace(_edicion.Cedula))">
                                @(_consultandoHacienda ? "Consultando..." : "Consultar en Hacienda")
                            </button>
                        </div>

                        <div class="col-12 seepos-form-seccion">Contacto</div>
                        <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_edicion.Telefono01" Requerido="true" /></div>
                        <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Teléfono alterno" @bind-Valor="_edicion.Telefono02" /></div>
                        <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Correo cuentas por cobrar" @bind-Valor="_edicion.EMail" Requerido="true" /></div>

                        <div class="col-12 seepos-form-seccion">Precios</div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-categoria-precio">Categoría de precio</label>
                            <select id="cliente-categoria-precio" class="form-select" @bind="CategoriaPrecioEdicion">
                                @foreach (var t in OpcionesTarifa)
                                {
                                    <option value="@t.IdTarifa">@t.Nombre@(t.Activa ? string.Empty : " (inactiva)")</option>
                                }
                            </select>
                            <div class="form-text">Tarifa de este cliente: la que se respeta al facturar. Se administran en Catálogos → Tarifas. Si el artículo no tiene precio en ella, se usa el Precio A.</div>
                        </div>

                        <div class="col-12 seepos-form-seccion">Ruta comercial</div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-tipo">Tipo de cliente</label>
                            <select id="cliente-tipo" class="form-select" value="@(_edicion.TipoCliente ?? "PUNTO_VENTA")" @onchange="e => _edicion.TipoCliente = e.Value?.ToString()">
                                <option value="PUNTO_VENTA">Punto de venta / distribuidora</option>
                                <option value="CONSUMIDOR_FINAL">Consumidor final</option>
                            </select>
                            <div class="form-text">@(_edicion.TipoCliente == "CONSUMIDOR_FINAL" ? "Consumidor final: usa la ruta de sistema «Consumidor Final»; la comisión es solo de quien factura." : "Punto de venta: tiene ruta y agente responsable.")</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-ruta">Ruta comercial @if (_edicion.TipoCliente != "CONSUMIDOR_FINAL") { <span class="text-danger" aria-hidden="true">*</span> }</label>
                            <select id="cliente-ruta" class="form-select" disabled="@(_edicion.TipoCliente == "CONSUMIDOR_FINAL")" value="@(_edicion.IdRutaComercial ?? 0)" @onchange="e => _edicion.IdRutaComercial = int.TryParse(e.Value?.ToString(), out var r) && r > 0 ? r : null">
                                <option value="0">@(_edicion.TipoCliente == "CONSUMIDOR_FINAL" ? "Consumidor Final (automática)" : "Seleccione...")</option>
                                @foreach (var ruta in _rutasComerciales.Where(r => !r.EsConsumidorFinal)) { <option value="@ruta.IdRuta">@ruta.Nombre</option> }
                                @if (_edicion.IdRutaComercial is > 0 && !_rutasComerciales.Any(r => r.IdRuta == _edicion.IdRutaComercial))
                                {
                                    <option value="@_edicion.IdRutaComercial">Ruta @_edicion.IdRutaComercial (inactiva)</option>
                                }
                            </select>
                            <div class="form-text">Obligatoria: de la ruta sale el agente responsable del cliente y es la ruta de todas sus facturas.</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-regla-credito">Crédito fiscal de sus compras</label>
                            <select id="cliente-regla-credito" class="form-select" value="@(_edicion.ReglaCreditoVenta ?? "")" @onchange="e => _edicion.ReglaCreditoVenta = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                                <option value="">Según la tarifa del artículo</option>
                                <option value="CON_DERECHO">Da derecho a crédito (exportador, zona franca, CCSS, municipalidad...)</option>
                                <option value="SIN_DERECHO">No da derecho a crédito</option>
                            </select>
                            <div class="form-text">Solo cambia las ventas exentas, no sujetas o exoneradas; una venta gravada común siempre da crédito. Se usa en la prorrata del IVA.</div>
                        </div>

                        <div class="col-12 seepos-form-seccion">Ubicación</div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-provincia">Provincia</label>
                            <select id="cliente-provincia" class="form-select" value="@_edicion.IdProvincia" @onchange="AlCambiarProvincia">
                                <option value="0">Seleccione...</option>
                                @foreach (var provincia in _provincias) { <option value="@provincia.Id">@provincia.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-canton">Cantón</label>
                            <select id="cliente-canton" class="form-select" value="@_edicion.IdCanton" @onchange="AlCambiarCanton" disabled="@(_edicion.IdProvincia <= 0)">
                                <option value="0">Seleccione...</option>
                                @foreach (var canton in _cantones) { <option value="@canton.Id">@canton.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-distrito">Distrito</label>
                            <select id="cliente-distrito" class="form-select" @bind="_edicion.IdDistrito" disabled="@(_edicion.IdCanton <= 0)">
                                <option value="0">Seleccione...</option>
                                @foreach (var distrito in _distritos) { <option value="@distrito.Id">@distrito.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-12"><AppCampoTexto Etiqueta="Dirección" @bind-Valor="_edicion.Direccion" Requerido="true" /></div>
                        <div class="col-12"><AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_edicion.Observaciones" /></div>

                        <div class="col-12 seepos-form-seccion">Facturación electrónica</div>
                        <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Correo de facturación electrónica" @bind-Valor="_edicion.CorreoComprobante" Requerido="true" /></div>

                        <div class="col-12">
                            <label class="form-label mb-1">Actividades económicas</label>
                            <p class="form-text mt-0 mb-2">Un cliente puede tener varias actividades registradas en Hacienda. La marcada como <strong>Principal</strong> es la que se usa en la factura electrónica.</p>
                            @if ((_edicion.Actividades?.Count ?? 0) > 0)
                            {
                                <div class="table-responsive mb-2"><table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Código</th><th>Descripción</th><th class="text-center">Principal</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var actividad in _edicion.Actividades)
                                        {
                                            <tr>
                                                <td>@actividad.Codigo</td>
                                                <td>@actividad.Descripcion</td>
                                                <td class="text-center">
                                                    <input type="radio" class="form-check-input" name="cliente-actividad-principal"
                                                           checked="@(actividad.Principal == true)" @onchange="() => MarcarActividadPrincipal(actividad)" />
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarActividad(actividad)">
                                                        <i class="bi bi-trash" aria-hidden="true"></i> Quitar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-3"><label class="form-label">Código</label><input class="form-control form-control-sm" @bind="_actCodigoCliente" /></div>
                                <div class="col-12 col-md-4"><label class="form-label">Descripción</label><input class="form-control form-control-sm" @bind="_actDescripcionCliente" /></div>
                                <div class="col-6 col-md-2 d-grid"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarActividadCliente">Agregar</button></div>
                                <div class="col-6 col-md-3 d-grid">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BuscarActividadesHaciendaCliente" disabled="@(_buscandoActividadesCliente || string.IsNullOrWhiteSpace(_edicion.Cedula))">
                                        @(_buscandoActividadesCliente ? "Consultando..." : "Buscar en Hacienda")
                                    </button>
                                </div>
                            </div>
                            @if (_actividadesClienteHacienda.Count > 0)
                            {
                                <div class="list-group list-group-flush mt-2">
                                    @foreach (var actividad in _actividadesClienteHacienda)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                @onclick="() => UsarActividadHacienda(actividad)">
                                            <span>@actividad.Codigo — @actividad.Descripcion</span>
                                            @if (actividad.Tipo) { <span class="badge bg-secondary">Principal en Hacienda</span> }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (!_variasSucursales) { <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Nombre comercial" @bind-Valor="_edicion.NombreFantasia" /></div> }
                        @if (_edicion.EnviarRecibo) { <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Correo para recibos" @bind-Valor="_edicion.CorreoRecibo" /></div> }
                        <div class="col-12">
                            <div class="seepos-editor-marcas">
                                <div class="form-check"><input id="cliente-sucursales" class="form-check-input" type="checkbox" checked="@_variasSucursales" @onchange="AlCambiarSucursales" /><label class="form-check-label" for="cliente-sucursales">Varias sucursales</label></div>
                                <div class="form-check"><input id="cliente-recibo" class="form-check-input" type="checkbox" @bind="_edicion.EnviarRecibo" /><label class="form-check-label" for="cliente-recibo">Enviar recibo al correo</label></div>
                            </div>
                        </div>

                        <div class="col-12 seepos-form-seccion">Marcas</div>
                        <div class="col-12">
                            <div class="seepos-editor-marcas">
                                @if (!Sesion.EsCostaPets)
                                {
                                    <div class="form-check"><input id="cliente-empresa-general" class="form-check-input" type="checkbox" @bind="_edicion.Empresa" /><label class="form-check-label" for="cliente-empresa-general">Empresa</label></div>
                                    <div class="form-check"><input id="cliente-mag" class="form-check-input" type="checkbox" @bind="_edicion.Mag" /><label class="form-check-label" for="cliente-mag">Registrado en MAG</label></div>
                                    <div class="form-check"><input id="cliente-actualizado" class="form-check-input" type="checkbox" @bind="_edicion.Actualizado" /><label class="form-check-label" for="cliente-actualizado">Actualizado</label></div>
                                    <div class="form-check"><input id="cliente-fallecido" class="form-check-input" type="checkbox" @bind="_edicion.Fallecido" /><label class="form-check-label" for="cliente-fallecido">Fallecido</label></div>
                                }
                                <div class="form-check"><input id="cliente-despacho" class="form-check-input" type="checkbox" @bind="_edicion.RequiereDespacho" /><label class="form-check-label" for="cliente-despacho">Requiere despacho (bodega)</label></div>
                                @if (Sesion.EsCostaPets)
                                {
                                    <div class="form-check"><input id="cliente-bonificado" class="form-check-input" type="checkbox" @bind="_edicion.TieneBonificacion" /><label class="form-check-label" for="cliente-bonificado">Bonificado</label></div>
                                }
                            </div>
                            @if (Sesion.EsCostaPets && _edicion.TieneBonificacion && _esNuevo)
                            {
                                <p class="text-secondary small mt-2 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>La pestaña de Bonificación se habilita al guardar el cliente.</p>
                            }
                        </div>
                    </div>
                }
                else if (_pestanaEdicion == "credito")
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-4"><div class="form-check mt-md-4"><input id="cliente-credito-abierto" class="form-check-input" type="checkbox" @bind="_edicion.Abierto" /><label class="form-check-label" for="cliente-credito-abierto">¿Activar crédito?</label></div></div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-plazo">Plazo de crédito</label>
                            <select id="cliente-plazo" class="form-select" @bind="_edicion.PlazoCredito">
                                <option value="0">Sin plazo</option>
                                @foreach (var p in _plazosCredito)
                                {
                                    <option value="@p.CantidadDias">@p.Descripcion</option>
                                }
                                @if (_edicion.PlazoCredito is > 0 && !_plazosCredito.Any(p => p.CantidadDias == _edicion.PlazoCredito))
                                {
                                    <option value="@_edicion.PlazoCredito">@_edicion.PlazoCredito días (no está en el catálogo)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4"><label class="form-label" for="cliente-credito">Límite de crédito</label><input id="cliente-credito" type="number" min="0" step="0.01" class="form-control" @bind="_edicion.MaxCredito" /></div>
                        <div class="col-12 col-md-4"><label class="form-label" for="cliente-descuento">Límite descuento (%)</label><input id="cliente-descuento" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_edicion.Descuento" /></div>
                        <div class="col-12 col-md-4"><label class="form-label" for="cliente-caducidad">Días mínimos de caducidad al despachar</label><input id="cliente-caducidad" type="number" min="0" step="1" class="form-control" @bind="_edicion.DiasMinimosCaducidad" /></div>
                        @if (!Sesion.EsCostaPets)
                        {
                            <div class="col-12 col-md-4"><label class="form-label" for="cliente-descuento-especial">Descuento especial (%)</label><input id="cliente-descuento-especial" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_edicion.DescuentoEspecial" /></div>
                            <div class="col-12 d-flex flex-wrap gap-4"><div class="form-check"><input id="cliente-sin-restriccion" class="form-check-input" type="checkbox" @bind="_edicion.Sinrestriccion" /><label class="form-check-label" for="cliente-sin-restriccion">Permitir venta sin restricción</label></div><div class="form-check"><input id="cliente-moroso" class="form-check-input" type="checkbox" @bind="_edicion.ClienteMoroso" /><label class="form-check-label text-danger" for="cliente-moroso">Cliente moroso</label></div><div class="form-check"><input id="cliente-orden" class="form-check-input" type="checkbox" @bind="_edicion.OrdenCompra" /><label class="form-check-label" for="cliente-orden">Obligar orden de compra</label></div></div>
                        }
                    </div>
                }
                else if (_pestanaEdicion == "carta")
                {
                    <p class="text-secondary small">La carta se administra por separado para conservar su vigencia y trazabilidad.</p>
                    @if (_cargandoCarta) { <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando carta</span></div> }
                    else if (_carta is null) { <button type="button" class="btn btn-outline-primary" @onclick="NuevaCarta">Agregar carta de exoneración</button> }
                    else { <p class="mb-2"><strong>@_carta.NumeroDocumento</strong> · vence @_carta.FechaVence.ToString("dd/MM/yyyy")</p><button type="button" class="btn btn-outline-primary" @onclick="EditarCarta">Editar carta</button> }
                }
                else if (_pestanaEdicion == "adjuntos")
                {
                    <InputFile class="form-control" OnChange="AgregarAdjunto" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp" />
                    <p class="form-text">PDF, Word o imágenes; máximo 10 MB por archivo.</p>
                    @if (_adjuntos.Count == 0 && _adjuntosNuevos.Count == 0) { <p class="text-secondary small">No hay adjuntos.</p> }
                    else { <ul class="list-group list-group-flush small">@foreach (var adjunto in _adjuntos) { <li class="list-group-item px-0 d-flex justify-content-between"><span>@adjunto.Extencion</span><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => EliminarAdjunto(adjunto)">Eliminar</button></li> } @foreach (var adjunto in _adjuntosNuevos) { <li class="list-group-item px-0 d-flex justify-content-between"><span>@adjunto.Extencion <span class="text-secondary">(pendiente)</span></span><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => _adjuntosNuevos.Remove(adjunto)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button></li> }</ul> }
                    @if (_adjuntosNuevos.Count > 0)
                    {
                        @if (_esNuevo)
                        {
                            <p class="alert alert-info small mt-3 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Los documentos se guardarán al crear el cliente.</p>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-primary mt-3" @onclick="GuardarAdjuntos" disabled="@_guardandoAdjuntos">@(_guardandoAdjuntos ? "Guardando..." : "Guardar adjuntos")</button>
                        }
                    }
                }
                else if (_pestanaEdicion == "facturacion")
                {
                    <div class="row g-3">
                        <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Sucursal" @bind-Valor="_datosSucursalEdicion.Sucursal" /></div>
                        <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Nombre comercial" @bind-Valor="_datosSucursalEdicion.NombreComercial" /></div>
                        <div class="col-12 col-md-2"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_datosSucursalEdicion.Telefono" /></div>
                        <div class="col-12 col-md-2"><AppCampoTexto Etiqueta="Correo" @bind-Valor="_datosSucursalEdicion.Email" /></div>
                        <div class="col-12 col-md-2 d-grid align-self-end">
                            <button type="button" class="btn btn-outline-primary" @onclick="AgregarDatosSucursal">@(_datosSucursalOriginal is null ? "Agregar" : "Guardar cambios")</button>
                        </div>
                        <div class="col-12"><AppCampoTexto Etiqueta="Contacto" @bind-Valor="_datosSucursalEdicion.Contacto" /></div>
                        @if (_datosSucursalOriginal is not null)
                        {
                            <div class="col-12"><button type="button" class="btn btn-sm btn-link text-secondary p-0" @onclick="CancelarEdicionDatosSucursal">Cancelar edición</button></div>
                        }
                    </div>
                    @if (_edicion.DatosSucursal is { Count: > 0 }) { <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Sucursal</th><th>Nombre comercial</th><th>Teléfono</th><th>Correo</th><th>Contacto</th><th></th></tr></thead><tbody>@foreach (var dato in _edicion.DatosSucursal) { <tr><td>@dato.Sucursal</td><td>@dato.NombreComercial</td><td>@dato.Telefono</td><td>@dato.Email</td><td>@dato.Contacto</td><td class="text-end text-nowrap"><button type="button" class="btn btn-sm btn-link" @onclick="() => EditarDatosSucursal(dato)"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</button><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarDatosSucursal(dato)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button></td></tr> }</tbody></table></div> }
                }
                else if (_pestanaEdicion == "bonificacion")
                {
                    @*  §5.9: cada asignación amarra un tipo a UN artículo (con "Bonificado"
                        activo) más una nota corta. El cliente puede tener varias, una por
                        artículo. Al facturar, el tipo sólo aplica para ese mismo artículo. *@
                    @if (_tiposBonificacion.Count == 0)
                    {
                        <div class="alert alert-warning">No hay tipos de bonificación activos. Créelos primero en <strong>Catálogos &rsaquo; Tipos de Bonificación</strong> (<code>/parameters/bonus-types</code>).</div>
                    }
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="cliente-bonificacion-tipo">Tipo de bonificación</label>
                            <select id="cliente-bonificacion-tipo" class="form-select" @bind="_tipoBonificacionSeleccionado">
                                <option value="0">Seleccione...</option>
                                @foreach (var tipo in _tiposBonificacion)
                                {
                                    <option value="@tipo.IdConfiguracionBonificacion">@tipo.Descripcion (@tipo.CantidadVenta lleva @tipo.CantidadBonificable)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Artículo bonificable</label>
                            <div class="input-group">
                                <input class="form-control" disabled value="@_articuloBonificacionSeleccionado?.Descripcion" placeholder="Ninguno seleccionado" />
                                <button type="button" class="btn btn-outline-primary" @onclick="AbrirBuscadorArticuloBonificacion"><i class="bi bi-search" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div class="col-12 col-md-9">
                            <label class="form-label" for="cliente-bonificacion-desc">Descripción</label>
                            <input id="cliente-bonificacion-desc" class="form-control" maxlength="160" @bind="_descripcionBonificacion" placeholder="Nota corta de la promoción" />
                        </div>
                        <div class="col-12 col-md-3 d-grid">
                            <button type="button" class="btn btn-success" @onclick="GuardarBonificacionCliente" disabled="@_guardandoBonificacion">
                                @(_idBonificacionEnEdicion > 0 ? "Guardar cambios" : "Agregar")
                            </button>
                        </div>
                    </div>

                    @if (_bonificaciones.Count == 0)
                    {
                        <p class="text-secondary small mt-3 mb-0">Sin bonificaciones asignadas.</p>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm align-middle">
                                <thead><tr><th>Tipo de bonificación</th><th>Artículo</th><th>Descripción</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var b in _bonificaciones)
                                    {
                                        <tr>
                                            <td>@NombreTipoBonificacion(b.IdConfiguracionBonificacion)</td>
                                            <td>@(string.IsNullOrWhiteSpace(b.DescripcionArticulo) ? b.IdArticulo.ToString() : b.DescripcionArticulo)</td>
                                            <td>@b.Descripcion</td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-link" @onclick="() => EditarBonificacionCliente(b)">Editar</button>
                                                <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => EliminarBonificacionCliente(b)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (!string.IsNullOrEmpty(_errorFicha))
        {
            <div class="alert alert-danger py-2 px-3 mb-0 me-auto small text-start" role="alert" style="white-space: pre-line;">@_errorFicha</div>
        }
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formCliente" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

