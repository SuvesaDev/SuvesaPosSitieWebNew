    private async Task AgregarAdjunto(InputFileChangeEventArgs evento)
    {
        var idCliente = IdClienteActual;

        var archivo = evento.File;
        const long maximo = 10 * 1024 * 1024;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        var permitidas = new[] { ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png", ".gif", ".webp" };

        if (!permitidas.Contains(extension) || archivo.Size > maximo)
        {
            await Dialogos.ErrorAsync("El adjunto debe ser PDF, Word o imagen y no superar 10 MB.");
            return;
        }

        await using var entrada = archivo.OpenReadStream(maximo);
        await using var memoria = new MemoryStream();
        await entrada.CopyToAsync(memoria);
        var base64 = Convert.ToBase64String(memoria.ToArray());
        var contenido = $"data:{archivo.ContentType};base64,{base64}";

        _adjuntosNuevos.Add(new ClienteAdjuntoDTO
        {
            IdCliente = idCliente,
            Archivo = contenido,
            Tipo = extension.TrimStart('.'),
            Extencion = archivo.Name
        });
    }

    private async Task GuardarAdjuntos()
    {
        var idCliente = IdClienteActual;
        if (idCliente <= 0 || _adjuntosNuevos.Count == 0 || _guardandoAdjuntos)
        {
            return;
        }

        if (!await Dialogos.ConfirmarAsync("Se guardarán los adjuntos seleccionados."))
        {
            return;
        }

        if (await PersistirAdjuntos(idCliente, recargar: true))
        {
            Dialogos.Exito("Adjuntos guardados.");
        }
    }

    private async Task<bool> PersistirAdjuntos(long idCliente, bool recargar)
    {
        if (idCliente <= 0 || _adjuntosNuevos.Count == 0 || _guardandoAdjuntos)
        {
            return false;
        }

        foreach (var adjunto in _adjuntosNuevos)
        {
            adjunto.IdCliente = idCliente;
        }

        _guardandoAdjuntos = true;
        var respuesta = await Api.GuardarAdjuntos(_adjuntosNuevos);
        _guardandoAdjuntos = false;

        if (!await Respuestas.CorrectaAsync(respuesta, "guardar los adjuntos"))
        {
            return false;
        }

        _adjuntosNuevos = new List<ClienteAdjuntoDTO>();
        if (recargar)
        {
            _cargandoAdjuntos = true;
            await CargarAdjuntos(idCliente);
        }
        return true;
    }

