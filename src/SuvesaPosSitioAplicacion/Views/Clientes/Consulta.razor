                    else { <ul class="list-group list-group-flush small">@foreach (var adjunto in _adjuntos) { <li class="list-group-item px-0 d-flex justify-content-between"><span>@adjunto.Extencion</span><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => EliminarAdjunto(adjunto)">Eliminar</button></li> } @foreach (var adjunto in _adjuntosNuevos) { <li class="list-group-item px-0 d-flex justify-content-between"><span>@adjunto.Extencion <span class="text-secondary">(pendiente)</span></span><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => _adjuntosNuevos.Remove(adjunto)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button></li> }</ul> }
                    @if (_adjuntosNuevos.Count > 0)
