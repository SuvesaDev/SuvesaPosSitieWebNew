    private async Task EditarCarta()
    {
        if (_carta is null)
        {
            return;
        }

        _cartaEsNueva = false;
        _cartaEdicion = new CartaExoneracionDTO
        {
            Id = _carta.Id,
            Cedula = _carta.Cedula,
            IdTipoExoneracion = _carta.IdTipoExoneracion,
            NumeroDocumento = _carta.NumeroDocumento,
            FechaEmision = _carta.FechaEmision,
            FechaVence = _carta.FechaVence,
            PorcentajeCompra = _carta.PorcentajeCompra,
            Impuesto = _carta.Impuesto,
            Nota = _carta.Nota,
            ReglaCreditoVenta = _carta.ReglaCreditoVenta,
            Estado = _carta.Estado,
            IdUsuarioCreacion = _carta.IdUsuarioCreacion,
            IdUsuarioModificacion = Sesion.Usuario
        };
        await _modalCarta.ShowAsync();
    }

    private async Task GuardarCarta()
    {
        if (_cartaEdicion is null || _guardandoCarta)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_cartaEdicion.NumeroDocumento)
            || _cartaEdicion.IdTipoExoneracion <= 0
            || _cartaEdicion.FechaVence < _cartaEdicion.FechaEmision)
        {
            await Dialogos.ErrorAsync("Indique documento, tipo de exoneración y un período válido.");
            return;
        }

        if (!await Dialogos.ConfirmarAsync(_cartaEsNueva ? "Se registrará la carta de exoneración." : "Se actualizará la carta de exoneración."))
        {
            return;
        }

        _guardandoCarta = true;
        var respuesta = _cartaEsNueva ? await Cartas.Crear(_cartaEdicion) : await Cartas.Editar(_cartaEdicion);
        _guardandoCarta = false;

        if (await Respuestas.CorrectaAsync(respuesta, "guardar la carta de exoneración"))
        {
            _carta = respuesta.Responses ?? _cartaEdicion;
            await _modalCarta.HideAsync();
            Dialogos.Exito("Carta de exoneración guardada.");
        }
    }

    private long IdClienteActual => _edicion?.Identificacion > 0
        ? _edicion.Identificacion
        : _elegido?.Identificacion ?? 0;

    private string? CedulaActual => _edicion?.Cedula ?? _elegido?.Cedula;
}
