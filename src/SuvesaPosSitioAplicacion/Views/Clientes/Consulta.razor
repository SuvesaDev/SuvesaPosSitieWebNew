                                    <div class="form-check"><input id="cliente-mag" class="form-check-input" type="checkbox" @bind="_edicion.Mag" /><label class="form-check-label" for="cliente-mag">Registrado en MAG</label></div>
                                    <div class="form-check"><input id="cliente-actualizado" class="form-check-input" type="checkbox" @bind="_edicion.Actualizado" /><label class="form-check-label" for="cliente-actualizado">Actualizado</label></div>
                                    <div class="form-check"><input id="cliente-fallecido" class="form-check-input" type="checkbox" @bind="_edicion.Fallecido" /><label class="form-check-label" for="cliente-fallecido">Fallecido</label></div>
