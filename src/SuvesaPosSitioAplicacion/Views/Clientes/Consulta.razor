        var accion = activar ? "activar" : "desactivar";
        if (!await Dialogos.ConfirmarPeligroAsync($"¿Desea {accion} a {cliente.Nombre}?"))
        {
            return;
        }

        var respuesta = await Api.CambiarEstado(new EliminarClienteDTO
        {
            Cedula = cliente.Cedula,
            Nombre = cliente.Nombre,
            IdUsuarioModificacion = Sesion.Usuario
        }, activar);

        if (await Respuestas.CorrectaAsync(respuesta, $"{accion} el cliente"))
        {
            await _detalle.HideAsync();
            Dialogos.Exito(activar ? "Cliente activado." : "Cliente desactivado.");
            await RefrescarResultados();
        }
    }

