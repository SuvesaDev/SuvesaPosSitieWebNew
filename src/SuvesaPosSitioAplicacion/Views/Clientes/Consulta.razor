        _esNuevo = false;
        _elegido = cliente;
        _edicion = ACliente(cliente);
        _edicion.DatosSucursal = (await Respuestas.DatoAsync(
            await Api.DatosSucursal(cliente.Identificacion), "consultar los datos de facturación"))?.ToList()
            ?? new List<ClienteDatosSucursalDTO>();
        _edicion.Actividades = (await Respuestas.DatoAsync(
            await Api.Actividades(cliente.Identificacion), "consultar las actividades económicas"))?.ToList()
            ?? new List<ActividadEconomicaClienteDTO>();
        _actCodigoCliente = _actDescripcionCliente = string.Empty;
        _datosSucursalEdicion = new ClienteDatosSucursalDTO();
        _datosSucursalOriginal = null;
        _variasSucursales = _edicion.DatosSucursal.Count > 0;
        _pestanaEdicion = "generales";
        _errorFicha = null;
        _adjuntos = new List<ClienteAdjuntoDTO>();
        _adjuntosNuevos = new List<ClienteAdjuntoDTO>();
        _carta = null;
        _cargandoCarta = !Sesion.EsCostaPets;
        _actividadesClienteHacienda = new List<ActividadesEmpresaDTO>();
        await CargarProvincias();
        await CargarTiposIdentificacion();
        if (_edicion.IdProvincia > 0)
        {
            await CargarCantones(_edicion.IdProvincia);
        }
        else
        {
            _cantones = new List<CantonDTO>();
        }
        if (_edicion.IdCanton > 0)
        {
            await CargarDistritos(_edicion.IdCanton);
        }
        else
        {
            _distritos = new List<DistritoDTO>();
        }
        if (Sesion.EsCostaPets)
        {
            _cargandoAdjuntos = true;
            await CargarAdjuntos(cliente.Identificacion);
        }
        else
        {
            await CargarCarta(cliente.Cedula);
        }
        _tiposBonificacion = new List<ConfiguracionBonificacion>();
        _bonificaciones = new List<ClienteBonificacionConfiguracionDTO>();
        LimpiarFormularioBonificacion();
        if (Sesion.EsCostaPets && _edicion.TieneBonificacion)
        {
            await CargarBonificacion();
        }
        await _modal.ShowAsync();
    }

    private string ClasePestana(string pestana)
        => _pestanaEdicion == pestana ? "btn-primary" : "btn-outline-primary";

    private string ClaseGenerales => ClasePestana("generales");
    private string ClaseCredito => ClasePestana("credito");
    private string ClaseCarta => ClasePestana("carta");
    private string ClaseAdjuntos => ClasePestana("adjuntos");
    private string ClaseFacturacion => ClasePestana("facturacion");
    private string ClaseBonificacion => ClasePestana("bonificacion");
    private void AbrirGenerales() => _pestanaEdicion = "generales";
    private void AbrirCredito() => _pestanaEdicion = "credito";
    private void AbrirCarta() => _pestanaEdicion = "carta";
    private void AbrirAdjuntos() => _pestanaEdicion = "adjuntos";
    private void AbrirFacturacion() => _pestanaEdicion = "facturacion";
    private async Task AbrirBonificacion()
    {
        _pestanaEdicion = "bonificacion";
        // Carga diferida: si el cliente se marcó "Bonificado" durante esta misma
        // edición, el catálogo aún no se trajo al abrir el modal.
        if (_edicion is not null && _tiposBonificacion.Count == 0)
        {
            await CargarBonificacion();
        }
    }

    private async Task CargarBonificacion()
    {
        if (_edicion is null) return;

        _tiposBonificacion = (await Respuestas.DatoAsync(await CatalogoBonificacion.Disponibles(), "consultar los tipos de bonificación"))
            ?.ToList() ?? new List<ConfiguracionBonificacion>();
        _bonificaciones = (await Respuestas.DatoAsync(
            await ClienteBonificacion.ObtenerPorCliente(_edicion.Cedula, _edicion.Identificacion), "consultar la bonificación del cliente"))
            ?.ToList() ?? new List<ClienteBonificacionConfiguracionDTO>();
    }

