        _tipoBonificacionSeleccionado = bonificacion.IdConfiguracionBonificacion;
        _descripcionBonificacion = bonificacion.Descripcion ?? string.Empty;
        _articuloBonificacionSeleccionado = new InventarioDTO
        {
            Codigo = bonificacion.IdArticulo,
            Descripcion = bonificacion.DescripcionArticulo,
            Bonificado = true
        };
    }

    private async Task GuardarBonificacionCliente()
    {
        if (_edicion is null || _tipoBonificacionSeleccionado <= 0) return;

        if (_articuloBonificacionSeleccionado is null)
        {
            await Dialogos.ErrorAsync("Seleccione el artículo bonificable.");
            return;
        }
        var descripcion = _descripcionBonificacion?.Trim() ?? string.Empty;
        if (descripcion.Length == 0)
        {
            await Dialogos.ErrorAsync("Indique una descripción para la bonificación.");
            return;
        }

        // una sola asignación por artículo (salvo que se esté editando ese registro)
        if (_bonificaciones.Any(b => b.IdArticulo == _articuloBonificacionSeleccionado.Codigo
                                     && b.IdConfiguracion != _idBonificacionEnEdicion))
        {
            await Dialogos.ErrorAsync("Ese artículo ya tiene una bonificación asignada a este cliente.");
            return;
        }

        _guardandoBonificacion = true;

        var configuracion = new ClienteBonificacionConfiguracionDTO
        {
            IdConfiguracion = _idBonificacionEnEdicion,
            IdConfiguracionBonificacion = _tipoBonificacionSeleccionado,
            IdCliente = _edicion.Identificacion,
            IdArticulo = _articuloBonificacionSeleccionado.Codigo,
            Descripcion = descripcion
        };

        var respuesta = _idBonificacionEnEdicion > 0
            ? await ClienteBonificacion.Editar(configuracion)
            : await ClienteBonificacion.Crear(configuracion);

        var guardada = await Respuestas.DatoAsync(respuesta, "guardar la bonificación");
        _guardandoBonificacion = false;

        if (guardada is null) return;

        // el API sólo rellena DescripcionArticulo en las lecturas; aquí ya lo tenemos.
        guardada.DescripcionArticulo = _articuloBonificacionSeleccionado.Descripcion;

        if (_idBonificacionEnEdicion > 0)
        {
            var indice = _bonificaciones.FindIndex(b => b.IdConfiguracion == _idBonificacionEnEdicion);
            if (indice >= 0) _bonificaciones[indice] = guardada;
        }
        else
        {
            _bonificaciones.Add(guardada);
        }

        LimpiarFormularioBonificacion();
        Dialogos.Exito("Bonificación guardada.");
    }

