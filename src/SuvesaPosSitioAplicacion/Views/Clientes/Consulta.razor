@page "/initial/customers"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IClientesConsulta Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject ICartasExoneracion Cartas
@inject IGeografia Geografia
@inject IEmpresas Empresas
@inject ICatalogoBonificacion CatalogoBonificacion
@inject IClienteBonificacion ClienteBonificacion
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IConfiguracionPlazosFiscales Plazos

@*  RUTA DEL MENU, no una propia.
    Esta pantalla ocupa la ruta del sistema actual, asi que a partir de aqui el menu
    llega al sitio nuevo y ya no al iframe de la SPA React.

    Ya incorpora alta, edicion y cambio de estado (cerrado en la Ola 4); no hace
    falta entrar por la SPA React para mantener estos registros.
*@

@*  OLA 1 — replica del ARQUETIPO 02 (consulta de nivel A, movil primero).
    Misma estructura que Views/Inventario/Consulta.razor: una consulta alimenta dos
    presentaciones, busqueda con espera y cancelacion, detalle en panel lateral.
    Solo cambian el proxy, los campos de la tarjeta y las columnas.
*@

<AppPantalla Pantalla="@Titulo" Icono="bi-people-fill" Subtitulo="Consulta y alta de clientes y sus mascotas" Nivel="NivelPantalla.Movil">
    <Acciones>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Agregar">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
            </button>
        }
    </Acciones>
    <ChildContent>
        <section class="seepos-clientes">

        <AppFiltros AlBuscar="Buscar" AlLimpiar="LimpiarFiltros" Buscando="_buscando"
                    Resumen="@ResumenConteo()">
            <div class="col-12 col-md-6">
                <label class="form-label" for="fCliTexto">Cédula o nombre</label>
                <input id="fCliTexto" type="search" class="form-control" placeholder="Escriba para filtrar..."
                       value="@_texto" @oninput="AlEscribir" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="fCliEstado">Estado</label>
                <select id="fCliEstado" class="form-select" @bind="_estado" @bind:after="Refiltrar">
                    <option value="A">Activos</option>
                    <option value="I">Inactivos</option>
                    <option value="T">Todos</option>
                </select>
            </div>
        </AppFiltros>

        @if (_buscando)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando</span>
                </div>
            </div>
        }
        else
        {
            @* Movil: tarjetas. *@
            <div class="d-md-none d-flex flex-column gap-2">
                @if (_resultados.Count == 0)
                {
                    <p class="text-secondary small text-center py-4 mb-0">
                        @(_modoBusqueda && _todos.Count == 0
                            ? "Escriba y pulse Buscar."
                            : "Ningún cliente coincide.")
                    </p>
                }
                @foreach (var c in _resultados)
                {
                    <button type="button" class="card text-start border-0 shadow-sm p-0"
                            @onclick="() => Ver(c)">
                        <div class="card-body py-2 px-3">
                            <div class="fw-semibold small">@c.Nombre</div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                <code class="small text-secondary">@c.Cedula</code>
                                @if (!string.IsNullOrWhiteSpace(c.Telefono_01))
                                {
                                    <span class="small text-secondary">@c.Telefono_01</span>
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>

            @* Escritorio y tableta: rejilla. *@
            <div class="d-none d-md-block card seepos-clientes-tabla">
                <div class="card-body">
                    <AppRejilla TItem="FiltranClienteDTO" Datos="Servir"
                                Nivel="NivelPantalla.Tableta" @ref="_rejilla"
                                TextoVacio="@(_modoBusqueda && _todos.Count == 0 ? "Escriba y pulse Buscar." : "Ningún cliente coincide.")">
                        <Columnas>
                            <HxGridColumn TItem="FiltranClienteDTO" HeaderText="Cedula"
                                          ItemTextSelector="c => c.Cedula"
                                          SortKeySelector="c => c.Cedula" />
                            <HxGridColumn TItem="FiltranClienteDTO" HeaderText="Nombre"
                                          ItemTextSelector="c => c.Nombre"
                                          SortKeySelector="c => c.Nombre" />
                            <HxGridColumn TItem="FiltranClienteDTO" HeaderText="Telefono"
                                          ItemTextSelector="c => c.Telefono_01" />
                            <HxGridColumn TItem="FiltranClienteDTO" HeaderText="Correo"
                                          ItemTextSelector="c => c.E_Mail" />
                            <HxGridColumn TItem="FiltranClienteDTO" HeaderText="Credito"
                                          ItemTextSelector="@(c => Formato.Importe(c.Max_Credito))"
                                          SortKeySelector="c => c.Max_Credito"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="FiltranClienteDTO" HeaderText=""
                                          HeaderCssClass="text-end" ItemCssClass="text-end text-nowrap align-middle">
                                <ItemTemplate Context="c">
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => Ver(c)">Ver</button>
                                    @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                                    {
                                        <button class="btn btn-sm btn-link p-0 ms-3" @onclick="() => Editar(c)">Editar</button>
                                    }
                                </ItemTemplate>
                            </HxGridColumn>
                        </Columnas>
                    </AppRejilla>
                </div>
            </div>
        }
        </section>

    </ChildContent>
</AppPantalla>

<HxOffcanvas @ref="_detalle" Title="@(_elegido?.Nombre ?? "Cliente")"
             Placement="OffcanvasPlacement.End">
    <BodyTemplate>
        @if (_elegido is not null)
        {
            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Cedula</dt>
                <dd class="col-7"><code>@_elegido.Cedula</code></dd>

                <dt class="col-5 fw-normal text-secondary">Telefono</dt>
                <dd class="col-7">@(_elegido.Telefono_01 ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Telefono 2</dt>
                <dd class="col-7">@(_elegido.Telefono_02 ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Correo</dt>
                <dd class="col-7">@(_elegido.E_Mail ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Direccion</dt>
                <dd class="col-7">@(_elegido.Direccion ?? "—")</dd>
            </dl>

            <hr />

            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Credito maximo</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Max_Credito)</dd>

                <dt class="col-5 fw-normal text-secondary">Plazo</dt>
                <dd class="col-7 seepos-importe">@_elegido.Plazo_Credito dias</dd>

                <dt class="col-5 fw-normal text-secondary">Impuesto</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Impuesto)</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_elegido.Observaciones))
            {
                <hr />
                <p class="small text-secondary mb-0">@_elegido.Observaciones</p>
            }

            <div class="d-flex gap-2 border-top pt-3 mt-3">
                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => Editar(_elegido)">Editar</button>
                }
                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                {
                    <button class="btn btn-sm @( _elegido.Anulado ? "btn-outline-success" : "btn-outline-danger")"
                            @onclick="() => CambiarEstado(_elegido)">
                        @(_elegido.Anulado ? "Activar" : "Desactivar")
                    </button>
                }
            </div>

            <hr />
            <h3 class="h6">Carta de exoneración</h3>
            @if (_cargandoCarta)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando carta</span></div>
            }
            else if (_carta is null)
            {
                <p class="small text-secondary mb-2">El cliente no tiene una carta de exoneración vigente.</p>
                @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="NuevaCarta">Agregar carta</button>
                }
            }
            else
            {
                <dl class="row small mb-2">
                    <dt class="col-6 fw-normal text-secondary">Documento</dt><dd class="col-6">@_carta.NumeroDocumento</dd>
                    <dt class="col-6 fw-normal text-secondary">Vence</dt><dd class="col-6">@_carta.FechaVence.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-6 fw-normal text-secondary">Exoneración</dt><dd class="col-6">@_carta.PorcentajeCompra.ToString("N2")%</dd>
                </dl>
                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="EditarCarta">Editar carta</button>
                }
            }

            <hr />
            <h3 class="h6">Adjuntos</h3>
            @if (_cargandoAdjuntos)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando adjuntos</span></div>
            }
            else
            {
                <InputFile class="form-control form-control-sm" OnChange="AgregarAdjunto" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp" />
                <p class="form-text">PDF, Word o imágenes; máximo 10 MB por archivo.</p>

                @if (_adjuntos.Count == 0 && _adjuntosNuevos.Count == 0)
                {
                    <p class="small text-secondary mb-0">No hay adjuntos.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var adjunto in _adjuntos)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                <span class="text-truncate">@adjunto.Extencion</span>
                                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarAdjunto(adjunto)">Eliminar</button>
                                }
                            </li>
                        }
                        @foreach (var adjunto in _adjuntosNuevos)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                                <span class="text-truncate">@adjunto.Extencion <span class="text-secondary">(pendiente)</span></span>
                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => _adjuntosNuevos.Remove(adjunto)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button>
                            </li>
                        }
                    </ul>
                    @if (_adjuntosNuevos.Count > 0)
                    {
                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="GuardarAdjuntos" disabled="@_guardandoAdjuntos">@(_guardandoAdjuntos ? "Guardando..." : "Guardar adjuntos")</button>
                    }
                }
            }
        }
    </BodyTemplate>
</HxOffcanvas>

<HxModal @ref="_modalCarta" Title="@(_cartaEsNueva ? "Nueva carta de exoneración" : "Editar carta de exoneración")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_cartaEdicion is not null)
        {
            <EditForm Model="_cartaEdicion" OnValidSubmit="GuardarCarta" id="formCarta">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Número de documento" @bind-Valor="_cartaEdicion.NumeroDocumento" /></div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-tipo">Tipo de exoneración</label>
                        <input id="carta-tipo" type="number" min="1" class="form-control" @bind="_cartaEdicion.IdTipoExoneracion" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-emision">Fecha de emisión</label>
                        <input id="carta-emision" type="date" class="form-control" @bind="_cartaEdicion.FechaEmision" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-vence">Fecha de vencimiento</label>
                        <input id="carta-vence" type="date" class="form-control" @bind="_cartaEdicion.FechaVence" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-porcentaje">Porcentaje de compra</label>
                        <input id="carta-porcentaje" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_cartaEdicion.PorcentajeCompra" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="carta-impuesto">Impuesto</label>
                        <input id="carta-impuesto" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_cartaEdicion.Impuesto" @bind:event="onchange" />
                    </div>
                    <div class="col-12"><AppCampoTexto Etiqueta="Nota" @bind-Valor="_cartaEdicion.Nota" /></div>
                </div>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modalCarta.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formCarta" disabled="@_guardandoCarta">@(_guardandoCarta ? "Guardando..." : "Guardar")</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modal" Title="@(_esNuevo ? "Nuevo cliente" : "Editar cliente")" Size="ModalSize.Large" Scrollable="true">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formCliente" class="seepos-cliente-editor">
                <DataAnnotationsValidator />
                <nav class="mb-3 seepos-editor-tabs" aria-label="Secciones del cliente">
                    <div class="nav nav-pills flex-wrap gap-2">
                        <button type="button" class="btn btn-sm @ClaseGenerales" @onclick="AbrirGenerales">Datos generales</button>
                        <button type="button" class="btn btn-sm @ClaseCredito" @onclick="AbrirCredito">Crédito y descuento</button>
                        @if (!Sesion.EsCostaPets)
                        {
                            <button type="button" class="btn btn-sm @ClaseCarta" @onclick="AbrirCarta">Carta exoneración</button>
                        }
                        @if (Sesion.EsCostaPets)
                        {
                            <button type="button" class="btn btn-sm @ClaseAdjuntos" @onclick="AbrirAdjuntos">Documentos adjuntos</button>
                        }
                        @if (Sesion.EsCostaPets && _variasSucursales)
                        {
                            <button type="button" class="btn btn-sm @ClaseFacturacion" @onclick="AbrirFacturacion">Datos facturación</button>
                        }
                        @if (Sesion.EsCostaPets && _edicion.TieneBonificacion && !_esNuevo)
                        {
                            <button type="button" class="btn btn-sm @ClaseBonificacion" @onclick="AbrirBonificacion">Bonificación</button>
                        }
                    </div>
                </nav>

                @if (_pestanaEdicion == "generales")
                {
                    <div class="row g-3">
                        <div class="col-12 seepos-form-seccion">Identificación</div>
                        <div class="col-12 col-md-5"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_edicion.Nombre" Requerido="true" /></div>
                        <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Cédula" @bind-Valor="_edicion.Cedula" Deshabilitado="@(!_esNuevo)" Requerido="true" /></div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-tipo-identificacion">Tipo de identificación</label>
                            <select id="cliente-tipo-identificacion" class="form-select" @bind="_edicion.IdTipoIdentificacion">
                                <option value="0">Seleccione...</option>
                                @foreach (var tipo in _tiposIdentificacion) { <option value="@tipo.Id">@tipo.Descripcion</option> }
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ConsultarHacienda" disabled="@(_consultandoHacienda || string.IsNullOrWhiteSpace(_edicion.Cedula))">
                                @(_consultandoHacienda ? "Consultando..." : "Consultar en Hacienda")
                            </button>
                        </div>

                        <div class="col-12 seepos-form-seccion">Contacto</div>
                        <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_edicion.Telefono01" /></div>
                        <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Teléfono alterno" @bind-Valor="_edicion.Telefono02" /></div>
                        <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Correo cuentas por cobrar" @bind-Valor="_edicion.EMail" /></div>

                        <div class="col-12 seepos-form-seccion">Ubicación</div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-provincia">Provincia</label>
                            <select id="cliente-provincia" class="form-select" value="@_edicion.IdProvincia" @onchange="AlCambiarProvincia">
                                <option value="0">Seleccione...</option>
                                @foreach (var provincia in _provincias) { <option value="@provincia.Id">@provincia.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-canton">Cantón</label>
                            <select id="cliente-canton" class="form-select" value="@_edicion.IdCanton" @onchange="AlCambiarCanton" disabled="@(_edicion.IdProvincia <= 0)">
                                <option value="0">Seleccione...</option>
                                @foreach (var canton in _cantones) { <option value="@canton.Id">@canton.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="cliente-distrito">Distrito</label>
                            <select id="cliente-distrito" class="form-select" @bind="_edicion.IdDistrito" disabled="@(_edicion.IdCanton <= 0)">
                                <option value="0">Seleccione...</option>
                                @foreach (var distrito in _distritos) { <option value="@distrito.Id">@distrito.Nombre</option> }
                            </select>
                        </div>
                        <div class="col-12"><AppCampoTexto Etiqueta="Dirección" @bind-Valor="_edicion.Direccion" /></div>
                        <div class="col-12"><AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_edicion.Observaciones" /></div>

                        <div class="col-12 seepos-form-seccion">Facturación electrónica</div>
                        <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Correo de facturación electrónica" @bind-Valor="_edicion.CorreoComprobante" /></div>

                        <div class="col-12">
                            <label class="form-label mb-1">Actividades económicas</label>
                            <p class="form-text mt-0 mb-2">Un cliente puede tener varias actividades registradas en Hacienda. La marcada como <strong>Principal</strong> es la que se usa en la factura electrónica.</p>
                            @if (_edicion.Actividades.Count > 0)
                            {
                                <div class="table-responsive mb-2"><table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Código</th><th>Descripción</th><th class="text-center">Principal</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var actividad in _edicion.Actividades)
                                        {
                                            <tr>
                                                <td>@actividad.Codigo</td>
                                                <td>@actividad.Descripcion</td>
                                                <td class="text-center">
                                                    <input type="radio" class="form-check-input" name="cliente-actividad-principal"
                                                           checked="@(actividad.Principal == true)" @onchange="() => MarcarActividadPrincipal(actividad)" />
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarActividad(actividad)">
                                                        <i class="bi bi-trash" aria-hidden="true"></i> Quitar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-3"><label class="form-label">Código</label><input class="form-control form-control-sm" @bind="_actCodigoCliente" /></div>
                                <div class="col-12 col-md-4"><label class="form-label">Descripción</label><input class="form-control form-control-sm" @bind="_actDescripcionCliente" /></div>
                                <div class="col-6 col-md-2 d-grid"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarActividadCliente">Agregar</button></div>
                                <div class="col-6 col-md-3 d-grid">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BuscarActividadesHaciendaCliente" disabled="@(_buscandoActividadesCliente || string.IsNullOrWhiteSpace(_edicion.Cedula))">
                                        @(_buscandoActividadesCliente ? "Consultando..." : "Buscar en Hacienda")
                                    </button>
                                </div>
                            </div>
                            @if (_actividadesClienteHacienda.Count > 0)
                            {
                                <div class="list-group list-group-flush mt-2">
                                    @foreach (var actividad in _actividadesClienteHacienda)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                @onclick="() => UsarActividadHacienda(actividad)">
                                            <span>@actividad.Codigo — @actividad.Descripcion</span>
                                            @if (actividad.Tipo) { <span class="badge bg-secondary">Principal en Hacienda</span> }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (!_variasSucursales) { <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Nombre fantasía" @bind-Valor="_edicion.NombreFantasia" /></div> }
                        @if (_edicion.EnviarRecibo) { <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Correo para recibos" @bind-Valor="_edicion.CorreoRecibo" /></div> }
                        <div class="col-12">
                            <div class="seepos-editor-marcas">
                                <div class="form-check"><input id="cliente-sucursales" class="form-check-input" type="checkbox" checked="@_variasSucursales" @onchange="AlCambiarSucursales" /><label class="form-check-label" for="cliente-sucursales">Varias sucursales</label></div>
                                <div class="form-check"><input id="cliente-recibo" class="form-check-input" type="checkbox" @bind="_edicion.EnviarRecibo" /><label class="form-check-label" for="cliente-recibo">Enviar recibo al correo</label></div>
                            </div>
                        </div>

                        <div class="col-12 seepos-form-seccion">Marcas</div>
                        <div class="col-12">
                            <div class="seepos-editor-marcas">
                                @if (!Sesion.EsCostaPets)
                                {
