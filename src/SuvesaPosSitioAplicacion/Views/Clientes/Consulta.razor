    private async Task AgregarDatosSucursal()
    {
        if (_edicion is null || string.IsNullOrWhiteSpace(_datosSucursalEdicion.Sucursal)
            || string.IsNullOrWhiteSpace(_datosSucursalEdicion.NombreComercial))
        {
            await Dialogos.ErrorAsync("Indique sucursal y nombre comercial.");
            return;
        }

        _datosSucursalEdicion.IdCliente = _edicion.Identificacion;
        _edicion.DatosSucursal ??= new List<ClienteDatosSucursalDTO>();
        _edicion.DatosSucursal.Add(_datosSucursalEdicion);
        _datosSucursalEdicion = new ClienteDatosSucursalDTO();
    }

    private async Task CargarAdjuntos(long idCliente)
    {
        _adjuntos = (await Respuestas.DatoAsync(await Api.Adjuntos(idCliente), "consultar los adjuntos"))
            ?.ToList() ?? new List<ClienteAdjuntoDTO>();
        _cargandoAdjuntos = false;
        StateHasChanged();
    }

    private async Task AgregarAdjunto(InputFileChangeEventArgs evento)
    {
        if (_elegido is null)
        {
            return;
        }

        var archivo = evento.File;
        const long maximo = 10 * 1024 * 1024;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        var permitidas = new[] { ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png", ".gif", ".webp" };

        if (!permitidas.Contains(extension) || archivo.Size > maximo)
        {
            await Dialogos.ErrorAsync("El adjunto debe ser PDF, Word o imagen y no superar 10 MB.");
            return;
        }

        await using var entrada = archivo.OpenReadStream(maximo);
        await using var memoria = new MemoryStream();
        await entrada.CopyToAsync(memoria);
        var base64 = Convert.ToBase64String(memoria.ToArray());
        var contenido = $"data:{archivo.ContentType};base64,{base64}";

        _adjuntosNuevos.Add(new ClienteAdjuntoDTO
        {
            IdCliente = _elegido.Identificacion,
            Archivo = contenido,
            Tipo = extension.TrimStart('.'),
            Extencion = archivo.Name
        });
    }

    private async Task GuardarAdjuntos()
    {
        if (_elegido is null || _adjuntosNuevos.Count == 0 || _guardandoAdjuntos)
        {
            return;
        }

        if (!await Dialogos.ConfirmarAsync("Se guardarán los adjuntos seleccionados."))
        {
            return;
        }

        _guardandoAdjuntos = true;
        var respuesta = await Api.GuardarAdjuntos(_adjuntosNuevos);
        _guardandoAdjuntos = false;

        if (await Respuestas.CorrectaAsync(respuesta, "guardar los adjuntos"))
        {
            Dialogos.Exito("Adjuntos guardados.");
            _adjuntosNuevos = new List<ClienteAdjuntoDTO>();
            _cargandoAdjuntos = true;
            await CargarAdjuntos(_elegido.Identificacion);
        }
    }

    private async Task EliminarAdjunto(ClienteAdjuntoDTO adjunto)
    {
        if (_elegido is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea eliminar este adjunto?"))
        {
            return;
        }

        if (await Respuestas.CorrectaAsync(await Api.EliminarAdjunto(adjunto.Id), "eliminar el adjunto"))
        {
            _adjuntos.Remove(adjunto);
            Dialogos.Exito("Adjunto eliminado.");
        }
    }

    private async Task CargarCarta(string? cedula)
    {
        if (string.IsNullOrWhiteSpace(cedula))
        {
            _cargandoCarta = false;
            return;
        }

        var respuesta = await Cartas.Buscar(cedula);
        // Una carta inexistente llega como respuesta de negocio; se muestra como
        // ausencia, sin convertir la consulta del cliente en una alerta de error.
        _carta = respuesta.EsCorrecta ? respuesta.Responses : null;
        _cargandoCarta = false;
        StateHasChanged();
    }

    private async Task NuevaCarta()
    {
        if (_elegido?.Cedula is null)
        {
            return;
        }

        _cartaEsNueva = true;
        _cartaEdicion = new CartaExoneracionDTO
        {
            Cedula = _elegido.Cedula,
            FechaEmision = DateTime.Today,
            FechaVence = DateTime.Today.AddYears(1),
            Estado = true,
            IdUsuarioCreacion = Sesion.Usuario
        };
        await _modalCarta.ShowAsync();
    }

    private async Task EditarCarta()
    {
        if (_carta is null)
        {
            return;
        }

        _cartaEsNueva = false;
        _cartaEdicion = new CartaExoneracionDTO
        {
            Id = _carta.Id,
            Cedula = _carta.Cedula,
            IdTipoExoneracion = _carta.IdTipoExoneracion,
            NumeroDocumento = _carta.NumeroDocumento,
            FechaEmision = _carta.FechaEmision,
            FechaVence = _carta.FechaVence,
            PorcentajeCompra = _carta.PorcentajeCompra,
            Impuesto = _carta.Impuesto,
            Nota = _carta.Nota,
            Estado = _carta.Estado,
            IdUsuarioCreacion = _carta.IdUsuarioCreacion,
            IdUsuarioModificacion = Sesion.Usuario
        };
        await _modalCarta.ShowAsync();
    }

    private async Task GuardarCarta()
    {
        if (_cartaEdicion is null || _guardandoCarta)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_cartaEdicion.NumeroDocumento)
            || _cartaEdicion.IdTipoExoneracion <= 0
            || _cartaEdicion.FechaVence < _cartaEdicion.FechaEmision)
        {
            await Dialogos.ErrorAsync("Indique documento, tipo de exoneración y un período válido.");
            return;
        }

        if (!await Dialogos.ConfirmarAsync(_cartaEsNueva ? "Se registrará la carta de exoneración." : "Se actualizará la carta de exoneración."))
        {
            return;
        }

        _guardandoCarta = true;
        var respuesta = _cartaEsNueva ? await Cartas.Crear(_cartaEdicion) : await Cartas.Editar(_cartaEdicion);
        _guardandoCarta = false;

        if (await Respuestas.CorrectaAsync(respuesta, "guardar la carta de exoneración"))
        {
            _carta = respuesta.Responses ?? _cartaEdicion;
            await _modalCarta.HideAsync();
            Dialogos.Exito("Carta de exoneración guardada.");
        }
    }
}
