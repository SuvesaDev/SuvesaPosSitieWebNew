    private Task GuardarDesdeFormulario(EditContext _) => Guardar();

    private async Task Guardar()
    {
        if (_edicion is null || _guardando)
        {
            return;
        }

        _errorFicha = null;
        var faltantes = new List<string>();
        if (string.IsNullOrWhiteSpace(_edicion.Cedula)) faltantes.Add("Cédula");
        if (string.IsNullOrWhiteSpace(_edicion.Nombre)) faltantes.Add("Nombre");
        if (string.IsNullOrWhiteSpace(_edicion.Telefono01)) faltantes.Add("Teléfono");
        if (string.IsNullOrWhiteSpace(_edicion.EMail)) faltantes.Add("Correo cuentas por cobrar");
        if (string.IsNullOrWhiteSpace(_edicion.Direccion)) faltantes.Add("Dirección");
        if (string.IsNullOrWhiteSpace(_edicion.CorreoComprobante)) faltantes.Add("Correo de facturación electrónica");
        if (_edicion.TipoCliente != "CONSUMIDOR_FINAL" && _edicion.IdRutaComercial is not > 0) faltantes.Add("Ruta comercial");
        if (faltantes.Count > 0)
        {
            _pestanaEdicion = "generales";
            _errorFicha = ValidacionFormulario.MensajeCamposFaltantes(faltantes);
            return;
        }

        if (_variasSucursales && (_edicion.DatosSucursal?.Count ?? 0) == 0)
        {
            _pestanaEdicion = "facturacion";
            _errorFicha = "Agregue al menos una sucursal para sus datos de facturación.";
            return;
        }

        var eraNuevo = _esNuevo;
        // La columna IdUsuarioCreacion no admite NULL: en alta nunca se llenaba desde
        // esta pantalla y el API rechazaba el INSERT ("Cannot insert the value NULL
        // into column 'IdUsuarioCreacion'"). Se aprovecha para dejar también quién
        // hizo la última modificación.
        if (eraNuevo)
        {
            _edicion.IdUsuarioCreacion = Sesion.Usuario;
        }
        _edicion.IdUsuarioModificacion = Sesion.Usuario;

        _guardando = true;
        var respuesta = eraNuevo ? await Api.Crear(_edicion) : await Api.Editar(_edicion);
        _guardando = false;

        var error = await Respuestas.MensajeSiFallaAsync(respuesta, eraNuevo ? "crear el cliente" : "editar el cliente");
        if (error is not null)
        {
            _errorFicha = error.Length > 0 ? error : null;
            return;
        }

        if (eraNuevo && _adjuntosNuevos.Count > 0)
        {
            var idCliente = respuesta.Responses?.Identificacion ?? 0;
            if (idCliente <= 0)
            {
                await Dialogos.ErrorAsync("El cliente fue creado, pero la API no devolvió su identificador para guardar los documentos. Ábralo en edición para cargarlos.");
                await _modal.HideAsync();
                await RefrescarResultados();
                return;
            }

            _edicion.Identificacion = idCliente;
            _esNuevo = false;
            if (!await PersistirAdjuntos(idCliente, recargar: false))
            {
                await Dialogos.ErrorAsync("El cliente fue creado, pero no se pudieron guardar todos los documentos. Puede reintentarlo desde esta pestaña.");
                return;
            }
        }

        await _modal.HideAsync();
        Dialogos.Exito(eraNuevo ? "Cliente creado." : "Cliente actualizado.");
        await RefrescarResultados();
    }

