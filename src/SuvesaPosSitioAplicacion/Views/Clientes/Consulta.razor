    private async Task AgregarDatosSucursal()
    {
        if (_edicion is null || string.IsNullOrWhiteSpace(_datosSucursalEdicion.Sucursal)
            || string.IsNullOrWhiteSpace(_datosSucursalEdicion.NombreComercial))
        {
            await Dialogos.ErrorAsync("Indique sucursal y nombre comercial.");
            return;
        }

        _datosSucursalEdicion.IdCliente = _edicion.Identificacion;
        _edicion.DatosSucursal ??= new List<ClienteDatosSucursalDTO>();

        if (_datosSucursalOriginal is not null)
        {
            // Edición: se reemplaza la fila en su lugar conservando Id/IdCliente.
            var indice = _edicion.DatosSucursal.ToList().IndexOf(_datosSucursalOriginal);
            _datosSucursalEdicion.Id = _datosSucursalOriginal.Id;
            if (indice >= 0)
            {
                var lista = _edicion.DatosSucursal.ToList();
                lista[indice] = _datosSucursalEdicion;
                _edicion.DatosSucursal = lista;
            }
            _datosSucursalOriginal = null;
        }
        else
        {
            _edicion.DatosSucursal.Add(_datosSucursalEdicion);
        }

        _datosSucursalEdicion = new ClienteDatosSucursalDTO();
    }

    private void EditarDatosSucursal(ClienteDatosSucursalDTO dato)
    {
        _datosSucursalOriginal = dato;
        _datosSucursalEdicion = new ClienteDatosSucursalDTO
        {
            Id = dato.Id,
            IdCliente = dato.IdCliente,
            Sucursal = dato.Sucursal,
            NombreComercial = dato.NombreComercial,
            Telefono = dato.Telefono,
            Email = dato.Email,
            Contacto = dato.Contacto
        };
    }

    private void CancelarEdicionDatosSucursal()
    {
        _datosSucursalOriginal = null;
