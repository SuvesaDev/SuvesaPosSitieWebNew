    private void UsarActividadHacienda(ActividadesEmpresaDTO actividad)
    {
        if (_edicion is null || string.IsNullOrWhiteSpace(actividad.Codigo))
        {
            return;
        }

        if (_edicion.Actividades.Any(a => string.Equals(a.Codigo, actividad.Codigo, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var esPrincipal = actividad.Tipo || _edicion.Actividades.Count == 0;
        AgregarActividad(actividad.Codigo, actividad.Descripcion ?? string.Empty, esPrincipal);
    }

    private void AgregarActividadCliente()
    {
        if (_edicion is null || string.IsNullOrWhiteSpace(_actCodigoCliente))
        {
            return;
        }

        if (_edicion.Actividades.Any(a => string.Equals(a.Codigo, _actCodigoCliente, StringComparison.OrdinalIgnoreCase)))
        {
            _actCodigoCliente = _actDescripcionCliente = string.Empty;
            return;
        }

        AgregarActividad(_actCodigoCliente.Trim(), _actDescripcionCliente.Trim(), _edicion.Actividades.Count == 0);
        _actCodigoCliente = _actDescripcionCliente = string.Empty;
    }

    private void AgregarActividad(string codigo, string descripcion, bool principal)
    {
        if (_edicion is null)
        {
            return;
        }

        _edicion.Actividades.Add(new ActividadEconomicaClienteDTO
        {
            Codigo = codigo,
            Descripcion = descripcion,
            Activo = true,
            Principal = principal
        });

        if (principal)
        {
            MarcarActividadPrincipal(_edicion.Actividades[^1]);
        }
    }

    private void MarcarActividadPrincipal(ActividadEconomicaClienteDTO actividad)
    {
        if (_edicion is null)
        {
            return;
        }

        foreach (var a in _edicion.Actividades)
        {
            a.Principal = ReferenceEquals(a, actividad);
        }

        // El código de actividad principal es el que la factura electrónica usa
        // como actividad del receptor; se mantiene sincronizado con la marca.
        _edicion.CodigoActividad = actividad.Codigo;
    }

    private void QuitarActividad(ActividadEconomicaClienteDTO actividad)
    {
        if (_edicion is null)
        {
            return;
        }

        var eraPrincipal = actividad.Principal == true;
        _edicion.Actividades.Remove(actividad);

        if (eraPrincipal)
        {
            var nuevaPrincipal = _edicion.Actividades.FirstOrDefault();
            if (nuevaPrincipal is not null)
            {
                MarcarActividadPrincipal(nuevaPrincipal);
            }
            else
            {
                _edicion.CodigoActividad = null;
            }
        }
    }

