    private static int IdSeleccionado(ChangeEventArgs evento)
        => int.TryParse(evento.Value?.ToString(), out var id) ? id : 0;

    private async Task Guardar()
    {
        if (_edicion is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_edicion.Cedula)
            || string.IsNullOrWhiteSpace(_edicion.Nombre)
            || string.IsNullOrWhiteSpace(_edicion.EMail)
            || string.IsNullOrWhiteSpace(_edicion.Direccion))
        {
            await Dialogos.ErrorAsync("Cédula, nombre, correo y dirección son obligatorios.");
            return;
        }

        if (_variasSucursales && (_edicion.DatosSucursal?.Count ?? 0) == 0)
        {
            _pestanaEdicion = "facturacion";
            await Dialogos.ErrorAsync("Agregue al menos una sucursal para sus datos de facturación.");
            return;
        }

        var confirmar = await Dialogos.ConfirmarAsync(
            _esNuevo ? "Se registrará el nuevo cliente." : "Se actualizarán los datos del cliente.");
        if (!confirmar)
        {
            return;
        }

        var eraNuevo = _esNuevo;
        // La columna IdUsuarioCreacion no admite NULL: en alta nunca se llenaba desde
        // esta pantalla y el API rechazaba el INSERT ("Cannot insert the value NULL
        // into column 'IdUsuarioCreacion'"). Se aprovecha para dejar también quién
        // hizo la última modificación.
        if (eraNuevo)
        {
            _edicion.IdUsuarioCreacion = Sesion.Usuario;
        }
        _edicion.IdUsuarioModificacion = Sesion.Usuario;

        _guardando = true;
        var respuesta = eraNuevo ? await Api.Crear(_edicion) : await Api.Editar(_edicion);
        _guardando = false;

        if (await Respuestas.CorrectaAsync(respuesta, eraNuevo ? "crear el cliente" : "editar el cliente"))
        {
            if (eraNuevo && _adjuntosNuevos.Count > 0)
            {
                var idCliente = respuesta.Responses?.Identificacion ?? 0;
                if (idCliente <= 0)
                {
                    await Dialogos.ErrorAsync("El cliente fue creado, pero la API no devolvió su identificador para guardar los documentos. Ábralo en edición para cargarlos.");
                    await _modal.HideAsync();
                    await RefrescarResultados();
                    return;
                }

                _edicion.Identificacion = idCliente;
                _esNuevo = false;
                if (!await PersistirAdjuntos(idCliente, recargar: false))
                {
                    await Dialogos.ErrorAsync("El cliente fue creado, pero no se pudieron guardar todos los documentos. Puede reintentarlo desde esta pestaña.");
                    return;
                }
            }

            await _modal.HideAsync();
            Dialogos.Exito(eraNuevo ? "Cliente creado." : "Cliente actualizado.");
            await RefrescarResultados();
        }
    }

    private async Task CambiarEstado(FiltranClienteDTO cliente)
