    /// <summary>Trae las actividades del contribuyente desde Hacienda para elegir cuáles
    /// agregar a la lista del cliente (no las agrega automáticamente: pueden repetirse
    /// consultas y el usuario decide cuáles usar).</summary>
    private async Task BuscarActividadesHaciendaCliente()
