    {
        _idBonificacionEnEdicion = bonificacion.IdConfiguracion;
        _tipoBonificacionSeleccionado = bonificacion.IdConfiguracionBonificacion;
        _descripcionBonificacion = bonificacion.Descripcion ?? string.Empty;
        _articuloBonificacionSeleccionado = new InventarioDTO
        {
            Codigo = bonificacion.IdArticulo,
            Descripcion = bonificacion.DescripcionArticulo,
            Bonificado = true
        };
