    /// <summary>Trae nombre y tipo de identificación del contribuyente desde Hacienda
    /// (mismo endpoint que ya usa la búsqueda de proveedores) para autocompletar.</summary>
    private async Task ConsultarHacienda()
    {
        if (_edicion is null)
        {
            return;
        }

        var cedula = new string((_edicion.Cedula ?? string.Empty).Where(char.IsDigit).ToArray());
        if (cedula.Length < 9)
        {
            Dialogos.Advertencia("Indique una cédula válida (al menos 9 dígitos) antes de consultar Hacienda.");
            return;
        }

        _edicion.Cedula = cedula;
        _consultandoHacienda = true;
        var r = await Respuestas.DatoAsync(await Api.BuscarHacienda(cedula), "consultar el cliente en Hacienda");
        _consultandoHacienda = false;

        if (r is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(r.Nombre))
        {
            _edicion.Nombre = r.Nombre;
        }
        if (r.IdTipoIdentificacion > 0)
        {
            _edicion.IdTipoIdentificacion = r.IdTipoIdentificacion;
        }
    }

