                }
                else if (_pestanaEdicion == "bonificacion")
                {
                    @*  §5.9: cada asignación amarra un tipo a UN artículo (con "Bonificado"
                        activo) más una nota corta. El cliente puede tener varias, una por
                        artículo. Al facturar, el tipo sólo aplica para ese mismo artículo. *@
                    @if (_tiposBonificacion.Count == 0)
                    {
                        <div class="alert alert-warning">No hay tipos de bonificación activos. Créelos primero en <strong>Catálogos &rsaquo; Tipos de Bonificación</strong> (<code>/parameters/bonus-types</code>).</div>
                    }
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="cliente-bonificacion-tipo">Tipo de bonificación</label>
                            <select id="cliente-bonificacion-tipo" class="form-select" @bind="_tipoBonificacionSeleccionado">
                                <option value="0">Seleccione...</option>
                                @foreach (var tipo in _tiposBonificacion)
                                {
                                    <option value="@tipo.IdConfiguracionBonificacion">@tipo.Descripcion (@tipo.CantidadVenta lleva @tipo.CantidadBonificable)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Artículo bonificable</label>
                            <div class="input-group">
                                <input class="form-control" disabled value="@_articuloBonificacionSeleccionado?.Descripcion" placeholder="Ninguno seleccionado" />
                                <button type="button" class="btn btn-outline-primary" @onclick="AbrirBuscadorArticuloBonificacion"><i class="bi bi-search" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div class="col-12 col-md-9">
                            <label class="form-label" for="cliente-bonificacion-desc">Descripción</label>
                            <input id="cliente-bonificacion-desc" class="form-control" maxlength="160" @bind="_descripcionBonificacion" placeholder="Nota corta de la promoción" />
                        </div>
                        <div class="col-12 col-md-3 d-grid">
                            <button type="button" class="btn btn-success" @onclick="GuardarBonificacionCliente" disabled="@_guardandoBonificacion">
                                @(_idBonificacionEnEdicion > 0 ? "Guardar cambios" : "Agregar")
                            </button>
                        </div>
                    </div>

                    @if (_bonificaciones.Count == 0)
                    {
                        <p class="text-secondary small mt-3 mb-0">Sin bonificaciones asignadas.</p>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm align-middle">
                                <thead><tr><th>Tipo de bonificación</th><th>Artículo</th><th>Descripción</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var b in _bonificaciones)
                                    {
                                        <tr>
                                            <td>@NombreTipoBonificacion(b.IdConfiguracionBonificacion)</td>
                                            <td>@(string.IsNullOrWhiteSpace(b.DescripcionArticulo) ? b.IdArticulo.ToString() : b.DescripcionArticulo)</td>
                                            <td>@b.Descripcion</td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-link" @onclick="() => EditarBonificacionCliente(b)">Editar</button>
                                                <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => EliminarBonificacionCliente(b)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formCliente" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

<AppBuscadorArticulo @ref="_buscadorBonificacion" AlElegir="ElegirArticuloBonificacion" AlCerrar="ReabrirModalCliente" />


@code {
    private const string Titulo = "Clientes";

    private AppRejilla<FiltranClienteDTO>? _rejilla;
    private HxOffcanvas _detalle = default!;
    private HxModal _modal = default!;
    private HxModal _modalCarta = default!;

    private string _texto = string.Empty;
    private string _estado = "A";   // "A" activos, "I" inactivos, "T" todos
    private List<FiltranClienteDTO> _todos = new();
    private List<FiltranClienteDTO> _resultados = new();
    private FiltranClienteDTO? _elegido;
    private bool _buscando;
    private ClienteDTO? _edicion;
