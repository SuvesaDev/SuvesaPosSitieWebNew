        if (!await Dialogos.ConfirmarPeligroAsync("¿Desea quitar esta bonificación del cliente?")) return;

        if (await Respuestas.CorrectaAsync(await ClienteBonificacion.Eliminar(bonificacion.IdConfiguracion), "quitar la bonificación"))
        {
            _bonificaciones.Remove(bonificacion);
            Dialogos.Exito("Bonificación eliminada.");
        }
    }

