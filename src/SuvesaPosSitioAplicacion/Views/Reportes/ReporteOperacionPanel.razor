@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Reportes
@using SuvesaPosSitioAplicacion.DTOs.Comisiones
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IReportesOperacion Api
@inject IComisiones ComisionesApi
@inject IClientesConsulta Clientes
@inject IProveedoresConsulta Proveedores
@inject IInventarioConsulta Inventarios
@inject ISeguridad Seguridad
@inject IFacturacion Facturacion
@inject ICompras ComprasApi
@inject IFamilias FamiliasApi
@inject IManejadorRespuestas Respuestas
@inject IRelojEquipo RelojEquipo
@inject IJSRuntime JS
@inject IContextoSesion Sesion
@inject NavigationManager Navegacion
@inject IEstadoEspacioTrabajo Espacio
@using SuvesaPosSitioAplicacion.Security

@* Cuerpo real del hub de reportes. Vive como componente propio (no como @page)
   para que Compras.razor pueda instanciarlo con @key="Tipo": cada tipo de
   reporte fuerza una instancia nueva (estado, filtros y catalogos propios),
   en vez de compartir un unico estado mutable entre reportes distintos —
   ver docs/... el bug que resuelve esto era que cambiar de reporte por el
   menu lateral (ruta distinta, mismo @page) no actualizaba el contenido
   porque no habia OnParametersSetAsync: la pestana cambiaba de nombre pero
   el contenido se quedaba pegado en el primer reporte cargado. *@

<AppPantalla Pantalla="@Titulo" Codigo="MODULO_REPORTES" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Consultar" disabled="@_cargando" title="Actualizar reporte">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </Acciones>
    <ChildContent>
        <section class="card mb-3 seepos-catalogo-reportes" aria-label="Catálogo de reportes">
            <div class="card-header bg-transparent p-0">
                <nav aria-label="Dominios de reportes">
                    <div class="nav nav-tabs seepos-pestanas-reportes" role="tablist">
                        @foreach (var dominio in GruposVisibles)
                        {
                            <button type="button" role="tab" aria-selected="@(dominio.Id == _grupoActivo)"
                                    class="nav-link @(dominio.Id == _grupoActivo ? "active" : string.Empty)"
                                    @onclick="() => CambiarGrupo(dominio.Id)">
                                <i class="bi @dominio.Icono me-1" aria-hidden="true"></i>@dominio.Nombre
                            </button>
                        }
                    </div>
                </nav>
            </div>
            <div class="card-body py-3">
                @if (GrupoActivo is { } grupo)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-body-secondary me-1">Reportes disponibles:</span>
                        @foreach (var opcion in OpcionesVisibles(grupo))
                        {
                            <button type="button" class="btn btn-sm @(opcion.Valor == _tipo ? "btn-primary" : "btn-outline-primary")" @onclick="() => CambiarTipo(opcion.Valor, opcion.Texto)">@opcion.Texto</button>
                        }
                    </div>
                }
            </div>
        </section>

        <AppFiltros Titulo="Filtros" AlBuscar="Consultar" AlLimpiar="Limpiar" Buscando="_cargando" Resumen="@Resumen">
            <div class="col-12 col-md-3"><AppCampoFecha Etiqueta="Desde" @bind-Valor="_desde" /></div>
            <div class="col-12 col-md-3"><AppCampoFecha Etiqueta="Hasta" @bind-Valor="_hasta" /></div>
            @if (!EsReporteComisiones)
            {
                <div class="col-12 col-md-5">
                    <label class="form-label small">Texto, documento, cliente, proveedor o artículo</label>
                    <input class="form-control" @bind="_texto" @bind:event="onchange" placeholder="Escriba para filtrar…" />
                </div>
            }
            <div class="col-12 col-md-3"><label class="form-label small">Sucursal</label><select class="form-select" @bind="_idSucursal"><option value="">Todas las sucursales</option>@foreach (var sucursal in _sucursales) { <option value="@sucursal.Id">@sucursal.NombreComercial</option> }</select></div>
            @if (EsReporteComisiones)
            {
                <div class="col-12 col-md-3"><label class="form-label small">Liquidación</label><select class="form-select" @bind="_estadoComision"><option value="">Todas</option><option>Pendiente</option><option>Liquidada</option></select></div>
            }
            @if (!EsReporteComisiones)
            {
            <div class="col-12 col-md-3"><label class="form-label small">Empresa</label><select class="form-select" @bind="_idEmpresa"><option value="">Todas las empresas</option>@foreach (var empresa in _empresas) { <option value="@empresa.Id">@empresa.Nombre</option> }</select></div>
            <div class="col-12 col-md-4"><label class="form-label small">Cliente</label><select class="form-select" @bind="_idCliente"><option value="">Todos los clientes</option>@foreach (var cliente in _clientes) { <option value="@cliente.Identificacion">@cliente.Cedula — @cliente.Nombre</option> }</select></div>
            <div class="col-12 col-md-4"><label class="form-label small">Proveedor</label><select class="form-select" @bind="_idProveedor"><option value="">Todos los proveedores</option>@foreach (var proveedor in _proveedores) { <option value="@proveedor.CodigoProv">@proveedor.Cedula — @proveedor.Nombre</option> }</select></div>
            <div class="col-12 col-md-4"><label class="form-label small">Artículo</label><select class="form-select" @bind="_idArticulo"><option value="">Todos los artículos</option>@foreach (var articulo in _articulos) { <option value="@articulo.Codigo">@articulo.Cod_Articulo — @articulo.Descripcion</option> }</select></div>
            <div class="col-12 col-md-3"><label class="form-label small">Bodega</label><select class="form-select" @bind="_idBodega"><option value="">Todas las bodegas</option>@foreach (var bodega in _bodegas) { <option value="@bodega.IdBodega">@bodega.NombreBodega</option> }</select></div>
            <div class="col-12 col-md-3"><label class="form-label small">Buscar lote</label><input class="form-control" @bind="_numeroLote" @bind:event="onchange" placeholder="Número de lote" /></div>
            }
            @if (EsReporteVentas)
            {
            <div class="col-12 col-md-3"><label class="form-label small">Agente (login)</label><input class="form-control" @bind="_idAgente" @bind:event="onchange" placeholder="Ej. jperez" /></div>
            <div class="col-12 col-md-3"><label class="form-label small">Tipo de venta</label><select class="form-select" @bind="_tipoVenta"><option value="">Contado y crédito</option><option value="01">Contado</option><option value="02">Crédito</option></select></div>
            @if (_tipo == "ventas-detalle")
            {
                <div class="col-12 col-md-3"><label class="form-label small">Familia</label><select class="form-select" @bind="_idFamilia"><option value="">Todas las familias</option>@foreach (var familia in _familias) { <option value="@familia.Codigo">@familia.Descripcion</option> }</select></div>
            }
            <div class="col-12 col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="fIncluirAnuladas" @bind="_incluirAnuladas" />
                    <label class="form-check-label small" for="fIncluirAnuladas">Incluir anuladas</label>
                </div>
            </div>
            }
        </AppFiltros>

        @if (EsReporteComisiones)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div class="small text-body-secondary"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>Solo facturas aceptadas y totalmente canceladas.</div>
                <button class="btn btn-sm btn-outline-success" @onclick="ExportarComisionesXlsx" disabled="@(!_comisiones.Movimientos.Any() || _cargando)"><i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Excel</button>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4"><div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">Comisiones</div><div class="fs-5 fw-semibold seepos-importe">@Formato.Importe(_comisiones.Movimientos.Sum(x => x.Importe))</div></div></div></div>
                <div class="col-12 col-md-4"><div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">Movimientos</div><div class="fs-5 fw-semibold">@_comisiones.Movimientos.Count</div></div></div></div>
                <div class="col-12 col-md-4"><div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">Beneficiarios</div><div class="fs-5 fw-semibold">@_comisiones.Resumen.Select(x => x.Beneficiario).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div></div></div></div>
            </div>
            <div class="card mb-3"><div class="card-header"><strong>Resumen por beneficiario</strong></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Beneficiario</th><th>Tipo</th><th class="text-end">Movimientos</th><th class="text-end">Total</th></tr></thead><tbody>
                @foreach (var fila in _comisiones.Resumen) { <tr><td>@fila.Beneficiario</td><td>@fila.TipoBeneficiario</td><td class="text-end">@fila.Movimientos</td><td class="text-end fw-semibold">@Formato.Importe(fila.Importe)</td></tr> }
                @if (!_comisiones.Resumen.Any()) { <tr><td colspan="4" class="text-secondary">No hay comisiones para los filtros indicados.</td></tr> }
            </tbody></table></div></div></div>
            <div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Fecha</th><th>Documento</th><th>Beneficiario</th><th>Artículo</th><th class="text-end">Base</th><th class="text-end">%</th><th class="text-end">Comisión</th><th>Liquidación</th></tr></thead><tbody>
                @foreach (var fila in _comisiones.Movimientos) { <tr><td>@fila.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><code>@fila.Documento</code></td><td>@fila.Beneficiario <small class="text-secondary d-block">@fila.TipoBeneficiario</small></td><td>@fila.Articulo</td><td class="text-end">@Formato.Importe(fila.Base)</td><td class="text-end">@fila.Porcentaje.ToString("N2")%</td><td class="text-end fw-semibold">@Formato.Importe(fila.Importe)</td><td><span class="badge @(fila.EstadoLiquidacion == "Liquidada" ? "text-bg-secondary" : "text-bg-success")">@fila.EstadoLiquidacion</span></td></tr> }
                @if (!_comisiones.Movimientos.Any()) { <tr><td colspan="8" class="text-secondary">Sin movimientos.</td></tr> }
            </tbody></table></div></div></div>
        }
        @if (_reporte is not null)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div class="small text-body-secondary"><i class="bi bi-database me-1" aria-hidden="true"></i>@_reporte.Fuente</div>
                <div class="btn-group" role="group" aria-label="Exportar reporte">
                    <button class="btn btn-sm btn-outline-success" @onclick="ExportarExcel" disabled="@_cargando"><i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Excel</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="ExportarPdf" disabled="@_cargando"><i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>PDF</button>
                </div>
            </div>
            <div class="row g-3 mb-3">
                @foreach (var indicador in _reporte.Indicadores)
                {
                    <div class="col-12 col-md-4">
                        <div class="card h-100"><div class="card-body py-3">
                            <div class="small text-body-secondary">@indicador.Etiqueta</div>
                            <div class="fs-5 fw-semibold seepos-importe">@(indicador.Formato == "cantidad" ? indicador.Valor.ToString("N2") : Formato.Importe(indicador.Valor))</div>
                        </div></div>
                    </div>
                }
            </div>
            @if (_reporte.Limitado)
            {
                <div class="alert alert-warning py-2 small">Se alcanzó el límite de seguridad de 2.000 filas. Acote fechas, texto o los identificadores para revisar más detalle.</div>
            }
            <AppGraficosReporte TipoReporte="_tipo" Filas="_reporte.Filas" />
        }

        @if (!EsReporteComisiones) { <div class="card">
            <div class="card-body p-0">
                <AppRejilla @ref="_rejilla" TItem="FilaReporteOperacionWebDTO" Datos="CargarRejilla" Nivel="NivelPantalla.Escritorio" TextoVacio="Seleccione un reporte y pulse Buscar.">
                    <Columnas>
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Fecha" ItemTextSelector="@(x => x.Fecha.ToString("dd/MM/yyyy HH:mm"))" SortKeySelector="x => x.Fecha" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Referencia" ItemTextSelector="x => x.Referencia" SortKeySelector="x => x.Referencia" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Entidad" ItemTextSelector="x => x.Entidad" SortKeySelector="x => x.Entidad" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Lote" ItemTextSelector="x => x.Lote" SortKeySelector="x => x.Lote" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Detalle" ItemTextSelector="x => x.Descripcion" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Cantidad" ItemTextSelector="@(x => x.Cantidad.ToString("N2"))" SortKeySelector="x => x.Cantidad" HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Monto" ItemTextSelector="@(x => Formato.Importe(x.Monto))" SortKeySelector="x => x.Monto" HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Saldo / existencia" ItemTextSelector="@(x => Formato.Importe(x.Saldo))" SortKeySelector="x => x.Saldo" HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                        <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="Estado" ItemTextSelector="x => x.Estado" SortKeySelector="x => x.Estado" />
                    </Columnas>
                </AppRejilla>
            </div>
        </div> }
    </ChildContent>
</AppPantalla>

@code {
    private const string Titulo = "Módulo Reportes";
    // El Codigo de cada opción es la función de MenuSeePos.cs (MODULO_REPORTES.*) que le
    // corresponde — generado por tools/anotar_codigos_menu.py. "comisiones" reutiliza el
    // permiso propio de esa pantalla (VENTAS.COMISIONES), no uno de Reportes, porque ya
    // tenía su menú y su controlador aparte.
    private static readonly GrupoReportes[] Grupos =
    [
        new("gerencial", "Panel ejecutivo", "bi-speedometer2",
        [
            ("panel-ejecutivo", "KPIs consolidados", "MODULO_REPORTES.PANEL_EJECUTIVO"),
        ]),
        new("ventas-cartera", "Ventas y cartera", "bi-receipt",
        [
            ("ventas", "Ventas", "MODULO_REPORTES.VENTAS"),
            ("ventas-detalle", "Ventas detalladas", "MODULO_REPORTES.VENTAS_DETALLE"),
            ("ventas-horas", "Ventas entre horas", "MODULO_REPORTES.VENTAS_ENTRE_HORAS"),
            ("clientes", "Clientes y comportamiento", "MODULO_REPORTES.COMPORTAMIENTO_DE_CLIENTES"),
            ("rentabilidad", "Rentabilidad", "MODULO_REPORTES.RENTABILIDAD"),
            ("ventas-compras", "Ventas vs. compras", "MODULO_REPORTES.VENTAS_VS_COMPRAS"),
            ("cuentas-por-cobrar", "CxC y antigüedad", "MODULO_REPORTES.CUENTAS_POR_COBRAR"),
            ("recuperacion-cxc", "Recuperación CxC", "MODULO_REPORTES.RECUPERACION_DE_CARTERA"),
            ("cabys", "Cumplimiento CABYS", "MODULO_REPORTES.CUMPLIMIENTO_CABYS"),
            ("apartados", "Apartados y préstamos", "MODULO_REPORTES.APARTADOS_Y_PRESTAMOS"),
            ("kpi-rutas", "KPI por ruta", "MODULO_REPORTES.KPI_POR_RUTA_COMERCIAL"),
            ("comisiones", "Comisiones", "VENTAS.COMISIONES"),
        ]),
        new("caja-bancos", "Caja y bancos", "bi-cash-stack",
        [
            ("caja", "Movimientos", "MODULO_REPORTES.CAJA"),
            ("arqueos-cierres", "Arqueos y cierres", "MODULO_REPORTES.ARQUEOS_Y_CIERRES"),
            ("depositos", "Depósitos", "MODULO_REPORTES.DEPOSITOS"),
        ]),
        new("compras", "Compras", "bi-cart-check",
        [
            ("compras", "Compras y devoluciones", "MODULO_REPORTES.COMPRAS"),
            ("gastos", "Gastos", "MODULO_REPORTES.GASTOS"),
            ("cuentas-por-pagar", "Abonos CxP", "MODULO_REPORTES.CUENTAS_POR_PAGAR"),
        ]),
        new("inventario", "Inventario", "bi-box-seam",
        [
            ("inventario", "Existencias y lotes", "MODULO_REPORTES.INVENTARIO"),
            ("inventario-abc", "ABC y Pareto", "MODULO_REPORTES.INVENTARIO_ABC"),
            ("rotacion-inventario", "Rotación y reorden", "MODULO_REPORTES.ROTACION_DE_INVENTARIO"),
            ("lotes", "Vencimiento de lotes", "MODULO_REPORTES.LOTES_Y_VENCIMIENTOS"),
            ("trazabilidad", "Trazabilidad por lotes", "MODULO_REPORTES.TRAZABILIDAD"),
            ("bonificaciones", "Bonificaciones y regalías", "MODULO_REPORTES.BONIFICACIONES"),
            ("empaquetado", "Empaquetado y maquila", "MODULO_REPORTES.EMPAQUETADO_Y_MAQUILA"),
            ("mermas", "Mermas", "MODULO_REPORTES.MERMAS"),
            ("auditoria", "Auditoría", "MODULO_REPORTES.AUDITORIA"),
        ]),
    ];

    /// <summary>Tipo de reporte con el que arranca esta instancia (segmento de ruta
    /// <c>/moduloReportes/{Tipo}</c>). Fijo durante la vida del componente: Compras.razor
    /// lo instancia con <c>@@key="Tipo"</c>, así que un tipo distinto siempre crea una
    /// instancia nueva en vez de reutilizar esta con estado mutado.</summary>
    [Parameter, EditorRequired] public string TipoInicial { get; set; } = "";

    private string _tipo = "ventas";
    private string _grupoActivo = "ventas-cartera";
    private IEnumerable<GrupoReportes> GruposVisibles => Grupos.Where(g => OpcionesVisibles(g).Any());
    private IEnumerable<(string Valor, string Texto, string Codigo)> OpcionesVisibles(GrupoReportes g) => g.Opciones.Where(o => Sesion.PuedeVer(o.Codigo));
    private GrupoReportes? GrupoActivo => Grupos.FirstOrDefault(x => x.Id == _grupoActivo);
    private string _texto = string.Empty;
    private DateTime? _desde;
    private DateTime? _hasta;
    private int? _idSucursal;
    private int? _idEmpresa;
    private long? _idCliente;
    private int? _idProveedor;
    private long? _idArticulo;
    private int? _idBodega;
    private string _numeroLote = string.Empty;
    private string _estadoComision = string.Empty;
    private string _idAgente = string.Empty;
    private int? _idFamilia;
    private string _tipoVenta = string.Empty;
    private bool _incluirAnuladas;
    private List<SucursalDTO> _sucursales = new();
    private List<EmpresaDTO> _empresas = new();
    private List<FiltranClienteDTO> _clientes = new();
    private List<ProveedorDTO> _proveedores = new();
    private List<InventarioDTO> _articulos = new();
    private List<Bodega> _bodegas = new();
    private List<FamiliaDTO> _familias = new();
    private bool _cargando;
    private AppRejilla<FilaReporteOperacionWebDTO>? _rejilla;
    private ReporteOperacionWebDTO? _reporte;
    private ComisionConsultaDTO _comisiones = new();
    private bool EsReporteComisiones => _tipo == "comisiones";
    private bool EsReporteVentas => _tipo is "ventas" or "ventas-detalle" or "ventas-horas";
    private string Resumen => EsReporteComisiones
        ? $"{_comisiones.Movimientos.Count:N0} movimientos de comisión"
        : _reporte is null ? "" : $"{_reporte.TotalRegistros:N0} registros · {_reporte.Titulo}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _hasta = await RelojEquipo.HoyAsync();
        _desde = _hasta.Value.AddDays(-30);
        await Sesion.CargarAsync();
        AplicarTipoInicial();
        await CargarCatalogosAsync();
        await Consultar();
        StateHasChanged();
    }

    /// <summary>Si la ruta trajo un tipo válido y visible para el usuario, arranca ahí.
    /// Si no, cae en el primer reporte visible del primer grupo visible.</summary>
    private void AplicarTipoInicial()
    {
        var grupo = !string.IsNullOrWhiteSpace(TipoInicial)
            ? Grupos.FirstOrDefault(g => OpcionesVisibles(g).Any(o => o.Valor == TipoInicial))
            : null;
        if (grupo is not null)
        {
            _grupoActivo = grupo.Id;
            _tipo = TipoInicial;
            return;
        }
        var primerGrupoVisible = GruposVisibles.FirstOrDefault();
        if (primerGrupoVisible is null) return;
        _grupoActivo = primerGrupoVisible.Id;
        _tipo = OpcionesVisibles(primerGrupoVisible).First().Valor;
    }

    /// <summary>Cambiar de reporte navega a su propia ruta (<c>/moduloReportes/{tipo}</c>)
    /// y abre/activa su propia pestaña del espacio de trabajo — cada reporte es una
    /// pestaña independiente con sus propios filtros y datos, no un estado compartido
    /// dentro de una única pestaña "Módulo Reportes".</summary>
    private void CambiarTipo(string tipo, string titulo)
    {
        if (tipo == _tipo) return;
        var ruta = $"/moduloReportes/{tipo}";
        Espacio.Abrir(titulo, ruta);
        Navegacion.NavigateTo(ruta);
    }

    private void CambiarGrupo(string grupo)
    {
        if (_grupoActivo == grupo) return;
        var siguiente = Grupos.FirstOrDefault(x => x.Id == grupo);
        var primerReporte = siguiente is null ? default : OpcionesVisibles(siguiente).FirstOrDefault();
        if (primerReporte is { Valor.Length: > 0 }) CambiarTipo(primerReporte.Valor, primerReporte.Texto);
    }

    private async Task Consultar()
    {
        if (_cargando) return;
        _cargando = true;
        try
        {
            if (EsReporteComisiones)
            {
                _comisiones = (await Respuestas.DatoAsync(await ComisionesApi.Consultar(new FiltroComisionesDTO
                {
                    Desde = _desde, Hasta = _hasta, IdSucursal = _idSucursal, EstadoLiquidacion = _estadoComision
                }), "consultar el reporte de comisiones")) ?? new();
                _reporte = null;
                return;
            }
            _reporte = await Respuestas.DatoAsync(await Api.Consultar(_tipo, new FiltroReporteOperacionWebDTO
            {
                Desde = _desde,
                Hasta = _hasta,
                FechaReferencia = await RelojEquipo.AhoraAsync(),
                IdSucursal = _idSucursal,
                IdEmpresa = _idEmpresa,
                IdCliente = _idCliente,
                IdProveedor = _idProveedor,
                IdArticulo = _idArticulo,
                IdBodega = _idBodega,
                NumeroLote = string.IsNullOrWhiteSpace(_numeroLote) ? null : _numeroLote.Trim(),
                IdAgente = string.IsNullOrWhiteSpace(_idAgente) ? null : _idAgente.Trim(),
                IdFamilia = _tipo == "ventas-detalle" ? _idFamilia : null,
                TipoVenta = string.IsNullOrWhiteSpace(_tipoVenta) ? null : _tipoVenta,
                IncluirAnuladas = _incluirAnuladas,
                Pagina = 1,
                // La rejilla pide sus páginas al servidor por separado. Esta
                // consulta alimenta indicadores y gráficas, así que debe usar
                // todo el conjunto permitido y no únicamente la primera página.
                TamanoPagina = 2000,
                Texto = string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim()
            }), "consultar el reporte");
        }
        finally { _cargando = false; }
        if (_rejilla is not null) await _rejilla.RefrescarAsync();
    }

    private async Task Limpiar()
    {
        _texto = string.Empty;
        _idSucursal = null;
        _idEmpresa = null;
        _idCliente = null;
        _idProveedor = null;
        _idArticulo = null;
        _idBodega = null;
        _numeroLote = string.Empty;
        _estadoComision = string.Empty;
        _idAgente = string.Empty;
        _idFamilia = null;
        _tipoVenta = string.Empty;
        _incluirAnuladas = false;
        _hasta = await RelojEquipo.HoyAsync();
        _desde = _hasta.Value.AddDays(-30);
        await Consultar();
    }

    private async Task CargarCatalogosAsync()
    {
        var sucursales = await Seguridad.ObtenerSucursales();
        var empresas = await Facturacion.Empresas();
        var clientes = await Clientes.Listar();
        var proveedores = await Proveedores.Obtener();
        var articulos = await Inventarios.Listar();
        var bodegas = await ComprasApi.Bodegas(false);
        var familias = await FamiliasApi.Obtener();
        _sucursales = sucursales.EsCorrecta ? (sucursales.Responses ?? []).OrderBy(x => x.NombreComercial).ToList() : [];
        _empresas = empresas.EsCorrecta ? (empresas.Responses ?? []).OrderBy(x => x.Nombre).ToList() : [];
        _clientes = clientes.EsCorrecta ? (clientes.Responses ?? []).OrderBy(x => x.Nombre).ToList() : [];
        _proveedores = proveedores.EsCorrecta ? (proveedores.Responses ?? []).OrderBy(x => x.Nombre).ToList() : [];
        _articulos = articulos.EsCorrecta ? (articulos.Responses ?? []).OrderBy(x => x.Descripcion).ToList() : [];
        _bodegas = bodegas.EsCorrecta ? (bodegas.Responses ?? []).Where(x => x.Estado).OrderBy(x => x.NombreBodega).ToList() : [];
        _familias = familias.EsCorrecta ? (familias.Responses ?? []).OrderBy(x => x.Descripcion).ToList() : [];
    }

    private async Task Exportar(string formato)
    {
        if (_reporte is null) return;
        var generado = await RelojEquipo.AhoraAsync();
        var parametros = new List<string>
        {
            $"generado={Uri.EscapeDataString(generado.ToString("O", System.Globalization.CultureInfo.InvariantCulture))}"
        };
        if (_desde.HasValue) parametros.Add($"desde={_desde.Value:yyyy-MM-dd}");
        if (_hasta.HasValue) parametros.Add($"hasta={_hasta.Value:yyyy-MM-dd}");
        if (_idSucursal.HasValue) parametros.Add($"idSucursal={_idSucursal}");
        if (_idEmpresa.HasValue) parametros.Add($"idEmpresa={_idEmpresa}");
        if (_idCliente.HasValue) parametros.Add($"idCliente={_idCliente}");
        if (_idProveedor.HasValue) parametros.Add($"idProveedor={_idProveedor}");
        if (_idArticulo.HasValue) parametros.Add($"idArticulo={_idArticulo}");
        if (_idBodega.HasValue) parametros.Add($"idBodega={_idBodega}");
        if (!string.IsNullOrWhiteSpace(_numeroLote)) parametros.Add($"numeroLote={Uri.EscapeDataString(_numeroLote.Trim())}");
        if (!string.IsNullOrWhiteSpace(_texto)) parametros.Add($"texto={Uri.EscapeDataString(_texto.Trim())}");
        if (!string.IsNullOrWhiteSpace(_idAgente)) parametros.Add($"idAgente={Uri.EscapeDataString(_idAgente.Trim())}");
        if (_tipo == "ventas-detalle" && _idFamilia.HasValue) parametros.Add($"idFamilia={_idFamilia}");
        if (!string.IsNullOrWhiteSpace(_tipoVenta)) parametros.Add($"tipoVenta={Uri.EscapeDataString(_tipoVenta)}");
        if (_incluirAnuladas) parametros.Add("incluirAnuladas=true");
        await JS.InvokeVoidAsync("seepos.descargarUrl", $"/reportes/operacion/{Uri.EscapeDataString(_tipo)}/{formato}?{string.Join("&", parametros)}");
    }

    private Task ExportarExcel() => Exportar("excel");
    private Task ExportarPdf() => Exportar("pdf");

    private async Task ExportarComisionesXlsx()
    {
        var archivo = await Respuestas.DatoAsync(await ComisionesApi.ExportarXlsx(new FiltroComisionesDTO
        {
            Desde = _desde, Hasta = _hasta, IdSucursal = _idSucursal, EstadoLiquidacion = _estadoComision
        }), "exportar el reporte de comisiones a Excel");
        if (archivo is not null && archivo.Contenido.Length > 0)
            await JS.InvokeVoidAsync("seepos.descargarBase64", archivo.Nombre, Convert.ToBase64String(archivo.Contenido), archivo.TipoContenido);
    }

    private async Task<GridDataProviderResult<FilaReporteOperacionWebDTO>> CargarRejilla(GridDataProviderRequest<FilaReporteOperacionWebDTO> peticion)
    {
        if (_reporte is null) return new GridDataProviderResult<FilaReporteOperacionWebDTO> { Data = [], TotalCount = 0 };
        var tamano = Math.Max(1, Convert.ToInt32(peticion.Count));
        var pagina = (Convert.ToInt32(peticion.StartIndex) / tamano) + 1;
        var datos = await Respuestas.DatoAsync(await Api.Consultar(_tipo, new FiltroReporteOperacionWebDTO
        {
            Desde = _desde, Hasta = _hasta, FechaReferencia = await RelojEquipo.AhoraAsync(), Texto = string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(),
            IdSucursal = _idSucursal, IdEmpresa = _idEmpresa, IdCliente = _idCliente, IdProveedor = _idProveedor, IdArticulo = _idArticulo,
            IdBodega = _idBodega, NumeroLote = string.IsNullOrWhiteSpace(_numeroLote) ? null : _numeroLote.Trim(),
            IdAgente = string.IsNullOrWhiteSpace(_idAgente) ? null : _idAgente.Trim(),
            IdFamilia = _tipo == "ventas-detalle" ? _idFamilia : null,
            TipoVenta = string.IsNullOrWhiteSpace(_tipoVenta) ? null : _tipoVenta,
            IncluirAnuladas = _incluirAnuladas,
            Pagina = pagina, TamanoPagina = tamano
        }), "cargar la página del reporte");
        return new GridDataProviderResult<FilaReporteOperacionWebDTO> { Data = datos?.Filas ?? [], TotalCount = datos?.TotalRegistros ?? 0 };
    }

    private sealed record GrupoReportes(string Id, string Nombre, string Icono, (string Valor, string Texto, string Codigo)[] Opciones);
