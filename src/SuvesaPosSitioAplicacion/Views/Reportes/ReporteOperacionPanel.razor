@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Reportes
@using SuvesaPosSitioAplicacion.DTOs.Comisiones
@using SuvesaPosSitioAplicacion.DTOs.Rutas
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IReportesOperacion Api
@inject IComisiones ComisionesApi
@inject IClientesConsulta Clientes
@inject IProveedoresConsulta Proveedores
@inject IInventarioConsulta Inventarios
@inject ISeguridad Seguridad
@inject IFacturacion Facturacion
@inject ICompras ComprasApi
@inject IFamilias FamiliasApi
@inject IRutasComerciales RutasApi
@inject IManejadorRespuestas Respuestas
@inject IRelojEquipo RelojEquipo
@inject IJSRuntime JS
@inject IContextoSesion Sesion
@inject NavigationManager Navegacion
@inject IEstadoEspacioTrabajo Espacio
@inject IEstadoReportes Estados
@inject IPreferenciasReportes Preferencias
@using SuvesaPosSitioAplicacion.Security

@* Cuerpo real de cada reporte. Vive como componente propio (no como @page):
   cada tipo de reporte tiene su propia pagina delgada (Ventas.razor,
   Compras.razor, etc., cada una con su propio @page "/moduloReportes/tipo")
   que solo instancia este panel. IEstadoReportes asigna a cada tipo un contexto
   propio de filtros, resultado y rejilla mientras su pestaña siga abierta; no hay
   un único hub compartiendo estado mutable entre reportes.
   Antes todo el hub era una sola @page que leía el tipo por query string en
   OnAfterRenderAsync (solo en el primer render): navegar entre reportes por
   el menu lateral (ruta distinta, mismo @page) cambiaba el nombre de la
   pestana pero el contenido se quedaba pegado en el primer reporte cargado. *@

<AppPantalla Pantalla="@Definicion.Titulo" Codigo="@Definicion.Codigo" Nivel="NivelPantalla.Escritorio"
             Icono="@Definicion.Icono" Subtitulo="@Definicion.Descripcion">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="VolverAlCatalogo" title="Volver al catálogo">
            <i class="bi bi-grid me-1" aria-hidden="true"></i>Catálogo
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="AlternarFavorito"
                title="@(Preferencias.EsFavorito(_tipo) ? "Quitar de favoritos" : "Agregar a favoritos")"
                aria-label="@(Preferencias.EsFavorito(_tipo) ? "Quitar de favoritos" : "Agregar a favoritos")">
            <i class="bi @(Preferencias.EsFavorito(_tipo) ? "bi-star-fill text-warning" : "bi-star")" aria-hidden="true"></i>
        </button>
        @if (_estado.TieneResultado)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="Consultar" disabled="@_cargando" title="Actualizar reporte">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            </button>
        }
    </Acciones>
    <ChildContent>
        <AppFiltros Titulo="Configure la consulta" AlBuscar="Consultar" AlLimpiar="Limpiar" Buscando="_cargando" Resumen="@Resumen" TextoBuscar="Consultar reporte">
            @if (Definicion.Tiene(FiltroReporteVisible.Periodo))
            {
                <div class="col-12">
                    <div class="d-flex flex-wrap align-items-center gap-1" aria-label="Periodos rápidos">
                        <span class="small text-body-secondary me-1">Rango rápido:</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AplicarRango(0)">Hoy</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AplicarRango(7)">7 días</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AplicarRango(30)">30 días</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AplicarMesActual">Este mes</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AplicarMesAnterior">Mes anterior</button>
                    </div>
                </div>
                <div class="col-12 col-md-3"><AppCampoFecha Etiqueta="Desde" @bind-Valor="_desde" /></div>
                <div class="col-12 col-md-3"><AppCampoFecha Etiqueta="Hasta" @bind-Valor="_hasta" /></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Sucursal))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Sucursal</label><select class="form-select" @bind="_idSucursal"><option value="">Todas las sucursales</option>@foreach (var sucursal in _sucursales) { <option value="@sucursal.Id">@sucursal.NombreComercial</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Cliente))
            {
                <div class="col-12 col-md-4"><label class="form-label small">Cliente</label><select class="form-select" @bind="_idCliente"><option value="">Todos los clientes</option>@foreach (var cliente in _clientes) { <option value="@cliente.Identificacion">@cliente.Cedula — @cliente.Nombre</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Proveedor))
            {
                <div class="col-12 col-md-4"><label class="form-label small">Proveedor</label><select class="form-select" @bind="_idProveedor"><option value="">Todos los proveedores</option>@foreach (var proveedor in _proveedores) { <option value="@proveedor.CodigoProv">@proveedor.Cedula — @proveedor.Nombre</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Articulo))
            {
                <div class="col-12 col-md-4"><label class="form-label small">Artículo</label><select class="form-select" @bind="_idArticulo"><option value="">Todos los artículos</option>@foreach (var articulo in _articulos) { <option value="@articulo.Codigo">@articulo.Cod_Articulo — @articulo.Descripcion</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Empresa))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Empresa</label><select class="form-select" @bind="_idEmpresa"><option value="">Todas las empresas</option>@foreach (var empresa in _empresas) { <option value="@empresa.Id">@empresa.Nombre</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Bodega))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Bodega</label><select class="form-select" @bind="_idBodega"><option value="">Todas las bodegas</option>@foreach (var bodega in _bodegas) { <option value="@bodega.IdBodega">@bodega.NombreBodega</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Lote))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Lote</label><input class="form-control" @bind="_numeroLote" @bind:event="onchange" placeholder="Número de lote" /></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Agente))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Agente (login)</label><input class="form-control" @bind="_idAgente" @bind:event="onchange" placeholder="Ej. jperez" /></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.TipoVenta))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Tipo de venta</label><select class="form-select" @bind="_tipoVenta"><option value="">Contado y crédito</option><option value="01">Contado</option><option value="02">Crédito</option></select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Familia))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Familia</label><select class="form-select" @bind="_idFamilia"><option value="">Todas las familias</option>@foreach (var familia in _familias) { <option value="@familia.Codigo">@familia.Descripcion</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.EstadoLiquidacion))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Liquidación</label><select class="form-select" @bind="_estadoComision"><option value="">Todas</option><option>Pendiente</option><option>Liquidada</option></select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.RutaComercial))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Ruta comercial</label><select class="form-select" @bind="_idRutaComercialComision"><option value="">Todas</option>@foreach (var ruta in _rutasComision) { <option value="@ruta.IdRuta">@ruta.Nombre</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.BeneficiarioComision))
            {
                <div class="col-12 col-md-3"><label class="form-label small">Beneficiario</label><select class="form-select" @bind="_idUsuarioBeneficiarioComision"><option value="">Todos</option>@foreach (var b in _beneficiariosComision) { <option value="@b.IdUsuarioBeneficiario">@b.Beneficiario (@b.TipoBeneficiario)</option> }</select></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Corte))
            {
                <div class="col-12 col-md-3"><label class="form-label small">N° de corte</label><input type="number" min="1" class="form-control" placeholder="Todos" @bind="_idCorteComision" /></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.Texto))
            {
                <div class="col-12 col-md-5"><label class="form-label small">Buscar en el reporte</label><input class="form-control" @bind="_texto" @bind:event="onchange" placeholder="Documento, nombre, código o detalle…" /></div>
            }
            @if (MostrarFiltro(FiltroReporteVisible.IncluirAnuladas))
            {
                <div class="col-12 col-md-3 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" id="fIncluirAnuladas" @bind="_incluirAnuladas" /><label class="form-check-label small" for="fIncluirAnuladas">Incluir anuladas</label></div></div>
            }
            @if (Definicion.FiltrosAvanzados != FiltroReporteVisible.Ninguno)
            {
                <div class="col-12">
                    <button class="btn btn-sm btn-link px-0" type="button" @onclick="AlternarFiltrosAvanzados" aria-expanded="@_estado.FiltrosAvanzadosAbiertos">
                        <i class="bi @(_estado.FiltrosAvanzadosAbiertos ? "bi-chevron-up" : "bi-sliders") me-1" aria-hidden="true"></i>
                        @(_estado.FiltrosAvanzadosAbiertos ? "Ocultar filtros adicionales" : "Más filtros")
                    </button>
                </div>
            }
        </AppFiltros>

        @if (!string.IsNullOrWhiteSpace(_errorFiltros))
        {
            <div class="alert alert-warning py-2" role="alert">@_errorFiltros</div>
        }

        @if (!_estado.TieneResultado && !_cargando)
        {
            <section class="seepos-reporte-inicio card" aria-label="Instrucciones del reporte">
                <div class="card-body text-center py-5">
                    <span class="seepos-reporte-inicio-icono"><i class="bi @Definicion.Icono" aria-hidden="true"></i></span>
                    <h2 class="h6 mt-3">Configure los filtros y pulse Consultar reporte</h2>
                    <p class="small text-body-secondary mb-0">Los datos no se cargan hasta que usted inicie la consulta.</p>
                </div>
            </section>
        }

        @if (EsReporteComisiones && _estado.ConsultadoEn.HasValue)
        {
            <ResumenConsultaReporte ConsultadoEn="_estado.ConsultadoEn" Filtros="FiltrosAplicados" />
            @if (PuedeExportarExcel)
            {
                <div class="d-flex justify-content-end mb-2"><button class="btn btn-sm btn-outline-success" @onclick="ExportarComisionesXlsx" disabled="@(!_comisiones.Movimientos.Any() || _cargando)"><i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Exportar Excel</button></div>
            }
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4"><div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">Comisiones</div><div class="fs-5 fw-semibold seepos-importe">@Formato.Importe(_comisiones.Movimientos.Sum(x => x.Importe))</div></div></div></div>
                <div class="col-12 col-md-4"><div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">Movimientos</div><div class="fs-5 fw-semibold">@_comisiones.Movimientos.Count</div></div></div></div>
                <div class="col-12 col-md-4"><div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">Beneficiarios</div><div class="fs-5 fw-semibold">@_comisiones.Resumen.Select(x => x.Beneficiario).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div></div></div></div>
            </div>
            <div class="card mb-3"><div class="card-header"><strong>Resumen por beneficiario</strong></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th>Beneficiario</th><th>Tipo</th><th class="text-end">Movimientos</th><th class="text-end">Total</th></tr></thead><tbody>
                @foreach (var fila in _comisiones.Resumen) { <tr><td>@fila.Beneficiario</td><td><span class="badge text-bg-light border">@fila.TipoBeneficiario</span></td><td class="text-end">@fila.Movimientos</td><td class="text-end fw-semibold">@Formato.Importe(fila.Importe)</td></tr> }
                @if (!_comisiones.Resumen.Any()) { <tr><td colspan="4" class="text-secondary">No hay comisiones para los filtros indicados.</td></tr> }
            </tbody></table></div></div></div>
            <div class="card"><div class="card-header d-flex justify-content-between align-items-center"><strong>Detalle auditable</strong><span class="text-secondary small">@_comisiones.Movimientos.Count movimiento(s)</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Documento</th><th>Cliente</th><th>Ruta comercial</th><th>Beneficiario</th><th>Artículo</th><th class="text-end">Base</th><th class="text-end">%</th><th class="text-end">Comisión</th><th>Estado</th></tr></thead><tbody>
                @foreach (var fila in _comisiones.Movimientos)
                {
                    <tr>
                        <td class="text-nowrap">
                            @fila.Fecha.ToLocalTime().ToString("dd/MM/yyyy")
                            <small class="text-secondary d-block">@fila.Fecha.ToLocalTime().ToString("HH:mm")</small>
                        </td>
                        <td class="text-nowrap"><span class="badge text-bg-light font-monospace fw-normal">@fila.Documento</span></td>
                        <td>
                            @fila.Cliente
                            @if (!string.IsNullOrWhiteSpace(fila.NombreComercial) && fila.NombreComercial != fila.Cliente)
                            {
                                <small class="text-secondary d-block">@fila.NombreComercial</small>
                            }
                        </td>
                        <td class="text-nowrap">@fila.RutaComercial</td>
                        <td class="text-nowrap">
                            @fila.Beneficiario
                            <small class="text-secondary d-block">@fila.TipoBeneficiario</small>
                        </td>
                        <td>@fila.Articulo</td>
                        <td class="text-end text-nowrap">@Formato.Importe(fila.Base)</td>
                        <td class="text-end text-nowrap">@fila.Porcentaje.ToString("N2")%</td>
                        <td class="text-end text-nowrap fw-semibold">@Formato.Importe(fila.Importe)</td>
                        <td class="text-nowrap"><span class="badge @(fila.EstadoLiquidacion == "Liquidada" ? "text-bg-secondary" : "text-bg-success")">@fila.EstadoLiquidacion</span></td>
                    </tr>
                }
                @if (!_comisiones.Movimientos.Any()) { <tr><td colspan="10" class="text-secondary">Sin movimientos.</td></tr> }
            </tbody></table></div></div></div>
        }
        @if (_reporte is not null)
        {
            <ResumenConsultaReporte ConsultadoEn="_estado.ConsultadoEn" Filtros="FiltrosAplicados" />
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                <details class="seepos-reporte-metodo small">
                    <summary><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Fuente y criterio</summary>
                    <p class="mb-0 mt-2">@_reporte.Fuente</p>
                </details>
                @if (PuedeExportarExcel || PuedeExportarPdf)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" disabled="@_cargando">
                            <i class="bi bi-download me-1" aria-hidden="true"></i>Exportar
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (PuedeExportarExcel) { <li><button class="dropdown-item" type="button" @onclick="ExportarExcel"><i class="bi bi-file-earmark-spreadsheet text-success me-2" aria-hidden="true"></i>Excel</button></li> }
                            @if (PuedeExportarPdf) { <li><button class="dropdown-item" type="button" @onclick="ExportarPdf"><i class="bi bi-file-earmark-pdf text-danger me-2" aria-hidden="true"></i>PDF</button></li> }
                        </ul>
                    </div>
                }
            </div>
            <div class="row g-3 mb-3">
                @foreach (var indicador in _reporte.Indicadores)
                {
                    <div class="col-12 col-md-4">
                        @if (DestinoIndicador(indicador.Etiqueta) is { } destino)
                        {
                            <button class="card h-100 w-100 text-start seepos-kpi-desglose" type="button" @onclick="() => AbrirDesglose(destino)"><span class="card-body py-3"><span class="small text-body-secondary d-flex justify-content-between">@indicador.Etiqueta <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span><span class="fs-5 fw-semibold seepos-importe d-block">@FormatearIndicador(indicador)</span></span></button>
                        }
                        else
                        {
                            <div class="card h-100"><div class="card-body py-3"><div class="small text-body-secondary">@indicador.Etiqueta</div><div class="fs-5 fw-semibold seepos-importe">@FormatearIndicador(indicador)</div></div></div>
                        }
                    </div>
                }
            </div>
            @if (_reporte.Limitado)
            {
                <div class="alert alert-warning py-2 small"><strong>Resultado limitado a 2.000 filas.</strong> Los indicadores, la exportación y el detalle reflejan ese alcance. Acote los filtros para obtener una lectura completa; las gráficas se ocultan para no presentar una muestra como si fuera el total.</div>
            }
            @if (Definicion.MostrarGraficas && !_reporte.Limitado)
            {
                <AppGraficosReporte TipoReporte="_tipo" Filas="_reporte.Filas" />
            }
            @if (_reporte.TotalRegistros == 0 && !_reporte.Indicadores.Any())
            {
                <div class="seepos-reporte-vacio card mb-3"><div class="card-body text-center py-4"><i class="bi bi-inbox fs-3 text-secondary" aria-hidden="true"></i><p class="fw-semibold mt-2 mb-1">No hay datos para los filtros seleccionados.</p><p class="small text-secondary mb-0">Amplíe el periodo o limpie algún filtro e intente nuevamente.</p></div></div>
            }
        }

        @if (!EsReporteComisiones && _reporte is { TotalRegistros: > 0 } && _tipo != "panel-ejecutivo") { <div class="card">
            <div class="card-body p-0">
                <AppRejilla @ref="_rejilla" TItem="FilaReporteOperacionWebDTO" Datos="CargarRejilla" Nivel="NivelPantalla.Escritorio"
                            EstadoUsuario="_estado.EstadoRejilla" EstadoUsuarioChanged="AlCambiarEstadoRejilla"
                            TextoVacio="No hay filas para los filtros seleccionados.">
                    <Columnas>
                        @foreach (var col in ColumnasActuales)
                        {
                            <HxGridColumn TItem="FilaReporteOperacionWebDTO" HeaderText="@col.Encabezado" ItemTextSelector="@col.Texto" SortKeySelector="@col.Orden"
                                          HeaderCssClass="@(col.Numerica ? "seepos-importe" : null)" ItemCssClass="@(col.Numerica ? "seepos-importe" : null)" />
                        }
                    </Columnas>
                </AppRejilla>
            </div>
        </div> }
    </ChildContent>
</AppPantalla>

@code {
    /// <summary>Tipo de reporte a mostrar, fijado por la página delgada que instancia
    /// este panel (p. ej. <c>Ventas.razor</c> pasa <c>"ventas"</c>). Cada tipo vive en su
    /// propia página/ruta y obtiene un contexto independiente en <see cref="IEstadoReportes"/>.</summary>
    [Parameter, EditorRequired] public string TipoInicial { get; set; } = "";

    private ReporteCatalogo? _definicion;
    private EstadoReportePestana _estado = new() { Tipo = string.Empty };
    private ReporteCatalogo Definicion => _definicion ?? throw new InvalidOperationException($"Tipo de reporte desconocido: {TipoInicial}");
    private string _tipo => Definicion.Tipo;

    private string _texto { get => _estado.Texto; set => _estado.Texto = value; }
    private DateTime? _desde { get => _estado.Desde; set => _estado.Desde = value; }
    private DateTime? _hasta { get => _estado.Hasta; set => _estado.Hasta = value; }
    private int? _idSucursal { get => _estado.IdSucursal; set => _estado.IdSucursal = value; }
    private int? _idEmpresa { get => _estado.IdEmpresa; set => _estado.IdEmpresa = value; }
    private long? _idCliente { get => _estado.IdCliente; set => _estado.IdCliente = value; }
    private int? _idProveedor { get => _estado.IdProveedor; set => _estado.IdProveedor = value; }
    private long? _idArticulo { get => _estado.IdArticulo; set => _estado.IdArticulo = value; }
    private int? _idBodega { get => _estado.IdBodega; set => _estado.IdBodega = value; }
    private string _numeroLote { get => _estado.NumeroLote; set => _estado.NumeroLote = value; }
    private string _estadoComision { get => _estado.EstadoComision; set => _estado.EstadoComision = value; }
    private int? _idRutaComercialComision { get => _estado.IdRutaComercialComision; set => _estado.IdRutaComercialComision = value; }
    private string _idUsuarioBeneficiarioComision { get => _estado.IdUsuarioBeneficiarioComision; set => _estado.IdUsuarioBeneficiarioComision = value; }
    private long? _idCorteComision { get => _estado.IdCorteComision; set => _estado.IdCorteComision = value; }
    private List<RutaComercialDTO> _rutasComision => _estado.RutasComerciales;
    /// <summary>Beneficiarios para el filtro: se arman con el último resultado consultado
    /// (no hay un catálogo propio de "todos los beneficiarios posibles").</summary>
    private readonly Dictionary<string, ResumenComisionDTO> _beneficiariosComisionVistos = new();
    private IEnumerable<ResumenComisionDTO> _beneficiariosComision => _beneficiariosComisionVistos.Values.OrderBy(b => b.Beneficiario);
    private string _idAgente { get => _estado.IdAgente; set => _estado.IdAgente = value; }
    private int? _idFamilia { get => _estado.IdFamilia; set => _estado.IdFamilia = value; }
    private string _tipoVenta { get => _estado.TipoVenta; set => _estado.TipoVenta = value; }
    private bool _incluirAnuladas { get => _estado.IncluirAnuladas; set => _estado.IncluirAnuladas = value; }
    private List<SucursalDTO> _sucursales => _estado.Sucursales;
    private List<EmpresaDTO> _empresas => _estado.Empresas;
    private List<FiltranClienteDTO> _clientes => _estado.Clientes;
    private List<ProveedorDTO> _proveedores => _estado.Proveedores;
    private List<InventarioDTO> _articulos => _estado.Articulos;
