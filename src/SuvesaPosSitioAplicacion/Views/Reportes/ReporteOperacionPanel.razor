    /// <summary>Columnas por defecto cuando el tipo no tiene configuración propia
    /// (hoy solo "panel-ejecutivo", que no trae filas — solo indicadores).</summary>
    private static readonly Columna[] ColumnasPorDefecto = [ColFecha, Col("Referencia", x => x.Referencia, x => x.Referencia), Col("Entidad", x => x.Entidad, x => x.Entidad), ColDetalle, ColEstado];

    private Columna[] ColumnasActuales => ColumnasPorTipo.TryGetValue(_tipo, out var columnas) ? columnas : ColumnasPorDefecto;

    protected override void OnParametersSet()
    {
        _definicion = CatalogoReportes.Buscar(TipoInicial)
            ?? throw new InvalidOperationException($"Tipo de reporte desconocido: {TipoInicial}");
        _estado = Estados.Obtener(_definicion.Tipo);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Sesion.CargarAsync();
        if (!Sesion.PuedeVer(Definicion.Codigo)) return;

        await Preferencias.CargarAsync();
        await Preferencias.RegistrarRecienteAsync(_tipo);
        if (!_estado.Inicializado)
        {
            await InicializarPredeterminadosAsync();
            _estado.Inicializado = true;
        }
        _estado.LimpiarFiltrosNoAplicables(Definicion);
        await CargarCatalogosAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void VolverAlCatalogo()
    {
        var pestana = Espacio.Abrir("Reportes", "/moduloReportes");
        Navegacion.NavigateTo(pestana.Ruta);
    }

    private async Task AlternarFavorito()
    {
        await Preferencias.AlternarFavoritoAsync(_tipo);
        await InvokeAsync(StateHasChanged);
    }

    private bool MostrarFiltro(FiltroReporteVisible filtro)
        => Definicion.FiltrosBasicos.HasFlag(filtro)
           || (_estado.FiltrosAvanzadosAbiertos && Definicion.FiltrosAvanzados.HasFlag(filtro));

    private void AlternarFiltrosAvanzados()
        => _estado.FiltrosAvanzadosAbiertos = !_estado.FiltrosAvanzadosAbiertos;

    private async Task AplicarRango(int dias)
    {
        var hoy = await RelojEquipo.HoyAsync();
        _hasta = hoy;
        _desde = dias <= 1 ? hoy : hoy.AddDays(-(dias - 1));
    }

    private async Task AplicarMesActual()
    {
        var hoy = await RelojEquipo.HoyAsync();
        _desde = new DateTime(hoy.Year, hoy.Month, 1);
        _hasta = hoy;
    }

    private async Task AplicarMesAnterior()
    {
        var hoy = await RelojEquipo.HoyAsync();
        var primeroActual = new DateTime(hoy.Year, hoy.Month, 1);
        _desde = primeroActual.AddMonths(-1);
        _hasta = primeroActual.AddDays(-1);
    }

    private async Task Consultar()
    {
        if (_cargando) return;
        _errorFiltros = ValidarFiltros();
        if (_errorFiltros is not null) return;

        _estado.LimpiarFiltrosNoAplicables(Definicion);
        _cargando = true;
        try
        {
            var ahora = await RelojEquipo.AhoraAsync();
            var filtro = CrearFiltro(ahora);
            if (EsReporteComisiones)
            {
                var resultado = await Respuestas.DatoAsync(await ComisionesApi.Consultar(new FiltroComisionesDTO
                {
                    Desde = _desde, Hasta = _hasta, IdSucursal = _idSucursal, EstadoLiquidacion = _estadoComision,
                    IdRutaComercial = _idRutaComercialComision,
                    IdUsuarioBeneficiario = string.IsNullOrWhiteSpace(_idUsuarioBeneficiarioComision) ? null : _idUsuarioBeneficiarioComision,
                    IdCorte = _idCorteComision,
                }), "consultar el reporte de comisiones");
                if (resultado is null) return;
                _comisiones = resultado;
                foreach (var b in _comisiones.Resumen) _beneficiariosComisionVistos[b.IdUsuarioBeneficiario] = b;
                _reporte = null;
                _estado.FiltroAplicado = filtro;
                _estado.EstadoLiquidacionAplicado = _estadoComision;
            }
            else
            {
                var resultado = await Respuestas.DatoAsync(await Api.Consultar(_tipo, filtro), "consultar el reporte");
                if (resultado is null) return;
                _reporte = resultado;
                _comisiones = new();
                _estado.FiltroAplicado = filtro;
                _estado.EstadoLiquidacionAplicado = string.Empty;
            }
            _estado.ConsultadoEn = ahora;
            _estado.EstadoRejilla = new GridUserState(0, []);
        }
        finally { _cargando = false; }
        if (_rejilla is not null) await _rejilla.RefrescarAsync();
    }

    private async Task Limpiar()
    {
        _texto = string.Empty;
        _idSucursal = null;
        _idEmpresa = null;
        _idCliente = null;
        _idProveedor = null;
        _idArticulo = null;
        _idBodega = null;
        _numeroLote = string.Empty;
        _estadoComision = string.Empty;
        _idAgente = string.Empty;
        _idFamilia = null;
        _tipoVenta = string.Empty;
        _incluirAnuladas = false;
        _reporte = null;
        _comisiones = new();
        _estado.ConsultadoEn = null;
        _estado.EstadoRejilla = new GridUserState(0, []);
        _estado.FiltroAplicado = null;
        _estado.EstadoLiquidacionAplicado = string.Empty;
        _errorFiltros = null;
        await InicializarPredeterminadosAsync();
    }

    private async Task CargarCatalogosAsync()
    {
        if (_estado.CatalogosCargados) return;
        var tareas = new List<Task>();
        if (Definicion.Tiene(FiltroReporteVisible.Sucursal)) tareas.Add(CargarSucursalesAsync());
        if (Definicion.Tiene(FiltroReporteVisible.Empresa)) tareas.Add(CargarEmpresasAsync());
        if (Definicion.Tiene(FiltroReporteVisible.Cliente)) tareas.Add(CargarClientesAsync());
        if (Definicion.Tiene(FiltroReporteVisible.Proveedor)) tareas.Add(CargarProveedoresAsync());
        if (Definicion.Tiene(FiltroReporteVisible.Articulo)) tareas.Add(CargarArticulosAsync());
        if (Definicion.Tiene(FiltroReporteVisible.Bodega)) tareas.Add(CargarBodegasAsync());
        if (Definicion.Tiene(FiltroReporteVisible.Familia)) tareas.Add(CargarFamiliasAsync());
        if (Definicion.Tiene(FiltroReporteVisible.RutaComercial)) tareas.Add(CargarRutasComercialesAsync());
        await Task.WhenAll(tareas);
        _estado.CatalogosCargados = true;
    }

    private async Task CargarSucursalesAsync() { var r = await Seguridad.ObtenerSucursales(); _estado.Sucursales = r.EsCorrecta ? (r.Responses ?? []).OrderBy(x => x.NombreComercial).ToList() : []; }
    private async Task CargarEmpresasAsync() { var r = await Facturacion.Empresas(); _estado.Empresas = r.EsCorrecta ? (r.Responses ?? []).OrderBy(x => x.Nombre).ToList() : []; }
    private async Task CargarClientesAsync() { var r = await Clientes.Listar(); _estado.Clientes = r.EsCorrecta ? (r.Responses ?? []).OrderBy(x => x.Nombre).ToList() : []; }
    private async Task CargarProveedoresAsync() { var r = await Proveedores.Obtener(); _estado.Proveedores = r.EsCorrecta ? (r.Responses ?? []).OrderBy(x => x.Nombre).ToList() : []; }
    private async Task CargarArticulosAsync() { var r = await Inventarios.Listar(); _estado.Articulos = r.EsCorrecta ? (r.Responses ?? []).OrderBy(x => x.Descripcion).ToList() : []; }
    private async Task CargarBodegasAsync() { var r = await ComprasApi.Bodegas(false); _estado.Bodegas = r.EsCorrecta ? (r.Responses ?? []).Where(x => x.Estado).OrderBy(x => x.NombreBodega).ToList() : []; }
    private async Task CargarFamiliasAsync() { var r = await FamiliasApi.Obtener(); _estado.Familias = r.EsCorrecta ? (r.Responses ?? []).OrderBy(x => x.Descripcion).ToList() : []; }
    private async Task CargarRutasComercialesAsync() { var r = await RutasApi.Listar(Sesion.IdSucursal); _estado.RutasComerciales = r.EsCorrecta ? (r.Responses ?? []).Where(x => x.Activo).OrderBy(x => x.Nombre).ToList() : []; }

    private async Task InicializarPredeterminadosAsync()
    {
        if (Definicion.Tiene(FiltroReporteVisible.Periodo)) await AplicarRango(30);
        if (Definicion.Tiene(FiltroReporteVisible.Sucursal) && Sesion.IdSucursal > 0) _idSucursal = Sesion.IdSucursal;
    }

    private string? ValidarFiltros()
    {
        if (!Definicion.Tiene(FiltroReporteVisible.Periodo)) return null;
        if (!_desde.HasValue || !_hasta.HasValue) return "Seleccione las fechas Desde y Hasta para consultar el reporte.";
        return _desde.Value.Date > _hasta.Value.Date ? "La fecha Desde no puede ser posterior a la fecha Hasta." : null;
    }

    private FiltroReporteOperacionWebDTO CrearFiltro(DateTime referencia) => new()
    {
        Desde = _desde,
        Hasta = _hasta,
        FechaReferencia = referencia,
        IdSucursal = _idSucursal,
        IdEmpresa = _idEmpresa,
        IdCliente = _idCliente,
        IdProveedor = _idProveedor,
        IdArticulo = _idArticulo,
        IdBodega = _idBodega,
        NumeroLote = string.IsNullOrWhiteSpace(_numeroLote) ? null : _numeroLote.Trim(),
        IdAgente = string.IsNullOrWhiteSpace(_idAgente) ? null : _idAgente.Trim(),
        IdFamilia = _idFamilia,
        TipoVenta = string.IsNullOrWhiteSpace(_tipoVenta) ? null : _tipoVenta,
        IncluirAnuladas = _incluirAnuladas,
        Pagina = 1,
        TamanoPagina = 2000,
        Texto = string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim()
    };

    private IReadOnlyList<string> ConstruirFiltrosAplicados()
    {
        var aplicado = _estado.FiltroAplicado;
        if (aplicado is null) return [];

        var filtros = new List<string>();
        if (Definicion.Tiene(FiltroReporteVisible.Periodo) && aplicado.Desde.HasValue && aplicado.Hasta.HasValue)
            filtros.Add($"{Definicion.EtiquetaPeriodo}: {aplicado.Desde:dd/MM/yyyy} – {aplicado.Hasta:dd/MM/yyyy}");
        if (aplicado.IdSucursal.HasValue)
            filtros.Add($"Sucursal: {_sucursales.FirstOrDefault(x => x.Id == aplicado.IdSucursal)?.NombreComercial ?? aplicado.IdSucursal.ToString()}");
        if (aplicado.IdEmpresa.HasValue)
            filtros.Add($"Empresa: {_empresas.FirstOrDefault(x => x.Id == aplicado.IdEmpresa)?.Nombre ?? aplicado.IdEmpresa.ToString()}");
        if (aplicado.IdCliente.HasValue)
            filtros.Add($"Cliente: {_clientes.FirstOrDefault(x => x.Identificacion == aplicado.IdCliente)?.Nombre ?? aplicado.IdCliente.ToString()}");
        if (aplicado.IdProveedor.HasValue)
            filtros.Add($"Proveedor: {_proveedores.FirstOrDefault(x => x.CodigoProv == aplicado.IdProveedor)?.Nombre ?? aplicado.IdProveedor.ToString()}");
        if (aplicado.IdArticulo.HasValue)
            filtros.Add($"Artículo: {_articulos.FirstOrDefault(x => x.Codigo == aplicado.IdArticulo)?.Descripcion ?? aplicado.IdArticulo.ToString()}");
        if (aplicado.IdBodega.HasValue)
            filtros.Add($"Bodega: {_bodegas.FirstOrDefault(x => x.IdBodega == aplicado.IdBodega)?.NombreBodega ?? aplicado.IdBodega.ToString()}");
        if (!string.IsNullOrWhiteSpace(aplicado.NumeroLote)) filtros.Add($"Lote: {aplicado.NumeroLote}");
        if (!string.IsNullOrWhiteSpace(aplicado.IdAgente)) filtros.Add($"Agente: {aplicado.IdAgente}");
        if (aplicado.IdFamilia.HasValue)
            filtros.Add($"Familia: {_familias.FirstOrDefault(x => x.Codigo == aplicado.IdFamilia)?.Descripcion ?? aplicado.IdFamilia.ToString()}");
        if (!string.IsNullOrWhiteSpace(aplicado.TipoVenta)) filtros.Add($"Tipo: {(aplicado.TipoVenta == "01" ? "Contado" : "Crédito")}");
        if (!string.IsNullOrWhiteSpace(_estado.EstadoLiquidacionAplicado)) filtros.Add($"Liquidación: {_estado.EstadoLiquidacionAplicado}");
        if (aplicado.IncluirAnuladas) filtros.Add("Incluye anuladas");
        if (!string.IsNullOrWhiteSpace(aplicado.Texto)) filtros.Add($"Búsqueda: {aplicado.Texto}");
        if (filtros.Count == 0) filtros.Add("Sin filtros adicionales");
        return filtros;
    }

    private static string FormatearIndicador(IndicadorReporteOperacionWebDTO indicador)
        => indicador.Formato == "cantidad" ? indicador.Valor.ToString("N2") : Formato.Importe(indicador.Valor);

    private string? DestinoIndicador(string etiqueta)
    {
        if (_tipo != "panel-ejecutivo") return null;
        return etiqueta switch
        {
            "Facturación neta" or "Documentos de venta" or "Pendiente de cobro" => "ventas",
            "Compras" => "compras",
            "Gastos" => "gastos",
            "Margen bruto estimado" => "rentabilidad",
            "Cartera pendiente (CxC)" or "DSO estimado" or "Cartera vencida +90 días" => "cuentas-por-cobrar",
            "Valor de inventario a costo" => "inventario",
            "Costo de mermas del período" or "Líneas con merma" => "mermas",
            _ => null,
        };
    }

    private void AbrirDesglose(string tipo)
    {
        var reporte = CatalogoReportes.Buscar(tipo);
        if (reporte is null || !Sesion.PuedeVer(reporte.Codigo)) return;
        var destino = Estados.Obtener(tipo);
        destino.CopiarFiltrosDesde(_estado, reporte);
        destino.Reporte = null;
        destino.Comisiones = new();
        destino.ConsultadoEn = null;
        destino.EstadoRejilla = new GridUserState(0, []);
        destino.FiltroAplicado = null;
        destino.EstadoLiquidacionAplicado = string.Empty;
        var pestana = Espacio.Abrir(reporte.Titulo, reporte.Ruta);
        Navegacion.NavigateTo(pestana.Ruta);
    }

    private Task AlCambiarEstadoRejilla(GridUserState estado)
    {
        _estado.EstadoRejilla = estado;
        return Task.CompletedTask;
    }

    private async Task Exportar(string formato)
    {
        var filtro = _estado.FiltroAplicado;
        if (_reporte is null || filtro is null) return;
        var generado = await RelojEquipo.AhoraAsync();
        var parametros = new List<string>
        {
            $"generado={Uri.EscapeDataString(generado.ToString("O", System.Globalization.CultureInfo.InvariantCulture))}",
            $"fechaReferencia={Uri.EscapeDataString((filtro.FechaReferencia ?? generado).ToString("O", System.Globalization.CultureInfo.InvariantCulture))}"
        };
        if (filtro.Desde.HasValue) parametros.Add($"desde={filtro.Desde.Value:yyyy-MM-dd}");
        if (filtro.Hasta.HasValue) parametros.Add($"hasta={filtro.Hasta.Value:yyyy-MM-dd}");
        if (filtro.IdSucursal.HasValue) parametros.Add($"idSucursal={filtro.IdSucursal}");
        if (filtro.IdEmpresa.HasValue) parametros.Add($"idEmpresa={filtro.IdEmpresa}");
        if (filtro.IdCliente.HasValue) parametros.Add($"idCliente={filtro.IdCliente}");
        if (filtro.IdProveedor.HasValue) parametros.Add($"idProveedor={filtro.IdProveedor}");
        if (filtro.IdArticulo.HasValue) parametros.Add($"idArticulo={filtro.IdArticulo}");
        if (filtro.IdBodega.HasValue) parametros.Add($"idBodega={filtro.IdBodega}");
        if (!string.IsNullOrWhiteSpace(filtro.NumeroLote)) parametros.Add($"numeroLote={Uri.EscapeDataString(filtro.NumeroLote)}");
        if (!string.IsNullOrWhiteSpace(filtro.Texto)) parametros.Add($"texto={Uri.EscapeDataString(filtro.Texto)}");
        if (!string.IsNullOrWhiteSpace(filtro.IdAgente)) parametros.Add($"idAgente={Uri.EscapeDataString(filtro.IdAgente)}");
        if (filtro.IdFamilia.HasValue) parametros.Add($"idFamilia={filtro.IdFamilia}");
        if (!string.IsNullOrWhiteSpace(filtro.TipoVenta)) parametros.Add($"tipoVenta={Uri.EscapeDataString(filtro.TipoVenta)}");
        if (filtro.IncluirAnuladas) parametros.Add("incluirAnuladas=true");
        await JS.InvokeVoidAsync("seepos.descargarUrl", $"/reportes/operacion/{Uri.EscapeDataString(_tipo)}/{formato}?{string.Join("&", parametros)}");
    }

    private Task ExportarExcel() => Exportar("excel");
    private Task ExportarPdf() => Exportar("pdf");

    private async Task ExportarComisionesXlsx()
    {
        var filtro = _estado.FiltroAplicado;
        if (filtro is null) return;
        var archivo = await Respuestas.DatoAsync(await ComisionesApi.ExportarXlsx(new FiltroComisionesDTO
        {
            Desde = filtro.Desde,
            Hasta = filtro.Hasta,
            IdSucursal = filtro.IdSucursal,
            EstadoLiquidacion = _estado.EstadoLiquidacionAplicado,
            IdRutaComercial = _idRutaComercialComision,
            IdUsuarioBeneficiario = string.IsNullOrWhiteSpace(_idUsuarioBeneficiarioComision) ? null : _idUsuarioBeneficiarioComision,
            IdCorte = _idCorteComision,
        }), "exportar el reporte de comisiones a Excel");
        if (archivo is not null && archivo.Contenido.Length > 0)
            await JS.InvokeVoidAsync("seepos.descargarBase64", archivo.Nombre, Convert.ToBase64String(archivo.Contenido), archivo.TipoContenido);
    }

    private Task<GridDataProviderResult<FilaReporteOperacionWebDTO>> CargarRejilla(GridDataProviderRequest<FilaReporteOperacionWebDTO> peticion)
    {
        if (_reporte is null)
            return Task.FromResult(new GridDataProviderResult<FilaReporteOperacionWebDTO> { Data = [], TotalCount = 0 });

        // El API entrega el conjunto autorizado (máximo 2.000 filas). Aplicar aquí
        // orden y página hace que la rejilla responda de verdad a sus encabezados y
        // permite restaurar exactamente la vista al volver a la pestaña.
        return Task.FromResult(peticion.ApplyTo(_reporte.Filas));
    }
}
