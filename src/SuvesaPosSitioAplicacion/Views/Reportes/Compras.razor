@page "/moduloReportes"
@page "/moduloReportes/{Tipo}"

@* Ruta de entrada del hub de reportes. El contenido real vive en
   ReporteOperacionPanel, instanciado con @key="Tipo": Blazor destruye y
   recrea el panel cada vez que Tipo cambia, en lugar de reutilizar la misma
   instancia (con su mismo estado/filtros) para reportes distintos. Antes
   todo el hub era una sola @page que leía el tipo por query string en
   OnAfterRenderAsync (solo en el primer render), así que navegar entre
   reportes por el menú lateral cambiaba el nombre de la pestaña pero el
   contenido se quedaba pegado en el primer reporte cargado. *@
<ReporteOperacionPanel @key="TipoEfectivo" TipoInicial="@TipoEfectivo" />

@code {
    [Parameter] public string? Tipo { get; set; }
    private string TipoEfectivo => Tipo?.Trim() ?? "";
}
