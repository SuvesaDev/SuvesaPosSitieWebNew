@page "/moduloReportes"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Helpers
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IContextoSesion Sesion
@inject IEstadoEspacioTrabajo Espacio
@inject IPreferenciasReportes Preferencias
@inject NavigationManager Navegacion

<AppPantalla Pantalla="Reportes" Codigo="MODULO_REPORTES" OmitirPermiso="true" Nivel="NivelPantalla.Escritorio"
             Icono="bi-bar-chart-fill" Subtitulo="Encuentre el análisis que necesita y trabaje con cada reporte de forma independiente.">
    <ChildContent>
        @if (!_sesionCargada)
        {
            <p class="text-secondary">Cargando catálogo…</p>
        }
        else if (!ReportesAutorizados.Any())
        {
            <div class="alert alert-info mb-0">
                <strong>No tiene reportes asignados.</strong>
                <span class="d-block small mt-1">Contacte a un administrador si necesita acceso.</span>
            </div>
        }
        else
        {
            <section class="seepos-reportes-buscador card mb-3" aria-label="Buscar reportes">
                <div class="card-body">
                    <label class="form-label fw-semibold" for="buscar-reporte">¿Qué necesita consultar?</label>
                    <div class="input-group">
                        <span class="input-group-text bg-body" aria-hidden="true"><i class="bi bi-search"></i></span>
                        <input id="buscar-reporte" class="form-control" type="search" @bind="_busqueda" @bind:event="oninput"
                               placeholder="Ej. cartera, ventas, lotes o auditoría" autocomplete="off" />
                        @if (!string.IsNullOrWhiteSpace(_busqueda))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => _busqueda = string.Empty" aria-label="Limpiar búsqueda">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                    <div class="form-text">Puede buscar por nombre, propósito o filtro disponible.</div>
                </div>
            </section>

            @if (FavoritosVisibles.Any() || RecientesVisibles.Any())
            {
                <section class="seepos-reportes-accesos card mb-4" aria-label="Accesos rápidos">
                    <div class="card-body d-flex flex-wrap align-items-center gap-2">
                        @if (FavoritosVisibles.Any())
                        {
                            <span class="small fw-semibold me-1"><i class="bi bi-star-fill text-warning me-1" aria-hidden="true"></i>Favoritos</span>
                            @foreach (var reporte in FavoritosVisibles)
                            {
                                <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => Abrir(reporte)">@reporte.Titulo</button>
                            }
                        }
                        @if (RecientesVisibles.Any())
                        {
                            <span class="small fw-semibold ms-md-3 me-1"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>Recientes</span>
                            @foreach (var reporte in RecientesVisibles.Take(3))
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => Abrir(reporte)">@reporte.Titulo</button>
                            }
                        }
                    </div>
                </section>
            }

            @if (GruposVisibles.Length == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-search fs-3 text-secondary" aria-hidden="true"></i>
                    <p class="fw-semibold mt-2 mb-1">No encontramos un reporte con ese criterio.</p>
                    <p class="small text-secondary mb-0">Pruebe con otra palabra o limpie la búsqueda.</p>
                </div>
            }
            else
            {
                @foreach (var grupo in GruposVisibles)
                {
                    <section class="mb-4" aria-labelledby="@($"dominio-{grupo.Id}")">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <h2 class="h6 mb-0" id="@($"dominio-{grupo.Id}")"><i class="bi @grupo.Icono me-2" aria-hidden="true"></i>@grupo.Nombre</h2>
                            <span class="badge text-bg-light">@OpcionesVisibles(grupo).Count()</span>
                        </div>
                        <div class="seepos-reportes-tarjetas">
                            @foreach (var reporte in OpcionesVisibles(grupo))
                            {
                                <article class="seepos-reporte-tarjeta">
                                    <button type="button" class="seepos-reporte-tarjeta-principal" @onclick="() => Abrir(reporte)"
                                            aria-label="@($"Abrir {reporte.Titulo}")">
                                        <span class="seepos-reporte-tarjeta-icono"><i class="bi @reporte.Icono" aria-hidden="true"></i></span>
                                        <span class="seepos-reporte-tarjeta-contenido">
                                            <strong>@reporte.Titulo</strong>
                                            <small>@reporte.Descripcion</small>
                                            <span class="seepos-reporte-filtros">
                                                @foreach (var filtro in CatalogoReportes.NombresFiltros(reporte).Take(4))
                                                {
                                                    <span>@filtro</span>
                                                }
                                            </span>
                                        </span>
                                        <i class="bi bi-arrow-right seepos-reporte-tarjeta-flecha" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="seepos-reporte-favorito @(Preferencias.EsFavorito(reporte.Tipo) ? "activo" : "")"
                                            @onclick="() => AlternarFavorito(reporte)"
                                            aria-label="@(Preferencias.EsFavorito(reporte.Tipo) ? $"Quitar {reporte.Titulo} de favoritos" : $"Agregar {reporte.Titulo} a favoritos")"
                                            title="@(Preferencias.EsFavorito(reporte.Tipo) ? "Quitar de favoritos" : "Agregar a favoritos")">
                                        <i class="bi @(Preferencias.EsFavorito(reporte.Tipo) ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                                    </button>
                                </article>
                            }
                        </div>
                    </section>
                }
            }
        }
    </ChildContent>
</AppPantalla>

@code {
    private bool _sesionCargada;
    private string _busqueda = string.Empty;

    private IEnumerable<ReporteCatalogo> ReportesAutorizados
        => CatalogoReportes.Todos.Where(r => Sesion.PuedeVer(r.Codigo));

    private IEnumerable<ReporteCatalogo> FavoritosVisibles
        => ReportesAutorizados.Where(r => Preferencias.EsFavorito(r.Tipo));

    private IEnumerable<ReporteCatalogo> RecientesVisibles
        => Preferencias.Recientes
            .Select(CatalogoReportes.Buscar)
            .OfType<ReporteCatalogo>()
            .Where(r => Sesion.PuedeVer(r.Codigo));

    private GrupoReportes[] GruposVisibles => CatalogoReportes.Grupos
        .Where(g => OpcionesVisibles(g).Any())
        .ToArray();

    private IEnumerable<ReporteCatalogo> OpcionesVisibles(GrupoReportes grupo)
        => grupo.Opciones.Where(r => Sesion.PuedeVer(r.Codigo) && Coincide(r));

    private bool Coincide(ReporteCatalogo reporte)
    {
        var termino = Texto.Normalizar(_busqueda);
        if (termino.Length == 0) return true;
        return Texto.Normalizar(reporte.Titulo).Contains(termino, StringComparison.Ordinal)
            || Texto.Normalizar(reporte.Descripcion).Contains(termino, StringComparison.Ordinal)
            || CatalogoReportes.NombresFiltros(reporte).Any(f => Texto.Normalizar(f).Contains(termino, StringComparison.Ordinal));
    }

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        _sesionCargada = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Preferencias.CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Abrir(ReporteCatalogo reporte)
    {
        await Preferencias.RegistrarRecienteAsync(reporte.Tipo);
        var pestana = Espacio.Abrir(reporte.Titulo, reporte.Ruta);
        Navegacion.NavigateTo(pestana.Ruta);
    }

    private async Task AlternarFavorito(ReporteCatalogo reporte)
    {
        await Preferencias.AlternarFavoritoAsync(reporte.Tipo);
        await InvokeAsync(StateHasChanged);
    }
}
