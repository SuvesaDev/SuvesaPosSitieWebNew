@page "/buys/providers"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IProveedoresConsulta Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

@*  RUTA DEL MENU, no una propia.
    Esta pantalla ocupa la ruta del sistema actual, asi que a partir de aqui el menu
    llega al sitio nuevo y ya no al iframe de la SPA React.

    Ya incorpora alta, edicion y cambio de estado (cerrado en la Ola 4); no hace
    falta entrar por la SPA React para mantener estos registros.
*@

@*  OLA 1 — replica del ARQUETIPO 02.
    Variante: el API no ofrece busqueda de proveedores, solo el listado completo.
    Asi que se trae una vez y se filtra en memoria, en lugar de consultar por cada
    tecla. Para un catalogo de proveedores el volumen lo permite; si algun dia deja
    de permitirlo, hay que pedirle al API un endpoint de busqueda.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Movil">
    <Acciones>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Agregar">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
            </button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar" aria-label="Actualizar proveedores">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </Acciones>
    <ChildContent>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" class="form-control"
                       placeholder="Nombre, cedula o contacto..."
                       aria-label="Filtrar proveedores"
                       value="@_texto" @oninput="AlEscribir" />
            </div>
        </div>

        @if (!_cargado)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando</span>
                </div>
            </div>
        }
        else if (_filtrados.Count == 0)
        {
            <div class="text-center text-secondary py-5 small">
                @(string.IsNullOrWhiteSpace(_texto)
                    ? "No hay proveedores registrados."
                    : "Ningun proveedor coincide con el filtro.")
            </div>
        }
        else
        {
            <p class="text-secondary small">
                @_filtrados.Count de @_todos.Count @(_todos.Count == 1 ? "proveedor" : "proveedores")
            </p>

            <div class="d-md-none d-flex flex-column gap-2">
                @foreach (var p in _filtrados)
                {
                    <button type="button" class="card text-start border-0 shadow-sm p-0"
                            @onclick="() => Ver(p)">
                        <div class="card-body py-2 px-3">
                            <div class="fw-semibold small">@p.Nombre</div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                <code class="small text-secondary">@p.Cedula</code>
                                @if (!string.IsNullOrWhiteSpace(p.Telefono1))
                                {
                                    <span class="small text-secondary">@p.Telefono1</span>
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>

            <div class="d-none d-md-block card">
                <div class="card-body">
                    <AppRejilla TItem="ProveedorDTO" Datos="Servir"
                                Nivel="NivelPantalla.Tableta" @ref="_rejilla">
                        <Columnas>
                            <HxGridColumn TItem="ProveedorDTO" HeaderText="Cedula"
                                          ItemTextSelector="p => p.Cedula"
                                          SortKeySelector="p => p.Cedula" />
                            <HxGridColumn TItem="ProveedorDTO" HeaderText="Nombre"
                                          ItemTextSelector="p => p.Nombre"
                                          SortKeySelector="p => p.Nombre" />
                            <HxGridColumn TItem="ProveedorDTO" HeaderText="Contacto"
                                          ItemTextSelector="p => p.Contacto" />
                            <HxGridColumn TItem="ProveedorDTO" HeaderText="Telefono"
                                          ItemTextSelector="p => p.Telefono1" />
                            <HxGridColumn TItem="ProveedorDTO" HeaderText="Credito"
                                          ItemTextSelector="@(p => Formato.Importe(p.MontoCredito ?? 0))"
                                          SortKeySelector="p => p.MontoCredito"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="ProveedorDTO" HeaderText="">
                                <ItemTemplate Context="p">
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => Ver(p)">Ver</button>
                                    @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                                    {
                                        <button class="btn btn-sm btn-link p-0 ms-3" @onclick="() => Editar(p)">Editar</button>
                                    }
                                </ItemTemplate>
                            </HxGridColumn>
                        </Columnas>
                    </AppRejilla>
                </div>
            </div>
        }

    </ChildContent>
</AppPantalla>

<HxOffcanvas @ref="_detalle" Title="@(_elegido?.Nombre ?? "Proveedor")"
             Placement="OffcanvasPlacement.End">
    <BodyTemplate>
        @if (_elegido is not null)
        {
            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Cedula</dt>
                <dd class="col-7"><code>@_elegido.Cedula</code></dd>

                <dt class="col-5 fw-normal text-secondary">Contacto</dt>
                <dd class="col-7">@(_elegido.Contacto ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Tel. contacto</dt>
                <dd class="col-7">@(_elegido.TelefonoCont ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Telefono</dt>
                <dd class="col-7">@(_elegido.Telefono1 ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Correo</dt>
                <dd class="col-7">@(_elegido.Email ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Direccion</dt>
                <dd class="col-7">@(_elegido.Direccion ?? "—")</dd>
            </dl>

            <hr />

            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Credito</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.MontoCredito ?? 0)</dd>

                <dt class="col-5 fw-normal text-secondary">Plazo</dt>
                <dd class="col-7 seepos-importe">@(_elegido.Plazo ?? 0) dias</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_elegido.Observaciones))
            {
                <hr />
                <p class="small text-secondary mb-0">@_elegido.Observaciones</p>
            }

            <div class="d-flex gap-2 border-top pt-3 mt-3">
                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => Editar(_elegido)">Editar</button>
                }
                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                {
                    <button class="btn btn-sm @(_elegido.Inhabilitado == true ? "btn-outline-success" : "btn-outline-danger")"
                            @onclick="() => CambiarEstado(_elegido)">
                        @(_elegido.Inhabilitado == true ? "Activar" : "Deshabilitar")
                    </button>
                }
            </div>
        }
    </BodyTemplate>
</HxOffcanvas>

<HxModal @ref="_modal" Title="@(_esNuevo ? "Nuevo proveedor" : "Editar proveedor")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formProveedor">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_edicion.Nombre" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Cédula" @bind-Valor="_edicion.Cedula" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Contacto" @bind-Valor="_edicion.Contacto" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Teléfono del contacto" @bind-Valor="_edicion.TelefonoCont" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_edicion.Telefono1" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Correo" @bind-Valor="_edicion.Email" /></div>
                    <div class="col-12"><AppCampoTexto Etiqueta="Dirección" @bind-Valor="_edicion.Direccion" /></div>
                    <div class="col-12"><AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_edicion.Observaciones" /></div>
                    <div class="col-12 d-flex gap-3">
                        <div class="form-check">
                            <input id="proveedor-actualizado" class="form-check-input" type="checkbox" @bind="_edicion.Actualizado" />
                            <label class="form-check-label" for="proveedor-actualizado">Actualizado</label>
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-1" /><h3 class="h6 mb-0">Cuentas bancarias</h3></div>
                    <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Tipo de cuenta" @bind-Valor="_cuentaEdicion.TipoCuenta" /></div>
                    <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Banco" @bind-Valor="_cuentaEdicion.Banco" /></div>
                    <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Número de cuenta" @bind-Valor="_cuentaEdicion.NumCuenta" /></div>
                    <div class="col-12 col-md-2">
                        <label class="form-label" for="cuenta-moneda">Moneda</label>
                        <select id="cuenta-moneda" class="form-select" @bind="_cuentaEdicion.CodMoneda" @bind:after="ActualizarMonedaCuenta">
                            <option value="1">Colón</option>
                            <option value="2">Dólar</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-1 d-grid align-self-end">
                        <button type="button" class="btn btn-outline-primary" @onclick="AgregarCuenta">Agregar</button>
                    </div>
                    @if (_edicion.CuentasBancariasProveedors is { Count: > 0 })
                    {
                        <div class="col-12 table-responsive">
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Tipo</th><th>Banco</th><th>Cuenta</th><th>Moneda</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var cuenta in _edicion.CuentasBancariasProveedors)
                                    {
                                        <tr>
                                            <td>@cuenta.TipoCuenta</td><td>@cuenta.Banco</td><td><code>@cuenta.NumCuenta</code></td><td>@cuenta.MonedaNombre</td>
                                            <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarCuenta(cuenta)">Quitar</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formProveedor" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Titulo = "Proveedores";

    private AppRejilla<ProveedorDTO>? _rejilla;
    private HxOffcanvas _detalle = default!;
    private HxModal _modal = default!;

    private List<ProveedorDTO> _todos = new();
    private List<ProveedorDTO> _filtrados = new();
    private ProveedorDTO? _elegido;
    private string _texto = string.Empty;
    private bool _cargado;
    private ProveedorDTO? _edicion;
    private bool _esNuevo;
    private bool _guardando;
    private CuentaBancariaProveedorDTO _cuentaEdicion = NuevaCuenta();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task AlEscribir(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? string.Empty;

        // Filtrado en memoria: sin tildes ni mayusculas, para que "jose" encuentre
        // "José" como espera cualquiera que escriba deprisa.
        var buscado = Security.NombrePantalla.Normalizar(_texto);

        _filtrados = string.IsNullOrWhiteSpace(buscado)
            ? _todos
            : _todos.Where(p =>
                  Security.NombrePantalla.Normalizar(p.Nombre).Contains(buscado)
                  || Security.NombrePantalla.Normalizar(p.Cedula).Contains(buscado)
                  || Security.NombrePantalla.Normalizar(p.Contacto).Contains(buscado))
              .ToList();

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private Task<GridDataProviderResult<ProveedorDTO>> Servir(
        GridDataProviderRequest<ProveedorDTO> peticion)
        => Task.FromResult(peticion.ApplyTo(_filtrados));

    private async Task Ver(ProveedorDTO proveedor)
    {
        _elegido = proveedor;
        await _detalle.ShowAsync();
    }

    private async Task Recargar() => await Cargar();

    private async Task Cargar()
    {
        _cargado = false;
        _todos = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los proveedores"))
                 ?.ToList() ?? new List<ProveedorDTO>();
        await AlEscribir(new ChangeEventArgs { Value = _texto });
        _cargado = true;

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private async Task Agregar()
    {
        _esNuevo = true;
        _edicion = new ProveedorDTO { Estado = true, Actualizado = true };
        _cuentaEdicion = NuevaCuenta();
        await _modal.ShowAsync();
    }

    private async Task Editar(ProveedorDTO proveedor)
    {
        _esNuevo = false;
        _edicion = Copiar(proveedor);
        _cuentaEdicion = NuevaCuenta();
        await _modal.ShowAsync();
    }

    private async Task Guardar()
    {
        if (_edicion is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_edicion.Nombre) || string.IsNullOrWhiteSpace(_edicion.Cedula))
        {
            await Dialogos.ErrorAsync("Nombre y cédula son obligatorios.");
            return;
        }

        if (!await Dialogos.ConfirmarAsync(_esNuevo ? "Se registrará el nuevo proveedor." : "Se actualizarán los datos del proveedor."))
        {
            return;
        }

        _guardando = true;
        if (_esNuevo)
        {
            _edicion.IdUsuarioCreacion = Sesion.Usuario;
            _edicion.FechaCreacion = DateTime.Today.ToString("d", System.Globalization.CultureInfo.GetCultureInfo("es-CR"));
        }
        else
        {
            _edicion.IdUsuarioModificacion = Sesion.Usuario;
            _edicion.FechaModificacion = DateTime.Today.ToString("d", System.Globalization.CultureInfo.GetCultureInfo("es-CR"));
        }
        var respuesta = _esNuevo ? await Api.Crear(_edicion) : await Api.Editar(_edicion);
        _guardando = false;

        if (await Respuestas.CorrectaAsync(respuesta, _esNuevo ? "crear el proveedor" : "editar el proveedor"))
        {
            await _modal.HideAsync();
            Dialogos.Exito(_esNuevo ? "Proveedor creado." : "Proveedor actualizado.");
            await Cargar();
        }
    }

    private async Task CambiarEstado(ProveedorDTO proveedor)
    {
        var inhabilitar = proveedor.Inhabilitado != true;
        var accion = inhabilitar ? "deshabilitar" : "activar";
        if (!await Dialogos.ConfirmarPeligroAsync($"¿Desea {accion} a {proveedor.Nombre}?"))
        {
            return;
        }

        var respuesta = await Api.CambiarEstado(proveedor.CodigoProv, inhabilitar);
        if (await Respuestas.CorrectaAsync(respuesta, $"{accion} el proveedor"))
        {
            await _detalle.HideAsync();
            Dialogos.Exito(inhabilitar ? "Proveedor deshabilitado." : "Proveedor activado.");
            await Cargar();
        }
    }

    private static ProveedorDTO Copiar(ProveedorDTO p) => new()
    {
        CodigoProv = p.CodigoProv,
        Cedula = p.Cedula,
        Nombre = p.Nombre,
        Contacto = p.Contacto,
        TelefonoCont = p.TelefonoCont,
        Observaciones = p.Observaciones,
        Telefono1 = p.Telefono1,
        Telefono2 = p.Telefono2,
        Fax1 = p.Fax1,
        Fax2 = p.Fax2,
        Email = p.Email,
        Direccion = p.Direccion,
        MontoCredito = p.MontoCredito,
        Plazo = p.Plazo,
        CostoTotal = p.CostoTotal,
        ImpIncluido = p.ImpIncluido,
        PedidosMes = p.PedidosMes,
        UtilidadInventario = p.UtilidadInventario,
        UtilidadFija = p.UtilidadFija,
        DescripcionCuentaContable = p.DescripcionCuentaContable,
        Actualizado = p.Actualizado,
        Inhabilitado = p.Inhabilitado,
        Serie = p.Serie,
        Bloqueado = p.Bloqueado,
        Estado = p.Estado,
        IdUsuarioCreacion = p.IdUsuarioCreacion,
        FechaCreacion = p.FechaCreacion,
        IdUsuarioModificacion = p.IdUsuarioModificacion,
        FechaModificacion = p.FechaModificacion,
        CuentasBancariasProveedors = p.CuentasBancariasProveedors?.ToList()
    };

    private void ActualizarMonedaCuenta()
        => _cuentaEdicion.MonedaNombre = _cuentaEdicion.CodMoneda == 2 ? "DOLAR" : "COLON";

    private async Task AgregarCuenta()
    {
        if (_edicion is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_cuentaEdicion.TipoCuenta)
            || string.IsNullOrWhiteSpace(_cuentaEdicion.Banco)
            || string.IsNullOrWhiteSpace(_cuentaEdicion.NumCuenta))
        {
            await Dialogos.ErrorAsync("Indique tipo, banco y número de cuenta.");
            return;
        }

        _cuentaEdicion.CodigoProv = _edicion.CodigoProv;
        _cuentaEdicion.Estado = 1;
        _edicion.CuentasBancariasProveedors ??= new List<CuentaBancariaProveedorDTO>();
        _edicion.CuentasBancariasProveedors.Add(_cuentaEdicion);
        _cuentaEdicion = NuevaCuenta();
    }

    private async Task QuitarCuenta(CuentaBancariaProveedorDTO cuenta)
    {
        if (_edicion?.CuentasBancariasProveedors is null)
        {
            return;
        }

        if (!await Dialogos.ConfirmarPeligroAsync("¿Desea quitar esta cuenta bancaria?"))
        {
            return;
        }

        // Las cuentas sin id aun no llegaron al API: basta retirarlas del modelo.
        if (cuenta.IdCuenta == 0 || _esNuevo)
        {
            _edicion.CuentasBancariasProveedors.Remove(cuenta);
            return;
        }

        if (await Respuestas.CorrectaAsync(await Api.EliminarCuenta(cuenta.IdCuenta), "eliminar la cuenta bancaria"))
        {
            _edicion.CuentasBancariasProveedors.Remove(cuenta);
            Dialogos.Exito("Cuenta bancaria eliminada.");
        }
    }

    private static CuentaBancariaProveedorDTO NuevaCuenta() => new()
    {
        CodMoneda = 1,
        MonedaNombre = "COLON",
        Estado = 1
    };
}
