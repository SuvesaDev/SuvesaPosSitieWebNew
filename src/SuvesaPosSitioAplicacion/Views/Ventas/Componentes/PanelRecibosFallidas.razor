@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.DTOs.Cobros
@using SuvesaPosSitioAplicacion.Helpers
@using SuvesaPosSitioAplicacion.Services
@using Havit.Blazor.Components.Web.Bootstrap
@inject IConsultaCobros Api
@inject IAbonoCobrarPreventas Emision
@inject IVentaOrquestada VentaOrquestada
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IJSRuntime JS

@* SANEAMIENTO Fase 8.2 — panel reutilizable: recibos de cobro emitidos y
   operaciones fallidas (comprobantes rechazados con cobro local).
   Con Vista=null muestra sus propias pestañas; con Vista="recibos"/"fallidas"
   se integra como una pestaña del "Cobrar" unificado. *@

@if (Vista is null)
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_tab == "recibos" ? "active" : null)" @onclick='() => Cambiar("recibos")'>Recibos emitidos</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tab == "fallidas" ? "active" : null)" @onclick='() => Cambiar("fallidas")'>
                Operaciones fallidas
                @if (_fallidas.Count > 0)
                {
                    <span class="badge text-bg-danger ms-1">@_fallidas.Count</span>
                }
            </button>
        </li>
    </ul>
}

@if (VistaEfectiva == "recibos")
{
    <div class="card mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-6 col-md-2"><label class="form-label small">Desde</label><input type="date" class="form-control form-control-sm" @bind="_desde" /></div>
            <div class="col-6 col-md-2"><label class="form-label small">Hasta</label><input type="date" class="form-control form-control-sm" @bind="_hasta" /></div>
            <div class="col-6 col-md-2"><label class="form-label small">N.º recibo</label><input type="number" class="form-control form-control-sm" @bind="_numeroRecibo" /></div>
            <div class="col-6 col-md-2"><label class="form-label small">Apertura</label><input type="number" class="form-control form-control-sm" @bind="_numApertura" /></div>
            <div class="col-6 col-md-2">
                <label class="form-label small">Estado</label>
                <select class="form-select form-select-sm" @bind="_estado">
                    <option value="0">Todos</option><option value="1">Confirmado</option><option value="2">Anulado</option>
                </select>
            </div>
            <div class="col-auto"><button class="btn btn-sm btn-primary" @onclick="CargarRecibos" disabled="@_cargando">Buscar</button></div>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
    }
    else if (_recibos.Count == 0)
    {
        <div class="alert alert-light border">Sin recibos para el filtro.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>Recibo</th><th>Fecha</th><th>Cliente</th>
                        <th class="text-center">Apert.</th><th class="text-center">Facturas</th>
                        <th class="text-end">Total</th><th class="text-end">Vuelto</th>
                        <th>Formas de pago</th><th class="text-center">Estado</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _recibos)
                    {
                        <tr class="@(r.Estado == 2 ? "text-muted" : "")">
                            <td><code>@r.NumeroFormateado</code></td>
                            <td class="small">@r.FechaUtc.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                            <td>@(r.NombreCliente ?? $"Cliente {r.IdCliente}")</td>
                            <td class="text-center">@r.NumApertura</td>
                            <td class="text-center">@r.CantidadFacturas</td>
                            <td class="text-end seepos-importe">@Formato.Importe(r.Total)</td>
                            <td class="text-end seepos-importe">@Formato.Importe(r.Vuelto)</td>
                            <td class="small">@r.FormasPagoResumen</td>
                            <td class="text-center"><span class="badge @(r.Estado == 1 ? "text-bg-success" : "text-bg-secondary")">@r.EstadoNombre</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-link p-0 me-2" @onclick="() => VerDetalle(r)">Detalle</button>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ImprimirRecibo(r.Id)">PDF</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    @if (_cargando)
    {
        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
    }
    else if (_fallidas.Count == 0)
    {
        <div class="alert alert-success border">No hay comprobantes rechazados pendientes de resolver.</div>
    }
    else
    {
        <div class="alert alert-warning">
            Estos comprobantes fueron <strong>rechazados por Hacienda</strong>. El cobro local
            <strong>no se borra</strong> (D10): corrija y reenvíe, o genere una NC sin ruta fiscal y recree la factura.
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Comprobante</th><th>Consecutivo</th><th>Cliente</th>
                        <th class="text-end">Monto</th><th class="text-center">Cobro local</th>
                        <th class="text-center">Intentos</th><th>Causa</th><th>Acción sugerida</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _fallidas)
                    {
                        <tr>
                            <td>
                                <span class="badge text-bg-light">@f.TipoComprobante</span>
                                <div class="small text-muted text-truncate" style="max-width:12rem" title="@f.Clave">@f.Clave</div>
                                <div class="small">@f.FechaActualizacionUtc.ToLocalTime().ToString("dd/MM/yy HH:mm")</div>
                            </td>
                            <td class="small"><code>@(f.ConsecutivoMh ?? "—")</code><br />@(f.NumFactura is { } n ? $"N.º {n:0}" : "")</td>
                            <td>@(f.NombreCliente ?? (f.IdCliente is { } c ? $"Cliente {c}" : "—"))</td>
                            <td class="text-end seepos-importe">@Formato.Importe(f.MontoFactura)</td>
                            <td class="text-center">
                                @if (f.TieneCobroLocal)
                                {
                                    <span class="badge text-bg-warning">@Formato.Importe(f.MontoCobradoLocal)</span>
                                    <div class="small text-muted">Recibo(s): @string.Join(", ", f.IdsCobro)</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">@f.IntentosEnvio</td>
                            <td class="small">@(f.CausaError ?? "—")</td>
                            <td class="small">@f.AccionSugerida</td>
                            <td class="text-nowrap">
                                @if (f.OrigenId is { } idv && string.Equals(f.OrigenTipo, "Venta", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn btn-sm btn-outline-primary mb-1 d-block w-100" disabled="@_procesando" @onclick="() => Reenviar(f)">Reenviar</button>
                                    <button class="btn btn-sm btn-outline-danger d-block w-100" disabled="@_procesando" @onclick="() => AnularYRecrear(f)">NC interna</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<HxModal @ref="_modalDetalle" Title="Detalle del recibo" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_detalle is not null)
        {
            <div class="row mb-3">
                <div class="col-md-6"><span class="text-secondary small">Recibo</span><div><code>@_detalle.NumeroFormateado</code></div></div>
                <div class="col-md-6"><span class="text-secondary small">Cliente</span><div>@(_detalle.NombreCliente ?? $"Cliente {_detalle.IdCliente}")</div></div>
                <div class="col-md-6"><span class="text-secondary small">Fecha</span><div>@_detalle.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                <div class="col-md-6"><span class="text-secondary small">Cajero</span><div>@_detalle.Usuario</div></div>
                @if (_detalle.Estado == 2)
                {
                    <div class="col-12 mt-2"><div class="alert alert-secondary mb-0 py-2">
                        Anulado @(_detalle.FechaAnulacionUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) — @_detalle.MotivoAnulacion
                    </div></div>
                }
            </div>

            <h6 class="text-uppercase text-secondary small">Facturas aplicadas</h6>
            <table class="table table-sm">
                <thead><tr><th>Factura</th><th>Consecutivo</th><th class="text-end">Aplicado</th></tr></thead>
                <tbody>
                    @foreach (var a in _detalle.Aplicaciones)
                    {
                        <tr><td>@a.NumFactura.ToString("0")</td><td><code>@(a.ConsecutivoMh ?? "—")</code></td><td class="text-end">@Formato.Importe(a.MontoAplicado)</td></tr>
                    }
                </tbody>
            </table>

            <h6 class="text-uppercase text-secondary small mt-3">Formas de pago</h6>
            <table class="table table-sm">
                <thead><tr><th>Forma</th><th>Referencia</th><th class="text-end">Recibido</th><th class="text-end">Aplicado</th><th class="text-end">Vuelto</th></tr></thead>
                <tbody>
                    @foreach (var p in _detalle.FormasPago)
                    {
                        <tr>
                            <td>@p.CodigoFormaPago</td><td class="small">@(p.Referencia ?? "—")</td>
                            <td class="text-end">@Formato.Importe(p.MontoRecibido)</td>
                            <td class="text-end">@Formato.Importe(p.MontoAplicado)</td>
                            <td class="text-end">@Formato.Importe(p.Vuelto)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-primary" @onclick="() => ImprimirRecibo(_detalle!.Id)">Imprimir PDF</button>
        <button class="btn btn-outline-secondary" @onclick="() => _modalDetalle.HideAsync()">Cerrar</button>
    </FooterTemplate>
</HxModal>
