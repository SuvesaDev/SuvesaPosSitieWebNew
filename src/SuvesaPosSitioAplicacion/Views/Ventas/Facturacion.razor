            _lineas.Clear();
            foreach (var l in _conteoPref.Lineas.Where(x => x.Vendido > 0.000001))
            {
                var ri = await Inventario.Uno(l.IdArticulo);
                if (!ri.EsCorrecta || ri.Responses is null) continue;

                if (l.IdStockLote is > 0)
