    /// <summary>
    /// Fase 1 — carga las formas de pago del cliente y la apertura de caja del cajero
    /// para el cobro de contado. Si no hay caja abierta, deja el aviso que bloquea la
    /// emisión (el API también lo rechaza).
    /// </summary>
    private async Task CargarCobroContadoAsync()
    {
        _formasPagoContado = new();
        _montosContado.Clear();
        _referenciasContado.Clear();
        _numAperturaContado = null;
        _avisoCajaContado = null;
        if (!RequiereAperturaContado || _cliente is null) return;

        var cajeros = await Respuestas.DatoAsync(await CajaApi.CajerosConCajaAbierta(), "consultar la caja abierta");
        var cajeroNombre = _usuarioVenta?.Nombre ?? Sesion.Usuario;
        var cajero = cajeros?.FirstOrDefault(c => string.Equals(c.Nombre, cajeroNombre, StringComparison.OrdinalIgnoreCase))
                     ?? (cajeros?.Count == 1 ? cajeros.First() : null);
        if (cajero is null || cajero.IdApertura <= 0)
        {
            _avisoCajaContado = "No hay una caja abierta para este cajero; no se puede facturar de contado hasta abrir caja.";
            return;
        }
        _numAperturaContado = cajero.IdApertura;

        _formasPagoContado = (await Respuestas.DatoAsync(await CobrosApi.FormasPago(_cliente.Identificacion), "consultar las formas de pago"))?.ToList() ?? new();
        foreach (var forma in _formasPagoContado)
            if (forma.Codigo is not null) _montosContado[forma.Codigo] = 0;
    }

