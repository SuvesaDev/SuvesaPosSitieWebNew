                        new List<DTOs.Lotes.LoteConsumoVenta> { new() { IdStockLote = l.IdStockLote.Value, Cantidad = l.Vendido } },
                        (decimal)l.Vendido);
                else
                    AgregarArticulo(ri.Responses, null, (decimal)l.Vendido);

                var linea = _lineas.LastOrDefault();
                if (linea is not null && l.PrecioUnitario > 0) { linea.Precio = (decimal)l.PrecioUnitario; linea.Recalcular(); }
            }
            RecalcularTodo();
        }
        finally { _cargandoPref = false; }
    }

    private async Task<FiltranClienteDTO?> BuscarClienteConsignacion(long idCliente, string? nombre)
