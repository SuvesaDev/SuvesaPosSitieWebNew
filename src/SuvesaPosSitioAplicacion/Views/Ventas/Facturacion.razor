    private async Task CargarConteoPrefactura()
    {
        _cargandoPref = true;
        try
        {
            var r = await ConsignacionApi.ConteoAsync(ConteoId);
            if (r.Status != DTOs.Generated.ResponseStatus._0 || r.Responses is null)
            {
                await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo cargar el conteo.");
