    private bool RequiereAperturaContado => !_esCredito && !EsPrefacturaConsignacion && !EsConsignacion;
    // W4: el reparto del cobro sale de PreparacionPagoVenta (misma lógica que Cobrar).
    private PreparacionPagoVenta.Reparto RepartoContado => PreparacionPagoVenta.Calcular(
        (decimal)_totales.Total,
