    private async Task BuscarClientes()
        => _clientesEncontrados = (await Respuestas.DatoAsync(await Clientes.Buscar(_textoCliente), "buscar clientes"))?.Where(c => !c.Anulado && !c.Fallecido).ToList() ?? new();
    private async Task BuscarClienteConEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarClientes(); }

    // Busca sola al escribir, igual que el buscador de articulos: el usuario no
    // deberia tener que acordarse de apretar "Buscar" para que esto funcione.
    // Espera a que pare de escribir para no llamar al API en cada tecla.
    private static readonly TimeSpan EsperaCliente = TimeSpan.FromMilliseconds(400);
    private CancellationTokenSource? _pendienteCliente;

    private async Task AlEscribirCliente(ChangeEventArgs e)
    {
        _textoCliente = e.Value?.ToString() ?? string.Empty;

        _pendienteCliente?.Cancel();

        if (_textoCliente.Trim().Length < 2)
        {
            _clientesEncontrados.Clear();
            return;
        }

        _pendienteCliente = new CancellationTokenSource();
        var token = _pendienteCliente.Token;

        try
        {
            await Task.Delay(EsperaCliente, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await BuscarClientes();
    }
    private async Task ElegirCliente(FiltranClienteDTO cliente)
    {
        _cliente = cliente;
        _textoCliente = cliente.Nombre ?? cliente.Cedula ?? string.Empty;
        _clientesEncontrados.Clear();
        if (_tipoFactura != 0 && !TiposDisponibles.Any(t => t.Codigo == _tipoFactura)) _tipoFactura = 0;
        RecalcularTodo();

        _bonificacionesCliente = new List<ClienteBonificacionConfiguracionDTO>();
        if (cliente.TieneBonificacion)
        {
            _cargandoBonificacionCliente = true;
            _bonificacionesCliente = (await Respuestas.DatoAsync(
                await ClienteBonificacion.ObtenerPorCliente(cliente.Cedula, cliente.Identificacion), "consultar la bonificación del cliente"))
                ?.ToList() ?? new List<ClienteBonificacionConfiguracionDTO>();
            _cargandoBonificacionCliente = false;
        }
    }

    private void QuitarCliente() { _cliente = null; _tipoFactura = 0; _bonificacionesCliente.Clear(); }

    private async Task AbrirCorreos()
    {
        if (_cliente is null) return;
        _correos.Clear();
        _correoNuevo = string.Empty;
        _correoEditandoIndice = null;
        _cargandoCorreos = true;
        await _modalCorreos.ShowAsync();
        // El sistema actual solo carga la lista cuando el API no devuelve un
        // "mensaje" junto con los correos; si viene un mensaje, se deja la lista
        // vacia sin mostrar error (igual que hace la ventana actual).
        var respuesta = await Clientes.ObtenerCorreosComprobante(_cliente.Identificacion);
        if (respuesta.EsCorrecta && respuesta.Responses?.Mensaje is null)
        {
            _correos.AddRange((respuesta.Responses?.Correos ?? Array.Empty<Correos>())
                .Select(c => c.Correo)
                .Where(c => !string.IsNullOrWhiteSpace(c))!);
        }
        _cargandoCorreos = false;
    }

    private async Task AgregarCorreoConEnter(KeyboardEventArgs e) { if (e.Key == "Enter") { AgregarOEditarCorreo(); await Task.CompletedTask; } }

    private void AgregarOEditarCorreo()
    {
        var correo = _correoNuevo.Trim();
        if (correo.Length == 0 || !PatronCorreo.IsMatch(correo)) return;

        if (_correoEditandoIndice is int indice)
        {
            _correos[indice] = correo;
            _correoEditandoIndice = null;
        }
        else if (!_correos.Contains(correo, StringComparer.OrdinalIgnoreCase))
        {
            _correos.Add(correo);
        }
        _correoNuevo = string.Empty;
    }

    private void EditarCorreo(int indice) { _correoEditandoIndice = indice; _correoNuevo = _correos[indice]; }
    private void QuitarCorreo(int indice)
    {
        _correos.RemoveAt(indice);
        if (_correoEditandoIndice == indice) { _correoEditandoIndice = null; _correoNuevo = string.Empty; }
    }
    private void LimpiarCorreos() { _correos.Clear(); _correoEditandoIndice = null; _correoNuevo = string.Empty; }

    private async Task GuardarCorreos()
    {
        if (_cliente is null) return;
        if (!await Dialogos.ConfirmarAsync("¿Desea agregar estos correos?")) return;
        _guardandoCorreos = true;
        var correos = new CorreosComprobantes
        {
            IdCliente = _cliente.Identificacion,
            Correos = _correos.Select(c => new Correos { Correo = c }).ToList()
        };
        var r = await Clientes.ActualizarCorreosComprobante(correos);
        _guardandoCorreos = false;
        if (await Respuestas.CorrectaAsync(r, "guardar los correos del comprobante"))
        {
            Dialogos.Exito("Correos del comprobante actualizados.");
            await _modalCorreos.HideAsync();
        }
    }

    private Task PrepararArticulo(InventarioDTO articulo) => PrepararArticulo(articulo, 1);
    private async Task PrepararArticulo(InventarioDTO articulo, decimal cantidad)
    {
        if (_cliente is null) { await Dialogos.ErrorAsync("Seleccione primero el cliente."); return; }
        var completo = await Respuestas.DatoAsync(await Inventario.Uno(articulo.Codigo), "consultar el artículo");
        if (completo is null) return;

        // §4.3.b — si el artículo es bonificable, resolver la bonificación en vez de agregar la línea directa.
        if (completo.Bonificado && await IniciarBonificacion(completo, cantidad)) return;

        _articuloPendiente = completo;
        _cantidadArticuloPendiente = cantidad;
        if (completo.Lote)
        {
            _repartoConsumo.Clear();
            _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(completo.Codigo), "consultar lotes"))?.ToList() ?? new();
            await _modalLotes.ShowAsync();
            return;
        }

        // Follow-up — guard de existencia negativa para líneas SIN lote (las de lote
        // ya se topan en el reparto). El API igual valida; esto es aviso temprano.
        if (!Sesion.PermitirExistenciaNegativa)
        {
            var ex = await Lotes2.ExistenciaConsolidadaAsync(completo.Codigo);
            if (ex.Status == DTOs.Generated.ResponseStatus._0 && ex.Responses is { } consol)
            {
                var yaEnDetalle = _lineas.Where(l => l.Articulo.Codigo == completo.Codigo && l.Lotes is null && !l.EsBonificacion).Sum(l => l.Cantidad);
                if ((decimal)consol.ExistenciaTotal - yaEnDetalle - cantidad < 0)
                {
                    await Dialogos.ErrorAsync($"No hay existencia suficiente de {completo.Descripcion} (disponible {consol.ExistenciaTotal:N2}).");
                    return;
                }
            }
        }
        AgregarArticulo(completo, null, cantidad);
    }

    private double RepartoTotal => _repartoConsumo.Values.Sum();

    private void SetReparto(StockLoteDTO lote, string? valor)
    {
        if (double.TryParse(valor, out var v) && v > 0)
            _repartoConsumo[lote.Id] = Math.Min(v, lote.Cantidad);
        else
            _repartoConsumo.Remove(lote.Id);
    }

    private async Task ConfirmarReparto()
    {
        if (_articuloPendiente is null) { await _modalLotes.HideAsync(); return; }
        var consumos = _repartoConsumo.Where(kv => kv.Value > 0)
            .Select(kv => new DTOs.Lotes.LoteConsumoVenta { IdStockLote = kv.Key, Cantidad = kv.Value }).ToList();
        AgregarArticuloConLotes(_articuloPendiente, consumos, _cantidadArticuloPendiente);
        await _modalLotes.HideAsync();
        await AbrirSiguienteLoteCatalogo();
    }
    private async Task AbrirSiguienteLoteCatalogo()
    {
        if (_colaLotesCatalogo.Count == 0) return;
        var pendiente = _colaLotesCatalogo.Dequeue();
        _articuloPendiente = pendiente.Articulo;
        _cantidadArticuloPendiente = pendiente.Cantidad;
        _repartoConsumo.Clear();
        _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(pendiente.Articulo.Codigo), "consultar lotes"))?.ToList() ?? new();
        await _modalLotes.ShowAsync();
    }
    // ======================= §4.3 — flujo de bonificación =======================

    /// <returns>true si tomó el control (abrió un modal); false si no aplica y se debe agregar normal.</returns>
    private async Task<bool> IniciarBonificacion(InventarioDTO articulo, decimal cantidad)
    {
        // §5.9 — ¿el cliente tiene una asignación para justo este artículo? Su tipo
        // manda sobre lo que tenga configurado el artículo.
        var asignacion = _bonificacionesCliente.FirstOrDefault(b => b.IdArticulo == articulo.Codigo);
        if (asignacion is not null)
        {
            var cfgCliente = ConfigBonificacion(asignacion.IdConfiguracionBonificacion);
            if (cfgCliente is not null)
            {
                await AbrirMezcla(articulo, cfgCliente, origenCliente: true, cantidadInicial: (int)Math.Max(1, cantidad));
                return true;
            }
        }

        // Cualquier otro artículo: preguntar si se usa la bonificación propia del artículo.
        var tipos = (await Respuestas.DatoAsync(await ArticuloBonificacion.ObtenerPorArticulo(articulo.Codigo), "consultar la bonificación del artículo"))?.ToList()
                    ?? new List<ArticuloBonificacionConfiguracion>();
        _tiposDelArticuloPendiente = tipos
            .Select(t => ConfigBonificacion(t.IdConfiguracionBonificacion))
            .Where(c => c is not null).Select(c => c!).ToList();

        if (_tiposDelArticuloPendiente.Count == 0) return false;   // marcado bonificable pero sin tipos -> línea normal

        _articuloBonificacionPendiente = articulo;
        _cantidadArticuloPendiente = cantidad;
        _tipoBonificacionElegido = _tiposDelArticuloPendiente.Count == 1 ? _tiposDelArticuloPendiente[0].IdConfiguracionBonificacion : 0;
        await _modalBonificacionArticulo.ShowAsync();
        return true;
    }

    private async Task ConfirmarBonificacionArticulo()
    {
        if (_tipoBonificacionElegido <= 0) { await Dialogos.ErrorAsync("Seleccione el tipo de bonificación."); return; }
        var cfg = ConfigBonificacion(_tipoBonificacionElegido);
        if (cfg is null || _articuloBonificacionPendiente is null) return;
        await _modalBonificacionArticulo.HideAsync();
        await AbrirMezcla(_articuloBonificacionPendiente, cfg, origenCliente: false, cantidadInicial: (int)Math.Max(1, _cantidadArticuloPendiente));
    }

    private async Task OmitirBonificacionArticulo()
    {
        await _modalBonificacionArticulo.HideAsync();
        var art = _articuloBonificacionPendiente;
        _articuloBonificacionPendiente = null;
        if (art is null) return;

        if (art.Lote)
        {
            _articuloPendiente = art;
            _repartoConsumo.Clear();
            _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(art.Codigo), "consultar lotes"))?.ToList() ?? new();
            await _modalLotes.ShowAsync();
        }
        else
        {
            AgregarArticulo(art, null, _cantidadArticuloPendiente);
        }
    }

    private async Task AbrirMezcla(InventarioDTO principal, ConfiguracionBonificacion cfg, bool origenCliente, int cantidadInicial)
    {
        _configMezclaActiva = cfg;
        _mezclaOrigenCliente = origenCliente;
        _articuloBonificacionPendiente = principal;

        var mezcla = (await Respuestas.DatoAsync(await Relacionados.BuscarBonificacion(principal.Codigo), "consultar los productos de bonificación"))?.ToList()
                     ?? new List<ArticulosRelacionadosDTO>();

        _itemsMezcla = new List<ItemMezcla>
        {
            new() { Codigo = principal.Codigo, Descripcion = principal.Descripcion ?? principal.Codigo.ToString(),
                    PrecioUnit = PrecioCliente(principal), PorcentajeImpuesto = Formato.AImporte(principal.IVenta),
                    Cantidad = Math.Min(cantidadInicial, cfg.CantidadVenta) }
        };
        foreach (var r in mezcla.Where(r => r.Codigo != principal.Codigo))
        {
            _itemsMezcla.Add(new ItemMezcla
            {
                Codigo = r.Codigo,
                Descripcion = r.Descripcion ?? r.Codigo.ToString(),
                // Precio de referencia cacheado del API; si no viene, se resuelve al aplicar.
                PrecioUnit = Formato.AImporte(r.Precio ?? 0),
                PorcentajeImpuesto = Formato.AImporte(principal.IVenta),
                Cantidad = 0
            });
        }

        await _modalMezclaBonificacion.ShowAsync();
    }

    private int TotalMezcla => _itemsMezcla.Sum(i => Math.Max(0, i.Cantidad));

    private async Task AplicarGrupoBonificacion()
    {
        if (_configMezclaActiva is null || _articuloBonificacionPendiente is null || _aplicandoBonificacion) return;
        _aplicandoBonificacion = true;

        // 1. Resolver el InventarioDTO completo de cada artículo usado (precio vigente,
        //    no el cacheado de ArticulosRelacionadosDTO que puede venir 0/null).
        var articulosCache = new Dictionary<long, InventarioDTO> { [_articuloBonificacionPendiente.Codigo] = _articuloBonificacionPendiente };
        var usados = new List<BonificacionCalculo.ArticuloUsado>();
        foreach (var i in _itemsMezcla.Where(i => i.Cantidad > 0))
        {
            if (!articulosCache.TryGetValue(i.Codigo, out var art))
            {
                art = await Respuestas.DatoAsync(await Inventario.Uno(i.Codigo), "consultar el artículo de la mezcla");
                if (art is null) { _aplicandoBonificacion = false; await Dialogos.ErrorAsync($"No se pudo cargar el artículo {i.Codigo}."); return; }
                articulosCache[i.Codigo] = art;
            }
            usados.Add(new BonificacionCalculo.ArticuloUsado(i.Codigo, art.Descripcion ?? i.Descripcion, PrecioCliente(art), Formato.AImporte(art.IVenta), i.Cantidad));
        }

        var resultado = BonificacionCalculo.ResolverGrupo(_configMezclaActiva.CantidadVenta, _configMezclaActiva.CantidadBonificable, usados);
        if (!resultado.Ok) { _aplicandoBonificacion = false; await Dialogos.ErrorAsync(resultado.Error!); return; }

        var idGrupo = _siguienteIdGrupo++;
        var idCfg = _configMezclaActiva.IdConfiguracionBonificacion;
        bool principalMarcada = false;

        foreach (var lg in resultado.Lineas)
        {
            var art = articulosCache[lg.Codigo];

            var linea = new LineaVenta
            {
                Articulo = art,
                Cantidad = lg.Cantidad,
                Precio = lg.EsBonificacion ? 0m : lg.PrecioUnit,
                Descuento = 0m,
                MaxDescuento = 0m,
                Impuesto = lg.PorcentajeImpuesto,
                IdLote = 0,
                Lote = null,
                IdGrupoBonificacion = idGrupo,
                IdConfiguracionBonificacion = idCfg,
                EsBonificacion = lg.EsBonificacion,
                PrecioReferencia = lg.PrecioUnit,
                EsLineaPrincipal = !principalMarcada
            };
            principalMarcada = true;
            linea.Recalcular();
            _lineas.Add(linea);
        }

        RecalcularTodo();
        _aplicandoBonificacion = false;
        _articuloBonificacionPendiente = null;
        _configMezclaActiva = null;
        _itemsMezcla = new();
        await _modalMezclaBonificacion.HideAsync();
    }

    private async Task CancelarMezcla()
    {
        _articuloBonificacionPendiente = null;
        _configMezclaActiva = null;
        _itemsMezcla = new();
        await _modalMezclaBonificacion.HideAsync();
    }

    private void AgregarArticulo(InventarioDTO articulo, StockLoteDTO? lote, decimal cantidad = 1)
    {
        var existente = _lineas.FirstOrDefault(l => l.Articulo.Codigo == articulo.Codigo && l.IdLote == (lote?.Id ?? 0) && l.Lotes is null);
        if (existente is not null) { existente.Cantidad += cantidad; existente.Recalcular(); RecalcularTodo(); return; }
        var precio = PrecioCliente(articulo);
        var linea = new LineaVenta { Articulo = articulo, Cantidad = cantidad, Precio = precio, Impuesto = Formato.AImporte(articulo.IVenta), Descuento = Math.Min(Formato.AImporte(_cliente?.DescuentoEspecial ?? 0), Formato.AImporte(articulo.Max_Descuento)), MaxDescuento = Formato.AImporte(articulo.Max_Descuento), IdLote = lote?.Id ?? 0, Lote = lote?.Lote };
        linea.Recalcular(); _lineas.Add(linea); RecalcularTodo();
    }

    /// <summary>§5 — agrega una línea con reparto multi-lote.</summary>
    private void AgregarArticuloConLotes(InventarioDTO articulo, List<DTOs.Lotes.LoteConsumoVenta> lotes, decimal cantidad)
    {
        if (lotes.Count == 0) { AgregarArticulo(articulo, (StockLoteDTO?)null, cantidad); return; }
        var precio = PrecioCliente(articulo);
        var unico = lotes.Count == 1 ? _lotesPendientes.FirstOrDefault(l => l.Id == lotes[0].IdStockLote) : null;
        var linea = new LineaVenta
        {
            Articulo = articulo, Cantidad = cantidad, Precio = precio,
            Impuesto = Formato.AImporte(articulo.IVenta),
            Descuento = Math.Min(Formato.AImporte(_cliente?.DescuentoEspecial ?? 0), Formato.AImporte(articulo.Max_Descuento)),
            MaxDescuento = Formato.AImporte(articulo.Max_Descuento),
            IdLote = unico?.Id ?? 0,
            Lote = unico?.Lote ?? (lotes.Count > 1 ? $"{lotes.Count} lotes" : null),
            Lotes = lotes
        };
        linea.Recalcular(); _lineas.Add(linea); RecalcularTodo();
    }
    private decimal PrecioCliente(InventarioDTO articulo) => (_cliente?.Tipoprecio ?? 1) switch { 2 when articulo.Precio_B > 0 => Formato.AImporte(articulo.Precio_B), 3 when articulo.Precio_C > 0 => Formato.AImporte(articulo.Precio_C), 4 when articulo.Precio_D > 0 => Formato.AImporte(articulo.Precio_D), _ => articulo.Promo_Activa && articulo.Promo_Inicio <= DateTime.Today && articulo.Promo_Finaliza >= DateTime.Today ? Formato.AImporte(articulo.Precio_Promo) : Formato.AImporte(articulo.Precio_A) };
    private void RecalcularLinea(LineaVenta linea)
    {
        // Las líneas de un grupo de bonificación no admiten editar precio ni descuento.
        if (linea.EsDeGrupo) { linea.Descuento = 0m; if (linea.EsBonificacion) linea.Precio = 0m; }
        linea.Cantidad = Math.Max(1, linea.Cantidad);
        linea.Descuento = Math.Clamp(linea.Descuento, 0, linea.MaxDescuento);
        linea.Recalcular();
        RecalcularTodo();
    }

    private void QuitarLinea(LineaVenta linea)
    {
        // §4.3.g — solo la línea principal se puede eliminar; borra en cascada su grupo.
        if (linea.EsDeGrupo)
        {
            if (!linea.EsLineaPrincipal) return;
            _lineas.RemoveAll(l => l.IdGrupoBonificacion == linea.IdGrupoBonificacion);
        }
        else
        {
            _lineas.Remove(linea);
        }
        RecalcularTodo();
    }
    private void RecalcularTodo() => _totales = CalculoDocumento.Totales(_lineas.Select(l => l.Calculo));

    private async Task Emitir()
    {
        if (!_ventaDesbloqueada) { await AbrirDesbloqueo(); return; }
        if (_cliente is null || _tipoFactura == 0 || _moneda == 0 || _lineas.Count == 0) { await Dialogos.ErrorAsync("Seleccione cliente, tipo de factura, moneda y al menos un artículo."); return; }
        if (_idEmpresa <= 0) { await Dialogos.ErrorAsync("Seleccione una empresa para registrar la facturación."); return; }
        if (!EsPrefacturaConsignacion)
        {
            // En la prefactura de consignación no se validan crédito / morosidad / orden
            // de compra: la condición (contado/crédito) se elige al facturar.
            if (_cliente.Cliente_Moroso && !_cliente.Sinrestriccion) { await Dialogos.ErrorAsync("El cliente tiene restricción de morosidad."); return; }
            if (_cliente.OrdenCompra && string.IsNullOrWhiteSpace(_ordenCompra)) { await Dialogos.ErrorAsync("El cliente requiere una orden de compra."); return; }
            var tipoDoc = _tipos.First(t => t.Codigo == _tipoFactura);
            if (tipoDoc.Credito && !_cliente.Abierto && !_cliente.Sinrestriccion) { await Dialogos.ErrorAsync("El cliente no tiene crédito habilitado."); return; }
            if (_lineas.Any(l => l.Articulo.SoloContado) && tipoDoc.Credito) { await Dialogos.ErrorAsync("La factura contiene artículos solo de contado."); return; }
            if (_lineas.Any(l => l.Articulo.SoloConExistencia && l.Cantidad > Formato.AImporte(l.Articulo.Existencia))) { await Dialogos.ErrorAsync("Una línea supera la existencia disponible."); return; }
        }
        if (!await Dialogos.ConfirmarAsync(EsPrefacturaConsignacion ? "Se generará la prefactura de consignación desde el conteo. ¿Desea continuar?" : EsConsignacion ? "Se registrará la consignación. ¿Desea continuar?" : "Se emitirá la factura y se afectará el inventario. ¿Desea continuar?")) return;
        _guardando = true;
        var empresa = _empresas.FirstOrDefault(e => e.Id == _idEmpresa);
        var factura = new FacturaDTO { Tipo = _tipoFactura, CodCliente = _cliente.Cedula, NumeroCedula = _cliente.Cedula, NombreCliente = _cliente.Nombre, Telefono = _cliente.Telefono_01, EmailCliente = _cliente.CorreoComprobante ?? _cliente.E_Mail, Observaciones = _observaciones, Orden = _ordenCompra, CodMoneda = _moneda.ToString(), Agente = _sinAgente, Cod_agente = !_sinAgente && _codAgente > 0 ? _codAgente : null, Cajero = _usuarioVenta?.Nombre ?? Sesion.Usuario, IdSucursal = Sesion.IdSucursal, IdEmpresa = _idEmpresa, Empresa = empresa?.Nombre, Preventa = EsPrefacturaConsignacion, EsConsignacion = EsConsignacion, SubTotal = (float)_totales.SubTotal, Descuento = (float)_totales.Descuento, ImpVenta = (float)_totales.Impuesto, Total = (float)_totales.Total, Detalle = _lineas.Select(l => new FacturaDetallesDTO { CodArticulo = l.Articulo.Codigo, CodFxArticulo = l.Articulo.Codigo, Descripcion = l.Articulo.Descripcion, Cantidad = (float)l.Cantidad, PrecioUnit = (float)l.Precio, Descuento = (float)l.Descuento, MontoDescuento = (float)l.Calculo.MontoDescuento, Impuesto = (long)l.Impuesto, MontoImpuesto = (float)l.Calculo.MontoImpuesto, SubtotalGravado = l.Impuesto > 0 ? (float)l.Calculo.SubtotalGravado : 0, SubTotalExcento = l.Impuesto == 0 ? (float)l.Calculo.SubTotal : 0, SubTotal = (float)l.Calculo.SubTotal, IdBodega = l.Articulo.Id_Bodega, Lote = l.IdLote, NumeroLote = l.Lote, Lotes = l.Lotes, EsBonificacion = l.EsBonificacion, IdGrupoBonificacion = l.IdGrupoBonificacion, IdConfiguracionBonificacion = l.IdConfiguracionBonificacion, EsLineaPrincipalBonificacion = l.EsDeGrupo ? l.EsLineaPrincipal : (bool?)null }).ToList() };
        if (EsPrefacturaConsignacion)
        {
            var rp = await ConsignacionApi.GenerarPrefacturaAsync(new GenerarPrefacturaConsignacion { IdConteo = ConteoId, Factura = factura });
            _guardando = false;
            if (rp.Status == DTOs.Generated.ResponseStatus._0 && rp.Responses is not null)
            {
                Dialogos.Exito($"Prefactura de consignación #{rp.Responses.Id} generada.");
                Navegacion.NavigateTo($"/consignment/prebill?id={rp.Responses.Id}");
            }
            else await Dialogos.ErrorAsync(rp.CurrentException ?? rp.ValidationErrors?.FirstOrDefault() ?? "No se pudo generar la prefactura.");
            return;
        }
        var r = await Api.Crear(factura); _guardando = false;
        if (await Respuestas.CorrectaAsync(r, EsConsignacion ? "registrar la consignación" : "emitir la factura")) { Dialogos.Exito(EsConsignacion ? "Consignación registrada correctamente." : "Factura emitida correctamente."); Limpiar(); }
    }
    private void Limpiar() { _cliente = null; _clientesEncontrados.Clear(); _textoCliente = _observaciones = _ordenCompra = string.Empty; _tipoFactura = 0; _moneda = _monedas.FirstOrDefault()?.CodMoneda ?? 0; _sinAgente = false; _codAgente = 0; _lineas.Clear(); _bonificacionesCliente.Clear(); _siguienteIdGrupo = 1; RecalcularTodo(); }
}
