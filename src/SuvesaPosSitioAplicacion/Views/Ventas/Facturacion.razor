    // --- Prefactura de consignación desde un conteo (CONSIGNACION_WEB.md §6b) ---
    protected override async Task OnParametersSetAsync()
    {
        if (EsPrefacturaConsignacion && (_conteoPref is null || _conteoPref.Id != ConteoId))
            await CargarConteoPrefactura();
    }

    private async Task CargarConteoPrefactura()
    {
        _cargandoPref = true;
        try
        {
            var r = await ConsignacionApi.ConteoAsync(ConteoId);
            if (r.Status != DTOs.Generated.ResponseStatus._0 || r.Responses is null)
            {
                await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo cargar el conteo.");
                return;
            }
            _conteoPref = r.Responses;

            _cliente = await BuscarClienteConsignacion(_conteoPref.IdCliente, _conteoPref.NombreCliente);
            if (_cliente is null) { await Dialogos.ErrorAsync("No se encontró el cliente del conteo."); return; }
            await CargarActividadesCliente(_cliente);

            _lineas.Clear();
            foreach (var l in _conteoPref.Lineas.Where(x => x.Vendido > 0.000001))
            {
                var ri = await Inventario.Uno(l.IdArticulo);
                if (!ri.EsCorrecta || ri.Responses is null) continue;

                if (l.IdStockLote is > 0)
                    AgregarArticuloConLotes(ri.Responses,
                        new List<DTOs.Lotes.LoteConsumoVenta> { new() { IdStockLote = l.IdStockLote.Value, Cantidad = l.Vendido } },
                        (decimal)l.Vendido);
                else
                    AgregarArticulo(ri.Responses, null, (decimal)l.Vendido);

                var linea = _lineas.LastOrDefault();
                if (linea is not null && l.PrecioUnitario > 0) { linea.Precio = (decimal)l.PrecioUnitario; linea.Recalcular(); }
            }
            RecalcularTodo();
        }
        finally { _cargandoPref = false; }
    }

    private async Task<FiltranClienteDTO?> BuscarClienteConsignacion(long idCliente, string? nombre)
    {
        var r1 = await Clientes.Buscar(idCliente.ToString());
        var c = r1.EsCorrecta ? (r1.Responses ?? new List<FiltranClienteDTO>()).FirstOrDefault(x => x.Identificacion == idCliente) : null;
        if (c is not null || string.IsNullOrWhiteSpace(nombre)) return c;
        var r2 = await Clientes.Buscar(nombre);
        return r2.EsCorrecta ? (r2.Responses ?? new List<FiltranClienteDTO>()).FirstOrDefault(x => x.Identificacion == idCliente) : null;
    }

