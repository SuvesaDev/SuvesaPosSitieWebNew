@page "/initial/billing"
@page "/consignment/prebill/from/{ConteoId:long}"
@implements IDisposable
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.DTOs.Consignacion
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.DTOs.Lotes
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@using SuvesaPosSitioAplicacion.Views.Ventas.Componentes
@inject IFacturacion Api
@inject IConsignacionInvApiCliente ConsignacionApi
@inject IEmpresas Empresas
@inject IClientesConsulta Clientes
@inject IInventarioConsulta Inventario
@inject ILotesApiCliente Lotes2
@inject IImagenesArticulo Imagenes
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject NavigationManager Navegacion
@inject IClienteBonificacion ClienteBonificacion
@inject ICatalogoBonificacion CatalogoBonificacion
@inject IArticuloBonificacion ArticuloBonificacion
@inject IArticulosRelacionados Relacionados
@inject ICompras Compras
@inject IEmisoresFiscales EmisoresApi
@inject IPerfilesEmision PerfilesApi
@inject IComandosFacturacion Comandos
@inject ICobrosCredito CobrosCreditoApi
@inject ITipoCambio TipoCambioApi
@inject ICobros CobrosApi
@inject ICajaOperaciones CajaApi
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IAbonoCobrarPreventas Preventas

@* Port del flujo de Billing: cliente -> artículos/lotes -> totales -> emisión.
   Los cálculos se hacen en decimal en CalculoDocumento; el DTO se arma una única vez
   al confirmar, para evitar que encabezado y detalle queden desincronizados. *@

<AppPantalla Pantalla="@Titulo" Icono="bi-receipt" Subtitulo="Emisión de factura electrónica" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Limpiar">Nueva factura</button>
    </Acciones>
    <ChildContent>
        <AppDesbloqueoClave @ref="_bloqueo" Titulo="la venta" AlCambiar="AlDesbloquear" />
        <fieldset disabled="@(!_ventaDesbloqueada)" class="seepos-facturacion border-0 p-0 m-0">
        <div class="row g-3">
            <div class="col-12 col-lg-8">
                <div class="card h-100 seepos-facturacion-cabecera">
                                <div class="card-header"><strong>@(EsPrefacturaConsignacion ? "Prefactura de consignación" : EsConsignacion ? "Registro de consignación" : "Factura de venta")</strong></div>
                    <div class="card-body">
                        @if (EsPrefacturaConsignacion)
                        {
                            <div class="alert alert-info py-2">
                                Prefactura desde el <strong>conteo #@ConteoId</strong>@(_conteoPref is not null ? $" — {_conteoPref.NombreCliente}" : "").
                                Ajuste precios y bonificaciones; la condición (contado/crédito) se elige al facturar.
                                @if (_cargandoPref) { <span class="spinner-border spinner-border-sm ms-2"></span> }
                            </div>
                        }
                        <div class="row g-3">
                            <div class="col-12 col-md-5">
                                <label class="form-label">Buscar cliente</label>
                                <div class="input-group"><input class="form-control" placeholder="Cédula o nombre" value="@_textoCliente" @oninput="AlEscribirCliente" @onkeydown="BuscarClienteConEnter" /><button type="button" class="btn btn-outline-primary" @onclick="BuscarClientes">Buscar</button></div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Condición de venta</label>
                                <select class="form-select" @bind="EsCreditoTexto" @bind:after="AlCambiarCondicion">
                                    <option value="false">Contado</option>
                                    <option value="true">Crédito</option>
                                </select>
                                @if (_creditoAviso is not null)
                                {
                                    <div class="form-text text-danger">@_creditoAviso</div>
                                }
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Serie / documento a emitir</label>
                                <select class="form-select" @bind="_idPerfil" @bind:after="AlCambiarPerfil" disabled="@(_perfiles.Count == 0)">
                                    <option value="0">@(_perfiles.Count == 0 ? "Seleccione empresa y sucursal..." : "Seleccione...")</option>
                                    @foreach (var p in _perfiles)
                                    {
                                        <option value="@p.IdSerie" disabled="@(!p.Elegible)">
                                            @p.Descripcion — @(p.TipoNombre ?? p.CodigoFe)@(p.Elegible ? "" : " — no aplica")
                                        </option>
                                    }
                                </select>
                                @if (_perfilAviso is not null)
                                {
                                    <div class="form-text text-danger">@_perfilAviso</div>
                                }
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Moneda</label>
                                <select class="form-select" @bind="_moneda" @bind:after="AlCambiarMoneda">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var moneda in _monedas) { <option value="@moneda.CodMoneda">@moneda.MonedaNombre</option> }
                                </select>
                                @if (_moneda == 2)
                                {
                                    <div class="form-text">@(_tipoCambio is { } tc ? $"Tipo de cambio: ₡{tc:N2}" : "Consultando tipo de cambio...")</div>
                                }
                            </div>
                            @if (!EsConsignacion)
                            {
                                <div class="col-12 col-md-3"><label class="form-label">Bodega</label>
                                    <select class="form-select" @bind="_bodega" disabled="@(_lineas.Count > 0)" title="@(_lineas.Count > 0 ? "Ya hay artículos agregados: quite todas las líneas para cambiar la bodega." : null)">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var b in _bodegas) { <option value="@b.IdBodega">@b.NombreBodega</option> }
                                    </select></div>
                            }
                            <div class="col-12 col-md-6"><label class="form-label">Empresa</label><select class="form-select" @bind="_idEmpresa" @bind:after="AlCambiarEmpresa"><option value="0">Seleccione...</option>@foreach (var empresa in _empresas) { <option value="@empresa.Id">@empresa.Nombre</option> }</select></div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Actividad económica</label>
                                    <select class="form-select" @bind="_codActividad" disabled="@(_actividadesEmpresa.Count == 0)">
                                        <option value="">@(_actividadesEmpresa.Count == 0 ? "La empresa no tiene actividades registradas" : "Seleccione...")</option>
                                        @foreach (var act in _actividadesEmpresa) { <option value="@act.Codigo">@act.Codigo — @act.Descripcion@(act.Principal == true ? " (principal)" : "")</option> }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <label class="form-label mb-0">Agente</label>
                                        <div class="form-check">
                                            <input id="factura-sin-agente" class="form-check-input" type="checkbox" @bind="_sinAgente" />
                                            <label class="form-check-label" for="factura-sin-agente">Sin agente</label>
                                        </div>
                                    </div>
                                    <select class="form-select" disabled="@_sinAgente" @bind="_codAgente">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var agente in _agentesVenta) { <option value="@agente.Id">@agente.Name</option> }
                                    </select>
                                </div>
                        </div>
                        @if (_clientesEncontrados.Count > 0)
                        {
                            <div class="list-group mt-2" style="max-height: 12rem; overflow-y:auto;">@foreach (var cliente in _clientesEncontrados) { <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirCliente(cliente)"><strong>@cliente.Nombre</strong><span class="text-secondary ms-2">@cliente.Cedula</span></button> }</div>
                        }
                        @if (_cliente is not null)
                        {
                            <div class="alert alert-light border mt-3 mb-0"><div class="d-flex justify-content-between"><strong>@_cliente.Nombre</strong><div><button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="AbrirCorreos"><i class="bi bi-envelope me-1" aria-hidden="true"></i>Correos del comprobante</button><button type="button" class="btn btn-sm btn-link" @onclick="QuitarCliente">Cambiar</button></div></div><div class="small text-secondary">@_cliente.Cedula · @_cliente.Telefono_01 · @_cliente.E_Mail</div>@if (_cliente.Cliente_Moroso && !_cliente.Sinrestriccion) { <div class="small text-danger mt-1">Cliente con restricción de morosidad.</div> } @if (_cliente.OrdenCompra) { <div class="small text-warning mt-1">El cliente requiere orden de compra.</div> }
                                <div class="mt-2 pt-2 border-top">
                                    <label class="form-label small mb-1">Actividad económica del cliente</label>
                                    @if (_buscandoActsCliente)
                                    {
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando</span></div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 align-items-start">
                                            <select class="form-select form-select-sm" @bind="_codActividadCliente" disabled="@(_actividadesCliente.Count == 0)">
                                                <option value="">@(_actividadesCliente.Count == 0 ? "El cliente no tiene actividades registradas" : "Seleccione...")</option>
                                                @foreach (var act in _actividadesCliente) { <option value="@act.Codigo">@act.Codigo — @act.Descripcion@(act.Principal == true ? " (principal)" : "")</option> }
                                            </select>
                                            <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" disabled="@_buscandoActsClienteHacienda" @onclick="BuscarActividadesClienteHacienda">
                                                @(_buscandoActsClienteHacienda ? "..." : "Buscar en Hacienda")
                                            </button>
                                        </div>
                                        @if (_actividadesClienteHaciendaSugeridas.Count > 0)
                                        {
                                            <div class="list-group list-group-flush mt-1">
                                                @foreach (var act in _actividadesClienteHaciendaSugeridas)
                                                {
                                                    <button type="button" class="list-group-item list-group-item-action py-1 px-2 small" @onclick="() => UsarActividadClienteHacienda(act)">
                                                        @act.Codigo — @act.Descripcion
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                                @if (_cliente.TieneBonificacion)
                                {
                                    <div class="mt-2 pt-2 border-top">
                                        <div class="d-flex align-items-center gap-2 small"><i class="bi bi-gift-fill text-success" aria-hidden="true"></i><strong>Cliente bonificado</strong></div>
                                        @if (_cargandoBonificacionCliente)
                                        {
                                            <div class="spinner-border spinner-border-sm text-primary mt-1" role="status"><span class="visually-hidden">Cargando</span></div>
                                        }
                                        else if (_bonificacionesCliente.Count == 0)
                                        {
                                            <p class="text-secondary small mb-0 mt-1">Sin bonificaciones configuradas.</p>
                                        }
                                        else
                                        {
                                            <ul class="small text-secondary mb-0 mt-1 ps-3">
                                                @foreach (var b in _bonificacionesCliente)
                                                {
                                                    <li>@NombreTipoBonificacion(b.IdConfiguracionBonificacion) · <strong>@(string.IsNullOrWhiteSpace(b.DescripcionArticulo) ? b.IdArticulo.ToString() : b.DescripcionArticulo)</strong>@(string.IsNullOrWhiteSpace(b.Descripcion) ? "" : $" — {b.Descripcion}")</li>
                                                }
                                            </ul>
                                            <p class="text-secondary small mb-0 mt-1"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Se aplica automáticamente al agregar el artículo indicado.</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <div class="row g-3 mt-0"><div class="col-12 col-md-6"><label class="form-label">Orden de compra</label><input class="form-control" @bind="_ordenCompra" /></div><div class="col-12 col-md-6"><label class="form-label">Observaciones</label><input class="form-control" @bind="_observaciones" /></div></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card h-100 seepos-facturacion-totales"><div class="card-header"><strong>Totales de la venta</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-7 fw-normal text-secondary">Subtotal</dt><dd class="col-5 text-end">@Formato.Importe(_totales.SubTotal)</dd><dt class="col-7 fw-normal text-secondary">Descuento</dt><dd class="col-5 text-end">@Formato.Importe(_totales.Descuento)</dd><dt class="col-7 fw-normal text-secondary">Impuesto</dt><dd class="col-5 text-end">@Formato.Importe(_totales.Impuesto)</dd><dt class="col-7">Total</dt><dd class="col-5 text-end fs-5">@Formato.Importe(_totales.Total)</dd></dl>
                    @if (MostrarCobroContado && _formasPagoContado.Count > 0)
                    {
                        <div class="small text-secondary mt-3"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>El cobro se captura al pulsar «Cobrar».</div>
                    }
                    @if (!EsPrefacturaConsignacion && !EsConsignacion && !_ruta.EsValida && _idPerfil > 0 && _ruta.Motivo is not null)
                    {
                        <div class="alert alert-warning py-2 small mb-0 mt-3">@_ruta.Motivo</div>
                    }
                    @if (MostrarCobroContado)
                    {
                        <button class="btn btn-primary w-100 mt-3" disabled="@(_guardando || !PuedeEmitirBase)" @onclick="AbrirCobro"><i class="bi bi-cash-coin me-2" aria-hidden="true"></i>Cobrar</button>
                    }
                    else
                    {
                        <button class="btn btn-primary w-100 mt-3" disabled="@(_guardando || !PuedeEmitir)" @onclick="Emitir"><i class="bi bi-receipt-cutoff me-2" aria-hidden="true"></i>@(_guardando ? "Registrando..." : EsPrefacturaConsignacion ? "Generar prefactura" : EsConsignacion ? "Registrar consignación" : PoliticaRutaFacturacion.TextoAccion(_ruta.Ruta))</button>
                    }</div></div>
            </div>
        </div>

        <div class="card mt-3 seepos-facturacion-detalle">
            <div class="card-header d-flex justify-content-between align-items-center gap-2"><strong>Detalle</strong><div class="btn-group"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="AbrirBuscadorArticulo"><i class="bi bi-list-ul me-1" aria-hidden="true"></i>Buscar artículo</button><button type="button" class="btn btn-sm btn-primary" @onclick="AbrirCatalogoImagenes"><i class="bi bi-camera me-1" aria-hidden="true"></i>Catálogo visual</button></div></div>
            <div class="card-body p-0">
                @if (_lineas.Count == 0) { <p class="text-secondary text-center py-4 mb-0">Seleccione un cliente y agregue artículos a la factura.</p> }
                else { <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Código</th><th>Descripción</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Desc. %</th><th class="text-end">Impuesto</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@foreach (var linea in _lineas) { <tr><td><code>@linea.Articulo.Cod_Articulo</code></td><td>@linea.Articulo.Descripcion @if (linea.EsDeGrupo) { <span class="badge text-bg-success ms-1">@(linea.EsBonificacion ? "Regalo" : "Bonificación")</span> } @if (!string.IsNullOrWhiteSpace(linea.Lote)) { <small class="text-secondary d-block">Lote: @linea.Lote</small> }</td><td style="min-width:6rem"><input type="number" min="1" step="0.001" class="form-control form-control-sm text-end" disabled="@linea.EsDeGrupo" @bind="linea.Cantidad" @bind:after="() => RecalcularLinea(linea)" /></td><td style="min-width:7rem"><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end" disabled="@linea.EsDeGrupo" @bind="linea.Precio" @bind:after="() => RecalcularLinea(linea)" /></td><td style="min-width:5rem"><div class="d-flex align-items-center gap-1"><input type="number" min="0" max="@linea.TopeDescuentoEfectivo" step="0.01" class="form-control form-control-sm text-end" disabled="@linea.EsDeGrupo" @bind="linea.Descuento" @bind:after="() => RecalcularLinea(linea)" />@if (Sesion.EsSuperAdministrador && !linea.EsDeGrupo) { <button type="button" class="btn btn-sm btn-link p-0" title="@(linea.SinTopeDescuento ? "Quitar el descuento máximo (" + Formato.Cantidad(linea.MaxDescuento) + "%) para esta línea" : "Superar el descuento máximo (" + Formato.Cantidad(linea.MaxDescuento) + "%) para esta línea")" @onclick="() => AlternarTopeDescuento(linea)"><i class="bi @(linea.SinTopeDescuento ? "bi-unlock-fill text-warning" : "bi-lock-fill text-secondary")" aria-hidden="true"></i></button> }</div></td><td class="text-end">@Formato.Importe(linea.Calculo.MontoImpuesto)</td><td class="text-end fw-semibold">@Formato.Importe(linea.Calculo.Total)</td><td class="text-end">@if (!linea.EsDeGrupo || linea.EsLineaPrincipal) { <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarLinea(linea)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button> } else { <span class="text-secondary small">—</span> }</td></tr> }</tbody></table></div> }
            </div>
        </div>
        </fieldset>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modalCatalogo" Title="Catálogo de artículos" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_cargandoCatalogo)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando catálogo...</span></div></div>
        }
        else if (_catalogoImagenes.Count == 0)
        {
            <p class="text-secondary text-center py-4 mb-0">No hay artículos con imagen disponibles en el catálogo.</p>
        }
        else
        {
            <div class="form-check mb-3"><input id="catalogo-todos" class="form-check-input" type="checkbox" checked="@CatalogoCompletoSeleccionado" @onchange="SeleccionarTodoCatalogo" /><label class="form-check-label" for="catalogo-todos">Seleccionar todos (@_catalogoImagenes.Count)</label></div>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3" style="max-height: 58vh; overflow-y: auto;">
                @foreach (var producto in _catalogoImagenes)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm @(producto.Seleccionado ? "border-primary" : null)">
                            <div class="position-relative bg-body-tertiary text-center" style="height: 11rem;">
                                @if (!string.IsNullOrWhiteSpace(producto.Datos.Imagen)) { <img class="mw-100 h-100 p-2" style="object-fit: contain;" src="@ImagenCatalogo(producto.Datos.Imagen)" alt="@producto.Datos.Descripcion" loading="lazy" /> }
                                else { <i class="bi bi-image text-secondary" style="font-size: 3rem; line-height: 11rem;" aria-hidden="true"></i> }
                                <div class="position-absolute top-0 end-0 p-2"><input class="form-check-input" type="checkbox" aria-label="Seleccionar @producto.Datos.Descripcion" @bind="producto.Seleccionado" /></div>
                            </div>
                            <div class="card-body py-2"><p class="fw-semibold small mb-1">@producto.Datos.Descripcion</p><div class="small text-secondary">@Formato.Importe(producto.Datos.Precio)</div>@if (producto.Seleccionado) { <div class="input-group input-group-sm mt-2"><span class="input-group-text">Cant.</span><input class="form-control text-end" type="number" min="1" step="1" @bind="producto.Cantidad" /></div> }</div>
                        </div>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => _modalCatalogo.HideAsync()">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(_agregandoCatalogo || !_catalogoImagenes.Any(p => p.Seleccionado))" @onclick="AgregarSeleccionCatalogo">@(_agregandoCatalogo ? "Agregando..." : "Agregar selección")</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalLotes" Title="Reparto de lotes" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_articuloPendiente is not null)
        {
            <p class="text-secondary">
                @_articuloPendiente.Descripcion
                @if (_lineaEditandoLotes is not null)
                {
                    <text> — se necesitan <strong>@Formato.Cantidad(_cantidadArticuloPendiente)</strong> unidad(es).</text>
                }
                else
                {
                    <text> — indique cuántas unidades de cada lote va a facturar.</text>
                }
            </p>
        }
        @{ var lotesUsables = _lotesPendientes.Where(l => l.Activo != false && l.Cantidad > 0
                && (l.Vencimiento is null || l.Vencimiento.Value.Date >= DateTime.Today)).ToList(); }
        @if (lotesUsables.Count == 0) { <div class="alert alert-warning mb-0">El artículo maneja lotes, pero no tiene lotes disponibles no vencidos.</div> }
        else
        {
            <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                <thead><tr><th>Lote</th><th>Vence</th><th class="text-end">Existencia</th><th class="text-end" style="min-width:8rem">A consumir</th></tr></thead>
                <tbody>
                @foreach (var lote in lotesUsables)
                {
                    <tr>
                        <td>@lote.Lote @(lote.EsUnico ? "(único)" : "")</td>
                        <td>@(lote.Vencimiento is { } vf ? vf.ToString("dd/MM/yyyy") : "—")</td>
                        <td class="text-end">@Formato.Cantidad(lote.Cantidad)</td>
                        <td class="text-end">
                            <input type="number" min="0" max="@lote.Cantidad" step="0.001" class="form-control form-control-sm text-end"
                                   value="@(_repartoConsumo.TryGetValue(lote.Id, out var c) ? c.ToString() : "")"
                                   @onchange="e => SetReparto(lote, e.Value?.ToString())" />
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                @if (_lineaEditandoLotes is not null)
                {
                    <span class="@(RepartoTotal == (double)_cantidadArticuloPendiente ? "text-success" : "text-danger")">
                        Repartido @Formato.Cantidad((decimal)RepartoTotal) de @Formato.Cantidad(_cantidadArticuloPendiente)
                    </span>
                }
                else
                {
                    <span class="@(RepartoTotal > 0 ? "text-success" : "text-danger")">
                        Total a facturar: @Formato.Cantidad((decimal)RepartoTotal)
                    </span>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelarReparto">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="ConfirmarReparto"
                disabled="@(_lineaEditandoLotes is not null ? Math.Abs(RepartoTotal - (double)_cantidadArticuloPendiente) > 0.0001 : RepartoTotal <= 0)">Aceptar</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalCorreos" Title="Correos del comprobante" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-2 align-items-end mb-2">
            <div class="col-12 col-md-8">
                <label class="form-label">Correo electrónico</label>
                <input class="form-control" placeholder="correo@dominio.com" @bind="_correoNuevo" @bind:event="oninput" @onkeydown="AgregarCorreoConEnter" />
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="button" class="btn @(_correoEditandoIndice is not null ? "btn-warning" : "btn-success") flex-fill" @onclick="AgregarOEditarCorreo">@(_correoEditandoIndice is not null ? "Editar" : "Agregar")</button>
                <button type="button" class="btn btn-outline-danger" @onclick="LimpiarCorreos">Limpiar</button>
            </div>
        </div>
        @if (_cargandoCorreos)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
        }
        else if (_correos.Count == 0)
        {
            <p class="text-secondary text-center py-3 mb-0">Sin correos registrados para este cliente.</p>
        }
        else
        {
            <table class="table table-sm align-middle mb-0"><thead><tr><th>Correo electrónico</th><th></th></tr></thead><tbody>
                @for (var i = 0; i < _correos.Count; i++)
                {
                    var indice = i;
                    <tr><td>@_correos[indice]</td><td class="text-end"><button type="button" class="btn btn-sm btn-link" @onclick="() => EditarCorreo(indice)">Editar</button><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarCorreo(indice)">Quitar</button></td></tr>
                }
            </tbody></table>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-primary" disabled="@_guardandoCorreos" @onclick="GuardarCorreos">@(_guardandoCorreos ? "Guardando..." : "Guardar")</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => _modalCorreos.HideAsync()">Cerrar</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalBonificacionArticulo" Title="Bonificación del artículo" Size="ModalSize.Regular">
    <BodyTemplate>
        @if (_articuloBonificacionPendiente is not null)
        {
            <p class="text-secondary">@_articuloBonificacionPendiente.Descripcion es un artículo bonificable. ¿Desea aplicar una bonificación?</p>
        }
        <label class="form-label" for="bonif-art-tipo">Tipo de bonificación</label>
        <select id="bonif-art-tipo" class="form-select" @bind="_tipoBonificacionElegido">
            <option value="0">Seleccione...</option>
            @foreach (var c in _tiposDelArticuloPendiente)
            {
                <option value="@c.IdConfiguracionBonificacion">@c.Descripcion (@c.CantidadVenta lleva @c.CantidadBonificable)</option>
            }
        </select>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="OmitirBonificacionArticulo">Agregar sin bonificación</button>
        <button type="button" class="btn btn-primary" @onclick="ConfirmarBonificacionArticulo">Continuar</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalMezclaBonificacion" Title="Bonificación — completar la cantidad" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_configMezclaActiva is not null)
        {
            <p class="text-secondary">
                <strong>@_configMezclaActiva.Descripcion</strong>: por cada @_configMezclaActiva.CantidadVenta se regalan @_configMezclaActiva.CantidadBonificable.
                @if (_mezclaOrigenCliente) { <span>(tipo elegido por el cliente)</span> }
            </p>
            <table class="table table-sm align-middle">
                <thead><tr><th>Artículo</th><th class="text-end">Precio</th><th class="text-end" style="width:9rem">Cantidad</th><th style="min-width:12rem">Lote</th></tr></thead>
                <tbody>
                    @foreach (var item in _itemsMezcla)
                    {
                        <tr>
                            <td>@item.Descripcion</td>
                            <td class="text-end">@Formato.Importe(item.PrecioUnit)</td>
                            <td><input type="number" min="0" step="1" class="form-control form-control-sm text-end" @bind="item.Cantidad" /></td>
                            <td>
                                @if (!item.ManejaLotes)
                                {
                                    <span class="text-muted small">—</span>
                                }
                                else if (item.LotesDisponibles.Count == 0)
                                {
                                    <span class="text-danger small">Sin lotes disponibles</span>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm" @bind="item.IdLoteSeleccionado">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var lote in item.LotesDisponibles)
                                        {
                                            <option value="@lote.Id">@lote.Lote@(lote.EsUnico ? " (único)" : "")</option>
                                        }
                                    </select>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2" class="text-end">Total</th>
                        <th class="text-end @(TotalMezcla > _configMezclaActiva.CantidadTotalGrupo ? "text-danger" : null)">@TotalMezcla / @_configMezclaActiva.CantidadTotalGrupo</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
            <p class="text-secondary small mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>El artículo de menor precio entre los usados sale gratis (hasta @_configMezclaActiva.CantidadBonificable unidades).</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelarMezcla">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(_aplicandoBonificacion || _configMezclaActiva is null || TotalMezcla == 0 || TotalMezcla > _configMezclaActiva.CantidadTotalGrupo)" @onclick="AplicarGrupoBonificacion">@(_aplicandoBonificacion ? "Aplicando..." : "Aplicar bonificación")</button>
    </FooterTemplate>
</HxModal>

<AppBuscadorArticulo @ref="_buscadorArticulo" AlElegir="PrepararArticulo" IdBodega="@(EsConsignacion ? null : (int?)_bodega)" />

<HxModal @ref="_modalCobro" Title="Cobro del tiquete" Size="ModalSize.Regular" Scrollable="true">
    <BodyTemplate>
        <PanelPagoVenta Titulo="Formas de pago (100%)"
                        Total="@((decimal)_totales.Total)"
                        Formas="_formasPagoContado"
                        NumApertura="_numAperturaContado"
                        AvisoCaja="@_avisoCajaContado"
                        @bind-Montos="_montosContado"
                        @bind-Referencias="_referenciasContado"
                        RepartoChanged="_ => RecalcularTodo()" />
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => _modalCobro.HideAsync()">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(_guardando || !CobroContadoCubierto)" @onclick="EmitirDesdeModal">
            <i class="bi bi-receipt-cutoff me-2" aria-hidden="true"></i>@(_guardando ? "Emitiendo..." : "Emitir")
        </button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalComprobante" Title="Comprobante emitido" Size="ModalSize.Large" Scrollable="true">
    <BodyTemplate>
        @if (!string.IsNullOrWhiteSpace(_avisoResultado))
        {
            <p class="mb-2">@_avisoResultado</p>
        }
        @if (!string.IsNullOrWhiteSpace(_avisoComprobante))
        {
            <p class="small text-secondary mb-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@_avisoComprobante</p>
