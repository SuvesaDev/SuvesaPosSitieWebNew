    protected override async Task OnInitializedAsync()
    {
        // REDISENO_TIPOS_SERIES_CONDICION.md: el Tipo ya no lleva Contado/Credito —
        // la condición y la elegibilidad de la serie las resuelve PerfilesApi.Elegibles
        // según la Condición de venta elegida en pantalla.
        _tipos = (await Respuestas.DatoAsync(await Api.Tipos(), "consultar los tipos de factura"))?.Where(t => t.Activo && (int)t.Uso == 1).ToList() ?? new();
        _monedas = (await Respuestas.DatoAsync(await Compras.Monedas(), "consultar las monedas"))?.ToList() ?? new();
        if (_moneda == 0) _moneda = _monedas.FirstOrDefault()?.CodMoneda ?? 0;
        _agentesVenta = (await Respuestas.DatoAsync(await Api.Agentes(), "consultar los agentes de venta"))?.ToList() ?? new();
        _configsBonificacion = (await Respuestas.DatoAsync(await CatalogoBonificacion.Disponibles(), "consultar los tipos de bonificación"))?.ToList() ?? new();
        var rb = await Lotes2.BodegasOperativasAsync(Sesion.IdSucursal > 0 ? Sesion.IdSucursal : null);
        _bodegas = rb.Status == DTOs.Generated.ResponseStatus._0 ? (rb.Responses ?? new()) : new();
        if (_bodega == 0) _bodega = _bodegas.FirstOrDefault()?.IdBodega ?? 0;

        _emisores = (await Respuestas.DatoAsync(await EmisoresApi.Obtener(), "consultar los emisores"))?.ToList() ?? new();
        _idEmisor = _emisores.Count == 1 ? _emisores[0].Id : _emisores.FirstOrDefault()?.Id ?? 0;
        await CargarPerfiles();
    }

    // --- SANEAMIENTO Fase 8.3: perfil de emisión ---------------------------------

    private async Task CargarPerfiles()
    {
        _perfiles = new();
        _idPerfil = 0;
        _tipoFactura = 0;
        _perfilAviso = null;
        if (_idEmisor <= 0 || Sesion.IdSucursal <= 0) return;

        var lista = await Respuestas.DatoAsync(
            await PerfilesApi.Elegibles(_idEmisor, Sesion.IdSucursal, null, _esCredito ? "credito" : "contado"),
            "consultar las series disponibles para facturar");
        _perfiles = (lista ?? new List<SuvesaPosSitioAplicacion.DTOs.Cobros.PerfilEmisionElegibleWebDTO>())
            .OrderByDescending(p => p.Elegible).ThenBy(p => p.Descripcion)
            .ToList();
        RecalcularRuta();
    }

    private async Task AlCambiarPerfil()
    {
        _perfilAviso = null;
        _tipoFactura = 0;
        RecalcularRuta();
        var p = _perfiles.FirstOrDefault(x => x.IdSerie == _idPerfil);
        if (p is null) return;
        if (!p.Elegible)
        {
            _perfilAviso = p.MotivoNoElegible;
            return;
        }
        var tipo = _tipos.FirstOrDefault(t => t.Id == p.IdTipoFactura);
        if (tipo is null)
        {
            _perfilAviso = "El tipo de documento del perfil no está disponible en esta pantalla.";
            return;
        }
        _tipoFactura = tipo.Codigo;
        // La apertura de caja se necesita para preventa de contado y para tiquete;
        // el aviso de ruta inválida se muestra junto al botón Emitir.
        await CargarCobroContadoAsync();
    }

    /// <summary>W3: deriva la ruta de la pantalla de la serie elegida (PoliticaRutaFacturacion).</summary>
    private void RecalcularRuta()
    {
        var p = _perfiles.FirstOrDefault(x => x.IdSerie == _idPerfil);
        if (p is null || !p.Elegible || EsPrefacturaConsignacion || EsConsignacion)
        {
            _ruta = new(PoliticaRutaFacturacion.Ruta.ConfiguracionInvalida, null);
            return;
        }
        _ruta = PoliticaRutaFacturacion.Resolver(new PoliticaRutaFacturacion.EntradaSerie(
            EsTiquete: p.EsTiquete,
            EsCredito: p.EsCredito,
            RequiereDocumentoElectronico: !p.EsInterna,
            EmisionV44Habilitada: p.EmisionV44Habilitada,
            CodigoFe: p.CodigoFe));
    }

