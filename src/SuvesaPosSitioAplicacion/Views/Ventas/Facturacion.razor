    private async Task BuscarClientes()
        => _clientesEncontrados = (await Respuestas.DatoAsync(await Clientes.Buscar(_textoCliente), "buscar clientes"))?.Where(c => !c.Anulado && !c.Fallecido).ToList() ?? new();
    private async Task BuscarClienteConEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarClientes(); }

    // Busca sola al escribir, igual que el buscador de articulos: el usuario no
    // deberia tener que acordarse de apretar "Buscar" para que esto funcione.
    // Espera a que pare de escribir para no llamar al API en cada tecla.
    private static readonly TimeSpan EsperaCliente = TimeSpan.FromMilliseconds(400);
    private CancellationTokenSource? _pendienteCliente;

    private async Task AlEscribirCliente(ChangeEventArgs e)
    {
        _textoCliente = e.Value?.ToString() ?? string.Empty;

        _pendienteCliente?.Cancel();

        if (_textoCliente.Trim().Length < 2)
        {
            _clientesEncontrados.Clear();
            return;
        }

        _pendienteCliente = new CancellationTokenSource();
        var token = _pendienteCliente.Token;

        try
        {
            await Task.Delay(EsperaCliente, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await BuscarClientes();
    }
    private async Task ElegirCliente(FiltranClienteDTO cliente)
    {
        _cliente = cliente;
        _textoCliente = cliente.Nombre ?? cliente.Cedula ?? string.Empty;
        _clientesEncontrados.Clear();
        RecalcularTodo();
        await CargarActividadesCliente(cliente);
        await CargarCobroContadoAsync();

        _bonificacionesCliente = new List<ClienteBonificacionConfiguracionDTO>();
        if (cliente.TieneBonificacion)
        {
            _cargandoBonificacionCliente = true;
            _bonificacionesCliente = (await Respuestas.DatoAsync(
                await ClienteBonificacion.ObtenerPorCliente(cliente.Cedula, cliente.Identificacion), "consultar la bonificación del cliente"))
                ?.ToList() ?? new List<ClienteBonificacionConfiguracionDTO>();
            _cargandoBonificacionCliente = false;
        }
    }

    private void QuitarCliente() { _cliente = null; _tipoFactura = 0; _bonificacionesCliente.Clear(); _actividadesCliente = new(); _codActividadCliente = string.Empty; _actividadesClienteHaciendaSugeridas = new(); }

    // Al elegir cliente se consultan sus actividades económicas en Hacienda (por
    // cédula) para escoger bajo cuál se factura; se preselecciona la que el
    // cliente tiene guardada (Cliente.CodigoActividad) si aparece en la lista.
    private async Task CargarActividadesCliente(FiltranClienteDTO cliente)
    {
        _actividadesCliente = new();
        _codActividadCliente = string.Empty;
        if (cliente.Identificacion <= 0) return;

        _buscandoActsCliente = true;
        _actividadesCliente = (await Respuestas.DatoAsync(await Clientes.Actividades(cliente.Identificacion), "consultar las actividades del cliente"))?
            .Where(a => a.Activo != false).ToList() ?? new();
        _buscandoActsCliente = false;

        var guardada = cliente.CodigoActividad;
        var principal = _actividadesCliente.FirstOrDefault(a => a.Principal == true)?.Codigo;
        _codActividadCliente = !string.IsNullOrWhiteSpace(guardada) && _actividadesCliente.Any(a => a.Codigo == guardada)
            ? guardada!
            : principal ?? _actividadesCliente.FirstOrDefault()?.Codigo ?? guardada ?? string.Empty;

        _actividadesClienteHaciendaSugeridas = new();
    }

    /// <summary>Cuando el cliente no tiene actividades guardadas (o se quiere agregar
    /// otra), permite consultarlas en Hacienda sin salir de la venta. Las que se usen
    /// quedan disponibles para esta factura; para que queden guardadas en el cliente
    /// hay que agregarlas también desde su ficha (Clientes → Editar).</summary>
    private async Task BuscarActividadesClienteHacienda()
    {
        if (_cliente is null || string.IsNullOrWhiteSpace(_cliente.Cedula))
        {
            await Dialogos.ErrorAsync("El cliente no tiene cédula para consultar en Hacienda.");
            return;
        }

        _buscandoActsClienteHacienda = true;
        var r = await Respuestas.DatoAsync(await Empresas.ActividadesHacienda(_cliente.Cedula), "consultar las actividades del cliente en Hacienda");
        _buscandoActsClienteHacienda = false;

        _actividadesClienteHaciendaSugeridas = (r ?? new List<ActividadesEmpresaDTO>())
            .Where(a => !_actividadesCliente.Any(x => x.Codigo == a.Codigo))
            .ToList();
        if (r is not null && _actividadesClienteHaciendaSugeridas.Count == 0 && _actividadesCliente.Count == 0)
        {
            await Dialogos.ErrorAsync("Hacienda no devolvió actividades para este cliente.");
        }
    }

    private void UsarActividadClienteHacienda(ActividadesEmpresaDTO actividad)
    {
        if (string.IsNullOrWhiteSpace(actividad.Codigo)) return;
        if (!_actividadesCliente.Any(a => a.Codigo == actividad.Codigo))
        {
            _actividadesCliente.Add(new ActividadEconomicaClienteDTO
            {
                Codigo = actividad.Codigo,
                Descripcion = actividad.Descripcion,
                Activo = true,
                Principal = actividad.Tipo
            });
        }
        _codActividadCliente = actividad.Codigo;
        _actividadesClienteHaciendaSugeridas.Remove(actividad);
    }

