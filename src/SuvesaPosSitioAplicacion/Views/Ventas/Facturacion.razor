    private Task PrepararArticulo(InventarioDTO articulo) => PrepararArticulo(articulo, 1);
    private async Task PrepararArticulo(InventarioDTO articulo, decimal cantidad)
    {
        if (_cliente is null) { await Dialogos.ErrorAsync("Seleccione primero el cliente."); return; }
        var completo = await Respuestas.DatoAsync(await Inventario.Uno(articulo.Codigo), "consultar el artículo");
        if (completo is null) return;

        // §4.3.b — si el artículo es bonificable, resolver la bonificación en vez de agregar la línea directa.
        if (completo.Bonificado && await IniciarBonificacion(completo, cantidad)) return;

        _articuloPendiente = completo;
        _cantidadArticuloPendiente = cantidad;
        if (completo.Lote)
        {
            _repartoConsumo.Clear();
            _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(completo.Codigo), "consultar lotes"))?.ToList() ?? new();
            await _modalLotes.ShowAsync();
            return;
        }

        // Follow-up — guard de existencia negativa para líneas SIN lote (las de lote
        // ya se topan en el reparto). El API igual valida; esto es aviso temprano.
        if (!Sesion.PermitirExistenciaNegativa)
        {
            var ex = await Lotes2.ExistenciaConsolidadaAsync(completo.Codigo);
            if (ex.Status == DTOs.Generated.ResponseStatus._0 && ex.Responses is { } consol)
            {
                var yaEnDetalle = _lineas.Where(l => l.Articulo.Codigo == completo.Codigo && l.Lotes is null && !l.EsBonificacion).Sum(l => l.Cantidad);
                if ((decimal)consol.ExistenciaTotal - yaEnDetalle - cantidad < 0)
                {
                    await Dialogos.ErrorAsync($"No hay existencia suficiente de {completo.Descripcion} (disponible {consol.ExistenciaTotal:N2}).");
                    return;
                }
            }
        }
        AgregarArticulo(completo, null, cantidad);
    }

    private double RepartoTotal => _repartoConsumo.Values.Sum();

    private void SetReparto(StockLoteDTO lote, string? valor)
    {
        if (double.TryParse(valor, out var v) && v > 0)
            _repartoConsumo[lote.Id] = Math.Min(v, lote.Cantidad);
        else
            _repartoConsumo.Remove(lote.Id);
    }

    private async Task ConfirmarReparto()
    {
        if (_articuloPendiente is null) { await _modalLotes.HideAsync(); return; }
        var consumos = _repartoConsumo.Where(kv => kv.Value > 0)
            .Select(kv => new DTOs.Lotes.LoteConsumoVenta { IdStockLote = kv.Key, Cantidad = kv.Value }).ToList();
        if (_lineaEditandoLotes is not null)
        {
            ActualizarLotesDeLinea(_lineaEditandoLotes, consumos);
            _lineaEditandoLotes = null;
        }
        else
        {
            // Al agregar un artículo nuevo no hay una cantidad fija que cumplir — el
            // buscador siempre pide 1 unidad y no deja elegir más; lo que el usuario
            // reparte aquí es lo que define cuánto se factura.
            AgregarArticuloConLotes(_articuloPendiente, consumos, (decimal)RepartoTotal);
        }
        await _modalLotes.HideAsync();
        await AbrirSiguienteLoteCatalogo();
    }

    /// <summary>Corrige el reparto de una línea ya agregada (no crea una línea nueva).</summary>
    private void ActualizarLotesDeLinea(LineaVenta linea, List<DTOs.Lotes.LoteConsumoVenta> lotes)
    {
        if (lotes.Count == 1)
        {
            var unico = _lotesPendientes.FirstOrDefault(l => l.Id == lotes[0].IdStockLote);
            linea.IdLote = unico?.Id ?? 0;
            linea.Lote = unico?.Lote;
            linea.Lotes = null;
        }
        else
        {
            linea.IdLote = 0;
            linea.Lote = $"{lotes.Count} lotes";
            linea.Lotes = lotes;
        }
        linea.Recalcular();
        RecalcularTodo();
    }

    /// <summary>Reabre "Reparto de lotes" para una línea ya agregada, seedeado con su
    /// reparto actual, cuando su cantidad cambió y ya no coincide con lo repartido.</summary>
    private async Task AbrirRepartoParaEditar(LineaVenta linea)
    {
        _lineaEditandoLotes = linea;
        _cantidadAntesDeEditarLotes = linea.Lotes?.Sum(l => l.Cantidad) is { } repartido && repartido > 0
            ? (decimal)repartido
            : linea.Cantidad;
        _articuloPendiente = linea.Articulo;
        _cantidadArticuloPendiente = linea.Cantidad;
        _repartoConsumo.Clear();
        _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(linea.Articulo.Codigo), "consultar lotes"))?.ToList() ?? new();
        if (linea.Lotes is { Count: > 0 })
        {
            foreach (var l in linea.Lotes) _repartoConsumo[l.IdStockLote] = l.Cantidad;
        }
        else if (linea.IdLote > 0)
        {
            _repartoConsumo[linea.IdLote] = (double)linea.Cantidad;
        }
        await _modalLotes.ShowAsync();
    }

    /// <summary>Si se cancela reabriendo el reparto de una línea, la cantidad vuelve a lo
    /// que sí tenía lotes asignados — dejarla como quedó tras el cambio manual perpetuaría
    /// el mismo desajuste que disparó la reapertura.</summary>
    private async Task CancelarReparto()
    {
        if (_lineaEditandoLotes is { } linea)
        {
            linea.Cantidad = _cantidadAntesDeEditarLotes;
            linea.Recalcular();
            RecalcularTodo();
            _lineaEditandoLotes = null;
        }
        await _modalLotes.HideAsync();
    }
    private async Task AbrirSiguienteLoteCatalogo()
    {
        if (_colaLotesCatalogo.Count == 0) return;
        var pendiente = _colaLotesCatalogo.Dequeue();
        _articuloPendiente = pendiente.Articulo;
        _cantidadArticuloPendiente = pendiente.Cantidad;
        _repartoConsumo.Clear();
        _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(pendiente.Articulo.Codigo), "consultar lotes"))?.ToList() ?? new();
        await _modalLotes.ShowAsync();
    }
    // ======================= §4.3 — flujo de bonificación =======================

    /// <returns>true si tomó el control (abrió un modal); false si no aplica y se debe agregar normal.</returns>
    private async Task<bool> IniciarBonificacion(InventarioDTO articulo, decimal cantidad)
    {
        // §5.9 — ¿el cliente tiene una asignación para justo este artículo? Su tipo
        // manda sobre lo que tenga configurado el artículo.
        var asignacion = _bonificacionesCliente.FirstOrDefault(b => b.IdArticulo == articulo.Codigo);
        if (asignacion is not null)
        {
            var cfgCliente = ConfigBonificacion(asignacion.IdConfiguracionBonificacion);
            if (cfgCliente is not null)
            {
                await AbrirMezcla(articulo, cfgCliente, origenCliente: true, cantidadInicial: (int)Math.Max(1, cantidad));
                return true;
            }
        }

        // Cualquier otro artículo: preguntar si se usa la bonificación propia del artículo.
        var tipos = (await Respuestas.DatoAsync(await ArticuloBonificacion.ObtenerPorArticulo(articulo.Codigo), "consultar la bonificación del artículo"))?.ToList()
                    ?? new List<ArticuloBonificacionConfiguracion>();
        _tiposDelArticuloPendiente = tipos
            .Select(t => ConfigBonificacion(t.IdConfiguracionBonificacion))
            .Where(c => c is not null).Select(c => c!).ToList();

        if (_tiposDelArticuloPendiente.Count == 0) return false;   // marcado bonificable pero sin tipos -> línea normal

        _articuloBonificacionPendiente = articulo;
        _cantidadArticuloPendiente = cantidad;
        _tipoBonificacionElegido = _tiposDelArticuloPendiente.Count == 1 ? _tiposDelArticuloPendiente[0].IdConfiguracionBonificacion : 0;
        await _modalBonificacionArticulo.ShowAsync();
        return true;
    }

    private async Task ConfirmarBonificacionArticulo()
    {
        if (_tipoBonificacionElegido <= 0) { await Dialogos.ErrorAsync("Seleccione el tipo de bonificación."); return; }
        var cfg = ConfigBonificacion(_tipoBonificacionElegido);
        if (cfg is null || _articuloBonificacionPendiente is null) return;
        await _modalBonificacionArticulo.HideAsync();
        await AbrirMezcla(_articuloBonificacionPendiente, cfg, origenCliente: false, cantidadInicial: (int)Math.Max(1, _cantidadArticuloPendiente));
    }

    private async Task OmitirBonificacionArticulo()
    {
        await _modalBonificacionArticulo.HideAsync();
        var art = _articuloBonificacionPendiente;
        _articuloBonificacionPendiente = null;
        if (art is null) return;

        if (art.Lote)
        {
            _articuloPendiente = art;
            _repartoConsumo.Clear();
            _lotesPendientes = (await Respuestas.DatoAsync(await Inventario.Lotes(art.Codigo), "consultar lotes"))?.ToList() ?? new();
            await _modalLotes.ShowAsync();
        }
        else
        {
            AgregarArticulo(art, null, _cantidadArticuloPendiente);
        }
    }

    private async Task AbrirMezcla(InventarioDTO principal, ConfiguracionBonificacion cfg, bool origenCliente, int cantidadInicial)
    {
        _configMezclaActiva = cfg;
        _mezclaOrigenCliente = origenCliente;
        _articuloBonificacionPendiente = principal;

        var mezcla = (await Respuestas.DatoAsync(await Relacionados.BuscarBonificacion(principal.Codigo), "consultar los productos de bonificación"))?.ToList()
                     ?? new List<ArticulosRelacionadosDTO>();

        _itemsMezcla = new List<ItemMezcla>
        {
            await CrearItemMezclaAsync(principal, Math.Min(cantidadInicial, cfg.CantidadTotalGrupo))
        };
        foreach (var r in mezcla.Where(r => r.Codigo != principal.Codigo))
        {
            // Se resuelve el InventarioDTO completo (no solo lo cacheado en
            // ArticulosRelacionadosDTO) porque hace falta saber si maneja lotes.
            var art = await Respuestas.DatoAsync(await Inventario.Uno(r.Codigo), "consultar el artículo de la mezcla");
            if (art is null) continue;
            _itemsMezcla.Add(await CrearItemMezclaAsync(art, 0));
        }

        await _modalMezclaBonificacion.ShowAsync();
    }

    /// <summary>Arma un ítem de la mezcla, resolviendo sus lotes usables si el artículo
    /// maneja lotes — sin esto no había forma de elegir el lote de un artículo usado
    /// o regalado en una bonificación, y la factura fallaba al emitir.</summary>
    private async Task<ItemMezcla> CrearItemMezclaAsync(InventarioDTO articulo, int cantidad)
    {
        var lotesUsables = new List<StockLoteDTO>();
        if (articulo.Lote)
        {
            var lotes = (await Respuestas.DatoAsync(await Inventario.Lotes(articulo.Codigo), "consultar lotes"))?.ToList() ?? new();
            lotesUsables = lotes.Where(l => l.Activo != false && l.Cantidad > 0
                && (l.Vencimiento is null || l.Vencimiento.Value.Date >= DateTime.Today)).ToList();
        }
        return new ItemMezcla
        {
            Codigo = articulo.Codigo,
            Descripcion = articulo.Descripcion ?? articulo.Codigo.ToString(),
            PrecioUnit = PrecioCliente(articulo),
            PorcentajeImpuesto = Formato.AImporte(articulo.IVenta),
            Cantidad = cantidad,
            ManejaLotes = articulo.Lote,
            LotesDisponibles = lotesUsables,
            IdLoteSeleccionado = lotesUsables.Count == 1 ? lotesUsables[0].Id : 0
        };
    }

    private int TotalMezcla => _itemsMezcla.Sum(i => Math.Max(0, i.Cantidad));

    private async Task AplicarGrupoBonificacion()
    {
        if (_configMezclaActiva is null || _articuloBonificacionPendiente is null || _aplicandoBonificacion) return;

        var sinLote = _itemsMezcla.FirstOrDefault(i => i.Cantidad > 0 && i.ManejaLotes && i.IdLoteSeleccionado <= 0);
        if (sinLote is not null) { await Dialogos.ErrorAsync($"Seleccione el lote de '{sinLote.Descripcion}'."); return; }

        _aplicandoBonificacion = true;

        // 1. Resolver el InventarioDTO completo de cada artículo usado (precio vigente,
        //    no el cacheado de ArticulosRelacionadosDTO que puede venir 0/null).
        var articulosCache = new Dictionary<long, InventarioDTO> { [_articuloBonificacionPendiente.Codigo] = _articuloBonificacionPendiente };
        var usados = new List<BonificacionCalculo.ArticuloUsado>();
        foreach (var i in _itemsMezcla.Where(i => i.Cantidad > 0))
        {
            if (!articulosCache.TryGetValue(i.Codigo, out var art))
            {
                art = await Respuestas.DatoAsync(await Inventario.Uno(i.Codigo), "consultar el artículo de la mezcla");
                if (art is null) { _aplicandoBonificacion = false; await Dialogos.ErrorAsync($"No se pudo cargar el artículo {i.Codigo}."); return; }
                articulosCache[i.Codigo] = art;
            }
            usados.Add(new BonificacionCalculo.ArticuloUsado(i.Codigo, art.Descripcion ?? i.Descripcion, PrecioCliente(art), Formato.AImporte(art.IVenta), i.Cantidad));
        }

        var resultado = BonificacionCalculo.ResolverGrupo(_configMezclaActiva.CantidadVenta, _configMezclaActiva.CantidadBonificable, usados);
        if (!resultado.Ok) { _aplicandoBonificacion = false; await Dialogos.ErrorAsync(resultado.Error!); return; }

        var idGrupo = _siguienteIdGrupo++;
        var idCfg = _configMezclaActiva.IdConfiguracionBonificacion;
        bool principalMarcada = false;

        foreach (var lg in resultado.Lineas)
        {
            var art = articulosCache[lg.Codigo];
            var item = _itemsMezcla.FirstOrDefault(i => i.Codigo == lg.Codigo);
            var loteElegido = item?.LotesDisponibles.FirstOrDefault(l => l.Id == item.IdLoteSeleccionado);

            var linea = new LineaVenta
            {
                Articulo = art,
                Cantidad = lg.Cantidad,
                Precio = lg.EsBonificacion ? 0m : lg.PrecioUnit,
                Descuento = 0m,
                MaxDescuento = 0m,
                Impuesto = lg.PorcentajeImpuesto,
                IdLote = loteElegido?.Id ?? 0,
                Lote = loteElegido?.Lote,
                IdGrupoBonificacion = idGrupo,
                IdConfiguracionBonificacion = idCfg,
                EsBonificacion = lg.EsBonificacion,
                PrecioReferencia = lg.PrecioUnit,
                EsLineaPrincipal = !principalMarcada
            };
            principalMarcada = true;
            linea.Recalcular();
            _lineas.Add(linea);
        }

        RecalcularTodo();
        _aplicandoBonificacion = false;
        _articuloBonificacionPendiente = null;
        _configMezclaActiva = null;
        _itemsMezcla = new();
        await _modalMezclaBonificacion.HideAsync();
    }

    private async Task CancelarMezcla()
    {
        _articuloBonificacionPendiente = null;
        _configMezclaActiva = null;
        _itemsMezcla = new();
        await _modalMezclaBonificacion.HideAsync();
    }

    private void AgregarArticulo(InventarioDTO articulo, StockLoteDTO? lote, decimal cantidad = 1)
    {
        var existente = _lineas.FirstOrDefault(l => l.Articulo.Codigo == articulo.Codigo && l.IdLote == (lote?.Id ?? 0) && l.Lotes is null);
        if (existente is not null) { existente.Cantidad += cantidad; existente.Recalcular(); RecalcularTodo(); return; }
        var precio = PrecioCliente(articulo);
        var linea = new LineaVenta { Articulo = articulo, Cantidad = cantidad, Precio = precio, Impuesto = Formato.AImporte(articulo.IVenta), Descuento = Math.Min(Formato.AImporte(_cliente?.DescuentoEspecial ?? 0), Formato.AImporte(articulo.Max_Descuento)), MaxDescuento = Formato.AImporte(articulo.Max_Descuento), IdLote = lote?.Id ?? 0, Lote = lote?.Lote };
        linea.Recalcular(); _lineas.Add(linea); RecalcularTodo();
    }

    /// <summary>§5 — agrega una línea con reparto multi-lote.</summary>
    private void AgregarArticuloConLotes(InventarioDTO articulo, List<DTOs.Lotes.LoteConsumoVenta> lotes, decimal cantidad)
    {
        if (lotes.Count == 0) { AgregarArticulo(articulo, (StockLoteDTO?)null, cantidad); return; }
        var precio = PrecioCliente(articulo);
        var unico = lotes.Count == 1 ? _lotesPendientes.FirstOrDefault(l => l.Id == lotes[0].IdStockLote) : null;
        var linea = new LineaVenta
        {
            Articulo = articulo, Cantidad = cantidad, Precio = precio,
            Impuesto = Formato.AImporte(articulo.IVenta),
            Descuento = Math.Min(Formato.AImporte(_cliente?.DescuentoEspecial ?? 0), Formato.AImporte(articulo.Max_Descuento)),
            MaxDescuento = Formato.AImporte(articulo.Max_Descuento),
            IdLote = unico?.Id ?? 0,
            Lote = unico?.Lote ?? (lotes.Count > 1 ? $"{lotes.Count} lotes" : null),
            Lotes = lotes
        };
        linea.Recalcular(); _lineas.Add(linea); RecalcularTodo();
    }
    private decimal PrecioCliente(InventarioDTO articulo) => (_cliente?.Tipoprecio ?? 1) switch { 2 when articulo.Precio_B > 0 => Formato.AImporte(articulo.Precio_B), 3 when articulo.Precio_C > 0 => Formato.AImporte(articulo.Precio_C), 4 when articulo.Precio_D > 0 => Formato.AImporte(articulo.Precio_D), _ => articulo.Promo_Activa && articulo.Promo_Inicio <= DateTime.Today && articulo.Promo_Finaliza >= DateTime.Today ? Formato.AImporte(articulo.Precio_Promo) : Formato.AImporte(articulo.Precio_A) };
    /// <summary>Solo un super administrador puede pasar por encima del descuento
    /// máximo del artículo en una línea puntual — es una excepción deliberada, no un
    /// ajuste de configuración, así que se pide confirmación cada vez.</summary>
    private async Task AlternarTopeDescuento(LineaVenta linea)
    {
        if (!Sesion.EsSuperAdministrador) return;
        if (linea.SinTopeDescuento)
        {
            linea.SinTopeDescuento = false;
            await RecalcularLinea(linea);
            return;
        }
        if (!await Dialogos.ConfirmarAsync(
                $"Se permitirá superar el descuento máximo configurado ({Formato.Cantidad(linea.MaxDescuento)}%) para '{linea.Articulo.Descripcion}' en esta factura. ¿Continuar?",
                "Superar descuento máximo"))
            return;
        linea.SinTopeDescuento = true;
    }

    private async Task RecalcularLinea(LineaVenta linea)
    {
        // Las líneas de un grupo de bonificación no admiten editar precio ni descuento.
        if (linea.EsDeGrupo) { linea.Descuento = 0m; if (linea.EsBonificacion) linea.Precio = 0m; }
        linea.Cantidad = Math.Max(1, linea.Cantidad);
        var descuentoTecleado = linea.Descuento;
        linea.Descuento = Math.Clamp(linea.Descuento, 0, linea.TopeDescuentoEfectivo);
        // Sin este aviso, el campo simplemente vuelve al máximo permitido sin
        // explicación — parece que "no se aplicó" el descuento tecleado.
        if (descuentoTecleado > linea.TopeDescuentoEfectivo)
        {
            Dialogos.Advertencia($"El descuento máximo para '{linea.Articulo.Descripcion}' es {Formato.Cantidad(linea.TopeDescuentoEfectivo)}%.");
        }
        linea.Recalcular();
        RecalcularTodo();

        // Si la línea ya tenía lote(s) asignado(s) y la cantidad cambió, lo repartido
        // queda desactualizado (de ahí "el artículo maneja lotes; indique los lotes" al
        // emitir, sin forma de corregirlo). Se reabre el reparto con la cantidad nueva.
        if (!linea.EsDeGrupo && linea.Articulo.Lote)
        {
            var repartido = linea.Lotes?.Sum(l => l.Cantidad) ?? (linea.IdLote > 0 ? (double)linea.Cantidad : 0);
            if (Math.Abs(repartido - (double)linea.Cantidad) > 0.0001)
            {
                await AbrirRepartoParaEditar(linea);
            }
        }
    }

    private void QuitarLinea(LineaVenta linea)
    {
        // §4.3.g — solo la línea principal se puede eliminar; borra en cascada su grupo.
        if (linea.EsDeGrupo)
        {
            if (!linea.EsLineaPrincipal) return;
            _lineas.RemoveAll(l => l.IdGrupoBonificacion == linea.IdGrupoBonificacion);
        }
        else
        {
            _lineas.Remove(linea);
        }
        RecalcularTodo();
    }
    private void RecalcularTodo() => _totales = CalculoDocumento.Totales(_lineas.Select(l => l.Calculo));

    // Tiquete: «Cobrar» abre el modal de formas de pago; «Emitir» dentro del modal
    // dispara el mismo flujo de Emitir() (que revalida todo).
    private async Task AbrirCobro()
    {
        if (!_ventaDesbloqueada) { await AbrirDesbloqueo(); return; }
        if (_cliente is null || _idPerfil == 0 || _tipoFactura == 0 || _moneda == 0 || _lineas.Count == 0)
        { await Dialogos.ErrorAsync("Seleccione cliente, condición, la serie a emitir, moneda y al menos un artículo."); return; }
        if (_cliente.Cliente_Moroso && !_cliente.Sinrestriccion) { await Dialogos.ErrorAsync("El cliente tiene restricción de morosidad."); return; }
        if (_cliente.OrdenCompra && string.IsNullOrWhiteSpace(_ordenCompra)) { await Dialogos.ErrorAsync("El cliente requiere una orden de compra."); return; }
        if (RequiereAperturaContado && _numAperturaContado is not > 0) { await Dialogos.ErrorAsync(_avisoCajaContado ?? "No hay una caja abierta para facturar de contado."); return; }
        await _modalCobro.ShowAsync();
    }

    private Task EmitirDesdeModal() => Emitir();

    private async Task CerrarComprobante()
    {
        await _modalComprobante.HideAsync();
        _docId = 0;
        _avisoResultado = _avisoComprobante = null;
        await Limpiar();
    }

    private async Task Emitir()
    {
        if (!_ventaDesbloqueada) { await AbrirDesbloqueo(); return; }
        if (_cliente is null || _idPerfil == 0 || _tipoFactura == 0 || _moneda == 0 || _lineas.Count == 0) { await Dialogos.ErrorAsync("Seleccione cliente, condición, la serie a emitir, moneda y al menos un artículo."); return; }
        if (_moneda == 2 && _tipoCambio is null) { await Dialogos.ErrorAsync("No se pudo obtener el tipo de cambio. Vuelva a seleccionar la moneda dólares."); return; }
        if (_idEmpresa <= 0) { await Dialogos.ErrorAsync("Seleccione una empresa para registrar la facturación."); return; }
        if (!EsConsignacion && _bodega <= 0) { await Dialogos.ErrorAsync("Seleccione la bodega de la que sale el inventario."); return; }
        if (!EsPrefacturaConsignacion)
        {
            // En la prefactura de consignación no se validan crédito / morosidad / orden
            // de compra: la condición (contado/crédito) se elige al facturar.
            if (_cliente.Cliente_Moroso && !_cliente.Sinrestriccion) { await Dialogos.ErrorAsync("El cliente tiene restricción de morosidad."); return; }
            if (_cliente.OrdenCompra && string.IsNullOrWhiteSpace(_ordenCompra)) { await Dialogos.ErrorAsync("El cliente requiere una orden de compra."); return; }
            if (_lineas.Any(l => l.Articulo.SoloConExistencia && l.Cantidad > Formato.AImporte(l.Articulo.Existencia))) { await Dialogos.ErrorAsync("Una línea supera la existencia disponible."); return; }
            if (_esCredito)
            {
                if (!_cliente.Abierto && !_cliente.Sinrestriccion) { await Dialogos.ErrorAsync("El cliente no tiene crédito habilitado."); return; }
                if (_lineas.Any(l => l.Articulo.SoloContado)) { await Dialogos.ErrorAsync("La factura contiene artículos solo de contado."); return; }

                var credito = await Respuestas.DatoAsync(await CobrosCreditoApi.Credito(_cliente.Identificacion), "consultar el crédito del cliente");
                if (credito is null) return;
                if (credito.Bloqueado) { await Dialogos.ErrorAsync(credito.MotivoBloqueo ?? "El cliente está bloqueado para crédito."); return; }
                if (credito.Disponible < (decimal)_totales.Total)
                {
                    await Dialogos.ErrorAsync($"El crédito disponible del cliente ({credito.Disponible:N2}) es menor al total de la venta ({_totales.Total:N2}).");
                    return;
                }
            }
            else
            {
                if (!_ruta.EsValida) { await Dialogos.ErrorAsync(_ruta.Motivo ?? "La serie seleccionada no define una ruta válida de facturación."); return; }
                // Preventa de contado y tiquete: ambas exigen apertura de caja válida (A0.1).
                if (RequiereAperturaContado && _numAperturaContado is not > 0) { await Dialogos.ErrorAsync(_avisoCajaContado ?? "No hay una caja abierta para facturar de contado."); return; }
                // Solo el tiquete captura el pago aquí y exige el 100%.
                if (MostrarCobroContado && !CobroContadoCubierto) { await Dialogos.ErrorAsync($"El tiquete exige cobrar el 100%: las formas de pago ({TotalPagadoContado:N2}) no cubren el total ({_totales.Total:N2})."); return; }
            }
        }
        var confirmacion = (EsPrefacturaConsignacion, EsConsignacion, _ruta.Ruta) switch
        {
            (true, _, _) => "Se generará la prefactura de consignación desde el conteo. ¿Desea continuar?",
            (_, true, _) => "Se registrará la consignación. ¿Desea continuar?",
            (_, _, PoliticaRutaFacturacion.Ruta.GuardarPreventaContado) => "Se guardará una preventa pendiente de cobro en Cobrar. Todavía no se emite la factura. ¿Continuar?",
            (_, _, PoliticaRutaFacturacion.Ruta.ConfirmarCredito) => "Se confirmará la factura a crédito con su plazo y saldo. ¿Continuar?",
            _ => "Se cobrará el 100% y se confirmará el tiquete, afectando el inventario. ¿Continuar?",
        };
        // El tiquete confirma con el botón «Emitir» del modal de cobro; el resto sí pregunta.
        if (!MostrarCobroContado && !await Dialogos.ConfirmarAsync(confirmacion)) return;
        _guardando = true;
        var empresa = _empresas.FirstOrDefault(e => e.Id == _idEmpresa);
        var perfil = _perfiles.FirstOrDefault(x => x.IdSerie == _idPerfil);
        var factura = new FacturaDTO { Tipo = _tipoFactura, NumCaja = (perfil?.NumeroTerminal ?? 0).ToString(), Fecha = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"), CodCliente = _cliente.Identificacion.ToString(), NumeroCedula = _cliente.Cedula, NombreCliente = _cliente.Nombre, Telefono = _cliente.Telefono_01, EmailCliente = _cliente.CorreoComprobante ?? _cliente.E_Mail, Observaciones = _observaciones, Orden = _ordenCompra, CodMoneda = _moneda.ToString(), TipoCambio = _moneda == 2 ? (double?)(_tipoCambio ?? 1m) : null, Agente = _sinAgente, Cod_agente = !_sinAgente && _codAgente > 0 ? _codAgente : null, Cajero = _usuarioVenta?.Nombre ?? Sesion.Usuario, IdSucursal = Sesion.IdSucursal, IdEmpresa = _idEmpresa, Empresa = empresa?.Nombre, CodigoActividadEmisor = string.IsNullOrWhiteSpace(_codActividad) ? null : _codActividad, CodigoActividadReceptor = string.IsNullOrWhiteSpace(_codActividadCliente) ? null : _codActividadCliente, Preventa = EsPrefacturaConsignacion || _ruta.Ruta == PoliticaRutaFacturacion.Ruta.GuardarPreventaContado, EsConsignacion = EsConsignacion, EsCredito = _esCredito, IdSerie = _idPerfil > 0 ? _idPerfil : null, NumApertura = RequiereAperturaContado ? _numAperturaContado : null, Pagos = MostrarCobroContado ? _montosContado.Where(kv => kv.Value > 0).Select(kv => new PagoFacturaDTO { FormaPago = kv.Key, Monto = (double)kv.Value, Referencia = _referenciasContado.TryGetValue(kv.Key, out var _rf) ? _rf : null }).ToList() : new(), SubTotal = (float)_totales.SubTotal, Descuento = (float)_totales.Descuento, ImpVenta = (float)_totales.Impuesto, Total = (float)_totales.Total, Detalle = _lineas.Select(l => new FacturaDetallesDTO { CodArticulo = l.Articulo.Codigo, CodFxArticulo = l.Articulo.Codigo, Descripcion = l.Articulo.Descripcion, Cantidad = (float)l.Cantidad, PrecioUnit = (float)l.Precio, Descuento = (float)l.Descuento, MontoDescuento = (float)l.Calculo.MontoDescuento, Impuesto = (long)l.Impuesto, MontoImpuesto = (float)l.Calculo.MontoImpuesto, SubtotalGravado = l.Impuesto > 0 ? (float)l.Calculo.SubtotalGravado : 0, SubTotalExcento = l.Impuesto == 0 ? (float)l.Calculo.SubTotal : 0, SubTotal = (float)l.Calculo.SubTotal, IdBodega = EsConsignacion ? l.Articulo.Id_Bodega : _bodega, Lote = l.IdLote, NumeroLote = l.Lote, Lotes = l.Lotes, EsBonificacion = l.EsBonificacion, IdGrupoBonificacion = l.IdGrupoBonificacion, IdConfiguracionBonificacion = l.IdConfiguracionBonificacion, EsLineaPrincipalBonificacion = l.EsDeGrupo ? l.EsLineaPrincipal : (bool?)null }).ToList() };
        if (EsPrefacturaConsignacion)
        {
            var rp = await ConsignacionApi.GenerarPrefacturaAsync(new GenerarPrefacturaConsignacion { IdConteo = ConteoId, Factura = factura });
            _guardando = false;
            if (rp.Status == DTOs.Generated.ResponseStatus._0 && rp.Responses is not null)
            {
                Dialogos.Exito($"Prefactura de consignación #{rp.Responses.Id} generada.");
                Navegacion.NavigateTo($"/consignment/prebill?id={rp.Responses.Id}");
            }
            else await Dialogos.ErrorAsync(rp.CurrentException ?? rp.ValidationErrors?.FirstOrDefault() ?? "No se pudo generar la prefactura.");
            return;
        }
        if (EsConsignacion)
        {
            var rcon = await Api.Crear(factura); _guardando = false;
            if (await Respuestas.CorrectaAsync(rcon, "registrar la consignación")) { Dialogos.Exito("Consignación registrada correctamente."); await Limpiar(); }
            return;
        }

        // W3: una sola llamada de comando por confirmación. La misma clave de idempotencia
        // se reutiliza si el usuario reintenta un envío que quedó en estado desconocido.
        _claveIdempotencia ??= Guid.NewGuid().ToString("N");
        var rc = _ruta.Ruta switch
        {
            PoliticaRutaFacturacion.Ruta.GuardarPreventaContado => await Comandos.CrearPreventaContado(factura, _claveIdempotencia),
            PoliticaRutaFacturacion.Ruta.ConfirmarCredito       => await Comandos.ConfirmarVentaCredito(factura, _claveIdempotencia),
            _                                                    => await Comandos.CobrarVentaTiquete(factura, _claveIdempotencia),
        };
        _guardando = false;
        var res = await Respuestas.DatoAsync(rc, "registrar la operación");
        if (res is null) return;   // el error ya se mostró; la clave se conserva para reintentar
        _claveIdempotencia = null;
        MostrarResultadoOperacion(res);

        if (MostrarCobroContado) await _modalCobro.HideAsync();

        // La preventa de contado todavía no emite nada; y sin id de venta no hay PDF que abrir.
        if (_ruta.Ruta == PoliticaRutaFacturacion.Ruta.GuardarPreventaContado || res.IdVenta <= 0)
        {
            Dialogos.Exito(_avisoResultado ?? "Operación registrada.");
            await Limpiar();
            return;
        }

        // Tiquete o crédito: mostrar el comprobante impreso y, si es electrónico,
        // firmarlo y enviarlo a Hacienda de forma síncrona para que salga con clave.
        _docId = res.IdVenta;
        _docSlug = _esCredito ? "factura-electronica" : "tiquete-electronico";
        _docFormato = _esCredito ? null : "termico80";
        _avisoComprobante = null;
        _emitiendoHacienda = res.EstadoFiscal != "NoAplica" && res.IdVenta > 0;
        await _modalComprobante.ShowAsync();

        if (_emitiendoHacienda)
        {
            StateHasChanged();
            var em = _esCredito
                ? await Preventas.EmitirFactura(res.IdVenta)
                : await Preventas.EmitirTiquete(res.IdVenta);
            _emitiendoHacienda = false;
            _avisoComprobante = em?.Responses?.EsValido == true
                ? "Comprobante recibido por Hacienda."
                : "El comprobante sigue en proceso en Hacienda; podrá reimprimirlo desde la Bandeja cuando se acepte.";
            StateHasChanged();
        }
    }

    /// <summary>W3: resultado recuperable — nunca "Factura emitida" a secas. Distingue
    /// preventa / crédito / tiquete y estado fiscal (en proceso, interno, NoAplica).</summary>
    private void MostrarResultadoOperacion(ResultadoOperacionFacturacionDTO r)
    {
        var lineas = new List<string> { $"Documento #{r.NumeroOperativo} — total {Formato.Importe((decimal)r.Total)}" };
        switch (_ruta.Ruta)
        {
            case PoliticaRutaFacturacion.Ruta.GuardarPreventaContado:
                lineas.Add("Preventa pendiente. Cóbrela desde Cobrar; todavía no se emite la factura.");
                break;
            case PoliticaRutaFacturacion.Ruta.ConfirmarCredito:
                lineas.Add($"Factura a crédito confirmada. Saldo {Formato.Importe((decimal)r.SaldoPendiente)}"
                    + (r.Vencimiento is { } v ? $", vence {v:dd/MM/yyyy}." : "."));
                lineas.Add(r.EstadoFiscal == "NoAplica" ? "Documento interno (sin Hacienda)." : "Comprobante electrónico en proceso.");
                break;
            default:
                lineas.Add(r.EstadoFiscal == "NoAplica"
                    ? "Cobrado. Documento interno, sin espera de Hacienda."
                    : "Cobrado. Comprobante electrónico en proceso.");
                break;
        }
        if (r.FueReintento) lineas.Add("(Se recuperó el resultado de un envío anterior; no se cobró ni emitió dos veces.)");
        _avisoResultado = string.Join(" ", lineas);
    }
    private async Task Limpiar() { _cliente = null; _clientesEncontrados.Clear(); _textoCliente = _observaciones = _ordenCompra = string.Empty; _tipoFactura = 0; _esCredito = false; _creditoAviso = null; _moneda = _monedas.FirstOrDefault()?.CodMoneda ?? 0; _tipoCambio = null; _sinAgente = false; _codAgente = 0; _lineas.Clear(); _bonificacionesCliente.Clear(); _siguienteIdGrupo = 1; _formasPagoContado = new(); _montosContado.Clear(); _referenciasContado.Clear(); _numAperturaContado = null; _avisoCajaContado = null; _claveIdempotencia = null; _ruta = new(PoliticaRutaFacturacion.Ruta.ConfiguracionInvalida, null); await CargarPerfiles(); RecalcularTodo(); }
}
