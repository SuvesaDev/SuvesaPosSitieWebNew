        if (c is not null || string.IsNullOrWhiteSpace(nombre)) return c;
        var r2 = await Clientes.Buscar(nombre);
        return r2.EsCorrecta ? (r2.Responses ?? new List<FiltranClienteDTO>()).FirstOrDefault(x => x.Identificacion == idCliente) : null;
