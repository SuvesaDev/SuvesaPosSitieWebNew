@page "/initial/repayment"
@page "/sales/repayment"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IDevolucionesVenta Api
@inject IFacturacion Facturas
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject NavigationManager Navegacion

@*  Ola 5 — el menu React tiene "Devoluciones" dos veces (/initial/repayment y
    /sales/repayment) porque el enrutador de la SPA manda ambas rutas al MISMO
    componente (RepaymentPage). Se replica igual: una sola pantalla con dos @page.

    La pestaña "Validación" del sistema actual (elegir Efectivo/Depósito/Anticipo,
    usuario que recibe, notas) es mockup puro: los selects y botones no tienen
    onChange/onClick, y el contenido siempre muestra el mismo sub-formulario
    (Anticipo) sin importar cual boton se "presione". Por eso "usuario que recibe"
    y "notas" nunca se completan de verdad hoy. Aquí sí se conectan (con
    ObtenerPersonal, que el sistema actual ya consulta pero nunca conecta a un
    input real) porque es trivial y mejor que replicar un formulario muerto.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _modalBuscarDevoluciones.ShowAsync()">
            <i class="bi bi-clock-history me-1" aria-hidden="true"></i>Devoluciones anteriores
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Limpiar">Nueva devolución</button>
    </Acciones>
    <ChildContent>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-3 border rounded bg-body-tertiary">
            @if (_desbloqueada)
            {
                <div><strong><i class="bi bi-unlock-fill me-2 text-success" aria-hidden="true"></i>Devoluciones desbloqueadas</strong><span class="text-secondary ms-2">Usuario: @_usuario?.Nombre</span></div>
            }
            else
            {
                <div><strong><i class="bi bi-lock-fill me-2 text-warning" aria-hidden="true"></i>Bloqueado</strong><span class="text-secondary ms-2">Ingrese la clave interna para comenzar.</span></div>
                <button type="button" class="btn btn-sm btn-primary" @onclick="() => _modalDesbloqueo.ShowAsync()">Desbloquear</button>
            }
        </div>

        <fieldset disabled="@(!_desbloqueada)" class="border-0 p-0 m-0">
        <div class="row g-3">
            <div class="col-12 col-lg-8">
                <div class="card h-100">
                    <div class="card-header"><strong>Factura original</strong></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Número de factura</label>
                                <div class="input-group">
                                    <input class="form-control" placeholder="Buscar por número..." @bind="_numeroFactura" @onkeydown="BuscarPorNumeroConEnter" />
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => _modalBuscarFactura.ShowAsync()"><i class="bi bi-search" aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </div>
                        @if (_factura is not null)
                        {
                            <dl class="row small mt-3 mb-0">
                                <dt class="col-3 fw-normal text-secondary">Cliente</dt><dd class="col-9">@_factura.NombreCliente</dd>
                                <dt class="col-3 fw-normal text-secondary">Fecha</dt><dd class="col-9">@_factura.Fecha</dd>
                                <dt class="col-3 fw-normal text-secondary">Total factura</dt><dd class="col-9">@Formato.Importe(_factura.SubTotal)</dd>
                            </dl>

                            <hr />
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Artículo a devolver</label>
                                    <select class="form-select" @bind="_idVentaDetalleSeleccionado" @bind:after="AlSeleccionarLinea">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var linea in _factura.Detalle ?? new List<FacturaDetallesDTO>())
                                        {
                                            <option value="@linea.IdVentaDetalle">@linea.Descripcion (máx. @Formato.Cantidad(linea.Cantidad))@(linea.IdGrupoBonificacion is not null ? " · Bonificación" : "")</option>
                                        }
                                    </select>
                                </div>
                                @if (_lineaSeleccionada is not null)
                                {
                                    <div class="col-6 col-md-2"><label class="form-label">Precio</label><input class="form-control" disabled value="@Formato.Importe(_lineaSeleccionada.PrecioUnit)" /></div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label">Cantidad a devolver</label>
                                        <input type="number" min="0" max="@_lineaSeleccionada.Cantidad" step="0.001" class="form-control" disabled="@(_lineaSeleccionada.IdGrupoBonificacion is not null)" @bind="_cantidadDevolver" @onkeydown="AgregarConEnter" />
                                        @if (_lineaSeleccionada.IdGrupoBonificacion is not null) { <small class="text-secondary">El grupo de bonificación se devuelve completo.</small> }
                                    </div>
                                    <div class="col-6 col-md-2 d-grid"><button type="button" class="btn btn-outline-primary" @onclick="Agregar">Agregar</button></div>
                                    <div class="col-6 col-md-2 d-grid"><button type="button" class="btn btn-outline-secondary" @onclick="AgregarTodos">Agregar todos</button></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card h-100"><div class="card-header"><strong>Totales de la devolución</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-7 fw-normal text-secondary">Sub. gravado</dt><dd class="col-5 text-end">@Formato.Importe(_subtotalGravado)</dd><dt class="col-7 fw-normal text-secondary">Sub. exento</dt><dd class="col-5 text-end">@Formato.Importe(_totales.SubTotal - _subtotalGravado)</dd><dt class="col-7 fw-normal text-secondary">Impuesto</dt><dd class="col-5 text-end">@Formato.Importe(_totales.Impuesto)</dd><dt class="col-7">Total</dt><dd class="col-5 text-end fs-5">@Formato.Importe(_totales.Total)</dd></dl></div></div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><strong>Líneas a devolver</strong></div>
            <div class="card-body p-0">
                @if (_lineas.Count == 0) { <p class="text-secondary text-center py-4 mb-0">Seleccione la factura y agregue los artículos a devolver.</p> }
                else { <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Descripción</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@foreach (var l in _lineas) { <tr><td>@l.Descripcion @if (l.EsDeGrupo) { <span class="badge text-bg-success ms-1">@(l.EsBonificacion ? "Regalo" : "Bonificación")</span> }</td><td class="text-end">@Formato.Cantidad(l.Cantidad)</td><td class="text-end">@Formato.Importe(l.PrecioUnit)</td><td class="text-end fw-semibold">@Formato.Importe(l.Calculo.Total)</td><td class="text-end">@if (!l.EsDeGrupo || l.EsLineaPrincipal) { <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarLinea(l)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button> } else { <span class="text-secondary small">—</span> }</td></tr> }</tbody></table></div> }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><strong>Recepción</strong></div>
            <div class="card-body row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label">Usuario que recibe</label>
                    <select class="form-select" @bind="_idPersonalRecibe">
                        <option value="0">Seleccione...</option>
                        @foreach (var p in _personal) { <option value="@p.IdPersonal">@p.NombrePersonal</option> }
                    </select>
                </div>
                <div class="col-12 col-md-8"><label class="form-label">Notas</label><input class="form-control" @bind="_notas" /></div>
            </div>
        </div>

        <button class="btn btn-primary mt-3" disabled="@(_guardando || _lineas.Count == 0)" @onclick="Registrar">
            <i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>@(_guardando ? "Registrando..." : "Registrar devolución")
        </button>
        </fieldset>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modalDesbloqueo" Title="Desbloquear devoluciones" Size="ModalSize.Regular">
    <BodyTemplate>
        <label class="form-label" for="clave-devolucion">Clave interna</label>
        <input id="clave-devolucion" type="password" class="form-control" autocomplete="current-password" @bind="_claveInterna" @onkeydown="DesbloquearConEnter" />
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-primary" disabled="@_validandoClave" @onclick="Desbloquear">@(_validandoClave ? "Validando..." : "Desbloquear")</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalBuscarFactura" Title="Buscar factura" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">Tipo de factura</label>
                <select class="form-select" @bind="_filtroTipo"><option value="0">Todos</option>@foreach (var t in _tipos) { <option value="@t.Codigo">@t.Descripcion</option> }</select>
            </div>
            <div class="col-12 col-md-4"><label class="form-label">Nombre del cliente</label><input class="form-control" @bind="_filtroCliente" /></div>
            <div class="col-12 col-md-3"><label class="form-label">Fecha</label><input type="date" class="form-control" @bind="_filtroFecha" /></div>
            <div class="col-12 col-md-1 d-grid"><button type="button" class="btn btn-primary" @onclick="BuscarPorFiltro">Buscar</button></div>
        </div>
        @if (_facturasEncontradas.Count == 0) { <p class="text-secondary text-center py-3 mb-0">Sin resultados todavía.</p> }
        else { <div class="list-group">@foreach (var f in _facturasEncontradas) { <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirFacturaEncontrada(f)"><strong>@f.NumFactura</strong><span class="text-secondary ms-2">@f.NombreCliente</span><span class="text-secondary float-end">@f.Fecha.ToString("dd/MM/yyyy")</span></button> }</div> }
    </BodyTemplate>
</HxModal>

<HxModal @ref="_modalBuscarDevoluciones" Title="Devoluciones anteriores" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-4"><label class="form-label">Cliente</label><input class="form-control" @bind="_filtroDevolucionCliente" /></div>
            <div class="col-12 col-md-3"><label class="form-label">Número</label><input class="form-control" @bind="_filtroDevolucionNumero" /></div>
            <div class="col-12 col-md-3"><label class="form-label">Fecha desde</label><input type="date" class="form-control" @bind="_filtroDevolucionFecha" /></div>
            <div class="col-12 col-md-2 d-grid"><button type="button" class="btn btn-primary" @onclick="BuscarDevolucionesAnteriores">Buscar</button></div>
        </div>
        @if (_devolucionesEncontradas.Count == 0) { <p class="text-secondary text-center py-3 mb-0">Sin resultados todavía.</p> }
        else { <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Número</th><th>Fecha</th><th class="text-end">Monto</th></tr></thead><tbody>@foreach (var d in _devolucionesEncontradas) { <tr><td>@d.Devolucion</td><td>@d.Fecha</td><td class="text-end">@Formato.Importe(d.Monto)</td></tr> }</tbody></table></div> }
    </BodyTemplate>
</HxModal>

@code {
    private const string Titulo = "Devoluciones";

    private sealed class LineaDevolucion
    {
        public required long IdVentaDetalle { get; init; }
        public required long Codigo { get; init; }
        public required string Descripcion { get; init; }
        public decimal Cantidad { get; init; }
        public decimal CantVet { get; init; }
        public decimal CantBod { get; init; }
        public decimal PrecioUnit { get; init; }
        public decimal Descuento { get; init; }
        public decimal Impuesto { get; init; }
        public int IdBodega { get; init; }
        public long? IdStockLote { get; init; }

        // §4.5 — bonificación heredada de la factura original.
        public bool EsBonificacion { get; init; }
        public int? IdGrupoBonificacion { get; init; }
        public int? IdConfiguracionBonificacion { get; init; }
        public bool EsLineaPrincipal { get; init; }
        public bool EsDeGrupo => IdGrupoBonificacion is not null;

        public CalculoDocumento.LineaCalculada Calculo { get; set; }
    }

    private HxModal _modalDesbloqueo = default!, _modalBuscarFactura = default!, _modalBuscarDevoluciones = default!;

    private bool _desbloqueada, _validandoClave;
    private string _claveInterna = string.Empty;
    private Usuario? _usuario;

    private List<TipoFactura> _tipos = new();
    private List<PersonalDTO> _personal = new();

    private string _numeroFactura = string.Empty;
    private bool _prefillPendiente;
    private FacturaDTO? _factura;
    private long _idVentaDetalleSeleccionado;
    private FacturaDetallesDTO? _lineaSeleccionada;
    private decimal _cantidadDevolver = 1;
    private readonly List<LineaDevolucion> _lineas = new();
    private CalculoDocumento.TotalesDocumento _totales;
    private decimal _subtotalGravado;

    private int _idPersonalRecibe;
    private string _notas = string.Empty;
    private bool _guardando;

    private int _filtroTipo;
    private string _filtroCliente = string.Empty;
    private DateTime? _filtroFecha;
    private List<FacturaBuscarDevolucionesDTO> _facturasEncontradas = new();

    private string _filtroDevolucionCliente = string.Empty;
    private string _filtroDevolucionNumero = string.Empty;
    private DateTime? _filtroDevolucionFecha;
    private List<DevolucionVentaDTO> _devolucionesEncontradas = new();

    protected override void OnInitialized()
    {
        // La bandeja de documentos abre esta pantalla con ?factura=<nº> para
        // arrancar la devolución de esa factura una vez desbloqueada.
        var uri = Navegacion.ToAbsoluteUri(Navegacion.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("factura", out var valor) && !string.IsNullOrWhiteSpace(valor))
        {
            _numeroFactura = valor.ToString();
            _prefillPendiente = true;
        }
    }

    private async Task DesbloquearConEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await Desbloquear(); }

    private async Task Desbloquear()
    {
        if (string.IsNullOrWhiteSpace(_claveInterna)) { await Dialogos.ErrorAsync("Ingrese la clave interna."); return; }
        _validandoClave = true;
        var r = await Facturas.ValidarClaveInterna(_claveInterna);
        _validandoClave = false;
        if (!r.EsCorrecta || r.Responses is null)
        {
            _claveInterna = string.Empty;
            await Dialogos.ErrorAsync(r.Excepcion ?? "Contraseña incorrecta.");
            return;
        }
        _usuario = r.Responses;
        _claveInterna = string.Empty;
        _desbloqueada = true;
        await _modalDesbloqueo.HideAsync();

        _tipos = (await Respuestas.DatoAsync(await Facturas.Tipos(), "consultar los tipos de factura"))?.ToList() ?? new();
        _personal = (await Respuestas.DatoAsync(await Api.Personal(), "consultar el personal"))?.Where(p => p.Activo).ToList() ?? new();

        if (_prefillPendiente && !string.IsNullOrWhiteSpace(_numeroFactura))
        {
            _prefillPendiente = false;
            var factura = await Respuestas.DatoAsync(await Api.BuscarFacturaPorNumero(_numeroFactura), "buscar la factura");
            CargarFactura(factura);
        }
    }

    private async Task BuscarPorNumeroConEnter(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_numeroFactura)) return;
        var factura = await Respuestas.DatoAsync(await Api.BuscarFacturaPorNumero(_numeroFactura), "buscar la factura");
        CargarFactura(factura);
    }

    private async Task BuscarPorFiltro()
    {
        var filtro = new BuscarFacturaDevolucionesDTO
        {
            Tipo = _filtroTipo > 0 ? _filtroTipo : null,
            NombreCliente = string.IsNullOrWhiteSpace(_filtroCliente) ? null : _filtroCliente,
            Fecha = _filtroFecha?.ToString("yyyy-MM-dd")
        };
        _facturasEncontradas = (await Respuestas.DatoAsync(await Api.BuscarFacturasPorFiltro(filtro), "buscar facturas"))?.ToList() ?? new();
    }

    private async Task ElegirFacturaEncontrada(FacturaBuscarDevolucionesDTO encontrada)
    {
        await _modalBuscarFactura.HideAsync();
        var factura = await Respuestas.DatoAsync(await Api.BuscarFacturaPorId((int)encontrada.Id), "buscar la factura");
        CargarFactura(factura);
    }

    private void CargarFactura(FacturaDTO? factura)
    {
        if (factura is null) return;
        _factura = factura;
        _idVentaDetalleSeleccionado = 0;
        _lineaSeleccionada = null;
        _lineas.Clear();
        RecalcularTotales();
    }

    private void AlSeleccionarLinea()
        => _lineaSeleccionada = _factura?.Detalle?.FirstOrDefault(l => l.IdVentaDetalle == _idVentaDetalleSeleccionado);

    private async Task AgregarConEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await Agregar(); }

    private async Task Agregar()
    {
        if (_lineaSeleccionada is null) return;
        if (_cantidadDevolver <= 0 || _cantidadDevolver > Formato.AImporte(_lineaSeleccionada.Cantidad))
        {
            await Dialogos.ErrorAsync("La cantidad a devolver debe ser mayor a cero y no superar la cantidad original.");
            return;
        }
        AgregarLinea(_lineaSeleccionada, _cantidadDevolver);
        _lineaSeleccionada = null;
        _idVentaDetalleSeleccionado = 0;
        _cantidadDevolver = 1;
    }

    private async Task AgregarTodos()
    {
        if (_factura?.Detalle is null || _factura.Detalle.Count == 0) return;
        if (!await Dialogos.ConfirmarAsync("¿Desea devolver todos los artículos de la factura?")) return;
        foreach (var linea in _factura.Detalle)
        {
            AgregarLinea(linea, Formato.AImporte(linea.Cantidad));
        }
        _lineaSeleccionada = null;
        _idVentaDetalleSeleccionado = 0;
    }

    private void AgregarLinea(FacturaDetallesDTO linea, decimal cantidad)
    {
        // §4.5 — un grupo de bonificación se devuelve entero, a cantidad completa:
        // no se puede devolver solo la línea pagada o solo la de regalo.
        if (linea.IdGrupoBonificacion is int grupo && _factura?.Detalle is not null)
        {
            _lineas.RemoveAll(l => l.IdGrupoBonificacion == grupo);
            foreach (var g in _factura.Detalle.Where(d => d.IdGrupoBonificacion == grupo))
                AgregarLineaBonificacion(g);
            RecalcularTotales();
            return;
        }

        if (_lineas.Any(l => l.IdVentaDetalle == linea.IdVentaDetalle))
        {
            _lineas.RemoveAll(l => l.IdVentaDetalle == linea.IdVentaDetalle);
        }

        var nueva = new LineaDevolucion
        {
            IdVentaDetalle = linea.IdVentaDetalle ?? 0,
            Codigo = linea.CodFxArticulo,
            Descripcion = linea.Descripcion ?? string.Empty,
            Cantidad = cantidad,
            CantVet = Formato.AImporte(linea.CantVen),
            CantBod = Formato.AImporte(linea.CantBod),
            PrecioUnit = Formato.AImporte(linea.PrecioUnit),
            Descuento = Formato.AImporte(linea.Descuento),
            Impuesto = linea.Impuesto,
            IdBodega = linea.IdBodega,
            IdStockLote = linea.Lote > 0 ? linea.Lote : null
        };
        nueva.Calculo = CalculoDocumento.Linea(nueva.Cantidad, nueva.PrecioUnit, nueva.Descuento, nueva.Impuesto);
        _lineas.Add(nueva);
        RecalcularTotales();
    }

    // Devuelve una línea de bonificación con los valores exactos de la factura
    // (la de regalo va a precio 0 con su impuesto real, tal como se emitió).
    private void AgregarLineaBonificacion(FacturaDetallesDTO linea)
    {
        var nueva = new LineaDevolucion
        {
            IdVentaDetalle = linea.IdVentaDetalle ?? 0,
            Codigo = linea.CodFxArticulo,
            Descripcion = linea.Descripcion ?? string.Empty,
            Cantidad = Formato.AImporte(linea.Cantidad),
            CantVet = Formato.AImporte(linea.CantVen),
            CantBod = Formato.AImporte(linea.CantBod),
            PrecioUnit = Formato.AImporte(linea.PrecioUnit),
            Descuento = 0m,
            Impuesto = linea.Impuesto,
            IdBodega = linea.IdBodega,
            EsBonificacion = linea.EsBonificacion,
            IdGrupoBonificacion = linea.IdGrupoBonificacion,
            IdConfiguracionBonificacion = linea.IdConfiguracionBonificacion,
            EsLineaPrincipal = linea.EsLineaPrincipalBonificacion == true,
            Calculo = new CalculoDocumento.LineaCalculada(
                SubTotal: Formato.AImporte(linea.SubTotal),
                MontoDescuento: Formato.AImporte(linea.MontoDescuento),
                MontoImpuesto: Formato.AImporte(linea.MontoImpuesto),
                SubtotalGravado: Formato.AImporte(linea.SubtotalGravado),
                Total: Formato.AImporte(linea.SubTotal) + Formato.AImporte(linea.MontoImpuesto))
        };
        _lineas.Add(nueva);
    }

    private void QuitarLinea(LineaDevolucion linea)
    {
        if (linea.EsDeGrupo)
            _lineas.RemoveAll(l => l.IdGrupoBonificacion == linea.IdGrupoBonificacion);
        else
            _lineas.Remove(linea);
        RecalcularTotales();
    }
    private void RecalcularTotales()
    {
        _totales = CalculoDocumento.Totales(_lineas.Select(l => l.Calculo));
        _subtotalGravado = _lineas.Sum(l => l.Calculo.SubtotalGravado);
    }

    private async Task BuscarDevolucionesAnteriores()
    {
        var filtro = new FiltroFacturaDevVenta
        {
            Cliente = string.IsNullOrWhiteSpace(_filtroDevolucionCliente) ? null : _filtroDevolucionCliente,
            Numero = string.IsNullOrWhiteSpace(_filtroDevolucionNumero) ? null : _filtroDevolucionNumero,
            FechaDesde = _filtroDevolucionFecha?.ToString("yyyy-MM-dd") ?? string.Empty,
            FechaHasta = string.Empty
        };
        _devolucionesEncontradas = (await Respuestas.DatoAsync(await Api.Buscar(filtro), "buscar devoluciones"))?.ToList() ?? new();
    }

    private async Task Registrar()
    {
        if (_factura is null || _lineas.Count == 0 || _guardando) return;
        if (!await Dialogos.ConfirmarAsync("Se registrará la devolución y se afectará el inventario. ¿Desea continuar?")) return;

        _guardando = true;
        var dto = new DevolucionVentaDTO
        {
            IdFactura = _factura.Id,
            SaldoAntFact = _factura.SubTotal,
            SubTotalGravado = (double)_subtotalGravado,
            SubTotalExcento = (double)(_totales.SubTotal - _subtotalGravado),
            Descuento = (double)_totales.Descuento,
            Impuesto = (double)_totales.Impuesto,
            Monto = (double)_totales.Total,
            Fecha = DateTime.Today.ToString("dd/MM/yyyy"),
            CedulaUsuario = Sesion.Usuario,
            CodMoneda = 1,
            Caja = 0,
            Consecutivo = 0,
            Enviadodgt = true,
            MontoDevolucion = (double)_totales.Total,
            NumApertura = 0,
            UsuarioRecibio = _personal.FirstOrDefault(p => p.IdPersonal == _idPersonalRecibe)?.NombrePersonal,
            NotasDevolucion = _notas,
            IdSucursal = Sesion.IdSucursal,
            Detalle = _lineas.Select(l => new DevolucionVentaDetalleDTO
            {
                Codigo = l.Codigo,
                Descripcion = l.Descripcion,
                Cantidad = (double)l.Cantidad,
                CantVet = (double)l.CantVet,
                CantBod = (double)l.CantBod,
                PrecioUnit = (double)l.PrecioUnit,
                Descuento = (double)l.Descuento,
                MontoDescuento = (double)l.Calculo.MontoDescuento,
                Impuesto = (double)l.Impuesto,
                MontoImpuesto = (double)l.Calculo.MontoImpuesto,
                SubtotalGravado = (double)l.Calculo.SubtotalGravado,
                SubTotalExcento = l.Impuesto == 0 ? (double)l.Calculo.SubTotal : 0,
                SubTotal = (double)l.Calculo.SubTotal,
                IdArticuloV = l.IdVentaDetalle.ToString(),
                IdBodega = l.IdBodega,
                IdStockLote = l.IdStockLote,
                EsBonificacion = l.EsBonificacion,
                IdGrupoBonificacion = l.IdGrupoBonificacion,
                IdConfiguracionBonificacion = l.IdConfiguracionBonificacion,
                EsLineaPrincipalBonificacion = l.EsDeGrupo ? l.EsLineaPrincipal : (bool?)null
            }).ToList()
        };

        var r = await Api.Crear(dto);
        _guardando = false;
        if (await Respuestas.CorrectaAsync(r, "registrar la devolución"))
        {
            Dialogos.Exito("Devolución registrada correctamente.");
            Limpiar();
        }
    }

    private void Limpiar()
    {
        _numeroFactura = string.Empty;
        _factura = null;
        _idVentaDetalleSeleccionado = 0;
        _lineaSeleccionada = null;
        _lineas.Clear();
        _idPersonalRecibe = 0;
        _notas = string.Empty;
        RecalcularTotales();
    }
}
