@page "/sales/budgets/seguimiento"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ICotizaciones Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

@*  OLA 1 — replica del ARQUETIPO 02, con filtro por estado.
    Es la pantalla que un agente de ventas abre en el movil para saber que paso con
    sus cotizaciones. Reutiliza el proxy de Proforma sin anadir nada al API.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Movil">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </Acciones>

    <ChildContent>

        <div class="card mb-3 seepos-seguimiento-filtros"><div class="card-header"><i class="bi bi-funnel me-2 text-primary"></i><strong>Filtros de consulta</strong><span class="text-secondary small ms-2">Busque por cliente, número o estado.</span></div><div class="card-body row g-3 align-items-end">
            <div class="col-12 col-md-8">
                <input type="search" class="form-control"
                       placeholder="Cliente o numero..."
                       aria-label="Filtrar cotizaciones"
                       value="@_texto" @oninput="AlEscribir" />
            </div>
            <div class="col-12 col-md-4">
                <select class="form-select" aria-label="Estado"
                        @onchange="AlCambiarEstado">
                    <option value="vigentes">Vigentes</option>
                    <option value="contactada">Contactadas</option>
                    <option value="seguimiento">En seguimiento</option>
                    <option value="negociacion">En negociación</option>
                    <option value="aceptada">Aceptadas</option>
                    <option value="rechazada">Rechazadas</option>
                    <option value="sin-respuesta">Sin respuesta</option>
                    <option value="anuladas">Anuladas</option>
                    <option value="todas">Todas</option>
                </select>
            </div>
        </div></div>

        @if (!_cargado)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando</span>
                </div>
            </div>
        }
        else if (_filtradas.Count == 0)
        {
            <div class="text-center text-secondary py-5 small">
                No hay cotizaciones que coincidan.
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small">
                    @_filtradas.Count de @_todas.Count
                </span>
                <span class="small fw-semibold">
                    Total: <span class="seepos-importe">@Formato.Importe(_total)</span>
                </span>
            </div>

            @* Movil: tarjetas. *@
            <div class="d-md-none d-flex flex-column gap-2">
                @foreach (var c in _filtradas)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span class="fw-semibold small">@c.NombreCliente</span>
                                <span class="seepos-importe small">@Formato.Importe(c.Total)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                <span class="small text-secondary">
                                    <code>@c.Cotizacion1</code> · @c.Fecha.ToString("dd/MM/yyyy")
                                </span>
                                <span class="badge @ClaseEstado(c)">
                                    @Estado(c)
                                </span>
                            </div>
                            @if (PuedeEditarEstado(c))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                                        @onclick="() => AbrirCambioEstado(c)">
                                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Actualizar seguimiento
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Escritorio y tableta: rejilla. *@
            <div class="d-none d-md-block card seepos-seguimiento-resultados">
                <div class="card-body">
                    <AppRejilla TItem="CotizacionesDTO" Datos="Servir"
                                Nivel="NivelPantalla.Tableta" @ref="_rejilla">
                        <Columnas>
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Numero"
                                          ItemTextSelector="@(c => c.Cotizacion1.ToString())"
                                          SortKeySelector="c => c.Cotizacion1" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Fecha"
                                          ItemTextSelector="@(c => c.Fecha.ToString("dd/MM/yyyy"))"
                                          SortKeySelector="c => c.Fecha" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Cliente"
                                          ItemTextSelector="c => c.NombreCliente"
                                          SortKeySelector="c => c.NombreCliente" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Validez"
                                          ItemTextSelector="@(c => $"{c.Validez} dias")" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Total"
                                          ItemTextSelector="@(c => Formato.Importe(c.Total))"
                                          SortKeySelector="c => c.Total"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Estado">
                                <ItemTemplate Context="c">
                                    <span class="badge @ClaseEstado(c)">
                                        @Estado(c)
                                    </span>
                                </ItemTemplate>
                            </HxGridColumn>
                            @if (Sesion.Puede(Codigo, AccionPantalla.Editar))
                            {
                                <HxGridColumn TItem="CotizacionesDTO" HeaderText="Acciones"
                                              HeaderCssClass="text-end" ItemCssClass="text-end">
                                    <ItemTemplate Context="c">
                                        @if (PuedeEditarEstado(c))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    title="Actualizar seguimiento"
                                                    @onclick="() => AbrirCambioEstado(c)">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                <span class="visually-hidden">Actualizar seguimiento</span>
                                            </button>
                                        }
                                    </ItemTemplate>
                                </HxGridColumn>
                            }
                        </Columnas>
                    </AppRejilla>
                </div>
            </div>
        }

    </ChildContent>
</AppPantalla>

<AppModal @ref="_modalEstado" Titulo="Actualizar seguimiento"
          Subtitulo="@(_cotizacionEditando is null ? null : $"Cotización #{_cotizacionEditando.Cotizacion1} · {_cotizacionEditando.NombreCliente}")"
          Tamano="ModalSize.Regular" AlGuardar="GuardarEstado" Guardando="_guardandoEstado"
          PuedeGuardar="@(_cotizacionEditando is not null)" TextoGuardar="Guardar seguimiento">
    @if (_cotizacionEditando is not null)
    {
        <div class="alert alert-light border small">
            Este cambio registra el seguimiento comercial. No anula la cotización ni la convierte en factura.
        </div>
        <div class="mb-3">
            <label class="form-label" for="cotizacion-estado">Estado <span class="text-danger">*</span></label>
            <select id="cotizacion-estado" class="form-select" @bind="_estadoEdicion">
                @foreach (var estado in EstadosEdicion())
                {
                    <option value="@estado">@estado</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="cotizacion-observacion">Nota del seguimiento</label>
            <textarea id="cotizacion-observacion" class="form-control" rows="4"
                      placeholder="Ej.: se llamó al cliente; solicita respuesta el viernes..."
                      @bind="_observacionEdicion"></textarea>
            <div class="form-text">Esta nota queda asociada a la cotización.</div>
        </div>
    }
</AppModal>

@code {
    private const string Titulo = "Seguimiento Cotizaciones";
    private const string Codigo = "PRESUPUESTOS.SEGUIMIENTO_COTIZACIONES";
    private static readonly string[] EstadosSeguimiento =
    {
        "Vigente", "Contactada", "En seguimiento", "En negociación",
        "Aceptada", "Rechazada", "Sin respuesta"
    };

    private AppRejilla<CotizacionesDTO>? _rejilla;
    private AppModal _modalEstado = default!;

    private List<CotizacionesDTO> _todas = new();
    private List<CotizacionesDTO> _filtradas = new();
    private decimal _total;
    private string _texto = string.Empty;
    private string _estado = "vigentes";
    private bool _cargado;
    private CotizacionesDTO? _cotizacionEditando;
    private string _estadoEdicion = "Vigente";
    private string _observacionEdicion = string.Empty;
    private bool _guardandoEstado;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _todas = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar las cotizaciones"))
                 ?.ToList() ?? new List<CotizacionesDTO>();

        _cargado = true;
        Filtrar();
    }

    private async Task Recargar()
    {
        _cargado = false;
        await Cargar();

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private async Task AlEscribir(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? string.Empty;
        Filtrar();

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private async Task AlCambiarEstado(ChangeEventArgs e)
    {
        _estado = e.Value?.ToString() ?? "vigentes";
        Filtrar();

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private void Filtrar()
    {
        IEnumerable<CotizacionesDTO> q = _estado switch
        {
            "anuladas" => _todas.Where(c => c.Anulado),
            "contactada" => _todas.Where(c => EsEstado(c, "Contactada")),
            "seguimiento" => _todas.Where(c => EsEstado(c, "En seguimiento")),
            "negociacion" => _todas.Where(c => EsEstado(c, "En negociación")),
            "aceptada" => _todas.Where(c => EsEstado(c, "Aceptada")),
            "rechazada" => _todas.Where(c => EsEstado(c, "Rechazada")),
            "sin-respuesta" => _todas.Where(c => EsEstado(c, "Sin respuesta")),
            "todas" => _todas,
            _ => _todas.Where(c => !c.Anulado)
        };

        var buscado = Helpers.Texto.Normalizar(_texto);

        if (!string.IsNullOrWhiteSpace(buscado))
        {
            q = q.Where(c =>
                Helpers.Texto.Normalizar(c.NombreCliente).Contains(buscado)
                || c.Cotizacion1.ToString().Contains(buscado));
        }

        _filtradas = q.OrderByDescending(c => c.Fecha).ToList();

        // Los importes llegan en double: se convierten en el borde y se suman en decimal.
        _total = CalculoDocumento.Redondear(
            _filtradas.Sum(c => Formato.AImporte(c.Total)));
    }

    private static string Estado(CotizacionesDTO c)
        => c.Anulado ? "Anulada"
         : c.Venta ? "Convertida en venta"
         : c.Confirmada == true ? "Confirmada"
         : string.IsNullOrWhiteSpace(c.EstadoActual) ? "Vigente"
         : c.EstadoActual.Trim();

    private static string ClaseEstado(CotizacionesDTO c)
        => c.Anulado ? "text-bg-secondary"
         : Estado(c) is "Rechazada" or "Sin respuesta" ? "text-bg-danger"
         : Estado(c) is "Contactada" or "En seguimiento" or "En negociación" ? "text-bg-warning"
         : "text-bg-success";

    private static bool EsEstado(CotizacionesDTO c, string estado)
        => !c.Anulado && string.Equals(Estado(c), estado, StringComparison.OrdinalIgnoreCase);

    private bool PuedeEditarEstado(CotizacionesDTO c)
        => !c.Anulado && Sesion.Puede(Codigo, AccionPantalla.Editar);

    private IEnumerable<string> EstadosEdicion()
    {
        if (!EstadosSeguimiento.Contains(_estadoEdicion, StringComparer.OrdinalIgnoreCase))
            yield return _estadoEdicion;

        foreach (var estado in EstadosSeguimiento)
            yield return estado;
    }

    private async Task AbrirCambioEstado(CotizacionesDTO resumen)
    {
        if (!PuedeEditarEstado(resumen)) return;

        // Se usa el encabezado completo para que el endpoint de edición conserve
        // datos que el listado no necesita mostrar (moneda, condiciones y detalle).
        var cotizacion = await Respuestas.DatoAsync(
            await Api.ObtenerPorId(resumen.Cotizacion1, resumen), "consultar la cotización");
        if (cotizacion is null) return;

        _cotizacionEditando = cotizacion;
        _estadoEdicion = string.IsNullOrWhiteSpace(cotizacion.EstadoActual)
            ? "Vigente" : cotizacion.EstadoActual.Trim();
        _observacionEdicion = cotizacion.ObservacionEstado ?? string.Empty;
        await _modalEstado.MostrarAsync();
    }

    private async Task GuardarEstado()
    {
        if (_cotizacionEditando is null || _guardandoEstado
            || string.IsNullOrWhiteSpace(_estadoEdicion)) return;

        if (!await Dialogos.ConfirmarAsync(
                $"¿Guardar el estado «{_estadoEdicion.Trim()}» para la cotización #{_cotizacionEditando.Cotizacion1}?",
                "Actualizar seguimiento", "Guardar")) return;

        _guardandoEstado = true;
        try
        {
            _cotizacionEditando.EstadoActual = _estadoEdicion.Trim();
            _cotizacionEditando.ObservacionEstado = string.IsNullOrWhiteSpace(_observacionEdicion)
                ? null : _observacionEdicion.Trim();

            if (!await Respuestas.CorrectaAsync(
                    await Api.EditarEncabezado(_cotizacionEditando), "actualizar el seguimiento")) return;

            await _modalEstado.OcultarAsync();
            Dialogos.Exito("Seguimiento actualizado.");
            await Recargar();
        }
        finally
        {
            _guardandoEstado = false;
        }
    }

    private Task<GridDataProviderResult<CotizacionesDTO>> Servir(
        GridDataProviderRequest<CotizacionesDTO> peticion)
        => Task.FromResult(peticion.ApplyTo(_filtradas));
}
