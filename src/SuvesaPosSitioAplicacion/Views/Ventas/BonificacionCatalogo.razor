@page "/sales/bonuses"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.DTOs.Bonificacion
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ICatalogoBonificacion Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta">
    <Acciones>
        <button class="btn btn-sm btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg me-1"></i>Agregar</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar"><i class="bi bi-arrow-clockwise me-1"></i>Recargar</button>
    </Acciones>
    <ChildContent>
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-3">Tipos de bonificación ("compra N, regalo M"). Un tipo deshabilitado no se ofrece al facturar.</p>
                <AppRejilla TItem="ConfiguracionBonificacionDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid" TextoVacio="No hay tipos de bonificación registrados.">
                    <Columnas>
                        <HxGridColumn TItem="ConfiguracionBonificacionDTO" HeaderText="Descripción" ItemTextSelector="x => x.Descripcion" SortKeySelector="x => x.Descripcion" />
                        <HxGridColumn TItem="ConfiguracionBonificacionDTO" HeaderText="Compra" ItemTextSelector="x => x.CantidadVenta.ToString()" />
                        <HxGridColumn TItem="ConfiguracionBonificacionDTO" HeaderText="Regalo" ItemTextSelector="x => x.CantidadBonificable.ToString()" />
                        <HxGridColumn TItem="ConfiguracionBonificacionDTO" HeaderText="Estado">
                            <ItemTemplate Context="x">
                                <span class="badge @(x.Activo ? "text-bg-success" : "text-bg-secondary")">@(x.Activo ? "Activo" : "Inactivo")</span>
                            </ItemTemplate>
                        </HxGridColumn>
                        <HxGridColumn TItem="ConfiguracionBonificacionDTO" HeaderText="" HeaderCssClass="text-end" ItemCssClass="text-end">
                            <ItemTemplate Context="x">
                                <button class="btn btn-sm btn-link p-0" @onclick="() => Editar(x)">Editar</button>
                                @if (x.Activo)
                                {
                                    <button class="btn btn-sm btn-link text-warning p-0 ms-2" @onclick="() => CambiarEstado(x, false)">Deshabilitar</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-link text-success p-0 ms-2" @onclick="() => CambiarEstado(x, true)">Habilitar</button>
                                }
                                <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => Eliminar(x)">Eliminar</button>
                            </ItemTemplate>
                        </HxGridColumn>
                    </Columnas>
                </AppRejilla>
            </div>
        </div>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Regular">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formBonificacion">
                <div class="row g-3">
                    <div class="col-12"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion" Requerido="true" /></div>
                    <div class="col-md-6"><label class="form-label">Cantidad de compra</label><input class="form-control" type="number" min="1" max="100000" @bind="_edicion.CantidadVenta" /></div>
                    <div class="col-md-6"><label class="form-label">Cantidad de regalo</label><input class="form-control" type="number" min="1" max="100000" @bind="_edicion.CantidadBonificable" /></div>
                    <div class="col-12">
                        <div class="form-check"><input id="activo" class="form-check-input" type="checkbox" @bind="_edicion.Activo" /><label class="form-check-label" for="activo">Activo</label></div>
                    </div>
                </div>
                <p class="text-muted small mt-2 mb-0">La cantidad de regalo debe ser menor que la de compra.</p>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" form="formBonificacion" type="submit" disabled="@_guardando">@(_guardando ? "Guardando..." : "Guardar")</button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Titulo = "Catálogo de Bonificaciones";
    private AppRejilla<ConfiguracionBonificacionDTO>? _grid;
    private HxModal _modal = default!;
    private List<ConfiguracionBonificacionDTO> _items = new();
    private ConfiguracionBonificacionDTO? _edicion;
    private bool _nuevo, _cargado, _guardando;

    private string TituloModal => _nuevo ? "Nuevo tipo de bonificación" : "Editar tipo de bonificación";

    private async Task<GridDataProviderResult<ConfiguracionBonificacionDTO>> Cargar(GridDataProviderRequest<ConfiguracionBonificacionDTO> request)
    {
        if (!_cargado)
        {
            _items = (await Respuestas.DatoAsync(await Api.Todas(), "consultar los tipos de bonificación"))?.ToList() ?? new();
            _cargado = true;
        }
        return request.ApplyTo(_items);
    }

    private async Task Recargar()
    {
        _cargado = false;
        if (_grid is not null) await _grid.RefrescarAsync();
    }

    private async Task Nuevo()
    {
        _nuevo = true;
        _edicion = new ConfiguracionBonificacionDTO { Activo = true, CantidadVenta = 1, CantidadBonificable = 1 };
        await _modal.ShowAsync();
    }

    private async Task Editar(ConfiguracionBonificacionDTO item)
    {
        _nuevo = false;
        _edicion = new ConfiguracionBonificacionDTO
        {
            IdConfiguracionBonificacion = item.IdConfiguracionBonificacion,
            Descripcion = item.Descripcion,
            CantidadVenta = item.CantidadVenta,
            CantidadBonificable = item.CantidadBonificable,
            Activo = item.Activo
        };
        await _modal.ShowAsync();
    }

    private async Task Guardar()
    {
        if (_edicion is null || _guardando) return;
        _edicion.Descripcion = _edicion.Descripcion?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_edicion.Descripcion) || _edicion.Descripcion.Length > 130)
        {
            await Dialogos.ErrorAsync("Indique una descripción de hasta 130 caracteres.");
            return;
        }
        if (_edicion.CantidadVenta < 1 || _edicion.CantidadBonificable < 1)
        {
            await Dialogos.ErrorAsync("Las cantidades de compra y de regalo deben ser mayores que cero.");
            return;
        }
        if (_edicion.CantidadBonificable >= _edicion.CantidadVenta)
        {
            await Dialogos.ErrorAsync("La cantidad de regalo debe ser menor que la de compra.");
            return;
        }

        _guardando = true;
        var respuesta = _nuevo ? await Api.Crear(_edicion) : await Api.Editar(_edicion);
        _guardando = false;

        if (await Respuestas.CorrectaAsync(respuesta, _nuevo ? "crear el tipo de bonificación" : "editar el tipo de bonificación"))
        {
            await _modal.HideAsync();
            await Recargar();
        }
    }

    private async Task CambiarEstado(ConfiguracionBonificacionDTO item, bool activar)
    {
        var respuesta = activar
            ? await Api.Habilitar(item.IdConfiguracionBonificacion)
            : await Api.Deshabilitar(item.IdConfiguracionBonificacion);
        if (await Respuestas.CorrectaAsync(respuesta, activar ? "habilitar el tipo de bonificación" : "deshabilitar el tipo de bonificación"))
            await Recargar();
    }

    private async Task Eliminar(ConfiguracionBonificacionDTO item)
    {
        if (!await Dialogos.ConfirmarPeligroAsync($"¿Eliminar el tipo de bonificación '{item.Descripcion}'? Si está en uso por algún artículo o cliente, use Deshabilitar.", "Eliminar tipo de bonificación"))
            return;
        if (await Respuestas.CorrectaAsync(await Api.Eliminar(item.IdConfiguracionBonificacion), "eliminar el tipo de bonificación"))
            await Recargar();
    }
}
