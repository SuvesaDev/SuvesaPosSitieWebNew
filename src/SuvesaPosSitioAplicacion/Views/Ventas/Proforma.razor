@page "/sales/budgets/proforma"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Ventas.Componentes
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ICotizaciones Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject NavigationManager Navegacion
@inject ITarifasPrecio TarifasApi
@inject IInventarioConsulta Inventario
@inject ICatalogoBonificacion CatalogoBonificacion
@inject IClienteBonificacion ClienteBonificacion
@inject IRelojEquipo RelojEquipo
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IClientesConsulta ClientesApi

@*  ARQUETIPO 03 - DOCUMENTO MAESTRO-DETALLE
    =========================================
    El patron que sostiene facturacion, compras y proformas. El mas complejo de los
    cinco, y el unico con implicaciones fiscales.

    Que copiar:
      1. **Los importes se calculan en decimal, siempre.** El API los entrega en
         double; se convierten en el borde con Formato.AImporte y se opera con
         CalculoDocumento. Nunca aritmetica en double.
      2. El calculo vive en Services/CalculoDocumento, no en la pantalla. Asi se
         puede probar sin navegador, y se comparte con facturacion y compras.
      3. Las lineas se anaden con el buscador del arquetipo 04, que devuelve el
         articulo y es la pantalla quien decide que hacer con el.
      4. Al recalcular se recalcula TODO el documento desde las lineas. Nunca se
         ajusta un total sumandole la diferencia: asi es como se desincronizan.
      5. Guardar es una sola llamada con encabezado y detalle juntos.

    Que adaptar: el DTO del documento, los campos del encabezado y las columnas.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Nueva">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nueva
            </button>
        }
    </Acciones>

    <ChildContent>
        @if (_documento is null)
        {
            <div class="card seepos-proformas-lista">
                <div class="card-body">
                    <AppRejilla TItem="CotizacionesDTO" Datos="Cargar"
                                TextoVacio="No hay proformas registradas.">
                        <Columnas>
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Numero"
                                          ItemTextSelector="@(c => c.Cotizacion1.ToString())"
                                          SortKeySelector="c => c.Cotizacion1" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Fecha"
                                          ItemTextSelector="@(c => c.Fecha.ToString("dd/MM/yyyy"))"
                                          SortKeySelector="c => c.Fecha" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Cliente"
                                          ItemTextSelector="c => c.NombreCliente"
                                          SortKeySelector="c => c.NombreCliente" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Total"
                                          ItemTextSelector="@(c => Formato.Importe(c.Total))"
                                          SortKeySelector="c => c.Total"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText="Estado">
                                <ItemTemplate Context="c">
                                    <span class="badge @(c.Venta ? "text-bg-primary" : c.Anulado ? "text-bg-secondary" : "text-bg-success")">
                                        @(c.Venta ? "Facturada" : c.Anulado ? "Anulada" : string.IsNullOrWhiteSpace(c.EstadoActual) ? "Vigente" : c.EstadoActual)
                                    </span>
                                </ItemTemplate>
                            </HxGridColumn>
                            <HxGridColumn TItem="CotizacionesDTO" HeaderText=""
                                          HeaderCssClass="text-end" ItemCssClass="text-end">
                                <ItemTemplate Context="c">
                                    <button class="btn btn-sm btn-outline-primary" title="Abrir proforma" aria-label="Abrir proforma" @onclick="() => Abrir(c)"><i class="bi bi-eye"></i></button>
                                    @if (PuedeFacturar(c))
                                    {
                                        <button class="btn btn-sm btn-success" title="Facturar esta proforma" aria-label="Facturar proforma" @onclick="() => Facturar(c)"><i class="bi bi-receipt"></i></button>
                                    }
                                    @if (c.Cotizacion1 > 0 && Sesion.Puede(Titulo, AccionPantalla.Imprimir))
                                    {
                                        <BotonImprimir Tipo="presupuesto" Id="c.Cotizacion1" SoloIcono="true" Clase="btn-sm btn-outline-secondary" Titulo="Imprimir proforma" />
                                    }
                                </ItemTemplate>
                            </HxGridColumn>
                        </Columnas>
                    </AppRejilla>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@(_documento.Cotizacion1 > 0 ? $"Proforma {_documento.Cotizacion1}" : "Proforma nueva")</span>
                    <span class="d-flex gap-2">
                        @if (_documento.Cotizacion1 > 0 && Sesion.Puede(Titulo, AccionPantalla.Imprimir))
                        {
                            <BotonImprimir Tipo="presupuesto" Id="_documento.Cotizacion1" Texto="Imprimir" />
                        }
                        @if (PuedeFacturar(_documento))
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => Facturar(_documento)"><i class="bi bi-receipt me-1" aria-hidden="true"></i>Facturar</button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Cerrar">Volver</button>
                    </span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6 position-relative">
                            <label class="form-label">Cliente</label>
                            <div class="input-group">
                                <input class="form-control" @bind="_documento.NombreCliente" @bind:event="oninput" @onkeydown="BuscarClienteConEnter" placeholder="Escriba parte del nombre o la cédula" />
                                <button type="button" class="btn btn-outline-primary" @onclick="BuscarCliente"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
                            </div>
                            @if (_clientesEncontrados.Count > 0)
                            {
                                <div class="list-group position-absolute shadow" style="z-index:1050;max-height:14rem;overflow:auto;width:calc(100% - 1.5rem)">
                                    @foreach (var c in _clientesEncontrados)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirCliente(c)"><strong>@c.Nombre</strong><span class="text-secondary ms-2">@c.Cedula</span></button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-3">
                            <AppCampoTexto Etiqueta="Cedula" @bind-Valor="_documento.CedulaCliente" />
                            @if (_ficha is not null)
                            {
                                <div class="form-text">Precio del cliente: <strong>@NombreTarifa</strong>@(_ficha.DescuentoEspecial > 0 ? $" · descuento {Formato.Cantidad(_ficha.DescuentoEspecial)}%" : "")</div>
                            }
                        </div>
                        <div class="col-12 col-md-3">
                            <AppCampoNumero Etiqueta="Validez (dias)" @bind-Valor="_validez" />
                        </div>
                        @if (SucursalClienteVenta.MostrarSelector(_sucursalesCliente))
                        {
                            <div class="col-12 col-md-6">
                                <SelectorSucursalCliente Sucursales="_sucursalesCliente" @bind-Valor="_documento.IdClienteSucursal" Clase="" />
                            </div>
                        }
                        <div class="col-12">
                            <AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_documento.Observaciones" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Detalle</span>
                    <button class="btn btn-sm btn-primary" @onclick="BuscarArticulo">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar articulo
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (_lineas.Count == 0)
                    {
                        <p class="text-secondary small text-center py-4 mb-0">
                            Agregue articulos a la proforma.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Codigo</th>
                                        <th>Descripcion</th>
                                        <th class="seepos-importe" style="width:7rem">Cantidad</th>
                                        <th class="seepos-importe" style="width:9rem">Precio</th>
                                        <th class="seepos-importe" style="width:6rem">Desc. %</th>
                                        <th class="seepos-importe">Impuesto</th>
                                        <th class="seepos-importe">Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in _lineas)
                                    {
                                        <tr>
                                            <td><code class="small">@l.CodArticulo</code></td>
                                            <td class="small">@l.Descripcion
                                                @if (l.EsDeGrupo) { <span class="badge text-bg-success ms-1">@(l.EsBonificacion ? "Regalo" : "Bonificación")</span> }
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                       disabled="@l.EsDeGrupo"
                                                       value="@l.Cantidad"
                                                       @onchange="e => CambiarCantidad(l, e)" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                       disabled="@(!Sesion.PuedeCambiarPrecio || l.EsDeGrupo)"
                                                       title="@(Sesion.PuedeCambiarPrecio ? null : "No tiene permiso para modificar el precio")"
                                                       value="@l.PrecioUnitario"
                                                       @onchange="e => CambiarPrecio(l, e)" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                       disabled="@l.EsDeGrupo"
                                                       value="@l.Descuento"
                                                       @onchange="e => CambiarDescuento(l, e)" />
                                            </td>
                                            <td class="seepos-importe">@Formato.Importe(l.Calculo.MontoImpuesto)</td>
                                            <td class="seepos-importe">@Formato.Importe(l.Calculo.Total)</td>
                                            <td class="text-end">
                                                @if (!l.EsDeGrupo || l.EsLineaPrincipal)
                                                {
                                                    <button class="btn btn-sm btn-link text-danger p-0"
                                                            aria-label="Quitar" @onclick="() => Quitar(l)">
                                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6 offset-md-6">
                    <div class="card">
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-7 fw-normal text-secondary">Subtotal</dt>
                                <dd class="col-5 seepos-importe">@Formato.Importe(_totales.SubTotal)</dd>

                                <dt class="col-7 fw-normal text-secondary">Descuento</dt>
                                <dd class="col-5 seepos-importe">@Formato.Importe(_totales.Descuento)</dd>

                                <dt class="col-7 fw-normal text-secondary">Impuesto</dt>
                                <dd class="col-5 seepos-importe">@Formato.Importe(_totales.Impuesto)</dd>

                                <dt class="col-7 fw-semibold">Total</dt>
                                <dd class="col-5 seepos-importe fw-semibold">@Formato.Importe(_totales.Total)</dd>
                            </dl>

                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-primary flex-grow-1" @onclick="Guardar"
                                        disabled="@(_guardando || _lineas.Count == 0)">
                                    <i class="bi bi-check2-circle me-1"></i>@(_guardando ? "Guardando..." : "Guardar")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</AppPantalla>

<AppBuscadorArticulo @ref="_buscador" AlElegir="AgregarLinea" TiposPermitidos="TiposVendibles" PrecioDe="PrecioCliente" />

<FlujoBonificacion @ref="_flujoBonificacion" Configs="_configsBonificacion" BonificacionesCliente="_bonificacionesCliente"
                   PrecioDe="PrecioCliente" AsegurarPrecios="AsegurarPreciosTarifa"
                   AlAplicar="AplicarGrupoBonificacion" AlOmitir="AgregarSinBonificacion" />

@code {
    private const string Titulo = "Proformas o Cotización";

    // Solo se cotiza Normal (1) y Producto terminado (3); la materia prima (2) no se vende.
    private static readonly int[] TiposVendibles = { 1, 3 };

    /// <summary>Una linea en edicion. Los importes viven en decimal, no en double.</summary>
    private sealed class Linea
    {
        public long Numero { get; init; }
        public string? CodArticulo { get; init; }
        public long Codigo { get; init; }
        public string? Cabys { get; init; }
        public string? Descripcion { get; init; }
        public decimal PrecioCosto { get; init; }
        public decimal PrecioBase { get; init; }
        public decimal PrecioFlete { get; init; }
        public decimal PrecioOtros { get; init; }
        public string? SubFamilia { get; init; }
        public decimal MaxDescuento { get; set; }
        public decimal TipoCambioValorCompra { get; init; }
        public int CodMonedaVenta { get; init; }
        public decimal Cantidad { get; set; } = 1;
        public decimal PrecioUnitario { get; set; }
        public decimal Descuento { get; set; }
        public decimal Impuesto { get; set; }

        // Bonificación (mismas marcas que en Facturación): las líneas de un grupo no se editan; solo la principal se quita.
        public int? IdGrupoBonificacion { get; set; }
        public int? IdConfiguracionBonificacion { get; set; }
        public bool EsBonificacion { get; set; }          // línea de regalo (precio 0, impuesto sobre el precio de lista)
        public bool EsLineaPrincipal { get; set; }
        public decimal PrecioReferencia { get; set; }      // precio de lista de la línea de regalo
        public bool EsDeGrupo => IdGrupoBonificacion is not null;

        public CalculoDocumento.LineaCalculada Calculo { get; private set; }

        public void Recalcular()
            => Calculo = EsBonificacion
                ? CalculoDocumento.LineaBonificada(Cantidad, PrecioReferencia, Impuesto)
                : CalculoDocumento.Linea(Cantidad, PrecioUnitario, Descuento, Impuesto);
    }

    private AppBuscadorArticulo _buscador = default!;
    private FlujoBonificacion _flujoBonificacion = default!;
    private List<ConfiguracionBonificacion> _configsBonificacion = new();
    private List<ClienteBonificacionConfiguracionDTO> _bonificacionesCliente = new();
    private int _siguienteIdGrupo = 1;

    protected override async Task OnInitializedAsync()
        => _configsBonificacion = (await Respuestas.DatoAsync(await CatalogoBonificacion.Disponibles(), "consultar los tipos de bonificación"))?.ToList() ?? new();

    /// <summary>Asignaciones de bonificación del cliente (mandan sobre las del artículo). Solo si el cliente las tiene.</summary>
    private async Task CargarBonificacionesCliente()
    {
        _bonificacionesCliente = new();
        if (_ficha is { TieneBonificacion: true } f)
            _bonificacionesCliente = (await Respuestas.DatoAsync(await ClienteBonificacion.ObtenerPorCliente(f.Cedula, f.Identificacion), "consultar la bonificación del cliente"))
                ?.ToList() ?? new();
    }

    private List<CotizacionesDTO> _proformas = new();
    private bool _cargado;

    private CotizacionesDTO? _documento;
    private List<DTOs.Generated.FiltranClienteDTO> _clientesEncontrados = new();
    private readonly List<Linea> _lineas = new();
    private CalculoDocumento.TotalesDocumento _totales;
    private int? _validez = 15;
    private bool _guardando;

    private async Task BuscarClienteConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarCliente();
    }

    private async Task BuscarCliente()
    {
        if (_documento is null) return;
        var t = (_documento.NombreCliente ?? string.Empty).Trim();
        if (t.Length < 2)
        {
            _clientesEncontrados = new();
            await Dialogos.ErrorAsync("Escriba al menos 2 caracteres del nombre o la cédula del cliente.");
            return;
        }
        var clientes = await Respuestas.DatoAsync(await ClientesApi.Buscar(t), "buscar clientes");
        _clientesEncontrados = (clientes ?? Array.Empty<DTOs.Generated.FiltranClienteDTO>()).Where(c => !c.Anulado).Take(25).ToList();
        if (_clientesEncontrados.Count == 0)
            await Dialogos.ErrorAsync($"Ningún cliente coincide con «{t}».");
    }

    // --- Precio y descuento del cliente: MISMAS reglas que Facturación (Services/ReglasPrecioCliente) ---
    private DTOs.Generated.FiltranClienteDTO? _ficha;
    private DateTime _hoy = DateTime.Today;
    private readonly Dictionary<(int Tarifa, long Articulo), decimal> _preciosTarifaNueva = new();

    private int Tarifa => ReglasPrecioCliente.TarifaDelCliente(_ficha?.Tipoprecio ?? 0);
    private string NombreTarifa => Tarifa switch { 1 => "Precio A", 2 => "Precio B", 3 => "Precio C", 4 => "Precio D", _ => $"Tarifa {Tarifa}" };

    private decimal? PrecioTarifaNueva(long articulo)
        => Tarifa > 4 && _preciosTarifaNueva.TryGetValue((Tarifa, articulo), out var precio) && precio > 0 ? precio : null;

    private decimal PrecioCliente(InventarioDTO articulo)
        => ReglasPrecioCliente.PrecioLista(articulo, Tarifa, PrecioTarifaNueva(articulo.Codigo), _hoy);

    /// <summary>Si la tarifa del cliente es una de las nuevas (5 o más), trae el precio de esos artículos en ella.</summary>
    private async Task AsegurarPreciosTarifa(IEnumerable<long> ids)
    {
        var tarifa = Tarifa;
        if (tarifa <= 4) return;
        var faltan = ids.Distinct().Where(id => !_preciosTarifaNueva.ContainsKey((tarifa, id))).ToList();
        if (faltan.Count == 0) return;
        var r = await TarifasApi.PreciosEnTarifa((short)tarifa, faltan);
        if (!r.EsCorrecta || r.Responses is null)
        {
            Dialogos.Advertencia($"No se pudo consultar el precio de la tarifa del cliente. Se usará el Precio A; revise los precios de la proforma.");
            return;
        }
        foreach (var id in faltan) _preciosTarifaNueva[(tarifa, id)] = 0m;
        foreach (var p in r.Responses) _preciosTarifaNueva[(tarifa, p.IdArticulo)] = p.Precio;
    }

    // Sucursal del cliente a la que se cotiza (Facturación la respeta al facturar). Obligatoria solo si el cliente tiene varias.
    private List<DTOs.Generated.ClienteDatosSucursalDTO> _sucursalesCliente = new();

    private async Task CargarSucursalesCliente(bool conservarActual)
    {
        _sucursalesCliente = new();
        if (_documento is null || !long.TryParse(_documento.CodCliente, out var idCliente) || idCliente <= 0) return;
        var r = await ClientesApi.DatosSucursal(idCliente);
        if (r.EsCorrecta && r.Responses is not null) _sucursalesCliente = r.Responses.ToList();
        _documento.IdClienteSucursal = SucursalClienteVenta.Predeterminada(_sucursalesCliente, conservarActual ? _documento.IdClienteSucursal : null);
    }

    private async Task CargarFichaCliente()
    {
        _ficha = null;
        if (_documento is null || string.IsNullOrWhiteSpace(_documento.CodCliente)) return;
        var texto = !string.IsNullOrWhiteSpace(_documento.CedulaCliente) ? _documento.CedulaCliente : _documento.NombreCliente;
        if (string.IsNullOrWhiteSpace(texto)) return;
        var r = await ClientesApi.Buscar(texto!);
        _ficha = r.EsCorrecta ? (r.Responses ?? Array.Empty<DTOs.Generated.FiltranClienteDTO>())
            .FirstOrDefault(c => c.Identificacion.ToString() == _documento.CodCliente) : null;
    }

    private async Task ElegirCliente(DTOs.Generated.FiltranClienteDTO c)
    {
        if (_documento is null) return;
        var habiaLineas = _lineas.Count > 0;
        if (habiaLineas && !await Dialogos.ConfirmarAsync(
                "Cambiar el cliente recalcula el precio y el descuento de las líneas según su tarifa. ¿Continuar?", "Cambiar cliente"))
            return;

        _documento.NombreCliente = c.Nombre;
        _documento.CedulaCliente = c.Cedula;
        _documento.CodCliente = c.Identificacion.ToString();
        _ficha = c;
        _clientesEncontrados = new();
        _documento.IdClienteSucursal = null;
        await CargarSucursalesCliente(conservarActual: false);
        await CargarBonificacionesCliente();
        if (habiaLineas) await RecalcularPreciosSegunCliente();
    }

    /// <summary>Con otro cliente, cada línea vuelve al precio y al descuento que le corresponden por su tarifa.</summary>
    private async Task RecalcularPreciosSegunCliente()
    {
        await AsegurarPreciosTarifa(_lineas.Where(l => !l.EsDeGrupo).Select(l => l.Codigo));
        if (_lineas.Any(l => l.EsDeGrupo))
            Dialogos.Advertencia("Las líneas de bonificación conservan su precio; vuelva a aplicar la bonificación si el nuevo cliente tiene otra tarifa.");
        foreach (var linea in _lineas.Where(l => !l.EsDeGrupo))
        {
            var r = await Inventario.Uno(linea.Codigo);
            if (!r.EsCorrecta || r.Responses is null) continue;
            linea.PrecioUnitario = PrecioCliente(r.Responses);
            linea.MaxDescuento = Formato.AImporte(r.Responses.Max_Descuento);
            linea.Descuento = ReglasPrecioCliente.DescuentoInicial(_ficha?.DescuentoEspecial, r.Responses.Max_Descuento);
            linea.Recalcular();
        }
        Recalcular();
    }

    private async Task<GridDataProviderResult<CotizacionesDTO>> Cargar(
        GridDataProviderRequest<CotizacionesDTO> peticion)
    {
        if (!_cargado)
        {
            _proformas = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar las proformas"))
                         ?.ToList() ?? new List<CotizacionesDTO>();
            _cargado = true;
        }

        return peticion.ApplyTo(_proformas);
    }

    private async Task Nueva()
    {
        _hoy = await RelojEquipo.HoyAsync();
        _ficha = null;
        _sucursalesCliente = new();
        _bonificacionesCliente = new();
        _documento = new CotizacionesDTO { Fecha = _hoy, IdSucursal = Sesion.IdSucursal };
        _lineas.Clear();
        Recalcular();
    }

    private async Task Abrir(CotizacionesDTO resumen)
    {
        var completa = await Respuestas.DatoAsync(
            await Api.ObtenerPorId(resumen.Cotizacion1, resumen), "abrir la proforma");

        if (completa is null)
        {
            return;
        }

        _documento = completa;
        _validez = completa.Validez;
        _hoy = await RelojEquipo.HoyAsync();
        await CargarFichaCliente();
        await CargarSucursalesCliente(conservarActual: true);
        await CargarBonificacionesCliente();
        _lineas.Clear();

        foreach (var d in completa.Detalle ?? new List<DetalleCotizacionDTO>())
        {
            // Aqui esta el borde: lo que llega en double se pasa a decimal una vez,
            // y a partir de aqui todo el calculo es decimal.
            var linea = new Linea
            {
                Numero = d.Numero,
                CodArticulo = d.CodArticulo,
                Codigo = d.Codigo,
                Cabys = d.Cabys,
                Descripcion = d.Descripcion,
                PrecioCosto = Formato.AImporte(d.PrecioCosto),
                PrecioBase = Formato.AImporte(d.PrecioBase),
                PrecioFlete = Formato.AImporte(d.PrecioFlete),
                PrecioOtros = Formato.AImporte(d.PrecioOtros),
                SubFamilia = d.SubFamilia,
                MaxDescuento = Formato.AImporte(d.MaxDescuento),
                TipoCambioValorCompra = Formato.AImporte(d.TipoCambioValorCompra),
                CodMonedaVenta = d.CodMonedaVenta,
                Cantidad = Formato.AImporte(d.Cantidad),
                PrecioUnitario = Formato.AImporte(d.PrecioUnit),
                Descuento = Formato.AImporte(d.Descuento),
                Impuesto = Formato.AImporte(d.Impuesto),
                IdGrupoBonificacion = d.IdGrupoBonificacion,
                IdConfiguracionBonificacion = d.IdConfiguracionBonificacion,
                EsBonificacion = d.EsBonificacion,
                EsLineaPrincipal = d.EsLineaPrincipalBonificacion == true,
                PrecioReferencia = Formato.AImporte(d.PrecioReferenciaBonificacion)
            };

            linea.Recalcular();
            _lineas.Add(linea);
        }

        Recalcular();
    }

    /// <summary>Solo una proforma ACEPTADA, sin facturar y no anulada, y solo quien puede facturar.</summary>
    private bool PuedeFacturar(CotizacionesDTO c)
        => c.Cotizacion1 > 0 && !c.Anulado && !c.Venta
           && string.Equals(c.EstadoActual?.Trim(), "Aceptada", StringComparison.OrdinalIgnoreCase)
           && Sesion.Puede("Facturación", AccionPantalla.Crear);

    /// <summary>Abre Facturación con la proforma cargada (mismo proceso, mismas reglas: no se duplica nada).</summary>
    private void Facturar(CotizacionesDTO c) => Navegacion.NavigateTo($"/sales/billing/from-proforma/{c.Cotizacion1}");

    private void Cerrar()
    {
        _documento = null;
        _lineas.Clear();
    }

    private Task BuscarArticulo() => _buscador.AbrirAsync();

    private async Task AgregarLinea(InventarioDTO articulo)
    {
        await AsegurarPreciosTarifa(new[] { articulo.Codigo });
        // Artículo bonificable: si el cliente o el artículo tienen una bonificación, el flujo toma el control.
        if (articulo.Bonificado && await _flujoBonificacion.IniciarAsync(articulo, 1)) return;
        AgregarSinBonificacion((articulo, 1m));
    }

    private Task AgregarSinBonificacion((InventarioDTO Articulo, decimal Cantidad) pedido)
    {
        var articulo = pedido.Articulo;
        var existente = _lineas.FirstOrDefault(l => l.Codigo == articulo.Codigo);

        if (existente is not null)
        {
            // Repetir un articulo suma cantidad en vez de crear otra linea, que es
            // como se comporta el sistema actual.
            existente.Cantidad += pedido.Cantidad;
            existente.Recalcular();
            Recalcular();
            return Task.CompletedTask;
        }

        var linea = new Linea
        {
            CodArticulo = articulo.Cod_Articulo,
            Codigo = articulo.Codigo,
            Cabys = articulo.Codcabys,
            Descripcion = articulo.Descripcion,
            PrecioCosto = Formato.AImporte(articulo.Costo),
            PrecioBase = Formato.AImporte(articulo.Costo),
            PrecioFlete = Formato.AImporte(articulo.Costo),
            PrecioOtros = Formato.AImporte(articulo.OtrosCargos),
            SubFamilia = articulo.SubFamilia.ToString(),
            MaxDescuento = Formato.AImporte(articulo.Max_Descuento),
            TipoCambioValorCompra = Formato.AImporte(_documento?.TipoCambio ?? 0),
            CodMonedaVenta = articulo.MonedaVenta,
            Cantidad = pedido.Cantidad,
            PrecioUnitario = PrecioCliente(articulo),
            Descuento = ReglasPrecioCliente.DescuentoInicial(_ficha?.DescuentoEspecial, articulo.Max_Descuento),
            Impuesto = Formato.AImporte(articulo.IVenta)
        };

        linea.Recalcular();
        _lineas.Add(linea);
        Recalcular();
        return Task.CompletedTask;
    }

    /// <summary>El grupo de bonificación ya está resuelto (mismas reglas que Facturación): se agregan sus líneas.</summary>
    private Task AplicarGrupoBonificacion(FlujoBonificacion.GrupoBonificado grupo)
    {
        var idGrupo = Math.Max(_siguienteIdGrupo, _lineas.Select(l => l.IdGrupoBonificacion ?? 0).DefaultIfEmpty(0).Max() + 1);
        _siguienteIdGrupo = idGrupo + 1;

        foreach (var lg in grupo.Lineas)
        {
            var a = lg.Articulo;
            var linea = new Linea
            {
                CodArticulo = a.Cod_Articulo,
                Codigo = a.Codigo,
                Cabys = a.Codcabys,
                Descripcion = a.Descripcion,
                PrecioCosto = Formato.AImporte(a.Costo),
                PrecioBase = Formato.AImporte(a.Costo),
                PrecioFlete = Formato.AImporte(a.Costo),
                PrecioOtros = Formato.AImporte(a.OtrosCargos),
                SubFamilia = a.SubFamilia.ToString(),
                MaxDescuento = 0m,
                TipoCambioValorCompra = Formato.AImporte(_documento?.TipoCambio ?? 0),
                CodMonedaVenta = a.MonedaVenta,
                Cantidad = lg.Cantidad,
                PrecioUnitario = lg.EsBonificacion ? 0m : lg.PrecioUnit,
                Descuento = 0m,
                Impuesto = lg.PorcentajeImpuesto,
                IdGrupoBonificacion = idGrupo,
                IdConfiguracionBonificacion = grupo.IdConfiguracion,
                EsBonificacion = lg.EsBonificacion,
                PrecioReferencia = lg.PrecioUnit,
                EsLineaPrincipal = lg.EsPrincipal,
            };
            linea.Recalcular();
            _lineas.Add(linea);
        }
        Recalcular();
        return Task.CompletedTask;
    }

    private void Quitar(Linea linea)
    {
        // Solo la línea principal de un grupo de bonificación se puede quitar; borra el grupo completo.
        if (linea.EsDeGrupo)
        {
            if (!linea.EsLineaPrincipal) return;
            _lineas.RemoveAll(l => l.IdGrupoBonificacion == linea.IdGrupoBonificacion);
        }
        else
        {
            _lineas.Remove(linea);
        }
        Recalcular();
    }

    private void CambiarCantidad(Linea l, ChangeEventArgs e)
    {
        l.Cantidad = Leer(e, l.Cantidad);
        l.Recalcular();
        Recalcular();
    }

    private void CambiarPrecio(Linea l, ChangeEventArgs e)
    {
        if (!Sesion.PuedeCambiarPrecio) return;
        l.PrecioUnitario = Leer(e, l.PrecioUnitario);
        l.Recalcular();
        Recalcular();
    }

    private void CambiarDescuento(Linea l, ChangeEventArgs e)
    {
        var pedido = Leer(e, l.Descuento);
        if (pedido > l.MaxDescuento)
        {
            Dialogos.ErrorBreve($"El descuento máximo de este artículo es {Formato.Cantidad(l.MaxDescuento)}%.");
            pedido = l.MaxDescuento;
        }
        l.Descuento = pedido;
        l.Recalcular();
        Recalcular();
    }

    private static decimal Leer(ChangeEventArgs e, decimal actual)
        => decimal.TryParse(e.Value?.ToString(), out var v) && v >= 0 ? v : actual;

    /// <summary>
    /// Recalcula el documento ENTERO desde las lineas. Nunca se ajusta un total
    /// sumandole la diferencia: asi es como encabezado y detalle se desincronizan.
    /// </summary>
    private void Recalcular()
        => _totales = CalculoDocumento.Totales(_lineas.Select(l => l.Calculo));

    private async Task Guardar()
    {
        if (_documento is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_documento.NombreCliente))
        {
            await Dialogos.ErrorAsync("Indique el cliente.");
            return;
        }

        if (SucursalClienteVenta.Validar(_sucursalesCliente, _documento.IdClienteSucursal) is { } errorSucursal)
        {
            await Dialogos.ErrorAsync(errorSucursal);
            return;
        }

        _guardando = true;
        try
        {
            _documento.Validez = _validez ?? 0;
            _documento.SubTotal = (double)_totales.SubTotal;
            _documento.Descuento = (double)_totales.Descuento;
            _documento.PagoImpuesto = (double)_totales.Impuesto;
            _documento.Total = (double)_totales.Total;

            _documento.Detalle = _lineas.Select(l => new DetalleCotizacionDTO
            {
                Numero = l.Numero,
                Cotizacion = _documento.Cotizacion1,
                Codigo = l.Codigo,
                CodArticulo = l.CodArticulo,
                Cabys = l.Cabys,
                Descripcion = l.Descripcion,
                PrecioCosto = (double)l.PrecioCosto,
                PrecioBase = (double)l.PrecioBase,
                PrecioFlete = (double)l.PrecioFlete,
                PrecioOtros = (double)l.PrecioOtros,
                Cantidad = (double)l.Cantidad,
                PrecioUnit = (double)l.PrecioUnitario,
                Descuento = (double)l.Descuento,
                MontoDescuento = (double)l.Calculo.MontoDescuento,
                Impuesto = (double)l.Impuesto,
                MontoImpuesto = (double)l.Calculo.MontoImpuesto,
                SubTotal = (double)l.Calculo.SubTotal,
                SubtotalGravado = (double)l.Calculo.SubtotalGravado,
                SubTotalExcento = l.Impuesto == 0 ? (double)l.Calculo.SubtotalGravado : 0,
                Total = (double)l.Calculo.Total,
                SubFamilia = l.SubFamilia,
                MaxDescuento = (double)l.MaxDescuento,
                TipoCambioValorCompra = (double)l.TipoCambioValorCompra,
                CodMonedaVenta = l.CodMonedaVenta,
                EsBonificacion = l.EsBonificacion,
                IdGrupoBonificacion = l.IdGrupoBonificacion,
                IdConfiguracionBonificacion = l.IdConfiguracionBonificacion,
                EsLineaPrincipalBonificacion = l.EsDeGrupo ? l.EsLineaPrincipal : null,
                PrecioReferenciaBonificacion = (double)l.PrecioReferencia
            }).ToList();

            var r = _documento.Cotizacion1 > 0
                ? await Api.EditarEncabezado(_documento)
                : await Api.Crear(_documento);

            if (await Respuestas.CorrectaAsync(r, "guardar la proforma"))
            {
                Dialogos.Exito("Proforma guardada.");
                _cargado = false;
                // Al volver al listado se crea una rejilla nueva y Cargar consulta
                // una sola vez porque _cargado es false. No se intenta refrescar la
                // rejilla anterior, que ya fue desmontada al entrar al editor.
                Cerrar();
            }
        }
        finally
        {
            // Ningún error de transporte o render puede dejar el botón bloqueado
            // indefinidamente en «Guardando…».
            _guardando = false;
        }
    }
}
