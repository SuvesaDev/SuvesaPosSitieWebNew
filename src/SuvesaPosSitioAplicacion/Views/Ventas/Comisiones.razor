@page "/sales/commissions"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Comisiones
@using SuvesaPosSitioAplicacion.DTOs.Rutas
@using SuvesaPosSitioAplicacion.Security
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IComisiones Api
@inject IRutasComerciales RutasApi
@inject IContextoSesion Sesion
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IJSRuntime JS

<AppPantalla Pantalla="Comisiones" Codigo="VENTAS.COMISIONES" Icono="bi-cash-coin" Subtitulo="Comisiones de facturas aceptadas y totalmente canceladas.">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(!_datos.Movimientos.Any())" @onclick="Exportar"><i class="bi bi-filetype-csv me-1"></i>Exportar CSV</button>
        <button class="btn btn-sm btn-outline-success" disabled="@(!_datos.Movimientos.Any() || _exportandoXlsx)" @onclick="ExportarXlsx"><i class="bi bi-file-earmark-excel me-1"></i>@(_exportandoXlsx ? "Generando..." : "Exportar XLSX")</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Cargar"><i class="bi bi-arrow-clockwise"></i></button>
    </Acciones>
    <ChildContent>
        <div class="card mb-3"><div class="card-body"><div class="row g-3 align-items-end">
            <div class="col-12 col-md-3"><AppCampoFecha Etiqueta="Desde" @bind-Valor="_desde" /></div>
            <div class="col-12 col-md-3"><AppCampoFecha Etiqueta="Hasta" @bind-Valor="_hasta" /></div>
            <div class="col-12 col-md-3"><label class="form-label">Estado</label><select class="form-select" @bind="_estado"><option value="">Todos</option><option>Pendiente</option><option>Liquidada</option></select></div>
            <div class="col-12 col-md-3"><label class="form-label">Ruta comercial</label><select class="form-select" @bind="_idRutaComercial"><option value="0">Todas</option>@foreach (var ruta in _rutas) { <option value="@ruta.IdRuta">@ruta.Nombre</option> }</select></div>
            <div class="col-12 col-md-3"><label class="form-label">Beneficiario</label><select class="form-select" @bind="_idUsuarioBeneficiario"><option value="">Todos</option>@foreach (var b in _beneficiarios) { <option value="@b.IdUsuarioBeneficiario">@b.Beneficiario (@b.TipoBeneficiario)</option> }</select></div>
            <div class="col-12 col-md-3"><label class="form-label">N° de corte</label><input type="number" min="1" class="form-control" placeholder="Todos" @bind="_idCorte" /><div class="form-text">Re-consulta exactamente lo liquidado en un corte ya cerrado.</div></div>
            <div class="col-12 col-md-6 d-flex gap-2 align-self-end"><button class="btn btn-primary flex-grow-1" @onclick="Cargar"><i class="bi bi-search me-1"></i>Consultar</button><button class="btn btn-outline-success" disabled="@(!_datos.Movimientos.Any(m => m.EstadoLiquidacion == "Pendiente"))" @onclick="Cerrar"><i class="bi bi-lock me-1"></i>Cerrar período</button></div>
        </div></div></div>
        <div class="card mb-3"><div class="card-header"><strong>Resumen por beneficiario</strong></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th>Beneficiario</th><th>Tipo</th><th class="text-end">Movimientos</th><th class="text-end">Total</th></tr></thead><tbody>
        @foreach (var r in _datos.Resumen) { <tr><td>@r.Beneficiario</td><td><span class="badge text-bg-light border">@r.TipoBeneficiario</span></td><td class="text-end">@r.Movimientos</td><td class="text-end fw-semibold">@r.Importe.ToString("N2")</td></tr> }
        @if (!_datos.Resumen.Any()) { <tr><td colspan="4" class="text-secondary">No hay comisiones que cumplan los filtros. Las facturas de crédito y contado solo aparecen tras su cancelación total.</td></tr> }
        </tbody></table></div></div></div>
        <div class="card"><div class="card-header d-flex justify-content-between align-items-center"><strong>Detalle auditable</strong><span class="text-secondary small">@_datos.Movimientos.Count movimiento(s)</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Documento</th><th>Cliente</th><th>Ruta comercial</th><th>Beneficiario</th><th>Artículo</th><th class="text-end">Base</th><th class="text-end">%</th><th class="text-end">Comisión</th><th>Estado</th></tr></thead><tbody>
        @foreach (var m in _datos.Movimientos)
        {
            <tr>
                <td class="text-nowrap">
                    @m.Fecha.ToLocalTime().ToString("dd/MM/yyyy")
                    <small class="text-secondary d-block">@m.Fecha.ToLocalTime().ToString("HH:mm")</small>
                </td>
                <td class="text-nowrap"><span class="badge text-bg-light font-monospace fw-normal">@m.Documento</span></td>
                <td>
                    @m.Cliente
                    @if (!string.IsNullOrWhiteSpace(m.NombreComercial) && m.NombreComercial != m.Cliente)
                    {
                        <small class="text-secondary d-block">@m.NombreComercial</small>
                    }
                </td>
                <td class="text-nowrap">@m.RutaComercial</td>
                <td class="text-nowrap">
                    @m.Beneficiario
                    <small class="text-secondary d-block">@m.TipoBeneficiario</small>
                </td>
                <td>@m.Articulo</td>
                <td class="text-end text-nowrap">@m.Base.ToString("N2")</td>
                <td class="text-end text-nowrap">@m.Porcentaje.ToString("N2")%</td>
                <td class="text-end text-nowrap fw-semibold">@m.Importe.ToString("N2")</td>
                <td class="text-nowrap"><span class="badge @(m.EstadoLiquidacion == "Liquidada" ? "text-bg-secondary" : "text-bg-success")">@m.EstadoLiquidacion</span></td>
            </tr>
        }
        @if (!_datos.Movimientos.Any()) { <tr><td colspan="10" class="text-secondary">Sin movimientos.</td></tr> }
        </tbody></table></div></div></div>
    </ChildContent>
</AppPantalla>

@code {
    private DateTime? _desde = DateTime.Today.AddMonths(-1), _hasta = DateTime.Today;
    private string _estado = string.Empty;
    private int _idRutaComercial;
    private string _idUsuarioBeneficiario = string.Empty;
    private long? _idCorte;
    private IReadOnlyList<RutaComercialDTO> _rutas = Array.Empty<RutaComercialDTO>();
    private ComisionConsultaDTO _datos = new();
    private bool _exportandoXlsx;
    /// <summary>Beneficiarios para el filtro: se arman con el último resultado consultado
    /// (no hay un catálogo propio de "todos los beneficiarios posibles"), así que la
    /// lista se conserva entre consultas para no perder la opción ya elegida.</summary>
    private readonly Dictionary<string, ResumenComisionDTO> _beneficiariosVistos = new();
    private IEnumerable<ResumenComisionDTO> _beneficiarios => _beneficiariosVistos.Values.OrderBy(b => b.Beneficiario);

    protected override async Task OnInitializedAsync()
    {
        _rutas = (await Respuestas.DatoAsync(await RutasApi.Listar(Sesion.IdSucursal), "consultar las rutas comerciales")) ?? Array.Empty<RutaComercialDTO>();
        await Cargar();
    }

    private FiltroComisionesDTO FiltroActual() => new()
    {
        Desde = _desde, Hasta = _hasta, IdSucursal = Sesion.IdSucursal, EstadoLiquidacion = _estado,
        IdRutaComercial = _idRutaComercial > 0 ? _idRutaComercial : null,
        IdUsuarioBeneficiario = string.IsNullOrWhiteSpace(_idUsuarioBeneficiario) ? null : _idUsuarioBeneficiario,
        IdCorte = _idCorte,
    };

    private async Task Cargar()
    {
        _datos = (await Respuestas.DatoAsync(await Api.Consultar(FiltroActual()), "consultar las comisiones")) ?? new();
        foreach (var b in _datos.Resumen) _beneficiariosVistos[b.IdUsuarioBeneficiario] = b;
    }
    private async Task Cerrar()
    {
        if (!_desde.HasValue || !_hasta.HasValue) { await Dialogos.ErrorAsync("Indique el período que desea cerrar."); return; }
        if (!await Dialogos.ConfirmarPeligroAsync("Las comisiones pendientes del período quedarán liquidadas y no podrán modificarse.", "Cerrar período")) return;
        var corte = await Respuestas.DatoAsync(await Api.CrearCorte(new CrearCorteComisionesDTO { Desde = _desde.Value, Hasta = _hasta.Value, IdSucursal = Sesion.IdSucursal }), "cerrar el período de comisiones");
        if (corte is not null) { Dialogos.Exito($"Corte #{corte.IdCorte} creado: {corte.Movimientos} movimiento(s)."); await Cargar(); }
    }
    private async Task Exportar()
    {
        static string Q(string? texto) => "\"" + (texto ?? string.Empty).Replace("\"", "\"\"") + "\"";
        var csv = "Fecha,Documento,Cliente,Nombre comercial,Ruta comercial,Beneficiario,Tipo,Articulo,Base,Porcentaje,Comision,Estado fiscal,Estado cobro,Estado liquidacion,Corte\n"
            + string.Join("\n", _datos.Movimientos.Select(m => $"{m.Fecha:yyyy-MM-dd HH:mm},{Q(m.Documento)},{Q(m.Cliente)},{Q(m.NombreComercial)},{Q(m.RutaComercial)},{Q(m.Beneficiario)},{Q(m.TipoBeneficiario)},{Q(m.Articulo)},{m.Base},{m.Porcentaje},{m.Importe},{Q(m.EstadoFiscal)},{Q(m.EstadoCobro)},{Q(m.EstadoLiquidacion)},{m.IdCorte}"))
            // Resumen consolidado por colaborador (§5.3) — antes solo se veía en pantalla.
            + "\n\nResumen por colaborador\nBeneficiario,Tipo,Movimientos,Total\n"
            + string.Join("\n", _datos.Resumen.Select(r => $"{Q(r.Beneficiario)},{Q(r.TipoBeneficiario)},{r.Movimientos},{r.Importe}"));
        await JS.InvokeVoidAsync("seepos.descargarTexto", $"comisiones-{DateTime.Today:yyyyMMdd}.csv", csv, "text/csv;charset=utf-8");
    }
    private async Task ExportarXlsx()
    {
        _exportandoXlsx = true;
        var archivo = await Respuestas.DatoAsync(await Api.ExportarXlsx(FiltroActual()), "exportar las comisiones a Excel");
        _exportandoXlsx = false;
        if (archivo is not null && archivo.Contenido.Length > 0)
            await JS.InvokeVoidAsync("seepos.descargarBase64", archivo.Nombre, Convert.ToBase64String(archivo.Contenido), archivo.TipoContenido);
    }
}
