@page "/invoices/fiscal-tray"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IBandejaFiscal Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Buscar">Buscar</button></Acciones><ChildContent><div class="card mb-3"><div class="card-body row g-2"><div class="col-md-6"><AppCampoTexto Etiqueta="Clave" @bind-Valor="_filtro.Clave" /></div><div class="col-md-4"><label class="form-label">Estado</label><input class="form-control" @bind="_filtro.Estado" /></div></div></div><div class="card"><div class="card-body"><table class="table table-sm align-middle"><thead><tr><th>Clave</th><th>Tipo</th><th>Estado</th><th>Intentos</th><th></th></tr></thead><tbody>@foreach(var x in _resultado.Registros){<tr><td class="text-break">@x.Clave</td><td>@x.TipoComprobante</td><td>@x.Estado</td><td>@x.IntentosEnvio</td><td><button class="btn btn-sm btn-link" @onclick="()=>VerDetalle(x)">Detalle</button>@if(x.Estado=="ErrorTecnico" && Sesion.Puede(Titulo, AccionPantalla.Modificar)){<button class="btn btn-sm btn-link text-danger" @onclick="()=>Reintentar(x)">Reintentar</button>}</td></tr>}</tbody></table><div class="d-flex justify-content-between"><button class="btn btn-sm btn-outline-secondary" disabled="@(_resultado.Pagina<=1)" @onclick="Anterior">Anterior</button><span>Página @_resultado.Pagina · @_resultado.TotalRegistros registros</span><button class="btn btn-sm btn-outline-secondary" disabled="@(_resultado.Pagina*_resultado.TamanoPagina>=_resultado.TotalRegistros)" @onclick="Siguiente">Siguiente</button></div></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="Detalle de emisión fiscal" Size="ModalSize.Large"><BodyTemplate>@if(_detalle is not null){<p><strong>@_detalle.Clave</strong></p><p>@_detalle.Estado — @_detalle.CausaError</p><button class="btn btn-sm btn-outline-primary me-2" @onclick="Xml">Ver XML firmado</button><button class="btn btn-sm btn-outline-primary" @onclick="Respuesta">Ver respuesta Hacienda</button>@if(!string.IsNullOrWhiteSpace(_contenido)){<pre class="mt-3 p-2 bg-light text-break" style="max-height: 300px; overflow:auto">@_contenido</pre>}<h6 class="mt-3">Eventos</h6><ul>@foreach(var e in _detalle.Eventos){<li>@e.FechaUtc.ToLocalTime(): @e.TipoEvento — @e.Estado @e.Detalle</li>}</ul>}</BodyTemplate></HxModal>
@code { private const string Titulo="Bandeja Fiscal V4.4"; private readonly FiltroBandejaFiscalDTO _filtro=new(); private ResultadoBandejaFiscalDTO _resultado=new(); private DetalleBandejaFiscalDTO? _detalle; private string? _contenido; private HxModal _modal=default!; protected override async Task OnInitializedAsync()=>await Consultar(); private async Task Buscar(){_filtro.Pagina=1;await Consultar();} private async Task Anterior(){_filtro.Pagina--;await Consultar();} private async Task Siguiente(){_filtro.Pagina++;await Consultar();} private async Task Consultar(){_resultado=(await Respuestas.DatoAsync(await Api.Consultar(_filtro),"consultar la bandeja fiscal"))??new(){Pagina=_filtro.Pagina,TamanoPagina=_filtro.TamanoPagina};} private async Task VerDetalle(ItemBandejaFiscalDTO item){_contenido=null;_detalle=await Respuestas.DatoAsync(await Api.Detalle(item.Clave),"consultar el detalle fiscal");if(_detalle is not null)await _modal.ShowAsync();} private async Task Xml(){if(_detalle is not null)_contenido=await Respuestas.DatoAsync(await Api.XmlFirmado(_detalle.Clave),"obtener el XML firmado");} private async Task Respuesta(){if(_detalle is not null)_contenido=await Respuestas.DatoAsync(await Api.RespuestaHacienda(_detalle.Clave),"obtener la respuesta de Hacienda");} private async Task Reintentar(ItemBandejaFiscalDTO item){if(await Respuestas.CorrectaAsync(await Api.Reintentar(item.Clave),"reintentar la emisión fiscal"))await Consultar();} }
