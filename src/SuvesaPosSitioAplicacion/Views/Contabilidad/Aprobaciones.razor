@page "/accounting/approvals"
@using Microsoft.AspNetCore.Components.Forms
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Contabilidad
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.Services
@inject IAprobaciones AprobacionesApi
@inject IContabilidad Contabilidad
@inject IServicioDialogos Dialogos
@inject IManejadorRespuestas Respuestas

@* F2: la reapertura de un período, el cierre anual y el ajuste a un período anterior nunca ocurren
   solos: el contador los solicita, el Autorizador (dueño) los aprueba con la evidencia de su
   autorización, y recién entonces se pueden ejecutar. Con dos o más personas se puede activar el
   modo maker-checker: quien prepara una póliza no la aprueba. Con una sola, el modo Mitigante deja
   que se publique directo y el dueño firma cada semana lo que se hizo a mano. *@

<AppPantalla Pantalla="Aprobaciones" Codigo="CONTABILIDAD.APROBACIONES" Icono="bi-patch-check" Nivel="NivelPantalla.Tableta">
    <ChildContent>
        <div class="card mb-3">
            <div class="card-body">
                <AppSelectorLibroContable Prefijo="ap" AlCambiarLibro="AlCambiarLibro" />
            </div>
        </div>

        @if (_idLibro > 0)
        {
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item"><button class="nav-link @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">Solicitudes</button></li>
                <li class="nav-item"><button class="nav-link @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">Nueva solicitud</button></li>
                <li class="nav-item"><button class="nav-link @(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">Roles y modo</button></li>
                <li class="nav-item"><button class="nav-link @(_tab == 3 ? "active" : "")" @onclick="AbrirRevision">Revisión semanal</button></li>
            </ul>

            @if (_tab == 0)
            {
                <div class="card">
                    <div class="card-header d-flex gap-2 align-items-center">
                        <label class="small" for="ap-filtro">Estado</label>
                        <select id="ap-filtro" class="form-select form-select-sm w-auto" @bind="_filtroEstado" @bind:after="CargarSolicitudes">
                            <option value="">Todos</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Aprobada">Aprobada</option>
                            <option value="Ejecutada">Ejecutada</option>
                            <option value="Rechazada">Rechazada</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                        <thead><tr><th>#</th><th>Tipo</th><th>Detalle</th><th>Solicitó</th><th>Estado</th><th>Evidencia</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in _solicitudes)
                            {
                                <tr>
                                    <td>@s.Id</td>
                                    <td>@s.Tipo</td>
                                    <td>
                                        <div>@s.Motivo</div>
                                        @if (!string.IsNullOrEmpty(s.PeriodoAfectado)) { <div class="small text-secondary">Período @s.PeriodoAfectado</div> }
                                        @if (s.MontoImpacto is not null)
                                        {
                                            <div class="small">Efecto en resultados @s.MontoImpacto.Value.ToString("N2")
                                                @if (s.EsMaterial) { <span class="badge bg-danger ms-1">Material</span> }
                                                else { <span class="badge bg-secondary ms-1">No material</span> }
                                            </div>
                                            <div class="small text-secondary">@s.DetalleMaterialidad</div>
                                        }
                                        @if (!string.IsNullOrEmpty(s.ComentarioResolucion)) { <div class="small text-secondary">@s.ResueltoPor: @s.ComentarioResolucion</div> }
                                    </td>
                                    <td>@s.SolicitadoPor<div class="small text-secondary">@s.FechaSolicitudUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div></td>
                                    <td><span class="badge @ClaseEstado(s.Estado)">@s.Estado</span></td>
                                    <td>@s.Evidencias</td>
                                    <td class="text-nowrap">
                                        @if (s.Estado == "Pendiente")
                                        {
                                            @if (RequiereEvidencia(s.Tipo))
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirEvidencia(s)">Evidencia</button>
                                            }
                                            <button class="btn btn-sm btn-success" disabled="@_procesando" @onclick="() => Resolver(s, true)">Aprobar</button>
                                            <button class="btn btn-sm btn-outline-danger" disabled="@_procesando" @onclick="() => Resolver(s, false)">Rechazar</button>
                                            <button class="btn btn-sm btn-link text-danger" disabled="@_procesando" @onclick="() => Cancelar(s)">Cancelar</button>
                                        }
                                        else if (s.Estado == "Aprobada")
                                        {
                                            <span class="small text-secondary">Lista para ejecutarse en @(s.Tipo == "Reapertura" ? "Cierre" : "Cierre anual").</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_solicitudes.Count == 0) { <tr><td colspan="7" class="text-secondary">Sin solicitudes.</td></tr> }
                        </tbody>
                    </table></div>
                </div>
            }
            else if (_tab == 1)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="ap-tipo">Qué se solicita</label>
                                <select id="ap-tipo" class="form-select" @bind="_tipoNueva">
                                    <option value="Reapertura">Reabrir un período</option>
                                    <option value="CierreAnual">Cerrar el año</option>
                                    <option value="AjustePeriodoAnterior">Ajustar un período anterior</option>
                                </select>
                            </div>
                            @if (_tipoNueva is "Reapertura" or "AjustePeriodoAnterior")
                            {
                                <div class="col-12 col-md-4">
                                    <label class="form-label" for="ap-periodo">Período</label>
                                    <select id="ap-periodo" class="form-select" @bind="_idPeriodoNueva">
                                        <option value="0">Seleccione...</option>
                                        @foreach (var p in _periodosCerrados)
                                        {
                                            <option value="@p.Id">@p.Mes.ToString("00")/@p.Ejercicio (@p.Estado)</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="col-6 col-md-4">
                                    <label class="form-label" for="ap-ejercicio">Ejercicio</label>
                                    <input id="ap-ejercicio" type="number" class="form-control" @bind="_ejercicioNueva" />
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label" for="ap-motivo">Motivo</label>
                                <textarea id="ap-motivo" class="form-control" rows="2" maxlength="500" @bind="_motivoNueva"></textarea>
                            </div>
                        </div>

                        @if (_tipoNueva == "AjustePeriodoAnterior")
                        {
                            <div class="mt-3">
                                <div class="form-check mb-2">
                                    <input id="ap-fraude" class="form-check-input" type="checkbox" @bind="_causaLegal" />
                                    <label class="form-check-label" for="ap-fraude">Corrige un error por causa legal o de fraude (siempre material)</label>
                                </div>
                                <p class="small text-secondary">La póliza se publica con fecha de hoy, en el período abierto; el período corregido no se reabre. Si el efecto supera el 5% de la utilidad neta o el 1% de los ingresos de ese período, es material y los comparativos se reexpresan.</p>
                                <div class="table-responsive"><table class="table table-sm align-middle">
                                    <thead><tr><th>Cuenta</th><th>Movimiento</th><th class="text-end">Monto</th><th></th></tr></thead>
                                    <tbody>
                                        @for (var i = 0; i < _lineas.Count; i++)
                                        {
                                            var linea = _lineas[i];
                                            var indice = i;
                                            <tr>
                                                <td>
                                                    <select class="form-select form-select-sm" @bind="linea.IdCuentaContable" aria-label="Cuenta de la línea @(i + 1)">
                                                        <option value="0">Seleccione...</option>
                                                        @foreach (var c in _cuentas)
                                                        {
                                                            <option value="@c.Id">@c.Codigo — @c.Descripcion</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm" @bind="linea.TipoMovimiento" aria-label="Movimiento de la línea @(i + 1)">
                                                        <option value="Debito">Débito</option>
                                                        <option value="Credito">Crédito</option>
                                                    </select>
                                                </td>
                                                <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="linea.Monto" aria-label="Monto de la línea @(i + 1)" /></td>
                                                <td>@if (_lineas.Count > 2) { <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => _lineas.RemoveAt(indice)">Quitar</button> }</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="AgregarLinea">Agregar línea</button>
                            </div>
                        }

                        <div class="mt-3">
                            <button class="btn btn-primary" disabled="@_procesando" @onclick="Solicitar">Enviar solicitud</button>
                        </div>
                    </div>
                </div>
            }
            else if (_tab == 2 && _config is not null)
            {
                <div class="card mb-3">
                    <div class="card-header">Modo de aprobación</div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="ap-modo">Modo</label>
                                <select id="ap-modo" class="form-select" @bind="_modoNuevo">
                                    <option value="Mitigante">Mitigante (una persona prepara y publica; el dueño firma cada semana)</option>
                                    <option value="MakerChecker">Maker-checker (quien prepara no aprueba)</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <button class="btn btn-outline-primary" disabled="@(_procesando || _modoNuevo == _config.Modo)" @onclick="CambiarModo">Cambiar modo</button>
                            </div>
                        </div>
                        <p class="small text-secondary mt-2 mb-0">Maker-checker exige al menos dos personas con rol, una de ellas Aprobador o Autorizador.</p>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header">Roles de contabilidad</div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="ap-usuario">Usuario</label>
                                <input id="ap-usuario" class="form-control" @bind="_usuarioRol" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="ap-rol">Rol</label>
                                <select id="ap-rol" class="form-select" @bind="_rolNuevo">
                                    <option value="Preparador">Preparador</option>
                                    <option value="Aprobador">Aprobador</option>
                                    <option value="Autorizador">Autorizador (dueño)</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <button class="btn btn-outline-primary" disabled="@(_procesando || string.IsNullOrWhiteSpace(_usuarioRol))" @onclick="AsignarRol">Asignar</button>
                            </div>
                        </div>
                        <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Usuario</th><th>Rol</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var r in _config.Roles)
                                {
                                    <tr>
                                        <td>@r.Usuario</td>
                                        <td>@r.Rol</td>
                                        <td><button class="btn btn-sm btn-link text-danger p-0" @onclick="() => QuitarRol(r)">Quitar</button></td>
                                    </tr>
                                }
                                @if (_config.Roles.Count == 0) { <tr><td colspan="3" class="text-secondary">Todavía no hay roles asignados. Asigne primero al Autorizador (dueño).</td></tr> }
                            </tbody>
                        </table></div>
                    </div>
                </div>
            }
            else if (_tab == 3)
            {
                <div class="card">
                    <div class="card-header d-flex gap-2 align-items-center">
                        <label class="small" for="ap-semana">Semana de</label>
                        <input id="ap-semana" type="date" class="form-control form-control-sm w-auto" @bind="_diaSemana" @bind:after="CargarRevision" />
                    </div>
                    @if (_revision is not null)
                    {
                        <div class="card-body">
                            <p class="mb-1">Semana del @_revision.SemanaInicio.ToString("yyyy-MM-dd") al @_revision.SemanaFin.ToString("yyyy-MM-dd"):
                                @_revision.PolizasManuales póliza(s) manual(es), @_revision.Reversos reverso(s) a mano, @_revision.Ajustes ajuste(s) a períodos anteriores, @_revision.Reaperturas reapertura(s).</p>
                            @if (_revision.Firmada)
                            {
                                <p class="text-success">Firmada por @_revision.FirmadoPor el @_revision.FechaFirmaUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"). @_revision.Comentario</p>
                            }
                            else
                            {
                                <div class="row g-2 align-items-end">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small" for="ap-comentario-firma">Comentario (opcional)</label>
                                        <input id="ap-comentario-firma" class="form-control form-control-sm" @bind="_comentarioFirma" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <button class="btn btn-primary btn-sm" disabled="@_procesando" @onclick="Firmar">Firmar revisión</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Tipo</th><th>Póliza</th><th>Fecha</th><th>Usuario</th><th>Concepto</th><th class="text-end">Monto</th></tr></thead>
                            <tbody>
                                @foreach (var i in _revision.Items)
                                {
                                    <tr>
                                        <td>@i.Tipo</td>
                                        <td>@(i.Numero?.ToString() ?? i.IdAsiento.ToString())</td>
                                        <td>@i.FechaContable.ToString("yyyy-MM-dd")</td>
                                        <td>@i.Usuario</td>
                                        <td>@i.Concepto</td>
                                        <td class="text-end">@i.Monto.ToString("N2")</td>
                                    </tr>
                                }
                                @if (_revision.Items.Count == 0) { <tr><td colspan="6" class="text-secondary">Sin operaciones manuales esa semana.</td></tr> }
                            </tbody>
                        </table></div>
                    }
                </div>
            }
        }
    </ChildContent>
</AppPantalla>

<AppModal @ref="_modalEvidencia" Titulo="Evidencia de la autorización" AlGuardar="SubirEvidencia" Guardando="_subiendo" PuedeGuardar="_archivo is not null" TextoGuardar="Adjuntar">
    <p class="small text-secondary">Correo o acta firmada donde el dueño autoriza esta operación (PDF, JPG, PNG, EML o MSG, hasta 10 MB).</p>
    <InputFile class="form-control" OnChange="SeleccionarArchivo" />
</AppModal>

<AppModal @ref="_modalRechazo" Titulo="Rechazar solicitud" AlGuardar="ConfirmarRechazo" Guardando="_procesando" PuedeGuardar="!string.IsNullOrWhiteSpace(_comentarioRechazo)" TextoGuardar="Rechazar">
    <label class="form-label" for="ap-rechazo">Por qué se rechaza</label>
    <textarea id="ap-rechazo" class="form-control" rows="3" maxlength="500" @bind="_comentarioRechazo"></textarea>
</AppModal>

<AppConfirmarClaveContabilidad @ref="_confirmarClave" />

@code {
    private long _idLibro;
    private int _tab;
    private bool _procesando;
    private bool _subiendo;

    private List<SolicitudAprobacionDTO> _solicitudes = new();
    private string _filtroEstado = "";

    private string _tipoNueva = "Reapertura";
    private long _idPeriodoNueva;
    private int _ejercicioNueva = DateTime.Today.Year - 1;
    private string _motivoNueva = "";
    private bool _causaLegal;
    private List<PeriodoContableDTO> _periodosCerrados = new();
    private List<CuentaContableDTO> _cuentas = new();
    private List<LineaAsientoManualDTO> _lineas = NuevasLineas();

    private ConfiguracionAprobacionDTO? _config;
    private string _modoNuevo = "Mitigante";
    private string _usuarioRol = "";
    private string _rolNuevo = "Preparador";

    private RevisionSemanalDTO? _revision;
    private DateTime _diaSemana = DateTime.Today.AddDays(-7);
    private string _comentarioFirma = "";

    private AppModal _modalEvidencia = default!;
    private AppModal _modalRechazo = default!;
    private AppConfirmarClaveContabilidad _confirmarClave = default!;
    private IBrowserFile? _archivo;
    private SolicitudAprobacionDTO? _solicitudActiva;
    private string _comentarioRechazo = "";

    private static List<LineaAsientoManualDTO> NuevasLineas() => new()
    {
        new LineaAsientoManualDTO { Orden = 1, TipoMovimiento = "Debito" },
        new LineaAsientoManualDTO { Orden = 2, TipoMovimiento = "Credito" },
    };

    private static bool RequiereEvidencia(string tipo) => tipo is "Reapertura" or "CierreAnual" or "AjustePeriodoAnterior";

    private static string ClaseEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Aprobada" => "bg-info text-dark",
        "Ejecutada" => "bg-success",
        "Rechazada" => "bg-danger",
        _ => "bg-secondary",
    };

    private async Task AlCambiarLibro(long idLibro)
    {
        _idLibro = idLibro;
        _revision = null;
        _config = null;
        _solicitudes = new();
        if (idLibro == 0) return;

        _periodosCerrados = (await Respuestas.DatoAsync(await Contabilidad.ListarPeriodos(idLibro), "consultar los períodos"))
            ?.Where(p => p.Estado is "Cerrado" or "Bloqueado").OrderByDescending(p => p.Ejercicio).ThenByDescending(p => p.Mes).ToList() ?? new();
        _cuentas = (await Respuestas.DatoAsync(await Contabilidad.ListarCuentas(idLibro), "consultar las cuentas"))
            ?.Where(c => c.PermiteMovimiento).OrderBy(c => c.Codigo).ToList() ?? new();
        await CargarSolicitudes();
        await CargarConfiguracion();
    }

    private async Task CargarSolicitudes()
        => _solicitudes = (await Respuestas.DatoAsync(await AprobacionesApi.Solicitudes(_idLibro, string.IsNullOrEmpty(_filtroEstado) ? null : _filtroEstado), "consultar las solicitudes"))?.ToList() ?? new();

    private async Task CargarConfiguracion()
    {
        _config = await Respuestas.DatoAsync(await AprobacionesApi.Configuracion(_idLibro), "consultar la configuración");
        _modoNuevo = _config?.Modo ?? "Mitigante";
    }

    private void AgregarLinea() => _lineas.Add(new LineaAsientoManualDTO { Orden = _lineas.Count + 1, TipoMovimiento = "Debito" });

    private async Task Solicitar()
    {
        if (string.IsNullOrWhiteSpace(_motivoNueva))
        {
            Dialogos.Advertencia("Indique el motivo.");
            return;
        }
        var comando = new SolicitarAprobacionDTO { IdLibroContable = _idLibro, Tipo = _tipoNueva, Motivo = _motivoNueva.Trim() };
        if (_tipoNueva is "Reapertura" or "AjustePeriodoAnterior")
        {
            var periodo = _periodosCerrados.FirstOrDefault(p => p.Id == _idPeriodoNueva);
            if (periodo is null) { Dialogos.Advertencia("Seleccione el período."); return; }
            comando.IdReferencia = periodo.Id;
            if (_tipoNueva == "AjustePeriodoAnterior")
            {
                comando.PeriodoAfectado = $"{periodo.Ejercicio}-{periodo.Mes:00}";
                comando.CausaLegalOFraude = _causaLegal;
                var hoy = DateTimeOffset.Now;
                comando.Asiento = new CrearAsientoManualDTO
                {
                    IdLibroContable = _idLibro, FechaContable = hoy, FechaFiscal = hoy, Concepto = $"Ajuste a {comando.PeriodoAfectado}: {_motivoNueva.Trim()}",
                    Lineas = _lineas.Select((l, i) => new LineaAsientoManualDTO { Orden = i + 1, TipoMovimiento = l.TipoMovimiento, IdCuentaContable = l.IdCuentaContable, Monto = l.Monto, Descripcion = "Ajuste período anterior" }).ToList(),
                };
            }
        }
        else
        {
            comando.IdReferencia = _ejercicioNueva;
        }

        _procesando = true;
        var respuesta = await AprobacionesApi.Solicitar(comando);
        _procesando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "enviar la solicitud")) return;

        Dialogos.Exito("Solicitud enviada. Adjunte la evidencia de la autorización y pida al dueño que la apruebe.");
        _motivoNueva = "";
        _lineas = NuevasLineas();
        _tab = 0;
        await CargarSolicitudes();
    }

    private async Task Resolver(SolicitudAprobacionDTO solicitud, bool aprobar)
    {
        _solicitudActiva = solicitud;
        if (!aprobar)
        {
            _comentarioRechazo = "";
            await _modalRechazo.MostrarAsync();
            return;
        }
        _procesando = true;
        var respuesta = await AprobacionesApi.Resolver(solicitud.Id, true, null, null);
        if (!respuesta.EsCorrecta && (respuesta.Excepcion ?? "").Contains("contraseña", StringComparison.OrdinalIgnoreCase))
        {
            _procesando = false;
            var clave = await _confirmarClave.MostrarAsync();
            if (clave is null) return;
            _procesando = true;
            respuesta = await AprobacionesApi.Resolver(solicitud.Id, true, null, clave);
        }
        _procesando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "aprobar la solicitud")) return;
        Dialogos.Exito(solicitud.Tipo is "Reapertura" or "CierreAnual" ? "Solicitud aprobada: ya se puede ejecutar." : "Solicitud aprobada y publicada.");
        await CargarSolicitudes();
    }

    private async Task ConfirmarRechazo()
    {
        if (_solicitudActiva is null) return;
        _procesando = true;
        var respuesta = await AprobacionesApi.Resolver(_solicitudActiva.Id, false, _comentarioRechazo, null);
        _procesando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "rechazar la solicitud")) return;
        await _modalRechazo.OcultarAsync();
        await CargarSolicitudes();
    }

    private async Task Cancelar(SolicitudAprobacionDTO solicitud)
    {
        if (!await Dialogos.ConfirmarAsync("¿Cancelar esta solicitud?", "Cancelar solicitud")) return;
        _procesando = true;
        var respuesta = await AprobacionesApi.Cancelar(solicitud.Id);
        _procesando = false;
        if (await Respuestas.CorrectaAsync(respuesta, "cancelar la solicitud"))
            await CargarSolicitudes();
    }

    private async Task AbrirEvidencia(SolicitudAprobacionDTO solicitud)
    {
        _solicitudActiva = solicitud;
        _archivo = null;
        await _modalEvidencia.MostrarAsync();
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs e) => _archivo = e.File;

    private async Task SubirEvidencia()
    {
        if (_solicitudActiva is null || _archivo is null) return;
        _subiendo = true;
        await using var flujo = _archivo.OpenReadStream(10 * 1024 * 1024);
        var respuesta = await Contabilidad.CargarEvidenciaCierre(_idLibro, "Autorizacion", _solicitudActiva.Id, flujo, _archivo.Name, _archivo.ContentType);
        _subiendo = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "cargar la evidencia")) return;
        await _modalEvidencia.OcultarAsync();
        Dialogos.Exito("Evidencia adjunta.");
        await CargarSolicitudes();
    }

    private async Task CambiarModo()
    {
        _procesando = true;
        var respuesta = await AprobacionesApi.CambiarModo(_idLibro, _modoNuevo);
        _procesando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "cambiar el modo")) { _modoNuevo = _config?.Modo ?? "Mitigante"; return; }
        Dialogos.Exito("Modo actualizado.");
        await CargarConfiguracion();
    }

    private async Task AsignarRol()
    {
        _procesando = true;
        var respuesta = await AprobacionesApi.AsignarRol(_idLibro, _usuarioRol.Trim(), _rolNuevo);
        _procesando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "asignar el rol")) return;
        _usuarioRol = "";
        await CargarConfiguracion();
    }

    private async Task QuitarRol(UsuarioRolContableDTO rol)
    {
        if (!await Dialogos.ConfirmarAsync($"¿Quitar el rol {rol.Rol} a {rol.Usuario}?", "Quitar rol")) return;
        var respuesta = await AprobacionesApi.QuitarRol(rol.Id);
        if (await Respuestas.CorrectaAsync(respuesta, "quitar el rol"))
            await CargarConfiguracion();
    }

    private async Task AbrirRevision()
    {
        _tab = 3;
        if (_revision is null) await CargarRevision();
    }

    private async Task CargarRevision()
        => _revision = await Respuestas.DatoAsync(await AprobacionesApi.RevisionSemanal(_idLibro, DateOnly.FromDateTime(_diaSemana)), "consultar la revisión semanal");

    private async Task Firmar()
    {
        if (_revision is null) return;
        _procesando = true;
        var respuesta = await AprobacionesApi.FirmarRevisionSemanal(_idLibro, _revision.SemanaInicio, string.IsNullOrWhiteSpace(_comentarioFirma) ? null : _comentarioFirma.Trim());
        _procesando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "firmar la revisión")) return;
        _revision = respuesta.Responses;
        Dialogos.Exito("Revisión firmada.");
    }
}
