@page "/accounting/inbox"
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.Services
@inject IFacturacion FacturacionApi
@inject IEmisoresFiscales EmisoresApi
@inject IContabilidad Contabilidad
@inject IAprobaciones AprobacionesApi
@inject ISucursales SucursalesApi
@inject IContextoSesion Sesion
@inject IServicioDialogos Dialogos
@inject IManejadorRespuestas Respuestas

@* W3: una sola bandeja con dos pestañas — Eventos (accounting_events, incluye errores) y
   Pólizas (accounting_entries) — mismo espíritu que la bandeja fiscal V44
   (Views/Documentos/Bandeja.razor), pero sin MudDataGrid (no está disponible en este
   sitio): tabla HTML + "Anterior/Siguiente" basado en si la página vino llena. *@

<AppPantalla Pantalla="Bandeja" Codigo="CONTABILIDAD.BANDEJA" Icono="bi-journal-text" Nivel="NivelPantalla.Tableta">
    <Acciones>
        @if (_idLibroContable > 0 && _tab == 1 && Sesion.Puede("CONTABILIDAD.BANDEJA", AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="NuevaPolizaManual"><i class="bi bi-plus-lg me-1"></i>Nueva póliza manual</button>
        }
    </Acciones>
    <ChildContent>
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="bd-empresa">Empresa</label>
                        <select id="bd-empresa" class="form-select" @bind="_idEmpresa" @bind:after="AlCambiarSeleccion">
                            <option value="0">Seleccione...</option>
                            @foreach (var empresa in _empresas)
                            {
                                <option value="@empresa.Id">@empresa.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="bd-emisor">Emisor</label>
                        <select id="bd-emisor" class="form-select" @bind="_idEmisor" @bind:after="AlCambiarSeleccion">
                            <option value="0">Seleccione...</option>
                            @foreach (var emisor in _emisores)
                            {
                                <option value="@emisor.Id">@emisor.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @if (_idLibroContable == 0)
        {
            <p class="text-secondary mb-0">Seleccione empresa y emisor para ver la bandeja.</p>
        }
        else
        {
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item"><button class="nav-link @(_tab == 0 ? "active" : "")" @onclick="() => CambiarTab(0)">Eventos</button></li>
                <li class="nav-item"><button class="nav-link @(_tab == 1 ? "active" : "")" @onclick="() => CambiarTab(1)">Pólizas</button></li>
                <li class="nav-item"><button class="nav-link @(_tab == 2 ? "active" : "")" @onclick="() => CambiarTab(2)">Integridad</button></li>
            </ul>

            @if (_tab == 0)
            {
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="fe-estado">Estado</label>
                        <select id="fe-estado" class="form-select form-select-sm" @bind="_filtroEstado">
                            <option value="">Todos</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Contabilizado">Contabilizado</option>
                            <option value="ErrorConfiguracion">Error de configuración</option>
                            <option value="ErrorTecnico">Error técnico</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="fe-modulo">Módulo origen</label>
                        <input id="fe-modulo" class="form-control form-control-sm" @bind="_filtroModulo" placeholder="Ventas" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small" for="fe-desde">Desde</label>
                        <input id="fe-desde" type="date" class="form-control form-control-sm" @bind="_filtroDesde" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small" for="fe-hasta">Hasta</label>
                        <input id="fe-hasta" type="date" class="form-control form-control-sm" @bind="_filtroHasta" />
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <button class="btn btn-sm btn-outline-primary w-100" @onclick="BuscarEventos">Filtrar</button>
                    </div>
                </div>

                @if (_cargando)
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Fecha</th><th>Tipo</th><th>Origen</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var evento in _eventos)
                            {
                                <tr>
                                    <td>@evento.FechaContable.ToString("yyyy-MM-dd")</td>
                                    <td>@evento.TipoEvento</td>
                                    <td class="small text-secondary">@evento.OrigenModulo #@evento.OrigenId</td>
                                    <td>
                                        <span class="badge @ClaseEstadoEvento(evento.Estado)">@TextoEstadoEvento(evento.Estado)</span>
                                        @if (!string.IsNullOrWhiteSpace(evento.UltimoError))
                                        {
                                            <div class="small text-danger" title="@evento.UltimoError">@Truncar(evento.UltimoError, 60)</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (evento.Estado == "ErrorConfiguracion" && Sesion.Puede("CONTABILIDAD.BANDEJA", AccionPantalla.Editar))
                                        {
                                            <button class="btn btn-sm btn-link p-0" @onclick="() => Reintentar(evento)">Reintentar</button>
                                            <button class="btn btn-sm btn-link p-0 ms-2" title="Vuelve a armar el contenido del evento con los datos actuales del documento (para eventos viejos)" @onclick="() => Regenerar(evento)">Regenerar</button>
                                            <button class="btn btn-sm btn-link text-secondary p-0 ms-2" @onclick="() => DescartarEvento(evento)">No aplica</button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_eventos.Count == 0) { <tr><td colspan="5" class="text-secondary">Sin eventos para el filtro indicado.</td></tr> }
                        </tbody>
                    </table></div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="small text-secondary">Página @_paginaEventos</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" disabled="@(_paginaEventos <= 1)" @onclick="() => CambiarPaginaEventos(-1)">Anterior</button>
                            <button class="btn btn-outline-secondary" disabled="@(_eventos.Count < TamanoPagina)" @onclick="() => CambiarPaginaEventos(1)">Siguiente</button>
                        </div>
                    </div>
                }
            }
            else if (_tab == 1)
            {
                @if (_cargando)
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Fecha</th><th>Líneas</th><th class="text-end">Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var asiento in _asientos)
                            {
                                <tr class="@(asiento.Id == _asientoDetalle?.Id ? "table-active" : "")">
                                    <td>@asiento.FechaContable.ToString("yyyy-MM-dd")</td>
                                    <td class="small text-secondary">@(asiento.Lineas?.Count ?? 0) línea(s)</td>
                                    <td class="text-end">@TotalDebito(asiento).ToString("N2")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-link p-0" @onclick="() => VerDetalle(asiento)">Detalle</button>
                                        @if (Sesion.Puede("CONTABILIDAD.BANDEJA", AccionPantalla.Editar))
                                        {
                                            <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => Reversar(asiento)">Reversar</button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_asientos.Count == 0) { <tr><td colspan="4" class="text-secondary">Sin pólizas todavía.</td></tr> }
                        </tbody>
                    </table></div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="small text-secondary">Página @_paginaAsientos</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" disabled="@(_paginaAsientos <= 1)" @onclick="() => CambiarPaginaAsientos(-1)">Anterior</button>
                            <button class="btn btn-outline-secondary" disabled="@(_asientos.Count < TamanoPagina)" @onclick="() => CambiarPaginaAsientos(1)">Siguiente</button>
                        </div>
                    </div>
                }
            }
            else
            {
                @if (_cargando)
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
                }
                else
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Documentos sin contabilizar</h6>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="CargarIntegridad">Revisar</button>
                                    @if (_sinEvento is { Total: > 0 } && Sesion.Puede("CONTABILIDAD.REPROCESO", AccionPantalla.Editar))
                                    {
                                        <button class="btn btn-primary" disabled="@_guardando" @onclick="Regularizar">@TextoRegularizar()</button>
                                    }
                                </div>
                            </div>
                            <p class="small text-secondary">Ventas, compras y notas de crédito que ya debieron llegar al mayor y no tienen evento contable, desde el inicio del primer período (o la fecha de puesta en marcha, si se fijó@(_sinEvento?.FechaPuestaEnMarcha is DateOnly pm ? $": {pm:yyyy-MM-dd}" : "")). Para regularizar solo una parte, acote las fechas o marque los documentos.</p>
                            <div class="row g-2 mb-2">
                                <div class="col-auto"><label class="form-label small mb-0">Desde</label><input type="date" class="form-control form-control-sm" @bind="_regDesde" /></div>
                                <div class="col-auto"><label class="form-label small mb-0">Hasta</label><input type="date" class="form-control form-control-sm" @bind="_regHasta" /></div>
                            </div>
                            @if (_sinEvento is null || _sinEvento.Total == 0)
                            {
                                <p class="mb-0"><span class="badge text-bg-success">Todo contabilizado</span></p>
                            }
                            else
                            {
                                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                                    <thead><tr><th></th><th>Tipo</th><th>Número</th><th>Fecha</th><th class="text-end">Total</th><th>Motivo</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in _sinEvento.Documentos)
                                        {
                                            var clave = (d.Tipo, d.IdDocumento);
                                            <tr><td><input type="checkbox" class="form-check-input" checked="@_seleccion.Contains(clave)" @onchange="e => Marcar(clave, (bool)(e.Value ?? false))" /></td><td>@d.Tipo</td><td>@d.Numero</td><td>@d.Fecha.ToString("yyyy-MM-dd")</td><td class="text-end">@d.Total.ToString("N2")</td><td class="small text-secondary">@d.Motivo</td></tr>
                                        }
                                    </tbody>
                                </table></div>
                                @if (_sinEvento.Total > _sinEvento.Documentos.Count)
                                {
                                    <p class="small text-secondary mt-2 mb-0">Se muestran los primeros @_sinEvento.Documentos.Count de @_sinEvento.Total.</p>
                                }
                            }
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Compras con Mensaje Receptor rechazado</h6>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CargarIntegridad">Revisar</button>
                            </div>
                            <p class="small text-secondary">Hacienda rechazó el Mensaje Receptor y la compra no está en el mayor, aunque la mercadería haya entrado y la deuda exista. Puede contabilizarla de todos modos: su IVA queda como no acreditable y la acción queda en la bitácora con su motivo.</p>
                            @if (_comprasRechazadas is null || _comprasRechazadas.Total == 0)
                            {
                                <p class="mb-0"><span class="badge text-bg-success">Ninguna pendiente</span></p>
                            }
                            else
                            {
                                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Factura</th><th>Fecha</th><th class="text-end">Total</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _comprasRechazadas.Documentos)
                                        {
                                            <tr>
                                                <td>@c.Numero</td>
                                                <td>@c.Fecha.ToString("yyyy-MM-dd")</td>
                                                <td class="text-end">@c.Total.ToString("N2")</td>
                                                <td class="text-end">
                                                    @if (Sesion.Puede("CONTABILIDAD.REPROCESO", AccionPantalla.Editar))
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirForzarCompra(c)">Contabilizar de todos modos</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                            }
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Plantillas y eventos en error</h6>
                                @if (_diagnostico is { EventosEnErrorConfiguracion: > 0 } && Sesion.Puede("CONTABILIDAD.REPROCESO", AccionPantalla.Editar))
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@_guardando" @onclick="ReencolarErrores">Reencolar @_diagnostico.EventosEnErrorConfiguracion en error de configuración</button>
                                }
                            </div>
                            <p class="small text-secondary">Cada plantilla debe estar activa y cubrir las fechas por contabilizar. Corrija lo que se indica y reencole.</p>
                            @if (_diagnostico is null)
                            {
                                <p class="text-secondary mb-0">Sin datos.</p>
                            }
                            else if (_diagnostico.Problemas.Count == 0)
                            {
                                <p class="mb-0"><span class="badge text-bg-success">Plantillas completas</span></p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var p in _diagnostico.Problemas)
                                    {
                                        <li class="list-group-item px-0">
                                            <span class="badge @(p.Gravedad == "Error" ? "text-bg-danger" : "text-bg-warning") me-2">@p.Gravedad</span><code>@p.TipoEvento</code>
                                            <div class="small text-secondary">@p.Detalle</div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="mb-1">Prorrata del IVA (condición 05)</h6>
                            <p class="small text-secondary">El IVA de las compras con proporcionalidad espera en 1.1.7.3. Cada mes se traslada a crédito con el porcentaje provisional y el resto va a gasto; en diciembre se regulariza con el definitivo. La póliza la aprueba otra persona en Aprobaciones.</p>
                            <div class="row g-2 align-items-end">
                                <div class="col-6 col-md-2">
                                    <label class="form-label small" for="pr-anio">Año</label>
                                    <input id="pr-anio" type="number" class="form-control form-control-sm" min="2019" max="2100" @bind="_prorrataAnio" />
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label small" for="pr-mes">Período</label>
                                    <select id="pr-mes" class="form-select form-select-sm" @bind="_prorrataMes">
                                        @for (var m = 1; m <= 12; m++)
                                        {
                                            <option value="@m">Mes @m (traslado mensual)</option>
                                        }
                                        <option value="13">Regularización anual (porcentaje definitivo)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-3">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CalcularProrrata">Calcular propuesta</button>
                                </div>
                            </div>
                            @if (_prorrata is not null)
                            {
                                <div class="mt-3">
                                    <div class="small">IVA sujeto a proporcionalidad en el mayor: <strong>@_prorrata.IvaSujetoProrrata.ToString("N2")</strong>
                                        · porcentaje <strong>@_prorrata.PorcentajeAplicado.ToString("0.##")%</strong> <span class="text-secondary">(@_prorrata.OrigenPorcentaje)</span></div>
                                    @if (_prorrata.Lineas.Count > 0)
                                    {
                                        <div class="table-responsive mt-2"><table class="table table-sm align-middle mb-0">
                                            <thead><tr><th>Cuenta</th><th>Movimiento</th><th class="text-end">Monto</th><th>Descripción</th></tr></thead>
                                            <tbody>
                                                @foreach (var l in _prorrata.Lineas)
                                                {
                                                    <tr><td><code>@l.CodigoCuenta</code> @l.Cuenta</td><td>@l.TipoMovimiento</td><td class="text-end">@l.Monto.ToString("N2")</td><td class="small text-secondary">@l.Descripcion</td></tr>
                                                }
                                            </tbody>
                                        </table></div>
                                    }
                                    @foreach (var a in _prorrata.Advertencias)
                                    {
                                        <div class="small text-secondary mt-1"><i class="bi bi-info-circle me-1"></i>@a</div>
                                    }
                                    @if (_prorrata.EstadoSolicitud is not null)
                                    {
                                        <div class="mt-2"><span class="badge text-bg-info">Solicitud #@_prorrata.IdSolicitud: @_prorrata.EstadoSolicitud</span></div>
                                    }
                                    else if (_prorrata.Lineas.Count > 0 && Sesion.Puede("CONTABILIDAD.CIERRE", AccionPantalla.Editar))
                                    {
                                        <button class="btn btn-sm btn-primary mt-2" disabled="@_guardando" @onclick="EnviarProrrata">Enviar a aprobación</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    </ChildContent>
</AppPantalla>

<AppModal @ref="_modalDetalle" Titulo="Detalle de la póliza" Tamano="ModalSize.Large" MostrarCancelar="true" TextoCancelar="Cerrar">
    @if (_asientoDetalle is not null)
    {
        <div class="table-responsive"><table class="table table-sm align-middle mb-0">
            <thead><tr><th>Orden</th><th>Movimiento</th><th>Cuenta</th><th class="text-end">Monto</th><th>Descripción</th></tr></thead>
            <tbody>
                @foreach (var linea in (_asientoDetalle.Lineas ?? new List<LineaAsientoContableDTO>()).OrderBy(l => l.Orden))
                {
                    <tr>
                        <td>@linea.Orden</td>
                        <td>@linea.TipoMovimiento</td>
                        <td class="font-monospace">@NombreCuenta(linea.IdCuentaContable)</td>
                        <td class="text-end">@linea.MontoFuncional.ToString("N2")</td>
                        <td>@linea.Descripcion</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</AppModal>

<AppModal @ref="_modalForzarCompra" Titulo="Contabilizar compra con Mensaje Receptor rechazado" AlGuardar="ConfirmarForzarCompra" Guardando="_guardando"
          PuedeGuardar="!string.IsNullOrWhiteSpace(_motivoForzarCompra)" TextoGuardar="Contabilizar">
    @if (_compraAForzar is not null)
    {
        <p>La compra <strong>@_compraAForzar.Numero</strong> por <strong>@_compraAForzar.Total.ToString("N2")</strong> entra al mayor ahora. Su IVA se registra como no acreditable (gasto), porque sin Mensaje Receptor aceptado no hay crédito fiscal.</p>
        <div class="mb-2">
            <label class="form-label" for="bj-motivo-compra">Motivo</label>
            <textarea id="bj-motivo-compra" class="form-control" rows="3" maxlength="500" @bind="_motivoForzarCompra"></textarea>
        </div>
    }
</AppModal>

<AppModal @ref="_modalReverso" Titulo="Reversar póliza" AlGuardar="ConfirmarReverso" Guardando="_guardando"
          PuedeGuardar="!string.IsNullOrWhiteSpace(_motivoReverso)" TextoGuardar="Reversar">
    <p>Se creará un asiento espejo; la póliza original no se borra.</p>
    <div class="mb-2">
        <label class="form-label" for="bj-motivo-reverso">Motivo</label>
        <textarea id="bj-motivo-reverso" class="form-control" rows="3" maxlength="500" @bind="_motivoReverso"></textarea>
    </div>
</AppModal>

<AppModal @ref="_modalManual" Titulo="Nueva póliza manual" Tamano="ModalSize.ExtraLarge" AlGuardar="GuardarPolizaManual" Guardando="_guardando">
    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label" for="pm-sucursal">Sucursal</label>
            <select id="pm-sucursal" class="form-select" @bind="_idSucursalManual">
                <option value="0">Seleccione...</option>
                @foreach (var sucursal in _sucursales)
                {
                    <option value="@sucursal.Id">@(sucursal.NombreComercial ?? sucursal.Alias ?? sucursal.Id.ToString())</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="pm-concepto">Concepto</label>
            <input id="pm-concepto" class="form-control" maxlength="300" @bind="_conceptoManual" />
            @if (_modoMakerChecker)
            {
                <div class="form-text">Modo maker-checker: se envía como solicitud y otra persona debe aprobarla antes de publicarse.</div>
            }
        </div>
        <div class="col-6">
            <label class="form-label" for="pm-fecha">Fecha contable</label>
            <input id="pm-fecha" type="date" class="form-control" @bind="_fechaManual" />
        </div>
        <div class="col-6">
            <label class="form-label" for="pm-cliente">Cliente (opcional)</label>
            <input id="pm-cliente" type="number" class="form-control" @bind="_idClienteManual" />
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Líneas</h6>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarLineaManual"><i class="bi bi-plus-lg me-1"></i>Agregar línea</button>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Orden</th><th>Movimiento</th><th>Cuenta</th><th class="text-end">Monto</th><th>Descripción</th><th></th></tr></thead>
            <tbody>
                @foreach (var linea in _lineasManual)
                {
                    <tr>
                        <td style="width:5rem"><input type="number" class="form-control form-control-sm" @bind="linea.Orden" /></td>
                        <td style="width:9rem">
                            <select class="form-select form-select-sm" @bind="linea.TipoMovimiento">
                                <option value="Debito">Débito</option>
                                <option value="Credito">Crédito</option>
                            </select>
                        </td>
                        <td style="min-width:12rem">
                            <select class="form-select form-select-sm" @bind="linea.IdCuentaContable">
                                <option value="0">Seleccione...</option>
                                @foreach (var c in _cuentasMovimiento)
                                {
                                    <option value="@c.Id">@c.Codigo — @c.Descripcion</option>
                                }
                            </select>
                        </td>
                        <td style="width:9rem"><input type="number" step="0.01" class="form-control form-control-sm" @bind="linea.Monto" /></td>
                        <td style="min-width:10rem"><input class="form-control form-control-sm" @bind="linea.Descripcion" /></td>
                        <td><button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => _lineasManual.Remove(linea)"><i class="bi bi-trash"></i></button></td>
                    </tr>
                }
                @if (_lineasManual.Count == 0) { <tr><td colspan="6" class="text-secondary">Agregue al menos una línea Débito y una Crédito.</td></tr> }
            </tbody>
        </table>
    </div>
</AppModal>

<AppConfirmarClaveContabilidad @ref="_confirmarClave" />

@code {
    private const int TamanoPagina = 25;

    private List<EmpresaDTO> _empresas = new();
    private List<DTOs.Fiscal.EmisorFiscalDTO> _emisores = new();
    private int _idEmpresa;
    private int _idEmisor;
    private long _idLibroContable;
    private bool _cargando;
    private bool _guardando;
    private int _tab;

    private Dictionary<long, CuentaContableDTO> _cuentas = new();
    private List<CuentaContableDTO> _cuentasMovimiento = new();

    private List<EventoContableDTO> _eventos = new();
    private int _paginaEventos = 1;
    private string _filtroEstado = "";
    private string _filtroModulo = "";
    private DateOnly? _filtroDesde;
    private DateOnly? _filtroHasta;

    private List<AsientoContableDTO> _asientos = new();
    private int _paginaAsientos = 1;

    private AppModal _modalDetalle = default!;
    private AsientoContableDTO? _asientoDetalle;

    private AppModal _modalReverso = default!;
    private AsientoContableDTO? _asientoAReversar;
    private string? _contrasenaReverso;
    private string _motivoReverso = "";

    private AppModal _modalManual = default!;
    private List<DTOs.Fiscal.SucursalFiscalDTO> _sucursales = new();
    private DateOnly _fechaManual = DateOnly.FromDateTime(DateTime.Today);
    private int _idSucursalManual;
    private string _conceptoManual = "";
    /// <summary>En maker-checker las pólizas manuales y los reversos viajan como solicitud de aprobación.</summary>
    private bool _modoMakerChecker;
    private long? _idClienteManual;
    private List<LineaAsientoManualDTO> _lineasManual = new();

    private AppConfirmarClaveContabilidad _confirmarClave = default!;

    protected override async Task OnInitializedAsync()
    {
        _empresas = (await Respuestas.DatoAsync(await FacturacionApi.Empresas(), "consultar las empresas"))?.ToList() ?? new();
        _emisores = (await Respuestas.DatoAsync(await EmisoresApi.Obtener(), "consultar los emisores"))?.ToList() ?? new();
        _sucursales = (await Respuestas.DatoAsync(await SucursalesApi.Obtener(), "consultar las sucursales"))?.ToList() ?? new();
        if (_empresas.Count == 1) _idEmpresa = _empresas[0].Id;
        if (_emisores.Count == 1) _idEmisor = _emisores[0].Id;
        await AlCambiarSeleccion();
    }

    private async Task AlCambiarSeleccion()
    {
        _idLibroContable = 0;
        _eventos = new();
        _asientos = new();
        if (_idEmpresa == 0 || _idEmisor == 0) return;

        var estado = await Respuestas.DatoAsync(await Contabilidad.EstadoActivacion(_idEmpresa, _idEmisor, Sesion.IdSucursal > 0 ? Sesion.IdSucursal : null), "consultar el estado de activación");
        _idLibroContable = estado?.IdLibroContable ?? 0;
        if (_idLibroContable == 0) return;

        _modoMakerChecker = (await Respuestas.DatoAsync(await AprobacionesApi.Configuracion(_idLibroContable), "consultar el modo de aprobación"))?.Modo == "MakerChecker";

        var cuentas = (await Respuestas.DatoAsync(await Contabilidad.ListarCuentas(_idLibroContable), "consultar las cuentas"))?.ToList() ?? new();
        _cuentas = cuentas.ToDictionary(c => c.Id);
        _cuentasMovimiento = cuentas.Where(c => c.PermiteMovimiento == true).ToList();

        await CambiarTab(0);
    }

    private async Task CambiarTab(int tab)
    {
        _tab = tab;
        if (tab == 0) await BuscarEventos();
        else if (tab == 1) await CargarAsientos();
        else await CargarIntegridad();
    }

    private DTOs.Contabilidad.DocumentosSinEventoDTO? _sinEvento;
    private DTOs.Contabilidad.DiagnosticoPlantillasDTO? _diagnostico;

    private async Task CargarIntegridad()
    {
        _cargando = true;
        try
        {
            _sinEvento = await Respuestas.DatoAsync(await Contabilidad.DocumentosSinEvento(_idLibroContable), "consultar los documentos sin contabilizar");
            _diagnostico = await Respuestas.DatoAsync(await Contabilidad.DiagnosticarPlantillas(_idLibroContable), "diagnosticar las plantillas contables");
            _comprasRechazadas = await Respuestas.DatoAsync(await Contabilidad.ComprasRechazadas(_idLibroContable), "consultar las compras con Mensaje Receptor rechazado");
        }
        finally { _cargando = false; }
    }

    private DateTime? _regDesde, _regHasta;
    private readonly HashSet<(string Tipo, long Id)> _seleccion = new();

    private void Marcar((string, long) clave, bool marcado)
    {
        if (marcado) _seleccion.Add(clave); else _seleccion.Remove(clave);
    }

    private static DateOnly? Dia(DateTime? f) => f is DateTime d ? DateOnly.FromDateTime(d) : null;

    private string TextoRegularizar()
        => _seleccion.Count > 0 ? $"Regularizar {_seleccion.Count} marcado(s)"
         : _regDesde is not null || _regHasta is not null ? "Regularizar el rango"
         : $"Regularizar {_sinEvento?.Total}";

    private async Task Regularizar()
    {
        if (_sinEvento is null || _sinEvento.Total == 0) return;
        var elegidos = _sinEvento.Documentos.Where(d => _seleccion.Contains((d.Tipo, d.IdDocumento))).ToList();
        var alcance = elegidos.Count > 0 ? $"{elegidos.Count} documento(s) marcado(s)"
            : _regDesde is not null || _regHasta is not null ? "los documentos del rango de fechas" : $"{_sinEvento.Total} documento(s)";
        if (!await Dialogos.ConfirmarAsync($"¿Crear el evento contable de {alcance}? Entran a la cola y se contabilizan con la plantilla vigente; si ya existe el evento no se duplica.", "Regularizar")) return;
        _guardando = true;
        try
        {
            var resultado = await Respuestas.DatoAsync(await Contabilidad.RegularizarDocumentos(_idLibroContable, Dia(_regDesde), Dia(_regHasta), elegidos.Count > 0 ? elegidos : null), "regularizar los documentos");
            if (resultado is null) return;
            if (resultado.Errores.Count > 0)
                Dialogos.Advertencia($"Se regularizaron {resultado.Regularizados}; {resultado.Errores.Count} fallaron: {resultado.Errores[0]}");
            else
                Dialogos.Exito($"Se crearon {resultado.Regularizados} evento(s).");
            _seleccion.Clear();
            await CargarIntegridad();
        }
        finally { _guardando = false; }
    }

    private DTOs.Contabilidad.DocumentosSinEventoDTO? _comprasRechazadas;
    private AppModal _modalForzarCompra = default!;
    private DTOs.Contabilidad.DocumentoSinEventoDTO? _compraAForzar;
    private string _motivoForzarCompra = "";

    private async Task AbrirForzarCompra(DTOs.Contabilidad.DocumentoSinEventoDTO compra)
    {
        _compraAForzar = compra;
        _motivoForzarCompra = "";
        await _modalForzarCompra.MostrarAsync();
    }

    private async Task ConfirmarForzarCompra()
    {
        if (_compraAForzar is null || string.IsNullOrWhiteSpace(_motivoForzarCompra)) return;
        _guardando = true;
        try
        {
            var respuesta = await Contabilidad.ForzarCompra(_idLibroContable, _compraAForzar.IdDocumento, _motivoForzarCompra.Trim());
            if (!await Respuestas.CorrectaAsync(respuesta, "contabilizar la compra")) return;
            await _modalForzarCompra.OcultarAsync();
            Dialogos.Exito("La compra entró a la cola contable; se contabiliza en unos segundos.");
            await CargarIntegridad();
        }
        finally { _guardando = false; }
    }

    private int _prorrataAnio = DateTime.Today.Year;
    private int _prorrataMes = Math.Max(1, DateTime.Today.Month - 1);
    private DTOs.Contabilidad.PropuestaProrrataIvaDTO? _prorrata;

    private async Task CalcularProrrata()
        => _prorrata = await Respuestas.DatoAsync(await Contabilidad.PropuestaProrrataIva(_idLibroContable, _prorrataAnio, _prorrataMes), "calcular la prorrata del IVA");

    private async Task EnviarProrrata()
    {
        if (_prorrata is null || _prorrata.Lineas.Count == 0) return;
        _guardando = true;
        try
        {
            var solicitud = await Respuestas.DatoAsync(await Contabilidad.SolicitarProrrataIva(_idLibroContable, _prorrataAnio, _prorrataMes), "enviar la prorrata del IVA a aprobación");
            if (solicitud is null) return;
            Dialogos.Exito($"Solicitud #{solicitud.Id} enviada: otra persona con rol de aprobador debe aprobarla en Aprobaciones.");
            await CalcularProrrata();
        }
        finally { _guardando = false; }
    }

    private async Task ReencolarErrores()
    {
        _guardando = true;
        try
        {
            var resultado = await Respuestas.DatoAsync(await Contabilidad.ReencolarErroresConfiguracion(_idLibroContable), "reencolar los eventos");
            if (resultado is null) return;
            Dialogos.Exito($"{resultado.Reencolados} evento(s) reencolados.");
            await CargarIntegridad();
        }
        finally { _guardando = false; }
    }

    private async Task BuscarEventos()
    {
        _paginaEventos = 1;
        await CargarEventos();
    }

    private async Task CargarEventos()
    {
        _cargando = true;
        _eventos = (await Respuestas.DatoAsync(
            await Contabilidad.ListarEventos(_idLibroContable, string.IsNullOrWhiteSpace(_filtroEstado) ? null : _filtroEstado,
                null, string.IsNullOrWhiteSpace(_filtroModulo) ? null : _filtroModulo, _filtroDesde, _filtroHasta, _paginaEventos, TamanoPagina),
            "consultar la bandeja de eventos"))?.ToList() ?? new();
        _cargando = false;
    }

    private async Task CambiarPaginaEventos(int delta)
    {
        _paginaEventos = Math.Max(1, _paginaEventos + delta);
        await CargarEventos();
    }

    private async Task CargarAsientos()
    {
        _cargando = true;
        _asientos = (await Respuestas.DatoAsync(await Contabilidad.ListarAsientos(_idLibroContable, _paginaAsientos, TamanoPagina), "consultar la bandeja de pólizas"))?.ToList() ?? new();
        _cargando = false;
    }

    private async Task CambiarPaginaAsientos(int delta)
    {
        _paginaAsientos = Math.Max(1, _paginaAsientos + delta);
        await CargarAsientos();
    }

    private async Task DescartarEvento(EventoContableDTO evento)
    {
        if (!await Dialogos.ConfirmarAsync($"¿Marcar el evento {evento.TipoEvento} #{evento.Id} como «no aplica»? Sale de la cola y no genera póliza.", "No aplica")) return;
        var respuesta = await AprobacionesApi.DescartarEvento(evento.Id, "NoAplicable", "Sin efecto contable, descartado desde la bandeja.");
        if (await Respuestas.CorrectaAsync(respuesta, "descartar el evento"))
            await CambiarTab(_tab);
    }

    private async Task Regenerar(EventoContableDTO evento)
    {
        if (!await Dialogos.ConfirmarAsync("¿Volver a armar el contenido de este evento con los datos actuales de su documento? Queda de nuevo en cola; el contenido anterior se guarda en la auditoría.", "Regenerar")) return;
        var respuesta = await Contabilidad.RegenerarEventoDesdeDocumento(evento.Id);
        if (await Respuestas.CorrectaAsync(respuesta, "regenerar el evento"))
        {
            Dialogos.Exito(respuesta.Responses ? "Evento regenerado y reencolado." : "El documento no cambió el contenido; el evento volvió a la cola.");
            await CargarEventos();
        }
    }

    private async Task Reintentar(EventoContableDTO evento)
    {
        var respuesta = await Contabilidad.ReintentarEvento(evento.Id);
        if (await Respuestas.CorrectaAsync(respuesta, "reintentar el evento"))
        {
            Dialogos.Exito("Evento reencolado.");
            await CargarEventos();
        }
    }

    private async Task VerDetalle(AsientoContableDTO asiento)
    {
        _asientoDetalle = asiento;
        await _modalDetalle.MostrarAsync();
    }

    private async Task Reversar(AsientoContableDTO asiento)
    {
        var tocaControl = (asiento.Lineas ?? new List<LineaAsientoContableDTO>())
            .Any(l => _cuentas.TryGetValue(l.IdCuentaContable, out var c) && c.EsControl == true);

        string? contrasena = null;
        if (tocaControl)
        {
            contrasena = await _confirmarClave.MostrarAsync();
            if (contrasena is null) return;
        }

        _asientoAReversar = asiento;
        _contrasenaReverso = contrasena;
        _motivoReverso = "";
        await _modalReverso.MostrarAsync();
    }

    private async Task ConfirmarReverso()
    {
        if (_asientoAReversar is null || string.IsNullOrWhiteSpace(_motivoReverso)) return;
        _guardando = true;
        try
        {
            if (_modoMakerChecker)
            {
                var solicitud = await AprobacionesApi.Solicitar(new DTOs.Contabilidad.SolicitarAprobacionDTO
                {
                    IdLibroContable = _idLibroContable, Tipo = "ReversoPoliza", IdReferencia = _asientoAReversar.Id, Motivo = _motivoReverso.Trim(),
                });
                if (await Respuestas.CorrectaAsync(solicitud, "enviar la solicitud de reverso"))
                {
                    await _modalReverso.OcultarAsync();
                    Dialogos.Exito("Solicitud enviada: otra persona debe aprobarla en Aprobaciones.");
                }
                return;
            }

            var respuesta = await Contabilidad.ReversarAsiento(_asientoAReversar.Id, _contrasenaReverso, _motivoReverso.Trim());
            if (await Respuestas.CorrectaAsync(respuesta, "reversar la póliza"))
            {
                await _modalReverso.OcultarAsync();
                Dialogos.Exito("Póliza reversada.");
                await CargarAsientos();
            }
        }
        finally { _guardando = false; }
    }

    private async Task NuevaPolizaManual()
    {
        _fechaManual = DateOnly.FromDateTime(DateTime.Today);
        _idSucursalManual = Sesion.IdSucursal;
        _idClienteManual = null;
        _lineasManual = new()
        {
            new LineaAsientoManualDTO { Orden = 1, TipoMovimiento = "Debito" },
            new LineaAsientoManualDTO { Orden = 2, TipoMovimiento = "Credito" },
        };
        await _modalManual.MostrarAsync();
    }

    private void AgregarLineaManual()
        => _lineasManual.Add(new LineaAsientoManualDTO { Orden = _lineasManual.Count + 1, TipoMovimiento = "Debito" });

    private async Task GuardarPolizaManual()
    {
        if (_idSucursalManual <= 0)
        {
            await Dialogos.ErrorAsync("Elija la sucursal activa de la póliza.");
            return;
        }
        if (_lineasManual.Count == 0 || _lineasManual.Any(l => l.IdCuentaContable == 0 || l.Monto <= 0))
        {
            await Dialogos.ErrorAsync("Cada línea necesita cuenta y un monto mayor a cero.");
            return;
        }

        if (_modoMakerChecker && string.IsNullOrWhiteSpace(_conceptoManual))
        {
            await Dialogos.ErrorAsync("Indique el concepto: es el motivo que verá quien aprueba.");
            return;
        }

        var tocaControl = _lineasManual.Any(l => _cuentas.TryGetValue(l.IdCuentaContable, out var c) && c.EsControl == true);
        string? contrasena = null;
        if (tocaControl && !_modoMakerChecker)
        {
            contrasena = await _confirmarClave.MostrarAsync();
            if (contrasena is null) return;
        }

        var comando = new CrearAsientoManualDTO
        {
            IdLibroContable = _idLibroContable,
            IdEmisor = _idEmisor,
            IdSucursal = _idSucursalManual,
            IdEmpresa = _idEmpresa > 0 ? _idEmpresa : null,
            FechaContable = new DateTimeOffset(_fechaManual.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero),
            FechaFiscal = new DateTimeOffset(_fechaManual.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero),
            IdCliente = _idClienteManual,
            Concepto = string.IsNullOrWhiteSpace(_conceptoManual) ? null : _conceptoManual.Trim(),
            Contrasena = contrasena,
            Lineas = _lineasManual,
        };

        if (_modoMakerChecker)
        {
            _guardando = true;
            var solicitud = await AprobacionesApi.Solicitar(new DTOs.Contabilidad.SolicitarAprobacionDTO
            {
                IdLibroContable = _idLibroContable, Tipo = "AsientoManual", Motivo = comando.Concepto!, Asiento = comando,
            });
            _guardando = false;
            if (await Respuestas.CorrectaAsync(solicitud, "enviar la solicitud de la póliza"))
            {
                Dialogos.Exito("Solicitud enviada: otra persona debe aprobarla en Aprobaciones.");
                _conceptoManual = "";
                await _modalManual.OcultarAsync();
            }
            return;
        }

        _guardando = true;
        var respuesta = await Contabilidad.CrearAsientoManual(comando);
        _guardando = false;

        if (await Respuestas.CorrectaAsync(respuesta, "crear la póliza manual"))
        {
            Dialogos.Exito("Póliza creada.");
            await _modalManual.OcultarAsync();
            await CargarAsientos();
        }
    }

    private string NombreCuenta(long idCuenta)
        => _cuentas.TryGetValue(idCuenta, out var c) ? $"{c.Codigo} — {c.Descripcion}" : idCuenta.ToString();

    private static decimal TotalDebito(AsientoContableDTO asiento)
        => (decimal)(asiento.Lineas ?? new List<LineaAsientoContableDTO>()).Where(l => l.TipoMovimiento == "Debito").Sum(l => l.MontoFuncional);

    private static string ClaseEstadoEvento(string? estado) => estado switch
    {
        "Contabilizado" => "text-bg-success",
        "ErrorConfiguracion" => "text-bg-danger",
        "ErrorTecnico" => "text-bg-warning",
        "Pendiente" => "text-bg-secondary",
        _ => "text-bg-light",
    };

    private static string TextoEstadoEvento(string? estado) => estado switch
    {
        "ErrorConfiguracion" => "Error — requiere acción",
        "ErrorTecnico" => "Error técnico (reintento automático)",
        _ => estado ?? "",
    };

    private static string Truncar(string texto, int largo) => texto.Length <= largo ? texto : texto[..largo] + "…";
}
