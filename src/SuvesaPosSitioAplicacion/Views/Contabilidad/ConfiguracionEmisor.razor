@page "/accounting/issuer-setup"
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Contabilidad
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.Services
@inject IFacturacion FacturacionApi
@inject IEmisoresFiscales EmisoresApi
@inject ISucursales SucursalesApi
@inject IContabilidad Contabilidad
@inject IContextoSesion Sesion
@inject IServicioDialogos Dialogos
@inject IManejadorRespuestas Respuestas

@* El interruptor de Contabilidad es la sucursal. El emisor solo aporta el libro. *@

<AppPantalla Pantalla="Configuración emisor" Codigo="CONTABILIDAD.CONFIGURACION_EMISOR" Icono="bi-journal-text">
    <ChildContent>
        <div class="card">
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="ce-empresa">Empresa</label>
                        <select id="ce-empresa" class="form-select" @bind="_idEmpresa" @bind:after="AlCambiarSeleccion">
                            <option value="0">Seleccione...</option>
                            @foreach (var empresa in _empresas)
                            {
                                <option value="@empresa.Id">@empresa.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="ce-sucursal">Sucursal</label>
                        <select id="ce-sucursal" class="form-select" @bind="_idSucursal" @bind:after="AlCambiarSeleccion">
                            <option value="0">Seleccione...</option>
                            @foreach (var sucursal in _sucursales)
                            {
                                <option value="@sucursal.Id">@(sucursal.NombreComercial ?? sucursal.NombreFiscal)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="ce-emisor">Emisor</label>
                        <select id="ce-emisor" class="form-select" @bind="_idEmisor" @bind:after="AlCambiarSeleccion">
                            <option value="0">Seleccione...</option>
                            @foreach (var emisor in _emisores)
                            {
                                <option value="@emisor.Id">@emisor.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_cargando)
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
                }
                else if (_idSucursal == 0)
                {
                    <p class="text-secondary mb-0">Seleccione la sucursal. Ahí se enciende o se apaga la contabilidad.</p>
                }
                else if (_estado is not null)
                {
                    <div class="d-flex flex-wrap gap-4 align-items-center mb-3">
                        <div>
                            <div class="small text-secondary">Sucursal</div>
                            <span class="badge @(_estado.SucursalHabilitada ? "text-bg-success" : "text-bg-secondary")">
                                @(_estado.SucursalHabilitada ? "Encendida" : "Apagada")
                            </span>
                        </div>
                        @if (_idEmisor > 0)
                        {
                            <div>
                                <div class="small text-secondary">Libro del emisor</div>
                                <span class="badge @(_estado.EmisorHabilitado ? "text-bg-success" : "text-bg-secondary")">
                                    @(_estado.EmisorHabilitado ? "Creado" : "Sin libro")
                                </span>
                            </div>
                            <div>
                                <div class="small text-secondary">Relación emisor–sucursal</div>
                                <span class="badge @(_estado.RelacionVigente ? "text-bg-success" : "text-bg-secondary")">
                                    @(_estado.RelacionVigente ? "Vigente" : "No vigente")
                                </span>
                            </div>
                            <div>
                                <div class="small text-secondary">Contabilidad efectiva</div>
                                <span class="badge @(_estado.Efectivo ? "text-bg-success" : "text-bg-warning")">
                                    @(_estado.Efectivo ? "Activa" : "Inactiva")
                                </span>
                            </div>
                        }
                    </div>

                    @if (Sesion.Puede("CONTABILIDAD.CONFIGURACION_EMISOR", AccionPantalla.Activar))
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @if (_estado.SucursalHabilitada)
                            {
                                <button class="btn btn-sm btn-outline-danger" disabled="@_guardando" @onclick="DesactivarSucursal">Apagar sucursal</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary" disabled="@_guardando" @onclick="ActivarSucursal">Encender sucursal</button>
                            }

                            @if (_idEmisor > 0 && !_estado.EmisorHabilitado)
                            {
                                <button class="btn btn-sm btn-outline-primary" disabled="@_guardando" @onclick="ActivarEmisor">Crear libro del emisor</button>
                            }
                        </div>
                    }
                }

                @if (TieneLibro)
                {
                    <div class="mt-4">
                        <h2 class="h6">Cuentas de uso</h2>
                        <p class="form-text">El catálogo inicial sugiere un código. Aquí se elige la cuenta de este libro. Se puede cambiar cuando haga falta otra.</p>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="uso-retencion">Retención a proveedores</label>
                                <select id="uso-retencion" class="form-select" value="@(_cuentasUso.IdCuentaRetencion ?? 0)" @onchange="AsignarRetencion">
                                    <option value="0">Sin asignar</option>
                                    @foreach (var cuenta in _cuentasMovimiento)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Codigo — @cuenta.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="uso-dolares">Banco en dólares</label>
                                <select id="uso-dolares" class="form-select" value="@(_cuentasUso.IdCuentaBancoDolares ?? 0)" @onchange="AsignarBancoDolares">
                                    <option value="0">Sin asignar</option>
                                    @foreach (var cuenta in _cuentasMovimiento)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Codigo — @cuenta.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="uso-transito">Depósitos y cheques en tránsito</label>
                                <select id="uso-transito" class="form-select" value="@(_cuentasUso.IdCuentaTransito ?? 0)" @onchange="AsignarTransito">
                                    <option value="0">Sin asignar</option>
                                    @foreach (var cuenta in _cuentasMovimiento)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Codigo — @cuenta.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="uso-comisiones">Comisiones por pagar</label>
                                <select id="uso-comisiones" class="form-select" value="@(_cuentasUso.IdCuentaComisionesPorPagar ?? 0)" @onchange="AsignarComisiones">
                                    <option value="0">Sin asignar</option>
                                    @foreach (var cuenta in _cuentasMovimiento)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Codigo — @cuenta.Descripcion</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @if (Sesion.Puede("CONTABILIDAD.CONFIGURACION_EMISOR", AccionPantalla.Editar))
                        {
                            <button class="btn btn-sm btn-primary mt-3" disabled="@_guardando" @onclick="GuardarCuentasUso">Guardar cuentas de uso</button>
                        }
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</AppPantalla>

@code {
    [Inject] private Security.IContextoContabilidad ContextoContabilidad { get; set; } = default!;

    private List<EmpresaDTO> _empresas = new();
    private List<DTOs.Fiscal.EmisorFiscalDTO> _emisores = new();
    private List<DTOs.Fiscal.SucursalFiscalDTO> _sucursales = new();
    private int _idEmpresa;
    private int _idEmisor;
    private int _idSucursal;
    private EstadoActivacionContabilidadDTO? _estado;
    private CuentasUsoContableDTO _cuentasUso = new();
    private List<CuentaContableDTO> _cuentasMovimiento = new();
    private bool _cargando;
    private bool _guardando;
    private bool TieneLibro => _idEmisor > 0 && _estado?.IdLibroContable is > 0;

    protected override async Task OnInitializedAsync()
    {
        _empresas = (await Respuestas.DatoAsync(await FacturacionApi.Empresas(), "consultar las empresas"))?.ToList() ?? new();
        _emisores = (await Respuestas.DatoAsync(await EmisoresApi.Obtener(), "consultar los emisores"))?.ToList() ?? new();
        _sucursales = (await Respuestas.DatoAsync(await SucursalesApi.Obtener(), "consultar las sucursales"))?.ToList() ?? new();
        if (_empresas.Count == 1) _idEmpresa = _empresas[0].Id;
        if (_emisores.Count == 1) _idEmisor = _emisores[0].Id;
        if (Sesion.IdSucursal > 0) _idSucursal = Sesion.IdSucursal;
        else if (_sucursales.Count == 1) _idSucursal = _sucursales[0].Id;
        await AlCambiarSeleccion();
    }

    private async Task AlCambiarSeleccion()
    {
        _estado = null;
        if (_idSucursal == 0) return;

        _cargando = true;
        _estado = await Respuestas.DatoAsync(
            await Contabilidad.EstadoActivacion(_idEmpresa, _idEmisor == 0 ? null : _idEmisor, _idSucursal),
            "consultar el estado de activación de Contabilidad");
        _cargando = false;

        if (_idEmisor > 0)
        {
            await ContextoContabilidad.ResolverAsync(_idEmpresa, _idEmisor, _idSucursal);
            if (_estado?.IdLibroContable is > 0)
            {
                _cuentasUso = await Respuestas.DatoAsync(await Contabilidad.ObtenerCuentasUso(_idEmisor), "consultar las cuentas de uso") ?? new CuentasUsoContableDTO { IdEmisor = _idEmisor };
                var cuentas = await Respuestas.DatoAsync(await Contabilidad.ListarCuentas(_estado.IdLibroContable.Value), "consultar el catálogo");
                _cuentasMovimiento = cuentas?.Where(c => c.PermiteMovimiento == true).OrderBy(c => c.Codigo).ToList() ?? new();
            }
        }
    }

    private static long? CuentaElegida(ChangeEventArgs evento)
        => long.TryParse(evento.Value?.ToString(), out var idCuenta) && idCuenta > 0 ? idCuenta : null;

    private void AsignarRetencion(ChangeEventArgs evento) => _cuentasUso.IdCuentaRetencion = CuentaElegida(evento);
    private void AsignarBancoDolares(ChangeEventArgs evento) => _cuentasUso.IdCuentaBancoDolares = CuentaElegida(evento);
    private void AsignarTransito(ChangeEventArgs evento) => _cuentasUso.IdCuentaTransito = CuentaElegida(evento);
    private void AsignarComisiones(ChangeEventArgs evento) => _cuentasUso.IdCuentaComisionesPorPagar = CuentaElegida(evento);

    private async Task GuardarCuentasUso()
    {
        _cuentasUso.IdEmisor = _idEmisor;
        _guardando = true;
        var respuesta = await Contabilidad.GuardarCuentasUso(_idEmisor, _cuentasUso);
        _guardando = false;
        if (await Respuestas.CorrectaAsync(respuesta, "guardar las cuentas de uso"))
        {
            _cuentasUso = respuesta.Responses ?? _cuentasUso;
            Dialogos.Exito("Cuentas de uso guardadas.");
        }
    }

    private Task ActivarSucursal() => Ejecutar(() => Contabilidad.ActivarSucursal(_idSucursal), "encender Contabilidad en la sucursal");
    private Task DesactivarSucursal() => Ejecutar(() => Contabilidad.DesactivarSucursal(_idSucursal), "apagar Contabilidad en la sucursal");
    private Task ActivarEmisor() => Ejecutar(() => Contabilidad.ActivarEmisor(new ActivarEmisorDTO { IdEmisor = _idEmisor, MonedaFuncional = "CRC" }), "crear el libro del emisor");

    private async Task Ejecutar<T>(Func<Task<ResponseGeneric<T>>> accion, string queSeIntentaba)
    {
        _guardando = true;
        var respuesta = await accion();
        _guardando = false;

        if (await Respuestas.CorrectaAsync(respuesta, queSeIntentaba))
        {
            Dialogos.Exito("Listo.");
            await AlCambiarSeleccion();
        }
    }
}
