@page "/accounting/exchange-rates"
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Contabilidad
@using SuvesaPosSitioAplicacion.Services
@inject IAprobaciones Aprobaciones
@inject IServicioDialogos Dialogos
@inject IManejadorRespuestas Respuestas

@* F4: la contabilidad convierte con la tasa de VENTA del BCCR. Se captura sola cada día desde el
   indicador oficial; aquí se ve el historial y se completan a mano los días que falten. *@

<AppPantalla Pantalla="Tipos de cambio" Codigo="CONTABILIDAD.TIPOS_DE_CAMBIO" Icono="bi-currency-exchange" Nivel="NivelPantalla.Tableta">
    <ChildContent>
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-6 col-md-2">
                        <label class="form-label" for="tc-moneda">Moneda</label>
                        <input id="tc-moneda" class="form-control" maxlength="3" @bind="_moneda" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="tc-desde">Desde</label>
                        <input id="tc-desde" type="date" class="form-control" @bind="_desde" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="tc-hasta">Hasta</label>
                        <input id="tc-hasta" type="date" class="form-control" @bind="_hasta" />
                    </div>
                    <div class="col-6 col-md-2">
                        <button class="btn btn-primary w-100" @onclick="Cargar">Consultar</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Registrar un día</div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="tc-fecha">Fecha</label>
                        <input id="tc-fecha" type="date" class="form-control" @bind="_nuevaFecha" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="tc-compra">Compra</label>
                        <input id="tc-compra" type="number" step="0.01" class="form-control" @bind="_compra" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="tc-venta">Venta</label>
                        <input id="tc-venta" type="number" step="0.01" class="form-control" @bind="_venta" />
                    </div>
                    <div class="col-6 col-md-3">
                        <button class="btn btn-outline-primary w-100" disabled="@_guardando" @onclick="Registrar">Guardar</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                <thead><tr><th>Fecha</th><th>Moneda</th><th class="text-end">Compra</th><th class="text-end">Venta</th><th>Fuente</th></tr></thead>
                <tbody>
                    @foreach (var t in _tasas)
                    {
                        <tr>
                            <td>@t.Fecha.ToString("yyyy-MM-dd")</td>
                            <td>@t.Moneda</td>
                            <td class="text-end">@t.Compra.ToString("N2")</td>
                            <td class="text-end">@t.Venta.ToString("N2")</td>
                            <td>@t.Fuente</td>
                        </tr>
                    }
                    @if (_tasas.Count == 0) { <tr><td colspan="5" class="text-secondary">Sin tasas en el rango.</td></tr> }
                </tbody>
            </table></div>
        </div>
    </ChildContent>
</AppPantalla>

@code {
    private string _moneda = "USD";
    private DateTime _desde = DateTime.Today.AddDays(-30);
    private DateTime _hasta = DateTime.Today;
    private DateTime _nuevaFecha = DateTime.Today;
    private decimal _compra;
    private decimal _venta;
    private bool _guardando;
    private List<TipoCambioContableDTO> _tasas = new();

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        _tasas = (await Respuestas.DatoAsync(
            await Aprobaciones.TiposCambio(_moneda, DateOnly.FromDateTime(_desde), DateOnly.FromDateTime(_hasta)),
            "consultar los tipos de cambio"))?.ToList() ?? new();
    }

    private async Task Registrar()
    {
        if (_compra <= 0 || _venta <= 0)
        {
            Dialogos.Advertencia("Compra y venta deben ser mayores que cero.");
            return;
        }
        _guardando = true;
        var respuesta = await Aprobaciones.RegistrarTipoCambio(new RegistrarTipoCambioDTO
        {
            Fecha = DateOnly.FromDateTime(_nuevaFecha), Moneda = _moneda.Trim().ToUpperInvariant(), Compra = _compra, Venta = _venta,
        });
        _guardando = false;
        if (!await Respuestas.CorrectaAsync(respuesta, "registrar el tipo de cambio")) return;
        Dialogos.Exito("Tipo de cambio guardado.");
        await Cargar();
    }
}
