@page "/cuenta/ingresar"
@layout LayoutVacio
@using Microsoft.AspNetCore.Components.Endpoints
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SuvesaPosSitioAplicacion.Services
@inject IServicioAutenticacion Autenticacion
@inject NavigationManager Navegacion
@attribute [AllowAnonymous]

@* Render estatico a proposito: establecer la cookie de sesion exige HttpContext,
   y un componente interactivo ya no lo tiene. *@

<PageTitle>Ingresar &mdash; SeePOS</PageTitle>

<div class="container" style="max-width: 26rem;">
    <div class="card shadow-sm mt-5">
        <div class="card-body p-4">

            <h1 class="h4 mb-1">SUVESA SeePOS</h1>
            <p class="text-secondary small mb-4">Indique sus credenciales para continuar.</p>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert alert-danger py-2 small" role="alert">@Error</div>
            }

            <EditForm Model="Entrada" FormName="ingresar" OnValidSubmit="Validar">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="usuario">Usuario</label>
                    <InputText id="usuario" class="form-control" @bind-Value="Entrada.Usuario" autofocus />
                    <ValidationMessage For="() => Entrada.Usuario" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="password">Contrasena</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="Entrada.Password" />
                    <ValidationMessage For="() => Entrada.Password" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </EditForm>

        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    public LoginVM Entrada { get; set; } = default!;

    private string? Error { get; set; }

    // El binder puede dejarla en null tras el POST; se completa aqui, no en el inicializador.
    protected override void OnInitialized() => Entrada ??= new();

    private async Task Validar()
    {
        var r = await Autenticacion.IngresarAsync(HttpContext, Entrada.Usuario, Entrada.Password);

        if (!r.EsCorrecta)
        {
            Error = r.Excepcion;
            return;
        }

        Navegacion.NavigateTo("/cuenta/sucursal", forceLoad: true);
    }
}
