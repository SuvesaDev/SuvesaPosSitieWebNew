@page "/cuenta/sucursal"
@layout LayoutVacio
@using Microsoft.AspNetCore.Components.Endpoints
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authorization
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Security
@attribute [Authorize]
@inject ISeguridad Seguridad
@inject IServicioAutenticacion Autenticacion
@inject NavigationManager Navegacion
@inject ILogger<Sucursal> Log
@inject IContextoSesion Sesion
@inject IWebHostEnvironment Entorno

@* Segundo paso del ingreso. El sistema actual hace lo mismo tras validar credenciales. *@

<PageTitle>Seleccione el centro &mdash; SeePOS</PageTitle>

@*  Se presenta como modal sobre la pantalla de ingreso, igual que el sistema
    actual: tras validar credenciales aparece encima para elegir el centro.

    Es una pagina y no un dialogo interactivo porque establecer la cookie de sesion
    exige HttpContext, y un componente interactivo ya no lo tiene. El usuario ve un
    modal; por debajo es una peticion mas, que es lo que lo hace fiable. *@

<div class="seepos-fondo-ingreso seepos-fondo-centro" aria-hidden="true">
    <div class="seepos-fondo-centro-contenido">
        <div class="seepos-fondo-centro-marca">
            <img src="img/costavet-logo-compact.png" alt="" />
            <span>SeePOS</span>
        </div>
        <div class="seepos-fondo-centro-resumen">
            <span class="seepos-fondo-centro-icono"><i class="bi bi-shield-check"></i></span>
            <div>
                <strong>Acceso validado</strong>
                <span>Preparando su espacio de trabajo</span>
            </div>
        </div>
    </div>
</div>

<div class="modal-backdrop show"></div>

<div class="modal d-block seepos-modal-centro" tabindex="-1" role="dialog" aria-modal="true"
     aria-labelledby="tituloCentro" aria-describedby="descripcionCentro">
    <div class="modal-dialog modal-dialog-centered seepos-modal-centro-dialog">
        <div class="modal-content seepos-modal-centro-contenido">

            <div class="modal-header seepos-modal-centro-encabezado">
                <div class="seepos-modal-centro-identidad">
                    <span class="seepos-modal-centro-icono" aria-hidden="true"><i class="bi bi-shop"></i></span>
                    <div>
                        <span class="seepos-modal-centro-eyebrow">Espacio de trabajo</span>
                        <h1 class="modal-title" id="tituloCentro">Seleccione el centro</h1>
                    </div>
                </div>
            </div>

            <div class="modal-body seepos-modal-centro-cuerpo">
                <p class="seepos-modal-centro-descripcion" id="descripcionCentro">Elija la sucursal desde la que va a trabajar hoy.</p>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger seepos-modal-centro-alerta" role="alert">
                        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                        <span>@Error</span>
                    </div>

                    @if (Entorno.IsDevelopment() && Diagnostico is not null)
                    {
                        <details class="small text-secondary mb-2" open>
                            <summary>Detalle tecnico</summary>
                            <pre class="small mt-2 mb-0" style="white-space:pre-wrap">@Diagnostico</pre>
                        </details>
                    }
                }
                else if (Sucursales is null)
                {
                    <div class="seepos-modal-centro-cargando" role="status">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Consultando centros disponibles...</span>
                    </div>
                }
                else if (Sucursales.Count == 0)
                {
                    <div class="alert alert-warning seepos-modal-centro-alerta mb-0" role="alert">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <span>El usuario no tiene ningun centro asignado. Consulte con el administrador del sistema.</span>
                    </div>
                }
                else
                {
                    <EditForm Model="Seleccion" FormName="sucursal" OnValidSubmit="Elegir" id="formCentro">
                        <label class="form-label seepos-modal-centro-etiqueta" for="centro">Centro de trabajo</label>
                        <InputSelect class="form-select" @bind-Value="Seleccion.IdSucursal"
                                     id="centro" aria-label="Centro de trabajo">
                            <option value="0">Seleccione...</option>
                            @foreach (var s in Sucursales)
                            {
                                <option value="@s.Id">@(s.Alias ?? s.NombreComercial)</option>
                            }
                        </InputSelect>
                    </EditForm>
                }
            </div>

            <div class="modal-footer seepos-modal-centro-pie">
                <a href="/cuenta/salir" class="seepos-modal-centro-salir">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    <span>Ingresar con otro usuario</span>
                </a>
                @if (Sucursales is { Count: > 0 })
                {
                    <button type="submit" form="formCentro" class="btn btn-primary seepos-modal-centro-ingresar">
                        <span>Continuar</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                }
            </div>

        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    public LoginVM Seleccion { get; set; } = default!;

    private IList<SucursalDTO>? Sucursales { get; set; }
    private string? Error { get; set; }

    /// <summary>Solo en desarrollo: por que fallo, con datos en vez de conjeturas.</summary>
    private string? Diagnostico { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // El binder puede dejarla en null tras el POST.
        Seleccion ??= new();

        // Sin esto el token queda nulo y el API responde 401. Toda pantalla que
        // llame al API tiene que cargar antes el contexto; las de negocio lo hacen
        // dentro de AppPantalla, y estas dos de sesion lo hacen aqui.
        await Sesion.CargarAsync();

        var r = await Seguridad.ObtenerSucursales();

        if (!r.EsCorrecta)
        {
            // El detalle tecnico va al log, no a la pantalla: al usuario no le sirve
            // leer un codigo HTTP y no puede hacer nada con el.
            Log.LogWarning("No se pudieron consultar los centros: {Detalle}", r.Excepcion);

            if (Entorno.IsDevelopment())
            {
                var u = HttpContext.User;
                var token = u.FindFirst(ClaimsSeePos.Token)?.Value;

                Diagnostico =
                    $"autenticado      : {u.Identity?.IsAuthenticated}\n" +
                    $"usuario          : {u.Identity?.Name ?? "(ninguno)"}\n" +
                    $"claims           : {u.Claims.Count()}\n" +
                    $"token en claims  : {!string.IsNullOrWhiteSpace(token)}\n" +
                    $"largo del token  : {token?.Length ?? 0}\n" +
                    $"token en contexto: {!string.IsNullOrWhiteSpace(Sesion.Token)}\n" +
                    $"permisos         : {u.FindAll(ClaimsSeePos.Permiso).Count()}\n" +
                    $"---\n{r.Excepcion}";
            }

            Error = "No se pudieron consultar los centros. Intente de nuevo o vuelva a ingresar.";
            Sucursales = new List<SucursalDTO>();
            return;
        }

        Sucursales = r.Responses?.ToList() ?? new List<SucursalDTO>();
    }

    private async Task Elegir()
    {
        var elegida = Sucursales?.FirstOrDefault(s => s.Id == Seleccion.IdSucursal);

        if (elegida is null)
        {
            Error = "Seleccione un centro de la lista.";
            return;
        }

        var r = await Autenticacion.EstablecerSucursalAsync(HttpContext, elegida);

        if (!r.EsCorrecta)
        {
            Log.LogWarning("No se pudo establecer la sucursal: {Detalle}", r.Excepcion);
            Error = "No se pudo establecer el centro. Vuelva a ingresar.";
            return;
        }

        Navegacion.NavigateTo("/", forceLoad: true);
    }
}
