@page "/buys/physical-count"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.DTOs.Lotes
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ILotesApiCliente Api
@inject IServicioDialogos Dialogos
@inject SuvesaPosSitioAplicacion.Security.IContextoSesion Sesion

@* Toma física: suma las pretomas abiertas y ajusta el inventario solo al aprobar. *@

<AppPantalla Pantalla="@Titulo" Codigo="COMPRAS.TOMA.TOMA_FISICA" Icono="bi-clipboard-check"
             Subtitulo="Sumar las pretomas y ajustar el inventario al aprobar" Nivel="NivelPantalla.Tableta">
    <Acciones>
        <button class="btn btn-sm btn-outline-primary" @onclick="() => Aprobar(false)" disabled="@(_guardando || _lineas.Count == 0)">
            @(_guardando ? "Aprobando..." : "Aprobar parcial")
        </button>
        <button class="btn btn-sm btn-primary" @onclick="() => Aprobar(true)" disabled="@(_guardando || _lineas.Count == 0)">
            @(_guardando ? "Aprobando..." : "Aprobar total")
        </button>
    </Acciones>
    <ChildContent>
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="tf-bodega">Bodega <span class="text-danger">*</span></label>
                        <select id="tf-bodega" class="form-select" @bind="_bodega" @bind:after="AlCambiarBodega">
                            <option value="0">Seleccione...</option>
                            @foreach (var b in _bodegas) { <option value="@b.IdBodega">@b.NombreBodega</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="tf-texto">Buscar por código, descripción o lote</label>
                        <input id="tf-texto" class="form-control" @bind="_texto" @bind:event="oninput" placeholder="Filtra la suma, no la vuelve a pedir" />
                    </div>
                    <div class="col-12 col-md-3 d-grid">
                        <button class="btn btn-outline-primary" @onclick="Cargar" disabled="@(_cargando || _bodega <= 0)">
                            @(_cargando ? "Cargando..." : "Cargar pretomas")
                        </button>
                    </div>
                </div>
                <p class="form-text mb-0 mt-2">
                    Aquí se suman las pretomas abiertas de la bodega, por artículo, lote y vencimiento.
                    El inventario no cambia hasta aprobar.
                    <strong>Parcial</strong> ajusta solo lo contado.
                    <strong>Total</strong> ajusta lo contado y deja en cero lo que no se contó.
                    Buscar no borra la suma.
                    @if (_consolidado is not null)
                    {
                        <span> @_consolidado.Pretomas pretoma(s) · @_lineas.Count renglones.</span>
                    }
                </p>
            </div>
        </div>

        @if (_cargando)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
        }
        else if (_consolidado is null)
        {
            <div class="alert alert-light border">Cargue las pretomas abiertas de la bodega. Si no hay ninguna, haga primero la pretoma.</div>
        }
        else if (_lineas.Count == 0)
        {
            <div class="alert alert-light border">No hay pretomas abiertas con conteo en esta bodega.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Código</th><th>Descripción</th><th>Lote</th><th>Vence</th>
                            <th class="text-end">Sistema</th><th class="text-end">Contado</th><th class="text-end">Diferencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Visibles)
                        {
                            var dif = a.Contado - a.ExistenciaSistema;
                            <tr class="@(Math.Abs(dif) > 0.0001 ? "table-warning" : null)">
                                <td><code>@a.CodArticulo</code></td>
                                <td>@a.Descripcion</td>
                                <td>@(string.IsNullOrWhiteSpace(a.NumeroLote) ? "Sin lote" : a.NumeroLote)</td>
                                <td>@(a.Vencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="text-end">@a.ExistenciaSistema.ToString("N2")</td>
                                <td class="text-end">@a.Contado.ToString("N2")</td>
                                <td class="text-end fw-semibold @(dif < 0 ? "text-danger" : dif > 0 ? "text-success" : "")">@dif.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Visibles.Any())
            {
                <div class="alert alert-light border">Ningún renglón coincide con la búsqueda. La suma sigue cargada.</div>
            }
        }
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modalReporte" Title="Reporte de toma física" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_reporte is not null)
        {
            <p class="mb-2"><strong>Consecutivo N.º @_reporte.Id.ToString("D8")</strong>
               <span class="text-secondary small ms-2">(= id de la toma)</span>
               @if (_reporte.EsParcial) { <span class="badge text-bg-warning ms-2">Parcial</span> }
               @if (_reporte.Anulada) { <span class="badge text-bg-secondary ms-2">Anulada</span> }
            </p>
            @if (!string.IsNullOrWhiteSpace(_reporte.Observaciones))
            {
                <p class="text-secondary small">@_reporte.Observaciones</p>
            }
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3"><div class="text-secondary small">Artículos ajustados</div><div class="h5 mb-0">@_reporte.ArticulosAjustados</div></div>
                <div class="col-6 col-md-3"><div class="text-secondary small">Unidades ganadas</div><div class="h5 mb-0 text-success">@_reporte.UnidadesGanadas.ToString("N2")</div></div>
                <div class="col-6 col-md-3"><div class="text-secondary small">Costeo de ganancias</div><div class="h5 mb-0 text-success">@_reporte.CostoGanancias.ToString("N2")</div></div>
                <div class="col-6 col-md-3"><div class="text-secondary small">Unidades perdidas</div><div class="h5 mb-0 text-danger">@_reporte.UnidadesPerdidas.ToString("N2")</div></div>
                <div class="col-6 col-md-3"><div class="text-secondary small">Costeo de pérdidas</div><div class="h5 mb-0 text-danger">@_reporte.CostoPerdidas.ToString("N2")</div></div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Código</th><th>Descripción</th><th>Lote</th><th class="text-end">Sistema</th><th class="text-end">Contado</th><th class="text-end">Dif.</th><th class="text-end">Costo dif.</th></tr></thead>
                    <tbody>
                        @foreach (var l in _reporte.Lineas)
                        {
                            <tr>
                                <td><code>@l.CodArticulo</code></td><td>@l.Descripcion</td><td>@l.NumeroLote</td>
                                <td class="text-end">@l.ExistenciaSistema.ToString("N2")</td>
                                <td class="text-end">@l.Contado.ToString("N2")</td>
                                <td class="text-end @(l.Diferencia < 0 ? "text-danger" : l.Diferencia > 0 ? "text-success" : "")">@l.Diferencia.ToString("N2")</td>
                                <td class="text-end @(l.CostoDiferencia < 0 ? "text-danger" : "")">@l.CostoDiferencia.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (_reporte is not null && !_reporte.Anulada && Sesion.Puede(Titulo, AccionPantalla.Borrar))
        {
            <button class="btn btn-outline-danger" @onclick="Anular" disabled="@_anulando">@(_anulando ? "Anulando..." : "Anular toma")</button>
        }
        @if (_reporte is not null && Sesion.Puede(Titulo, AccionPantalla.Imprimir))
        {
            <BotonImprimir Tipo="toma-fisica" Id="_reporte.Id" Texto="Imprimir toma física" Clase="btn-outline-primary" />
        }
        <button class="btn btn-primary" @onclick="() => _modalReporte.HideAsync()">Cerrar</button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Titulo = "Toma física";

    private string _texto = string.Empty;
    private bool _cargando, _guardando, _anulando;
    private List<PretomaConsolidadoLinea> _lineas = new();
    private PretomaConsolidado? _consolidado;
    private HxModal _modalReporte = default!;
    private TomaFisicaReporte? _reporte;

    private int _bodega;
    private List<BodegaOperativa> _bodegas = new();

    private IEnumerable<PretomaConsolidadoLinea> Visibles
    {
        get
        {
            var t = _texto.Trim();
            if (t.Length == 0) return _lineas;
            return _lineas.Where(f =>
                f.CodArticulo.Contains(t, StringComparison.OrdinalIgnoreCase)
                || f.Descripcion.Contains(t, StringComparison.OrdinalIgnoreCase)
                || (f.NumeroLote ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        if (!Sesion.PuedeVer("COMPRAS.TOMA.TOMA_FISICA")) return;
        var r = await Api.BodegasOperativasAsync(Sesion.IdSucursal > 0 ? Sesion.IdSucursal : null);
        _bodegas = r.Status == ResponseStatus._0
            ? (r.Responses ?? new()).Where(b => b.IdSucursal == Sesion.IdSucursal).ToList()
            : new();
        if (_bodegas.Count == 1) _bodega = _bodegas[0].IdBodega;
    }

    private void AlCambiarBodega()
    {
        _lineas = new();
        _consolidado = null;
        _texto = string.Empty;
    }

    private async Task Cargar()
    {
        if (_bodega <= 0) { await Dialogos.ErrorAsync("Seleccione la bodega."); return; }
        _cargando = true;
        var r = await Api.TomaConsolidarAsync(_bodega);
        _cargando = false;
        if (r.Status != ResponseStatus._0 || r.Responses is null)
        {
            await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudieron sumar las pretomas.");
            return;
        }
        _consolidado = r.Responses;
        _lineas = r.Responses.Lineas ?? new();
    }

    private async Task Aprobar(bool total)
    {
        if (_lineas.Count == 0) { await Dialogos.ErrorAsync("No hay conteos para aprobar."); return; }
        var aviso = total
            ? "Se ajusta todo el inventario de la bodega. Lo contado queda en esa cantidad. Lo que no se contó queda en cero."
            : "Se ajustan solo los artículos, lotes y vencimientos que tienen conteo. Lo que no se contó queda igual.";
        if (!await Dialogos.ConfirmarAsync(aviso, total ? "Aprobar toma total" : "Aprobar toma parcial"))
            return;

        _guardando = true;
        var r = await Api.TomaAprobarAsync(new PretomaAprobar { Bodega = _bodega, ActualizacionTotal = total });
        _guardando = false;

        if (r.Status != ResponseStatus._0 || r.Responses is null)
        {
            await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo aprobar la toma física.");
            return;
        }
        _reporte = r.Responses;
        Dialogos.Exito("Toma física aprobada. El inventario quedó ajustado.");
        await _modalReporte.ShowAsync();
        await Cargar();
    }

    private async Task Anular()
    {
        if (_reporte is null || _reporte.Anulada) return;
        if (!await Dialogos.ConfirmarAsync("Se devuelve el inventario al saldo de antes de esta toma y las pretomas vuelven a quedar abiertas.", "Anular toma física"))
            return;
        _anulando = true;
        var r = await Api.TomaAnularAsync(_reporte.Id, "Anulada desde la pantalla");
        _anulando = false;
        if (r.Status != ResponseStatus._0 || r.Responses is null)
        {
            await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo anular la toma.");
            return;
        }
        _reporte = r.Responses;
        Dialogos.Exito("Toma anulada.");
        await Cargar();
    }
}
