@page "/buys/buy"
@using System.Globalization
@using System.Xml.Linq
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.DTOs.Lotes
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ICompras Api
@inject ILotesApiCliente Lotes2
@inject IProveedoresConsulta Proveedores
@inject IInventarioConsulta Inventario
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject IJSRuntime JS

@* Registro de compras: port nativo de BuysPage/BuysArticulosHeader del POS
   anterior. El encabezado se valida antes de abrir el buscador y cada detalle
   conserva su costo compuesto para que el API actualice inventario y lotes. *@

<AppPantalla Pantalla="@Titulo" Icono="bi-cart-plus-fill" Subtitulo="Registro de compras a proveedor" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NuevaCompra"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nueva compra</button>
        <button class="btn btn-sm btn-outline-primary" disabled="@(!_compraDesbloqueada)" @onclick="AbrirBuscadorCompras"><i class="bi bi-search me-1" aria-hidden="true"></i>Buscar</button>
        <button class="btn btn-sm btn-primary" disabled="@(!_compraDesbloqueada)" @onclick="AbrirImportadorXml"><i class="bi bi-file-earmark-arrow-up me-1" aria-hidden="true"></i>Importar XML</button>
    </Acciones>
    <ChildContent>
        <AppDesbloqueoClave @ref="_bloqueo" Titulo="el registro de compras" AlCambiar="AlDesbloquear" />
        <fieldset disabled="@(!_compraDesbloqueada)" class="seepos-compras border-0 p-0 m-0">
            <div class="row g-3">
                <div class="col-12 col-xl-8">
                    <div class="card h-100 seepos-compras-cabecera">
                        <div class="card-header d-flex justify-content-between align-items-center"><strong>@(_idCompra > 0 ? $"Compra #{_idCompra}" : "Datos de la compra")</strong>@if (_idCompra > 0) { <span class="badge text-bg-warning">Edición</span> }</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Proveedor</label>
                                    <div class="input-group"><input class="form-control" placeholder="Cédula o nombre del proveedor" @bind="_textoProveedor" @oninput="FiltrarProveedores" /><button type="button" class="btn btn-outline-primary" @onclick="MostrarProveedores">Buscar</button><button type="button" class="btn btn-outline-secondary" title="Crear proveedor" @onclick="AbrirNuevoProveedor"><i class="bi bi-person-plus" aria-hidden="true"></i></button></div>
                                    @if (_proveedoresEncontrados.Count > 0)
                                    {
                                        <div class="list-group position-absolute shadow seepos-resultados-proveedor">@foreach (var proveedor in _proveedoresEncontrados) { <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirProveedor(proveedor)"><strong>@proveedor.Nombre</strong><span class="text-secondary ms-2">@proveedor.Cedula</span></button> }</div>
                                    }
                                </div>
                                <div class="col-12 col-md-6"><label class="form-label">Proveedor seleccionado</label><div class="form-control bg-body-tertiary text-truncate">@(_proveedor?.Nombre ?? "Seleccione un proveedor")</div></div>
                                <div class="col-6 col-md-3"><label class="form-label">Número de factura</label><input class="form-control" @bind="_numeroFactura" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">Condición</label><select class="form-select" @bind="_tipoCompra" @bind:after="ActualizarVencimiento"><option value="2">Contado</option><option value="1">Crédito</option></select></div>
                                <div class="col-6 col-md-3"><label class="form-label">Fecha</label><input type="date" class="form-control" @bind="_fecha" @bind:after="ActualizarVencimiento" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">Días de crédito</label><input type="number" min="0" class="form-control" disabled="@(_tipoCompra != 1)" @bind="_diasCredito" @bind:after="ActualizarVencimiento" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">Vencimiento</label><input type="date" class="form-control" disabled value="@VencimientoTexto" /></div>
                                <div class="col-6 col-md-3"><label class="form-label">Moneda</label><select class="form-select" @bind="_moneda"><option value="0">Seleccione...</option>@foreach (var moneda in _monedas) { <option value="@moneda.CodMoneda">@moneda.MonedaNombre</option> }</select></div>
                                <div class="col-12 col-md-3"><label class="form-label">Bodega</label><select class="form-select" @bind="_bodega"><option value="0">Seleccione...</option>@foreach (var bodega in _bodegas) { <option value="@bodega.IdBodega">@bodega.NombreBodega</option> }</select></div>
                                @if (!EsCostaPetsCompra)
                                {
                                    <div class="col-12 col-md-3"><label class="form-label">Empresa</label><select class="form-select" @bind="_empresa"><option value="0">Seleccione...</option>@foreach (var empresa in _empresas) { <option value="@empresa.Id">@empresa.Nombre</option> }</select></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-4">
                    <div class="card h-100 seepos-compras-totales"><div class="card-header"><strong>Totales de compra</strong></div><div class="card-body"><dl class="row mb-0"><dt class="col-7 fw-normal text-secondary">Exento</dt><dd class="col-5 text-end">@Formato.Importe(TotalExento)</dd><dt class="col-7 fw-normal text-secondary">Gravado</dt><dd class="col-5 text-end">@Formato.Importe(TotalGravado)</dd><dt class="col-7 fw-normal text-secondary">Descuento</dt><dd class="col-5 text-end">@Formato.Importe(_totales.Descuento)</dd><dt class="col-7 fw-normal text-secondary">Impuesto</dt><dd class="col-5 text-end">@Formato.Importe(_totales.Impuesto)</dd><dt class="col-7">Total</dt><dd class="col-5 text-end fs-5">@Formato.Importe(_totales.Total)</dd></dl><button class="btn btn-primary w-100 mt-3" disabled="@(_guardando || _lineas.Count == 0)" @onclick="Guardar"><i class="bi bi-floppy me-2" aria-hidden="true"></i>@(_guardando ? "Guardando..." : _idCompra > 0 ? "Guardar cambios" : "Registrar compra")</button>@if (_idCompra > 0) { <button class="btn btn-outline-danger w-100 mt-2" disabled="@_guardando" @onclick="Anular"><i class="bi bi-x-circle me-2" aria-hidden="true"></i>Anular compra</button> }</div></div>
                </div>
            </div>

            <div class="card mt-3 seepos-compras-detalle">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2"><strong>Artículos en detalle</strong><button type="button" class="btn btn-sm btn-primary" @onclick="AbrirBuscadorArticulo"><i class="bi bi-search me-1" aria-hidden="true"></i>Buscar artículo</button></div>
                <div class="card-body">
                    @if (_articuloActual is not null)
                    {
                        <div class="seepos-compras-editor border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between gap-2 mb-3"><div><strong>@_articuloActual.Descripcion</strong><span class="text-secondary ms-2 small">@_articuloActual.Cod_Articulo · CABYS @_articuloActual.Codcabys</span></div><button type="button" class="btn btn-sm btn-link text-danger" @onclick="LimpiarEditor">Cancelar</button></div>
                            <div class="row g-3">
                                <div class="col-6 col-md-2"><label class="form-label">Cantidad</label><input type="number" min="0.001" step="0.001" class="form-control text-end" @bind="_cantidad" @bind:after="RecalcularEditor" /></div>
                                @if (!EsCostaPetsCompra) { <div class="col-6 col-md-2"><label class="form-label">Regalías</label><input type="number" min="0" step="0.001" class="form-control text-end" @bind="_regalias" /></div> }
                                <div class="col-6 col-md-2"><label class="form-label">Base</label><input type="number" min="0" step="0.01" class="form-control text-end" @bind="_base" @bind:after="RecalcularEditor" /></div>
                                @if (!EsCostaPetsCompra) { <div class="col-6 col-md-2"><label class="form-label">Flete</label><input type="number" min="0" step="0.01" class="form-control text-end" @bind="_flete" @bind:after="RecalcularEditor" /></div><div class="col-6 col-md-2"><label class="form-label">Otros cargos</label><input type="number" min="0" step="0.01" class="form-control text-end" @bind="_otros" @bind:after="RecalcularEditor" /></div> }
                                <div class="col-6 col-md-2"><label class="form-label">Costo unitario</label><div class="form-control bg-body-tertiary text-end">@Formato.Importe(CostoEditor)</div></div>
                                <div class="col-6 col-md-2"><label class="form-label">Descuento %</label><input type="number" min="0" max="100" step="0.01" class="form-control text-end" @bind="_descuento" @bind:after="RecalcularEditor" /></div>
                                <div class="col-6 col-md-2"><label class="form-label">Impuesto %</label><input type="number" min="0" max="100" step="0.01" class="form-control text-end" @bind="_impuesto" @bind:after="RecalcularEditor" /></div>
                                @if (_articuloActual.Lote)
                                {
                                    <div class="col-12 col-md-4"><label class="form-label">Número de lote</label><input class="form-control" @bind="_lote" /></div><div class="col-12 col-md-3"><label class="form-label">Vencimiento de lote</label><input type="date" class="form-control" @bind="_venceLote" /></div>
                                    <div class="col-12">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="form-text mb-0">¿La compra trae varios lotes de este artículo? Agréguelos aquí (la suma debe dar @Formato.Cantidad(_cantidad)).</span>
                                            <button type="button" class="btn btn-sm btn-link" @onclick="() => _lotesExtra.Add(new LoteExtra())">+ Otro lote</button>
                                        </div>
                                        @foreach (var le in _lotesExtra)
                                        {
                                            <div class="row g-2 align-items-end mt-1">
                                                <div class="col-5"><input class="form-control form-control-sm" placeholder="Número" @bind="le.Numero" /></div>
                                                <div class="col-4"><input type="date" class="form-control form-control-sm" @bind="le.Vence" /></div>
                                                <div class="col-2"><input type="number" min="0.001" step="0.001" class="form-control form-control-sm text-end" placeholder="Cant." @bind="le.Cantidad" /></div>
                                                <div class="col-1"><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => _lotesExtra.Remove(le)"><i class="bi bi-trash" aria-hidden="true"></i></button></div>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="col-12 col-md-auto d-flex align-items-end"><button type="button" class="btn btn-success w-100" @onclick="AgregarOActualizarLinea"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>@(_indiceEdicion is null ? "Agregar" : "Actualizar")</button></div>
                            </div>
                        </div>
                    }
                    @if (_lineas.Count == 0) { <p class="text-secondary text-center py-4 mb-0">Agregue los artículos recibidos en esta compra.</p> }
                    else { <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Código</th><th>Descripción</th><th class="text-end">Cantidad</th>@if (!EsCostaPetsCompra) { <th class="text-end">Regalías</th> }<th class="text-end">Base</th>@if (!EsCostaPetsCompra) { <th class="text-end">Flete</th><th class="text-end">Otros</th> }<th class="text-end">Costo</th><th class="text-end">Desc.</th><th class="text-end">IV</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@for (var i = 0; i < _lineas.Count; i++) { var linea = _lineas[i]; var indice = i; <tr><td><code>@linea.Articulo.Cod_Articulo</code></td><td>@linea.Articulo.Descripcion @if (linea.Articulo.Lote) { <small class="d-block text-secondary">Lote @linea.Lote · vence @linea.VenceLote.ToString("dd/MM/yyyy")</small> }</td><td class="text-end">@Formato.Cantidad(linea.Cantidad)</td>@if (!EsCostaPetsCompra) { <td class="text-end">@Formato.Cantidad(linea.Regalias)</td> }<td class="text-end">@Formato.Importe(linea.Base)</td>@if (!EsCostaPetsCompra) { <td class="text-end">@Formato.Importe(linea.Flete)</td><td class="text-end">@Formato.Importe(linea.Otros)</td> }<td class="text-end">@Formato.Importe(linea.Costo)</td><td class="text-end">@linea.Descuento:N2%</td><td class="text-end">@linea.Impuesto:N2%</td><td class="text-end fw-semibold">@Formato.Importe(linea.Calculo.Total)</td><td class="text-end text-nowrap"><button type="button" class="btn btn-sm btn-link" @onclick="() => EditarLinea(indice)">Editar</button><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarLinea(indice)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button></td></tr> }</tbody></table></div> }
                </div>
            </div>
        </fieldset>
    </ChildContent>
</AppPantalla>


<HxModal @ref="_modalNuevaProveedor" Title="Nuevo proveedor" Size="ModalSize.Regular">
    <BodyTemplate><div class="row g-3"><div class="col-12"><label class="form-label">Cédula</label><input class="form-control" @bind="_nuevoProveedorCedula" /></div><div class="col-12"><label class="form-label">Nombre</label><input class="form-control" @bind="_nuevoProveedorNombre" /></div><div class="col-12"><label class="form-label">Teléfono</label><input class="form-control" @bind="_nuevoProveedorTelefono" /></div></div></BodyTemplate>
    <FooterTemplate><button type="button" class="btn btn-outline-secondary" @onclick="CerrarNuevoProveedor">Cancelar</button><button type="button" class="btn btn-primary" @onclick="CrearProveedor">Guardar proveedor</button></FooterTemplate>
</HxModal>

<HxModal @ref="_modalBuscarCompras" Title="Buscar compras" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-2 align-items-end mb-3"><div class="col-12 col-md-4"><label class="form-label">Factura</label><input class="form-control" @bind="_filtroFactura" /></div><div class="col-12 col-md-4"><label class="form-label">Proveedor</label><input class="form-control" @bind="_filtroProveedor" /></div><div class="col-12 col-md-4 d-grid"><button type="button" class="btn btn-outline-primary" @onclick="BuscarCompras">Buscar</button></div></div>
        @if (_comprasEncontradas.Count == 0) { <p class="text-secondary text-center py-4">Use uno de los filtros para consultar compras.</p> }
        else { <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Factura</th><th>Proveedor</th><th>Fecha</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@foreach (var compra in _comprasEncontradas) { <tr><td>@compra.Factura</td><td>@compra.NombreProveedor</td><td>@compra.Fecha</td><td class="text-end">@Formato.Importe(compra.TotalFactura)</td><td class="text-end"><button type="button" class="btn btn-sm btn-primary" @onclick="() => CargarCompra(compra.IdCompra)">Abrir</button></td></tr> }</tbody></table></div> }
    </BodyTemplate>
</HxModal>

<HxModal @ref="_modalImportarXml" Title="Importar factura electrónica" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div class="seepos-importador-xml">
            <div class="border rounded p-3 mb-3 bg-body-tertiary">
                <label class="form-label" for="archivo-factura-xml">Comprobante electrónico XML</label>
                <InputFile id="archivo-factura-xml" class="form-control" accept=".xml,text/xml,application/xml" OnChange="ImportarXml" />
                <div class="form-text">Se aceptan Factura Electrónica y Tiquete Electrónico de Hacienda, incluyendo las versiones con espacios de nombres y firma digital.</div>
                @if (!string.IsNullOrWhiteSpace(_nombreArchivoXml)) { <div class="small mt-2"><i class="bi bi-file-earmark-check me-1 text-success" aria-hidden="true"></i>@_nombreArchivoXml</div> }
            </div>
            @if (_leyendoXml)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Leyendo XML...</span></div></div>
            }
            else if (_xml is not null)
            {
                <div class="row g-3 mb-3"><div class="col-12 col-md-6"><span class="text-secondary small d-block">Consecutivo</span><strong>@_xml.Consecutivo</strong></div><div class="col-12 col-md-6"><span class="text-secondary small d-block">Clave</span><span class="d-flex align-items-center gap-2"><code class="small text-break">@_xml.Clave</code><button type="button" class="btn btn-sm btn-link p-0" title="Copiar clave" @onclick="CopiarClave"><i class="bi @(_claveCopiada ? "bi-clipboard-check text-success" : "bi-clipboard")" aria-hidden="true"></i><span class="visually-hidden">Copiar clave</span></button></span></div><div class="col-12 col-md-4"><span class="text-secondary small d-block">Proveedor</span><strong>@_xml.NombreProveedor</strong><span class="text-secondary d-block">@_xml.CedulaProveedor</span></div><div class="col-6 col-md-2"><span class="text-secondary small d-block">Fecha</span><strong>@_xml.Fecha.ToString("dd/MM/yyyy")</strong></div><div class="col-6 col-md-2"><span class="text-secondary small d-block">Condición</span><strong>@(_xml.Credito ? "Crédito" : "Contado")</strong></div><div class="col-6 col-md-2"><span class="text-secondary small d-block">Moneda</span><strong>@_xml.Moneda</strong></div><div class="col-6 col-md-2"><span class="text-secondary small d-block">Total XML</span><strong>@Formato.Importe(_xml.Total)</strong></div></div>
                @if (_proveedorXmlNoExiste)
                {
                    <div class="alert alert-warning d-flex align-items-center justify-content-between gap-2"><span>El proveedor del XML no existe aún en el catálogo.</span><button type="button" class="btn btn-sm btn-outline-primary" @onclick="PrepararProveedorXml">Crear proveedor</button></div>
                }
                @if (_editorXml == EditorXml.Busqueda)
                {
                    <div class="border rounded p-3 mb-3 bg-body-tertiary">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><strong>Asociar artículo interno</strong><button type="button" class="btn btn-sm btn-link text-danger" @onclick="CancelarEditorXml">Cancelar asociación</button></div>
                        <p class="small text-secondary mb-2">Busque y elija el artículo que corresponde a la línea del proveedor. El importador permanece abierto.</p>
                        <div class="input-group mb-3"><input type="search" class="form-control" placeholder="Código o descripción del artículo" @bind="_textoBusquedaXml" @onkeydown="BuscarArticuloXmlConEnter" /><button type="button" class="btn btn-outline-primary" disabled="@_buscandoArticuloXml" @onclick="BuscarArticulosXml">@(_buscandoArticuloXml ? "Buscando..." : "Buscar")</button></div>
                        @if (_buscandoArticuloXml) { <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div> }
                        else if (_resultadosBusquedaXml.Count > 0) { <div class="table-responsive seepos-importador-resultados"><table class="table table-sm table-hover mb-0"><thead><tr><th>Código</th><th>Descripción</th><th class="text-end">Existencia</th><th class="text-end">Precio</th></tr></thead><tbody>@foreach (var articulo in _resultadosBusquedaXml) { <tr role="button" @onclick="() => ElegirArticuloXml(articulo)"><td><code>@articulo.Cod_Articulo</code></td><td>@articulo.Descripcion</td><td class="text-end">@Formato.Cantidad(articulo.Existencia)</td><td class="text-end">@Formato.Importe(articulo.Precio_A)</td></tr> }</tbody></table></div> }
                        else if (!string.IsNullOrWhiteSpace(_textoBusquedaXml)) { <p class="small text-secondary mb-0">No hay artículos para la búsqueda indicada.</p> }
                    </div>
                }
                @if (_editorXml == EditorXml.Lotes && LineaXmlSeleccionada is not null)
                {
                    <div class="border rounded p-3 mb-3 bg-body-tertiary"><div class="d-flex justify-content-between align-items-center mb-3"><strong>Lote: @LineaXmlSeleccionada.Articulo?.Descripcion</strong><button type="button" class="btn btn-sm btn-primary" @onclick="CancelarEditorXml">Aceptar lote</button></div><div class="row g-3"><div class="col-12 col-md-6"><label class="form-label">Número de lote</label><input class="form-control" @bind="LineaXmlSeleccionada.Lote" /></div><div class="col-12 col-md-6"><label class="form-label">Vencimiento</label><input type="date" class="form-control" @bind="LineaXmlSeleccionada.Vencimiento" /></div></div></div>
                }
                @if (_editorXml == EditorXml.Precios && LineaXmlSeleccionada is not null)
                {
                    <div class="border rounded p-3 mb-3 bg-body-tertiary"><div class="d-flex justify-content-between align-items-center mb-2"><strong>Precios de venta: @LineaXmlSeleccionada.Articulo?.Descripcion</strong><button type="button" class="btn btn-sm btn-primary" @onclick="CancelarEditorXml">Guardar precios</button></div><div class="alert alert-light border small">Costo nuevo: <strong>@Formato.Importe(CostoNuevoXml)</strong> · Impuesto: @LineaXmlSeleccionada.Impuesto:N2%</div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Tipo</th><th class="text-end">Utilidad %</th><th class="text-end">Precio</th><th class="text-end">Precio + IV</th></tr></thead><tbody>@foreach (var precio in LineaXmlSeleccionada.Precios) { <tr><td>@precio.Tarifa</td><td><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end" @bind="precio.Utilidad" @bind:after="RecalcularPrecioXml" /></td><td><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end" @bind="precio.Precio" @bind:after="RecalcularUtilidadXml" /></td><td class="text-end">@Formato.Importe(precio.Precio * (1 + LineaXmlSeleccionada.Impuesto / 100m))</td></tr> }</tbody></table></div></div>
                }
                <div class="alert alert-light border small py-2 mb-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Revise las asociaciones, cantidades, regalías, lotes y precios antes de aplicar. El vínculo proveedor–artículo se guarda explícitamente para las líneas asociadas manualmente.</div>
