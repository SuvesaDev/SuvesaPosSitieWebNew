    {
        if (!_compraDesbloqueada) { await AbrirDesbloqueo(); return; }
        _xml = null; _nombreArchivoXml = string.Empty; _proveedorXmlNoExiste = false; _indiceXmlAsignacion = _indiceXmlOpciones = null; _editorXml = EditorXml.Ninguno; _textoBusquedaXml = string.Empty; _resultadosBusquedaXml.Clear();
