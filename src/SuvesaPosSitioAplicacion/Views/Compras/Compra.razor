    private async Task ElegirArticuloXml(InventarioDTO articulo)
    {
        if (_xml is null || _indiceXmlAsignacion is not int indice) return;
        // El buscador devuelve una proyección ligera. La propiedad Lote (y
        // demás reglas del artículo) llega completa en la consulta individual;
        // sin esta lectura el botón de lotes no se podía mostrar aunque el
        // artículo realmente los manejara.
        var detalle = await Inventario.Uno(articulo.Codigo);
        if (detalle.EsCorrecta && detalle.Responses is not null) articulo = detalle.Responses;
        var linea = _xml.Lineas[indice];
        linea.Articulo = articulo;
        linea.VinculoConfirmado = false;
        linea.Lote = string.Empty;
        linea.Vencimiento = DateTime.Today;
        linea.Precios.Clear();
        PrepararPreciosXml(linea);
        CancelarEditorXml();
    }

    private void CancelarEditorXml()
    {
        _editorXml = EditorXml.Ninguno;
        _indiceXmlAsignacion = null;
        _indiceXmlOpciones = null;
        _textoBusquedaXml = string.Empty;
        _resultadosBusquedaXml.Clear();
    }

    /// <summary>
    /// Conserva el comportamiento de la ventana anterior: primero consulta de
    /// una sola vez los vínculos proveedor-artículo y solo pide elegir los que
    /// no estén en el catálogo. Esto evita una consulta por cada renglón XML.
    /// </summary>
    private async Task AsociarCatalogosXml()
    {
        if (_xml is null) return;
        var solicitud = _xml.Lineas.Select(l => new CatalogoProductosInternosDTO
        {
            CodigoProveedor = l.CodigoProveedor,
            DescripcionProveedor = l.Descripcion
        }).ToList();
        var catalogos = await Api.CatalogosInternos(solicitud);
        if (!catalogos.EsCorrecta || catalogos.Responses is null) return;

        var asociaciones = catalogos.Responses
            .Where(c => !string.IsNullOrWhiteSpace(c.CodigoInterno))
            .ToList();
        var tareas = _xml.Lineas.Select(async linea =>
        {
            var vinculo = asociaciones.FirstOrDefault(c =>
                string.Equals(c.CodigoProveedor?.Trim(), linea.CodigoProveedor, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(c.DescripcionProveedor?.Trim(), linea.Descripcion, StringComparison.OrdinalIgnoreCase));
            if (vinculo is null) return;

            var encontrados = await Inventario.Buscar(vinculo.CodigoInterno!);
            var articulo = encontrados.Responses?.FirstOrDefault(a =>
                string.Equals(a.Cod_Articulo, vinculo.CodigoInterno, StringComparison.OrdinalIgnoreCase));
            if (articulo is not null)
            {
                linea.Articulo = articulo;
                linea.VinculoConfirmado = true;
                PrepararPreciosXml(linea);
            }
        });
        await Task.WhenAll(tareas);
    }

    private void PrepararPreciosXml(LineaXml linea)
    {
        if (linea.Articulo is null || linea.Precios.Count > 0) return;
        foreach (var (tarifa, precio) in new[]
        {
            ("A", Formato.AImporte(linea.Articulo.Precio_A)),
            ("B", Formato.AImporte(linea.Articulo.Precio_B)),
            ("C", Formato.AImporte(linea.Articulo.Precio_C)),
            ("D", Formato.AImporte(linea.Articulo.Precio_D))
        })
        {
            var utilidad = linea.Precio > 0 ? CalculoDocumento.Redondear((precio / linea.Precio - 1m) * 100m) : 0m;
            linea.Precios.Add(new PrecioXml { Tarifa = tarifa, Precio = precio, Utilidad = Math.Max(0, utilidad) });
        }
    }

    private async Task VincularArticuloXml(int indice)
    {
        if (_xml is null || _xml.Lineas[indice].Articulo is not { } articulo) return;
        var linea = _xml.Lineas[indice];
        var respuesta = await Api.VincularArticuloXml(new CatalogoProductosInternosDTO
        {
            CodigoProveedor = linea.CodigoProveedor,
            DescripcionProveedor = linea.Descripcion,
            CodigoInterno = articulo.Cod_Articulo,
            DescripcionInterno = articulo.Descripcion
        });
        if (await Respuestas.CorrectaAsync(respuesta, "vincular el artículo importado"))
        {
            linea.VinculoConfirmado = true;
            Dialogos.Exito("Artículo vinculado al catálogo del proveedor.");
        }
    }

