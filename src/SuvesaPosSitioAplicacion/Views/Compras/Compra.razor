    private static void RecalcularLineaXml(LineaXml linea) => linea.Cantidad = Math.Max(0.001m, linea.Cantidad);
    private void RecalcularPrecioXml()
    {
        if (LineaXmlSeleccionada is not { } linea) return;
        linea.PreciosEditados = true;
        foreach (var precio in linea.Precios) precio.Precio = CalculoDocumento.Redondear(linea.Precio * (1 + Math.Max(0, precio.Utilidad) / 100m));
    }
    private void RecalcularUtilidadXml()
    {
        if (LineaXmlSeleccionada is not { } linea || linea.Precio <= 0) return;
        linea.PreciosEditados = true;
        foreach (var precio in linea.Precios) precio.Utilidad = Math.Max(0, CalculoDocumento.Redondear((precio.Precio / linea.Precio - 1m) * 100m));
    }

