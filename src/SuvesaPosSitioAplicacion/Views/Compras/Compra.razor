    private async Task BuscarCompras()
    {
        _comprasEncontradas = (await Respuestas.DatoAsync(await Api.Buscar(new FiltroFacturaCompras { Numero = _filtroFactura.Trim(), Proveedor = _filtroProveedor.Trim(), FechaDesde = string.Empty, FechaHasta = string.Empty }), "buscar compras"))?.OrderByDescending(c => c.IdCompra).ToList() ?? new();
