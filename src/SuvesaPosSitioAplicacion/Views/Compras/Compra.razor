    private async Task CargarCompra(long id)
    {
        var compra = await Respuestas.DatoAsync(await Api.Obtener(id), "abrir la compra");
        if (compra is null) return;
        _idCompra = compra.IdCompra; _numeroFactura = compra.Factura ?? string.Empty; _proveedor = _proveedores.FirstOrDefault(p => p.CodigoProv == compra.CodigoProv) ?? new ProveedorDTO { CodigoProv = compra.CodigoProv, Nombre = compra.NombreProveedor }; _textoProveedor = _proveedor.Cedula ?? compra.NombreProveedor ?? string.Empty; _tipoCompra = compra.TipoCompra; _moneda = compra.CodMonedaCompra; _empresa = int.TryParse(compra.IdEmpresa, out var empresa) ? empresa : 0; _fecha = Fecha(compra.Fecha); _vence = Fecha(compra.Vence); _diasCredito = Math.Max(0, (_vence - _fecha).Days); _bodega = 0; _lineas.Clear();
        foreach (var d in compra.Detalle ?? Array.Empty<FacturaCompraDetalleDTO>())
        {
            var articulo = new InventarioDTO { Codigo = d.Codigo, Cod_Articulo = d.CodArticulo, Descripcion = d.Descripcion, Codcabys = d.CodCabys, Precio_A = (float)d.PrecioA, Precio_B = (float)d.PrecioB, Precio_C = (float)d.PrecioC, Precio_D = (float)d.PrecioD, MonedaVenta = d.CodMonedaVenta, Lote = !string.IsNullOrWhiteSpace(d.Lote) };
            var linea = new LineaCompra { Articulo = articulo, IdArticuloComprados = d.IdArticuloComprados, Cabys = d.CodCabys, Cantidad = Formato.AImporte(d.Cantidad), Regalias = Formato.AImporte(d.Regalias), Base = Formato.AImporte(d.Base), Flete = Formato.AImporte(d.MontoFlete), Otros = Formato.AImporte(d.OtrosCargos), Descuento = Formato.AImporte(d.DescuentoP), Impuesto = Formato.AImporte(d.ImpuestoP), Lote = d.Lote ?? string.Empty, VenceLote = d.LoteArticulo?.Vencimiento?.DateTime ?? DateTime.Today };
            linea.Recalcular(); _lineas.Add(linea); if (_bodega == 0) _bodega = d.IdBodega;
        }
        RecalcularTotales(); LimpiarEditor(); await _modalBuscarCompras.HideAsync();
    }
    private static DateTime Fecha(string? valor) => DateTime.TryParse(valor, out var fecha) ? fecha.Date : DateTime.Today;
