    private async Task BuscarArticulosXml()
    {
        var texto = _textoBusquedaXml.Trim();
        _resultadosBusquedaXml.Clear();
        if (texto.Length < 2) return;
        _buscandoArticuloXml = true;
        try
        {
            var respuesta = await Inventario.Buscar(texto);
            if (respuesta.EsCorrecta) _resultadosBusquedaXml = respuesta.Responses?.ToList() ?? new();
        }
