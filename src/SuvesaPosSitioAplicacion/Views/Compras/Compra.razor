    private async Task Guardar()
    {
        if (!_compraDesbloqueada) { await AbrirDesbloqueo(); return; }
        if (_proveedor is null || string.IsNullOrWhiteSpace(_numeroFactura) || _bodega <= 0 || _moneda <= 0 || _lineas.Count == 0 || (!EsCostaPetsCompra && _empresa <= 0)) { await Dialogos.ErrorAsync("Complete encabezado, empresa y al menos un artículo antes de guardar."); return; }
        var accion = _idCompra > 0 ? "actualizar" : "registrar";
        if (!await Dialogos.ConfirmarAsync($"Se va a {accion} la compra y afectar el inventario. ¿Desea continuar?")) return;
        _guardando = true; var respuesta = _idCompra > 0 ? await Api.Editar(ArmarCompra()) : await Api.Crear(ArmarCompra()); _guardando = false;
        if (await Respuestas.CorrectaAsync(respuesta, $"{accion} la compra"))
        {
            if (_compraDesdeXml && _xml is not null)
            {
                var precios = PreciosActualizadosXml();
                if (precios.Count > 0) await Respuestas.CorrectaAsync(await Api.ActualizarPrecios(precios), "actualizar los precios importados");
            }
            Dialogos.Exito(_idCompra > 0 ? "Compra actualizada correctamente." : "Compra registrada correctamente.");
            NuevaCompra();
        }
    }
    private async Task Anular()
    {
        if (_idCompra <= 0 || !await Dialogos.ConfirmarAsync("Se anulará la compra y se revertirá el movimiento de inventario. ¿Desea continuar?")) return;
        _guardando = true; var respuesta = await Api.Anular(ArmarCompra()); _guardando = false;
        if (await Respuestas.CorrectaAsync(respuesta, "anular la compra")) { Dialogos.Exito("Compra anulada correctamente."); NuevaCompra(); }
    }

