    private async Task AplicarImportacionXml()
    {
        if (_xml is null || _xml.Lineas.Any(l => l.Articulo is null || !l.VinculoConfirmado)) return;
        var proveedor = _proveedores.FirstOrDefault(p => string.Equals(p.Cedula?.Trim(), _xml.CedulaProveedor, StringComparison.OrdinalIgnoreCase));
        if (proveedor is null) { _proveedorXmlNoExiste = true; return; }
        var sinLote = _xml.Lineas.Where(l => (EsCostaPetsCompra || l.Articulo?.Lote == true) && (string.IsNullOrWhiteSpace(l.Lote) || l.Vencimiento.Date < _xml.Fecha.Date)).ToList();
        if (sinLote.Count > 0) { await Dialogos.ErrorAsync($"Indique lote y vencimiento válido para {sinLote.Count} artículo(s) que manejan lotes.", "Importar XML"); return; }
        if (_xml.Lineas.Any(l => l.Cantidad <= 0)) { await Dialogos.ErrorAsync("Cada línea importada debe tener una cantidad mayor a cero.", "Importar XML"); return; }

        _idCompra = 0;
        _proveedor = proveedor;
        _textoProveedor = proveedor.Cedula ?? proveedor.Nombre ?? string.Empty;
        _numeroFactura = _xml.Consecutivo;
        _fecha = _xml.Fecha;
        _tipoCompra = _xml.Credito ? 1 : 2;
        _diasCredito = _xml.Credito ? _xml.DiasCredito : 0;
        ActualizarVencimiento();
        var moneda = _monedas.FirstOrDefault(m => string.Equals(m.MonedaNombre, _xml.Moneda, StringComparison.OrdinalIgnoreCase) || (string.Equals(_xml.Moneda, "CRC", StringComparison.OrdinalIgnoreCase) && ((m.MonedaNombre?.Contains("COL", StringComparison.OrdinalIgnoreCase) ?? false) || m.Simbolo == "₡")) || (string.Equals(_xml.Moneda, "USD", StringComparison.OrdinalIgnoreCase) && (m.MonedaNombre?.Contains("DOL", StringComparison.OrdinalIgnoreCase) ?? false)));
        if (moneda is not null) _moneda = moneda.CodMoneda;
        _lineas.Clear();
        foreach (var x in _xml.Lineas)
        {
            var linea = new LineaCompra { Articulo = x.Articulo!, Cabys = x.Cabys, Cantidad = x.Cantidad, Base = x.Precio, Flete = 0, Otros = 0, Regalias = EsCostaPetsCompra ? 0 : Math.Max(0, x.Regalia), Descuento = x.Descuento, Impuesto = x.Impuesto, Lote = x.Lote.Trim(), VenceLote = x.Vencimiento };
            linea.Recalcular();
            _lineas.Add(linea);
        }
        _compraDesdeXml = true;
        LimpiarEditor();
        RecalcularTotales();
        await _modalImportarXml.HideAsync();
        Dialogos.Exito("XML importado. Revise la bodega, las asociaciones y los importes antes de registrar la compra.");
    }

