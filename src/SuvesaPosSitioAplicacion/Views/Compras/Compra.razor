    private async Task ImportarXml(InputFileChangeEventArgs evento)
    {
        var archivo = evento.File;
        _nombreArchivoXml = archivo.Name;
        _xml = null;
        _proveedorXmlNoExiste = false;
        _leyendoXml = true;

        try
        {
            await using var flujo = archivo.OpenReadStream(10 * 1024 * 1024);
            var documento = await XDocument.LoadAsync(flujo, LoadOptions.None, CancellationToken.None);
            _xml = LeerComprobante(documento);
            _proveedorXmlNoExiste = !_proveedores.Any(p => string.Equals(p.Cedula?.Trim(), _xml.CedulaProveedor, StringComparison.OrdinalIgnoreCase));
            await AsociarCatalogosXml();
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Xml.XmlException or FormatException)
        {
            _nombreArchivoXml = string.Empty;
            await Dialogos.ErrorAsync("El archivo no contiene un comprobante electrónico XML válido de Hacienda.", "No se pudo importar el XML");
        }
        finally
        {
            _leyendoXml = false;
        }
    }

    private static ComprobanteXml LeerComprobante(XDocument documento)
    {
        var raiz = documento.Root ?? throw new FormatException("XML sin nodo raíz.");
        var tipo = raiz.Name.LocalName;
        if (tipo is not ("FacturaElectronica" or "TiqueteElectronico" or "NotaCreditoElectronica" or "NotaDebitoElectronica"))
        {
            throw new FormatException("Tipo de comprobante no soportado.");
        }

        var emisor = Hijo(raiz, "Emisor") ?? throw new FormatException("El XML no contiene emisor.");
        var detalle = Hijo(raiz, "DetalleServicio") ?? throw new FormatException("El XML no contiene detalle.");
        var lineas = detalle.Elements().Where(e => e.Name.LocalName == "LineaDetalle").Select((linea, indice) => LeerLinea(linea, indice + 1)).ToList();
        if (lineas.Count == 0) throw new FormatException("El XML no contiene líneas de detalle.");

        var resumen = Hijo(raiz, "ResumenFactura");
        var moneda = Texto(Hijo(resumen, "CodigoTipoMoneda"), "CodigoMoneda");
        var fechaTexto = Texto(raiz, "FechaEmision");
        var fecha = DateTimeOffset.TryParse(fechaTexto, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out var fechaConZona)
            ? fechaConZona.LocalDateTime.Date
            : DateTime.TryParse(fechaTexto, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out var fechaSimple) ? fechaSimple.Date : throw new FormatException("Fecha de emisión inválida.");
        var condicion = Texto(raiz, "CondicionVenta");
        var credito = condicion is "02" or "03";

        return new ComprobanteXml
        {
            Clave = Texto(raiz, "Clave"),
            Consecutivo = Texto(raiz, "NumeroConsecutivo"),
            CedulaProveedor = Texto(Hijo(emisor, "Identificacion"), "Numero"),
            NombreProveedor = Texto(emisor, "Nombre"),
            Fecha = fecha,
            Credito = credito,
            DiasCredito = Entero(Texto(raiz, "PlazoCredito")),
            Moneda = string.IsNullOrWhiteSpace(moneda) ? "CRC" : moneda,
            Total = Numero(Texto(resumen, "TotalComprobante")),
            Lineas = lineas
        };
    }

    private static LineaXml LeerLinea(XElement linea, int predeterminado)
    {
        var montoTotal = Numero(Texto(linea, "MontoTotal"));
        var montoDescuento = linea.Elements().Where(e => e.Name.LocalName == "Descuento").Sum(e => Numero(Texto(e, "MontoDescuento")));
        var impuestoNodo = linea.Elements().FirstOrDefault(e => e.Name.LocalName == "Impuesto");
        var tarifa = Numero(Texto(impuestoNodo, "Tarifa"));
        if (tarifa == 0)
        {
            var montoImpuesto = Numero(Texto(impuestoNodo, "Monto"));
            var baseImpuesto = montoTotal - montoDescuento;
            tarifa = baseImpuesto > 0 ? CalculoDocumento.Redondear(montoImpuesto * 100m / baseImpuesto) : 0;
        }
        var codigoProveedor = linea.Elements().Where(e => e.Name.LocalName == "Codigo")
            .Select(e => Texto(e, "Codigo") is { Length: > 0 } anidado ? anidado : e.Value.Trim())
            .FirstOrDefault() ?? string.Empty;

        return new LineaXml
        {
            Numero = Entero(Texto(linea, "NumeroLinea"), predeterminado),
            CodigoProveedor = codigoProveedor,
            Cabys = Texto(linea, "CodigoCABYS"),
            Descripcion = Texto(linea, "Detalle"),
            Presentacion = Texto(linea, "UnidadMedida"),
            Cantidad = Math.Max(0.001m, Numero(Texto(linea, "Cantidad"))),
            Precio = Numero(Texto(linea, "PrecioUnitario")),
            Descuento = montoTotal > 0 ? CalculoDocumento.Redondear(montoDescuento * 100m / montoTotal) : 0,
            Impuesto = tarifa
        };
    }

    private static XElement? Hijo(XElement? origen, string nombre) => origen?.Elements().FirstOrDefault(e => e.Name.LocalName == nombre);
    private static string Texto(XElement? origen, string nombre) => Hijo(origen, nombre)?.Value.Trim() ?? string.Empty;
    private static decimal Numero(string texto) => decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var valor) || decimal.TryParse(texto, NumberStyles.Number, new CultureInfo("es-CR"), out valor) ? valor : 0;
    private static int Entero(string texto, int predeterminado = 0) => int.TryParse(texto, NumberStyles.Integer, CultureInfo.InvariantCulture, out var valor) ? valor : predeterminado;

    private async Task AsociarArticuloXml(int indice)
    {
        if (_xml is null) return;
        _indiceXmlAsignacion = indice;
        var linea = _xml.Lineas[indice];
        _indiceXmlOpciones = null;
