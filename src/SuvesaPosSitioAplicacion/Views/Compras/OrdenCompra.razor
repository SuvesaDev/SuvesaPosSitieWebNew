@page "/buys/purchaseorder"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Compras
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@using Havit.Blazor.Components.Web.Bootstrap
@inject IOrdenesCompraFlujo Api
@inject IProveedoresConsulta Proveedores
@inject ICompras Compras
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject IJSRuntime JS

@*  Nueva función "Órdenes de compra": alta dirigida a un proveedor, con
    consecutivo propio, doble moneda, impresión y envío por correo. El
    seguimiento (entregado / cancelado / baja / facturado) vive en
    /buys/orders/checkorders. *@

<AppPantalla Pantalla="@Titulo" Codigo="COMPRAS.ORDEN_DE_COMPRA_MANUAL" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        <a class="btn btn-sm btn-outline-secondary" href="/buys/orders/checkorders">Seguimiento de órdenes</a>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Limpiar">Nueva orden</button>
    </Acciones>
    <ChildContent>
        @if (_creada is not null)
        {
            <div class="card mb-3 border-success">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <div>
                        <div class="text-secondary small text-uppercase">Orden registrada</div>
                        <div class="fs-4 fw-semibold">N.º @(_creada.Consecutivo ?? _creada.Orden)</div>
                        <div class="small text-secondary">@_creada.NombreProveedor · @Formato.Importe(_creada.Total) @_creada.MonedaNombre
                            @(_creada.CodMoneda != 1 ? $" (≈ {Formato.Importe(_creada.TotalColones)} CRC)" : "")</div>
                    </div>
                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-outline-primary" @onclick="() => Imprimir(_creada.Orden)"><i class="bi bi-printer me-1"></i>Imprimir</button>
                        <button class="btn btn-primary" disabled="@_enviando" @onclick="() => Enviar(_creada.Orden)">
                            <i class="bi bi-envelope me-1"></i>@(_enviando ? "Enviando..." : "Enviar al proveedor")
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header"><strong>Proveedor</strong></div>
            <div class="card-body">
                <div class="position-relative">
                    <div class="input-group">
                        <input class="form-control" placeholder="Cédula o nombre del proveedor" @bind="_textoProveedor" @oninput="FiltrarProveedores" />
                        <button type="button" class="btn btn-outline-primary" @onclick="MostrarProveedores">Buscar</button>
                    </div>
                    @if (_proveedoresEncontrados.Count > 0)
                    {
                        <div class="list-group position-absolute shadow" style="z-index:1050; max-height:12rem; overflow-y:auto;">
                            @foreach (var p in _proveedoresEncontrados)
                            {
                                <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirProveedor(p)"><strong>@p.Nombre</strong><span class="text-secondary ms-2">@p.Cedula</span></button>
                            }
                        </div>
                    }
                </div>
                @if (_proveedor is not null)
                {
                    <div class="alert alert-light border mt-2 mb-0">
                        <strong>@_proveedor.Nombre</strong><span class="text-secondary ms-2">@_proveedor.Cedula</span>
                        <span class="ms-3 small text-secondary">@(string.IsNullOrWhiteSpace(_proveedor.Email) ? "sin correo" : _proveedor.Email)</span>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Datos de la orden</strong></div>
            <div class="card-body row g-3">
                <div class="col-6 col-md-3"><label class="form-label">Fecha</label><input type="date" class="form-control" @bind="_fecha" /></div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Moneda <span class="text-secondary small">(opcional)</span></label>
                    <select class="form-select" @bind="_moneda" @bind:after="AlCambiarMoneda">
                        <option value="1">Colones</option>
                        @foreach (var m in _monedas.Where(x => x.CodMoneda != 1)) { <option value="@m.CodMoneda">@m.MonedaNombre</option> }
                    </select>
                </div>
                @if (_moneda != 1)
                {
                    <div class="col-6 col-md-3"><label class="form-label">Tipo de cambio</label><input type="number" min="0" step="0.0001" class="form-control" @bind="_tipoCambio" /></div>
                }
                <div class="col-6 col-md-3 d-flex align-items-end gap-3">
                    <div class="form-check"><input class="form-check-input" type="radio" name="fp" id="fpC" checked="@(!_credito)" @onclick="() => _credito = false" /><label class="form-check-label" for="fpC">Contado</label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="fp" id="fpCr" checked="@_credito" @onclick="() => _credito = true" /><label class="form-check-label" for="fpCr">Crédito</label></div>
                </div>
                @if (_credito)
                {
                    <div class="col-6 col-md-3"><label class="form-label">Días de crédito</label><input type="number" min="0" class="form-control" @bind="_diasCredito" /></div>
                }
                <div class="col-12 col-md-6"><label class="form-label">Entregar en / a nombre de</label><input class="form-control" @bind="_entregar" /></div>
                <div class="col-12"><label class="form-label">Observaciones</label><input class="form-control" @bind="_observaciones" /></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Artículos</strong>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _buscador.AbrirAsync()"><i class="bi bi-search me-1"></i>Buscar artículo</button>
            </div>
            <div class="card-body p-0">
                @if (_lineas.Count == 0) { <p class="text-secondary text-center py-4 mb-0">Busque los artículos a incluir en la orden.</p> }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Código</th><th>Descripción</th><th class="text-end">Cantidad</th><th class="text-end">Costo</th><th class="text-end">Desc. %</th><th class="text-end">Imp. %</th><th class="text-end">Total</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var l in _lineas)
                                {
                                    <tr>
                                        <td><code>@l.Codigo</code></td>
                                        <td>@l.Descripcion</td>
                                        <td style="min-width:6rem" class="text-end"><input type="number" min="0.001" step="0.001" class="form-control form-control-sm text-end" @bind="l.Cantidad" @bind:after="Recalcular" /></td>
                                        <td style="min-width:7rem" class="text-end"><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end" @bind="l.CostoUnitario" @bind:after="Recalcular" /></td>
                                        <td style="min-width:5rem" class="text-end"><input type="number" min="0" max="100" step="0.01" class="form-control form-control-sm text-end" @bind="l.PorcDescuento" @bind:after="Recalcular" /></td>
                                        <td style="min-width:5rem" class="text-end"><input type="number" min="0" max="100" step="0.01" class="form-control form-control-sm text-end" @bind="l.PorcImpuesto" @bind:after="Recalcular" /></td>
                                        <td class="text-end fw-semibold">@Formato.Importe(l.Total)</td>
                                        <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarLinea(l)"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-4 offset-lg-8">
                <div class="card"><div class="card-header"><strong>Totales</strong></div><div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7 fw-normal text-secondary">Subtotal</dt><dd class="col-5 text-end">@Formato.Importe(_subtotal)</dd>
                        <dt class="col-7 fw-normal text-secondary">Descuento</dt><dd class="col-5 text-end">@Formato.Importe(_descuento)</dd>
                        <dt class="col-7 fw-normal text-secondary">Impuesto</dt><dd class="col-5 text-end">@Formato.Importe(_impuesto)</dd>
                        <dt class="col-7">Total (@MonedaTexto)</dt><dd class="col-5 text-end fs-5">@Formato.Importe(_total)</dd>
                        @if (_moneda != 1)
                        {
                            <dt class="col-7 fw-normal text-secondary">Total en colones</dt><dd class="col-5 text-end">@Formato.Importe(_total * (decimal)_tipoCambio)</dd>
                        }
                    </dl>
                </div></div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" disabled="@(_guardando || _proveedor is null || _lineas.Count == 0)" @onclick="Guardar">
                @(_guardando ? "Guardando..." : "Registrar orden")
            </button>
        </div>
    </ChildContent>
</AppPantalla>

<AppBuscadorArticulo @ref="_buscador" AlElegir="AgregarArticulo" />

@code {
    private const string Titulo = "Orden de compra";

    private sealed class Linea
    {
        public long Codigo { get; set; }
        public string Descripcion { get; set; } = "";
        public decimal Cantidad { get; set; } = 1;
        public decimal CostoUnitario { get; set; }
        public decimal PorcDescuento { get; set; }
        public decimal PorcImpuesto { get; set; }
        public decimal Bruto => Math.Round(Cantidad * CostoUnitario, 2);
        public decimal Desc => Math.Round(Bruto * PorcDescuento / 100m, 2);
        public decimal Imp => Math.Round((Bruto - Desc) * PorcImpuesto / 100m, 2);
        public decimal Total => Bruto - Desc + Imp;
    }

    private AppBuscadorArticulo _buscador = default!;
    private List<ProveedorDTO> _proveedores = new(), _proveedoresEncontrados = new();
    private string _textoProveedor = "";
    private ProveedorDTO? _proveedor;
    private List<Moneda> _monedas = new();

    private DateTime _fecha = DateTime.Today;
    private int _moneda = 1;
    private double _tipoCambio = 1;
    private bool _credito;
    private int _diasCredito;
    private string _entregar = "";
    private string _observaciones = "";
    private readonly List<Linea> _lineas = new();
    private decimal _subtotal, _descuento, _impuesto, _total;
    private bool _guardando, _enviando;
    private OrdenCompraFlujoWebDTO? _creada;

    private string MonedaTexto => _moneda == 2 ? "USD" : _monedas.FirstOrDefault(m => m.CodMoneda == _moneda)?.MonedaNombre ?? "CRC";

    protected override async Task OnInitializedAsync()
    {
        _proveedores = (await Respuestas.DatoAsync(await Proveedores.Obtener(), "consultar los proveedores"))
                       ?.Where(p => p.Inhabilitado != true).OrderBy(p => p.Nombre).ToList() ?? new();
        _monedas = (await Respuestas.DatoAsync(await Compras.Monedas(), "consultar las monedas"))?.Where(m => m.Estado).ToList() ?? new();
    }

    private void AlCambiarMoneda()
    {
        if (_moneda == 1) { _tipoCambio = 1; return; }
        var m = _monedas.FirstOrDefault(x => x.CodMoneda == _moneda);
        if (m is not null && m.ValorVenta > 0) _tipoCambio = m.ValorVenta;
    }

    private void FiltrarProveedores(ChangeEventArgs e)
    {
        _textoProveedor = e.Value?.ToString() ?? "";
        var t = _textoProveedor.Trim();
        _proveedoresEncontrados = string.IsNullOrEmpty(t) ? new()
            : _proveedores.Where(p => (p.Nombre?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                                   || (p.Cedula?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)).Take(8).ToList();
    }

    private void MostrarProveedores() => _proveedoresEncontrados = _proveedores.Take(8).ToList();

    private void ElegirProveedor(ProveedorDTO p)
    {
        _proveedor = p;
        _textoProveedor = p.Cedula ?? p.Nombre ?? "";
        _proveedoresEncontrados.Clear();
    }

    private void AgregarArticulo(InventarioDTO art)
    {
        var ya = _lineas.FirstOrDefault(l => l.Codigo == art.Codigo);
        if (ya is not null) { ya.Cantidad += 1; Recalcular(); return; }
        _lineas.Add(new Linea
        {
            Codigo = art.Codigo,
            Descripcion = art.Descripcion ?? $"Artículo {art.Codigo}",
            CostoUnitario = Formato.AImporte(art.PrecioBase),
            PorcImpuesto = Formato.AImporte(art.IVenta),
        });
        Recalcular();
    }

    private void QuitarLinea(Linea l) { _lineas.Remove(l); Recalcular(); }

    private void Recalcular()
    {
        foreach (var l in _lineas)
        {
            l.Cantidad = Math.Max(0.001m, l.Cantidad);
            l.CostoUnitario = Math.Max(0, l.CostoUnitario);
            l.PorcDescuento = Math.Clamp(l.PorcDescuento, 0, 100);
            l.PorcImpuesto = Math.Clamp(l.PorcImpuesto, 0, 100);
        }
        _descuento = _lineas.Sum(l => l.Desc);
        _impuesto = _lineas.Sum(l => l.Imp);
        _subtotal = _lineas.Sum(l => l.Bruto - l.Desc);
        _total = _lineas.Sum(l => l.Total);
    }

    private async Task Guardar()
    {
        if (_proveedor is null || _lineas.Count == 0 || _guardando) return;
        if (!await Dialogos.ConfirmarAsync("¿Registrar esta orden de compra?")) return;

        _guardando = true;
        try
        {
            var cmd = new CrearOrdenCompraWebDTO
            {
                IdProveedor = _proveedor.CodigoProv,
                IdSucursal = Sesion.IdSucursal,
                Fecha = _fecha,
                CodMoneda = _moneda,
                TipoCambio = _moneda == 1 ? 1 : (_tipoCambio > 0 ? _tipoCambio : 1),
                Credito = _credito,
                Plazo = _credito ? _diasCredito : 0,
                Observaciones = _observaciones,
                Entregar = _entregar,
                Lineas = _lineas.Select(l => new LineaOrdenCompraWebDTO
                {
                    CodArticulo = l.Codigo,
                    Descripcion = l.Descripcion,
                    Cantidad = (double)l.Cantidad,
                    CostoUnitario = (double)l.CostoUnitario,
                    PorcDescuento = (double)l.PorcDescuento,
                    PorcImpuesto = (double)l.PorcImpuesto,
                }).ToList(),
            };

            _creada = await Respuestas.DatoAsync(await Api.Crear(cmd), "crear la orden de compra");
            if (_creada is not null)
            {
                Dialogos.Exito($"Orden de compra N.º {_creada.Consecutivo ?? _creada.Orden} registrada.");
                _lineas.Clear();
                Recalcular();
            }
        }
        finally { _guardando = false; }
    }

    private async Task Imprimir(long orden)
        => await JS.InvokeVoidAsync("open", $"/documentos/orden-compra/{orden}/pdf", "_blank");

    private async Task Enviar(long orden)
    {
        _enviando = true;
        try
        {
            var res = await Respuestas.DatoAsync(await Api.EnviarCorreo(orden, null), "enviar la orden por correo");
            if (res is null) return;
            if (res.Enviado) Dialogos.Exito($"Orden enviada a {res.Destino}.");
            else await Dialogos.ErrorAsync(res.Error ?? "No se pudo enviar el correo.", "Envío fallido");
        }
        finally { _enviando = false; }
    }

    private void Limpiar()
    {
        _creada = null;
        _proveedor = null;
        _textoProveedor = "";
        _proveedoresEncontrados.Clear();
        _fecha = DateTime.Today;
        _moneda = 1; _tipoCambio = 1;
        _credito = false; _diasCredito = 0;
        _entregar = ""; _observaciones = "";
        _lineas.Clear();
        Recalcular();
    }
}
