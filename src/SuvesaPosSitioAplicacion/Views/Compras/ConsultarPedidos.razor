@page "/buys/orders/checkorders"
@using MudBlazor
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IOrdenesCompraConsulta Api
@inject IManejadorRespuestas Respuestas

@* PILOTO MudDataGrid (2/2). Consulta con rango/numero y rejilla de 6 columnas. *@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar" aria-label="Actualizar pedidos">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </Acciones>

    <ChildContent>
        <AppFiltros AlBuscar="Buscar" AlLimpiar="Limpiar" Buscando="_cargando"
                    Resumen="@($"{_pedidos.Count} pedido(s)")">
            <Encabezado>
                <span class="small text-body-secondary">
                    Sin número se muestran los pedidos recientes que publica el API.
                </span>
            </Encabezado>
            <ChildContent>
                <div class="col-12 col-md-5">
                    <label class="form-label small" for="numero-pedido">Número de pedido</label>
                    <input id="numero-pedido" type="number" min="1" class="form-control"
                           @bind="_numero" @bind:event="onchange" />
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-check">
                        <input id="pedidos-anulados" class="form-check-input" type="checkbox" @bind="_anuladas" />
                        <label class="form-check-label" for="pedidos-anulados">Incluir anuladas</label>
                    </div>
                </div>
            </ChildContent>
        </AppFiltros>

        <MudIsla>
            <MudDataGrid T="OrdenCompraDTO" Items="_pedidos" Loading="_cargando"
                         Dense="true" Hover="true" Bordered="false" Striped="true"
                         Filterable="true" SortMode="SortMode.Multiple" Groupable="false"
                         FixedHeader="true" Height="60vh" Class="seepos-mud-grid">
                <NoRecordsContent>
                    <div class="text-secondary small py-4">No hay pedidos para mostrar.</div>
                </NoRecordsContent>
                <Columns>
                    <PropertyColumn Property="p => p.Orden" Title="Pedido" />
                    <PropertyColumn Property="p => p.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                    <PropertyColumn Property="p => p.Proveedor" Title="Proveedor" />
                    <TemplateColumn Title="Usuario" Sortable="false">
                        <CellTemplate>@UsuarioTexto(context.Item)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="p => p.Total" Title="Total"
                                    CellClass="justify-end" HeaderClass="justify-end">
                        <CellTemplate>@Formato.Importe(context.Item.Total)</CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="Estado">
                        <CellTemplate>@EstadoTexto(context.Item)</CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="OrdenCompraDTO" />
                </PagerContent>
            </MudDataGrid>
        </MudIsla>
    </ChildContent>
</AppPantalla>

@code {
    private const string Titulo = "Consultar Pedidos";

    private List<OrdenCompraDTO> _pedidos = new();
    private long? _numero;
    private bool _anuladas;
    private bool _cargando;

    protected override Task OnInitializedAsync() => Consultar();

    private Task Buscar() => Consultar();

    private Task Recargar() => Consultar();

    private void Limpiar()
    {
        _numero = null;
        _anuladas = false;
        _ = Consultar();
    }

    private async Task Consultar()
    {
        if (_cargando)
        {
            return;
        }

        _cargando = true;
        try
        {
            var respuesta = _numero is > 0
                ? await Api.Buscar(_numero.Value, _anuladas)
                : await Api.Obtener();

            var pedidos = await Respuestas.DatoAsync(respuesta, "consultar los pedidos");
            _pedidos = (pedidos ?? Array.Empty<OrdenCompraDTO>())
                .Where(p => _anuladas || p.Anulado != true)
                .OrderByDescending(p => p.Fecha)
                .ToList();
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string UsuarioTexto(OrdenCompraDTO pedido)
        => pedido.NombreUsuario ?? pedido.Usuario ?? "—";

    private static string EstadoTexto(OrdenCompraDTO pedido)
        => pedido.Anulado == true ? "Anulada" : "Activa";
}
