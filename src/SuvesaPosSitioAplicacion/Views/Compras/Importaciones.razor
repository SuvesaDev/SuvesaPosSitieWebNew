@page "/buys/importations"
@page "/buys/importations/{IdImportacion:long}"
@using Microsoft.AspNetCore.Components.Forms
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Compras
@using SuvesaPosSitioAplicacion.Services
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IImportaciones Api
@inject IManejadorRespuestas Respuestas
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.ICompras ComprasApi
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IEmisoresFiscales EmisoresApi
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.ISeriesFacturacionFiscales SeriesApi
@inject SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface.IProveedoresConsulta ProveedoresApi
@inject IServicioDialogos Dialogos
@inject NavigationManager Navegacion

<AppPantalla Pantalla="Importaciones" Icono="bi-box-seam" Subtitulo="Expedientes de compra extranjera, nacionalización y evidencia documental" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary me-2" @onclick="IrABandeja"><i class="bi bi-list-ul me-1"></i>Bandeja</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="Nueva"><i class="bi bi-plus-lg me-1"></i>Nueva importación</button>
    </Acciones>
    <ChildContent>
        <div class="card">
            <div class="card-header"><strong>@(_actual is null ? "Nueva importación" : $"Importación #{_actual.IdImportacion}")</strong></div>
            <div class="card-body">
                @if (_actual is null)
                {
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">Factura extranjera *</label><input class="form-control" @bind="_nueva.FacturaExtranjera" /></div>
                        <div class="col-md-4"><label class="form-label">DUA</label><input class="form-control" @bind="_nueva.Dua" /></div>
                        <div class="col-md-4"><label class="form-label">Embarque / BL</label><input class="form-control" @bind="_nueva.Embarque" /></div>
                        <div class="col-md-3"><label class="form-label">Proveedor extranjero *</label><select class="form-select" @bind="_nueva.IdProveedorExtranjero"><option value="0">Seleccione...</option>@foreach(var p in _proveedores){<option value="@p.CodigoProv">@p.Nombre</option>}</select></div>
                        <div class="col-md-3"><label class="form-label">Bodega *</label><select class="form-select" @bind="_nueva.IdBodega"><option value="0">Seleccione...</option>@foreach(var b in _bodegas){<option value="@b.IdBodega">@b.NombreBodega</option>}</select></div>
                        <div class="col-md-3"><label class="form-label">Emisor *</label><select class="form-select" @bind="_nueva.IdEmisor"><option value="">Seleccione...</option>@foreach(var e in _emisores){<option value="@e.Id">@e.Nombre · @e.Identificacion</option>}</select></div>
                        <div class="col-md-3"><label class="form-label">Serie mensaje receptor</label><select class="form-select" @bind="_nueva.IdSerieMensajeReceptor"><option value="">Seleccione...</option>@foreach(var s in _series.Where(s=>s.IdEmisor==_nueva.IdEmisor && s.CodigoFE=="05")){<option value="@s.IdSerie">@s.Descripcion</option>}</select></div>
                        <div class="col-md-2"><label class="form-label">Moneda *</label><select class="form-select" @bind="_nueva.CodMoneda"><option value="2">USD</option><option value="1">CRC</option></select></div>
                        <div class="col-md-2"><label class="form-label">Tipo cambio DUA *</label><input type="number" min="0.000001" step="0.000001" class="form-control" @bind="_nueva.TipoCambioDua" /></div>
                        <div class="col-md-2"><label class="form-label">Fecha TC DUA *</label><input type="date" class="form-control" @bind="_nueva.FechaTipoCambioDua" /></div>
                        <div class="col-12"><label class="form-label">Observaciones</label><input class="form-control" @bind="_nueva.Observaciones" /></div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Artículos de la factura extranjera</h6>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="AbrirImportadorPdf"><i class="bi bi-file-earmark-pdf me-1"></i>Importar desde PDF</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AbrirBuscadorArticulo"><i class="bi bi-search me-1"></i>Buscar artículo</button>
                        </div>
                    </div>
                    <AppBuscadorArticulo @ref="_buscadorArticulo" AlElegir="ElegirArticulo" IdBodega="@(_nueva.IdBodega > 0 ? _nueva.IdBodega : null)" />

                    @if (_articuloActual is not null)
                    {
                        <div class="border rounded p-3 mb-3 bg-body-tertiary">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>@_articuloActual.Descripcion</strong>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarEdicionLinea">Cancelar</button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-3"><label class="form-label">Código proveedor</label><input class="form-control" @bind="_codigoProveedor" /></div>
                                <div class="col-md-4"><label class="form-label">Descripción proveedor</label><input class="form-control" @bind="_descripcionProveedor" /></div>
                                <div class="col-md-2"><label class="form-label">Unidades</label><input type="number" min="0.001" step="0.001" class="form-control" @bind="_cantidad" /></div>
                                <div class="col-md-3"><label class="form-label">Costo unitario moneda</label><input type="number" min="0" step="0.000001" class="form-control" @bind="_costoUnitario" /></div>
                                <div class="col-md-4"><label class="form-label">Tributo DUA unitario (opcional)</label><input type="number" min="0" step="0.000001" class="form-control" @bind="_tributoDuaUnitario" /><small class="text-secondary">Si ya tiene la Declaración de Importación con el impuesto por SKU. Si no, se completa después con "Actualizar tributo".</small></div>
                                <div class="col-md-4"><label class="form-label">Precio A a aplicar (opcional, IVA incluido)</label><input type="number" min="0" step="0.01" class="form-control" @bind="_precioAAplicado" /><small class="text-secondary">Si se deja vacío, el cierre actualiza solo el costo.</small></div>
                            </div>
                            @if (_articuloActual.Lote)
                            {
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <label class="form-label mb-0">Lotes</label>
                                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _lotes.Add(new LoteEdicion())">+ Agregar lote</button>
                                    </div>
                                    @foreach (var lote in _lotes)
                                    {
                                        <div class="row g-2 align-items-end mb-2">
                                            <div class="col-md-4"><input class="form-control" placeholder="Número de lote" @bind="lote.Numero" /></div>
                                            <div class="col-md-4"><input type="date" class="form-control" @bind="lote.Vence" /></div>
                                            <div class="col-md-3"><input type="number" min="0" step="0.001" class="form-control text-end" @bind="lote.Cantidad" /></div>
                                            <div class="col-md-1"><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => _lotes.Remove(lote)"><i class="bi bi-trash"></i></button></div>
                                        </div>
                                    }
                                    @{ var sumaLotes = _lotes.Sum(x => x.Cantidad); }
                                    <div class="small @(Math.Abs(sumaLotes - _cantidad) > 0.001m ? "text-danger" : "text-success")">Repartido: @sumaLotes de @_cantidad</div>
                                </div>
                            }
                            <button type="button" class="btn btn-primary mt-3" @onclick="AgregarOActualizarLinea">@(_indiceEdicionLinea is null ? "Agregar" : "Actualizar")</button>
                        </div>
                    }

                    @if (_nueva.Lineas.Count == 0) { <p class="text-secondary mb-0">Agregue los artículos de la factura extranjera.</p> }
                    else
                    {
                        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Artículo</th><th>Código proveedor</th><th>Descripción</th><th class="text-end">Unidades</th><th class="text-end">Costo unitario</th><th class="text-end">Tributo DUA</th><th></th></tr></thead><tbody>
                            @for (var i = 0; i < _nueva.Lineas.Count; i++)
                            {
                                var indice = i;
                                var item = _nueva.Lineas[i];
                                <tr>
                                    <td>@(_articulosPorCodigo.TryGetValue(item.IdArticulo, out var nombre) ? nombre : item.IdArticulo.ToString())</td>
                                    <td>@item.CodigoProveedor</td>
                                    <td>@item.DescripcionProveedor</td>
                                    <td class="text-end">@item.Cantidad</td>
                                    <td class="text-end">@item.CostoProveedorMonedaUnitario:N6</td>
                                    <td class="text-end">@item.TributoDuaUnitario:N6</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="btn btn-sm btn-link" @onclick="() => EditarLinea(indice)"><i class="bi bi-pencil"></i></button>
                                        <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarLinea(indice)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody></table></div>
                    }
                    <button class="btn btn-primary mt-3" disabled="@(_guardando || _nueva.Lineas.Count == 0 || _nueva.IdEmisor is null or <= 0)" @onclick="Crear">@(_guardando ? "Guardando..." : "Crear expediente")</button>
                    @if (_nueva.IdEmisor is null or <= 0) { <div class="form-text text-danger mt-1">Seleccione el Emisor antes de crear el expediente.</div> }
                }
                else
                {
                    <dl class="row mb-0"><dt class="col-7 text-secondary fw-normal">Mercancía</dt><dd class="col-5 text-end">₡@_actual.CostoMercanciaCrc:N2</dd><dt class="col-7 text-secondary fw-normal">Costos logísticos (prorrateados por valor)</dt><dd class="col-5 text-end">₡@_actual.CostosImportacionCrc:N2</dd><dt class="col-7 text-secondary fw-normal">Tributo DUA (por línea, sin prorratear)</dt><dd class="col-5 text-end">₡@_actual.TributosDuaCrc:N2</dd><dt class="col-7">Costo nacionalizado</dt><dd class="col-5 text-end fw-bold">₡@_actual.CostoNacionalizadoCrc:N2</dd></dl>
                    <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Artículo</th><th class="text-end">Unidades</th><th class="text-end">Costo proveedor</th><th class="text-end">Log./unidad</th><th class="text-end">Tributo DUA/unidad</th><th class="text-end">Nacionalizado/unidad</th><th></th></tr></thead><tbody>@foreach (var item in _actual.Lineas) { <tr><td>@(item.DescripcionArticulo ?? item.IdArticulo.ToString()) <span class="text-secondary small">· @item.DescripcionProveedor</span></td><td class="text-end">@item.Cantidad</td><td class="text-end">₡@item.CostoProveedorCrcUnitario:N6</td><td class="text-end">₡@item.CostoImportacionUnitario:N6</td><td class="text-end">₡@item.TributoDuaUnitario:N6</td><td class="text-end fw-semibold">₡@item.CostoNacionalizadoUnitario:N6</td><td>@if (_actual.Estado != 6) { <button class="btn btn-sm btn-link" title="Actualizar tributo DUA de esta línea" @onclick="() => PrepararTributoDua(item)"><i class="bi bi-pencil"></i></button> }</td></tr> }</tbody></table></div>
                    @if (_lineaTributoDua is not null)
                    {
                        <div class="row g-2 align-items-end mb-3 border rounded p-2">
                            <div class="col-md-6"><label class="form-label">Tributo DUA unitario de "@(_lineaTributoDua.DescripcionArticulo ?? _lineaTributoDua.DescripcionProveedor)" (de la Declaración de Importación)</label><input type="number" min="0" step="0.000001" class="form-control" @bind="_tributoDua.TributoDuaUnitario" /></div>
                            <div class="col-md-3"><button class="btn btn-outline-primary" @onclick="GuardarTributoDua">Guardar</button> <button class="btn btn-outline-secondary" @onclick="() => _lineaTributoDua = null">Cancelar</button></div>
                        </div>
                    }
                    <hr />
                    <h6>Costos logísticos capitalizables (globales del envío)</h6>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3"><label class="form-label">Categoría</label><select class="form-select" @bind="_costo.Categoria"><option value="2">Flete</option><option value="3">Seguro</option><option value="5">Agencia aduanal</option><option value="6">Documentación</option><option value="7">Almacenaje</option><option value="8">Manejo</option><option value="9">Transporte local</option><option value="10">Otro</option></select></div>
                        <div class="col-md-4"><label class="form-label">Descripción</label><input class="form-control" @bind="_costo.Descripcion" /></div>
                        <div class="col-md-3"><label class="form-label">Monto capitalizable (CRC)</label><input type="number" min="0" step="0.01" class="form-control" @bind="_costo.MontoCapitalizable" /></div>
                        <div class="col-md-2"><label class="form-label">IVA acreditable</label><input type="number" min="0" step="0.01" class="form-control" @bind="_costo.IvaAcreditable" /></div>
                        <div class="col-12"><button class="btn btn-outline-primary" @onclick="AgregarCosto">Agregar costo</button><small class="text-secondary ms-2">Se reparte entre los artículos según su participación en el valor de la mercancía, no en partes iguales. El tributo DUA no va aquí: se captura por línea arriba.</small></div>
                    </div>
                    <div class="mt-3 border-top pt-3"><label class="form-label">Fecha de recepción física</label><div class="input-group"><input type="date" class="form-control" @bind="_cierre.FechaRecepcion" /><button class="btn btn-success" disabled="@(_guardando || _actual.Estado == 6)" @onclick="Cerrar">@(_actual.Estado == 6 ? "Importación cerrada" : "Cerrar y registrar inventario")</button></div><small class="text-secondary">El cierre es definitivo: registra existencias, actualiza el costo global del artículo y deja una cuenta por pagar por el proveedor extranjero y por cada factura local con XML fiscal. No genera movimiento de caja.</small></div>
                    @if (_actual.ComprasGeneradas.Count > 0)
                    {
                        <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Proveedor</th><th>Factura</th><th class="text-end">Total</th></tr></thead><tbody>@foreach (var c in _actual.ComprasGeneradas) { <tr><td>@c.Proveedor</td><td>@c.Factura</td><td class="text-end">@(c.CodMoneda == 2 ? "$" : "₡")@c.TotalFactura:N2</td></tr> }</tbody></table></div>
                    }
                    <hr />
                    <h6>Documentos y evidencia</h6>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3"><label class="form-label">Tipo</label><select class="form-select" @bind="_tipoDocumento"><option value="1">Factura extranjera PDF</option><option value="2">DUA</option><option value="3">Conocimiento de embarque</option><option value="4">XML fiscal nacional</option><option value="5">PDF fiscal nacional</option><option value="6">Evidencia interna</option></select></div>
                        <div class="col-md-3"><label class="form-label">Archivo</label><InputFile class="form-control" OnChange="SeleccionarArchivo" /></div>
                        <div class="col-md-2"><label class="form-label">Clave fiscal XML</label><input class="form-control" @bind="_claveFiscal" /></div>
                        @if (_tipoDocumento == 4)
                        {
                            <div class="col-md-2"><label class="form-label">Proveedor local *</label><select class="form-select" @bind="_idProveedorLocalDocumento"><option value="">Seleccione...</option>@foreach(var p in _proveedores){<option value="@p.CodigoProv">@p.Nombre</option>}</select></div>
                        }
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100" disabled="@(_archivo is null || (_tipoDocumento == 4 && _idProveedorLocalDocumento is null))" @onclick="Adjuntar">Adjuntar</button></div>
                    </div>
                    @if (_tipoDocumento == 4) { <small class="text-secondary">El proveedor local (almacén fiscal, agencia aduanal, etc.) es obligatorio: de aquí sale la cuenta por pagar al cerrar.</small> }
                    @if (_actual.Documentos.Count > 0) { <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Documento</th><th>Proveedor local</th><th>Clave fiscal</th><th>Estado Hacienda</th><th>Detalle</th><th></th></tr></thead><tbody>@foreach (var doc in _actual.Documentos) { <tr><td>@doc.NombreArchivo</td><td>@doc.NombreProveedorLocal</td><td><small>@doc.ClaveFiscal</small></td><td>@if (doc.EstadoFiscal == "Rechazado") { <span class="badge text-bg-warning">Rechazado</span> } else { @doc.EstadoFiscal }</td><td class="small text-secondary">@doc.DetalleFiscal</td><td>@if (doc.Tipo == 4) { <button class="btn btn-sm btn-outline-primary" @onclick="() => EnviarMensajeReceptor(doc.IdImportacionDocumento)">Enviar / reintentar</button> }</td></tr> }</tbody></table></div> }
                }
            </div>
        </div>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modalImportarPdf" Title="Importar artículos desde PDF" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label">PDF de la factura extranjera</label>
            <InputFile class="form-control" accept=".pdf,application/pdf" OnChange="ImportarPdf" />
            <div class="form-text">Extracción automática best-effort: revise y corrija cada línea antes de asociarla — no siempre acierta cantidad, precio o descripción.</div>
        </div>
        @if (_extrayendoPdf)
        {
            <div class="d-flex justify-content-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Leyendo...</span></div></div>
        }
        else if (_pdfCandidatas.Count > 0)
        {
            @if (!_pdfTextoExtraido)
            {
                <div class="alert alert-warning">No se pudo leer texto de este PDF (probablemente es una imagen escaneada). Puede adjuntarlo igual como evidencia y capturar las líneas manualmente.</div>
            }
            <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>#</th><th>Descripción</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Total</th><th></th><th></th></tr></thead><tbody>
                @foreach (var candidata in _pdfCandidatas)
                {
                    <tr class="@(candidata.RequiereRevision ? "table-warning" : null)">
                        <td>@candidata.NumeroLinea</td>
                        <td>@candidata.DescripcionProveedor <span class="text-secondary small">· @candidata.TextoOriginal</span></td>
                        <td class="text-end">@candidata.Cantidad</td>
                        <td class="text-end">@candidata.PrecioUnitario</td>
                        <td class="text-end">@candidata.Total</td>
                        <td>@if (candidata.RequiereRevision) { <span class="badge text-bg-warning">Revisar</span> }</td>
                        <td><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AsociarCandidataPdf(candidata)">Asociar</button></td>
                    </tr>
                }
            </tbody></table></div>
        }
        else if (_pdfIntentado)
        {
            <div class="alert alert-warning mb-0">No se encontraron líneas de artículo en este PDF (probablemente es una imagen escaneada). Puede adjuntarlo igual como evidencia y capturar las líneas manualmente.</div>
        }
    </BodyTemplate>
</HxModal>

@code {
    private CrearImportacionWebDTO _nueva = new() { TipoCambioDua = 1 };
    private ImportacionCostoWebDTO _costo = new() { Categoria = 2 };
    private CerrarImportacionWebDTO _cierre = new();
    private ImportacionResumenWebDTO? _actual;
    private IBrowserFile? _archivo;
    private int _tipoDocumento = 1;
    private string? _claveFiscal;
    private bool _guardando;

    [Parameter]
    public long? IdImportacion { get; set; }

    private List<SuvesaPosSitioAplicacion.DTOs.Generated.Bodega> _bodegas = new();
    private List<SuvesaPosSitioAplicacion.DTOs.Fiscal.EmisorFiscalDTO> _emisores = new();
    private List<SuvesaPosSitioAplicacion.DTOs.Fiscal.SerieFacturacionFiscalDTO> _series = new();
    private List<SuvesaPosSitioAplicacion.DTOs.Generated.ProveedorDTO> _proveedores = new();
    private readonly Dictionary<long, string> _articulosPorCodigo = new();
    private int? _idProveedorLocalDocumento;
    private ActualizarTributoDuaImportacionWebDTO _tributoDua = new();

    // Editor inline de línea — mismo patrón de Compra.razor: se llena al elegir un
    // artículo (búsqueda manual o asociación de una candidata del PDF), nunca se
    // inserta nada en _nueva.Lineas sin pasar por "Agregar"/"Actualizar" aquí.
    private AppBuscadorArticulo _buscadorArticulo = default!;
    private InventarioDTO? _articuloActual;
    private decimal _cantidad = 1m, _costoUnitario, _tributoDuaUnitario;
    private decimal? _precioAAplicado;
    private string _codigoProveedor = string.Empty, _descripcionProveedor = string.Empty;
    private sealed class LoteEdicion { public string Numero = string.Empty; public DateTime? Vence; public decimal Cantidad; }
    private readonly List<LoteEdicion> _lotes = new();
    private int? _indiceEdicionLinea;

    // Importación desde PDF — candidatas crudas del extractor heurístico; cada una se
    // "consume" al asociarla (pasa al editor de arriba), nunca se agrega directo.
    private HxModal _modalImportarPdf = default!;
    private bool _extrayendoPdf, _pdfIntentado, _pdfTextoExtraido;
    private List<LineaCandidataFacturaPdfWebDTO> _pdfCandidatas = new();

    protected override async Task OnInitializedAsync()
    {
        _bodegas = ((await Respuestas.DatoAsync(await ComprasApi.Bodegas(false))) ?? []).ToList();
        _emisores = ((await Respuestas.DatoAsync(await EmisoresApi.Obtener())) ?? []).ToList();
        if (_emisores.Count == 1) _nueva.IdEmisor = _emisores[0].Id;
        _series = ((await Respuestas.DatoAsync(await SeriesApi.Obtener())) ?? []).ToList();
        _proveedores = ((await Respuestas.DatoAsync(await ProveedoresApi.Obtener())) ?? []).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IdImportacion is > 0 && (_actual is null || _actual.IdImportacion != IdImportacion))
            _actual = await Respuestas.DatoAsync(await Api.Obtener(IdImportacion.Value));
    }

    private void IrABandeja() => Navegacion.NavigateTo("/buys/importationsbox");

    private async Task AbrirBuscadorArticulo()
    {
        if (_nueva.IdProveedorExtranjero <= 0 || _nueva.IdBodega <= 0 || _nueva.CodMoneda <= 0 || _nueva.TipoCambioDua <= 0)
        {
            await Dialogos.ErrorAsync("Complete proveedor, bodega, moneda y tipo de cambio DUA antes de agregar artículos.");
            return;
        }
        await _buscadorArticulo.AbrirAsync();
    }

    private void ElegirArticulo(InventarioDTO articulo)
    {
        _articuloActual = articulo;
        _indiceEdicionLinea = null;
        _lotes.Clear();
        if (_pdfCandidatasPendiente is { } candidata)
        {
            // Viene de "Asociar" en el importador de PDF: precarga lo extraído, pero el
            // usuario igual confirma con "Agregar" — nunca se inserta directo a la tabla.
            _codigoProveedor = candidata.CodigoProveedor ?? string.Empty;
            _descripcionProveedor = string.IsNullOrWhiteSpace(candidata.DescripcionProveedor) ? (articulo.Descripcion ?? string.Empty) : candidata.DescripcionProveedor;
            _cantidad = candidata.Cantidad is > 0 ? candidata.Cantidad.Value : 1m;
            _costoUnitario = candidata.PrecioUnitario ?? 0m;
            _tributoDuaUnitario = 0m;
            _precioAAplicado = null;
            _pdfCandidatas.Remove(candidata);
            _pdfCandidatasPendiente = null;
        }
        else
        {
            _codigoProveedor = string.Empty;
            _descripcionProveedor = articulo.Descripcion ?? string.Empty;
            _cantidad = 1m;
            _costoUnitario = 0m;
            _tributoDuaUnitario = 0m;
            _precioAAplicado = null;
        }
        _articulosPorCodigo[articulo.Codigo] = articulo.Descripcion ?? articulo.Cod_Articulo ?? articulo.Codigo.ToString();
    }

    private void EditarLinea(int indice)
    {
        var linea = _nueva.Lineas[indice];
        _articuloActual = new InventarioDTO { Codigo = linea.IdArticulo, Descripcion = _articulosPorCodigo.GetValueOrDefault(linea.IdArticulo, linea.DescripcionProveedor), Lote = linea.Lotes.Count > 0 };
        _indiceEdicionLinea = indice;
        _codigoProveedor = linea.CodigoProveedor;
        _descripcionProveedor = linea.DescripcionProveedor;
        _cantidad = linea.Cantidad;
        _costoUnitario = linea.CostoProveedorMonedaUnitario;
        _tributoDuaUnitario = linea.TributoDuaUnitario;
        _precioAAplicado = linea.PrecioAAplicado;
        _lotes.Clear();
        foreach (var lote in linea.Lotes)
            _lotes.Add(new LoteEdicion { Numero = lote.Numero, Vence = lote.FechaVencimiento.HasValue ? lote.FechaVencimiento.Value.ToDateTime(TimeOnly.MinValue) : null, Cantidad = lote.Cantidad });
    }

    private void CancelarEdicionLinea()
    {
        _articuloActual = null;
        _indiceEdicionLinea = null;
        _lotes.Clear();
    }

    private async Task AgregarOActualizarLinea()
    {
        if (_articuloActual is null || _cantidad <= 0 || _costoUnitario < 0) return;
        if (_articuloActual.Lote)
        {
            if (_lotes.Count == 0 || _lotes.Any(x => string.IsNullOrWhiteSpace(x.Numero) || x.Cantidad <= 0 || x.Vence is null)
                || Math.Abs(_lotes.Sum(x => x.Cantidad) - _cantidad) > 0.001m)
            {
                await Dialogos.ErrorAsync("Este artículo maneja lotes: indique lotes válidos (número, vencimiento y cantidad) cuya suma coincida con las unidades.");
                return;
            }
        }
        var linea = new ImportacionLineaWebDTO
        {
            IdArticulo = _articuloActual.Codigo,
            CodigoProveedor = _codigoProveedor,
            DescripcionProveedor = _descripcionProveedor,
            Cantidad = _cantidad,
            CostoProveedorMonedaUnitario = _costoUnitario,
            TributoDuaUnitario = _tributoDuaUnitario,
            PrecioAAplicado = _precioAAplicado,
            Lotes = _articuloActual.Lote
                ? _lotes.Select(l => new ImportacionLoteWebDTO { Numero = l.Numero.Trim(), FechaVencimiento = l.Vence.HasValue ? DateOnly.FromDateTime(l.Vence.Value) : null, Cantidad = l.Cantidad }).ToList()
                : new(),
        };
        if (_indiceEdicionLinea is int indice) _nueva.Lineas[indice] = linea; else _nueva.Lineas.Add(linea);
        CancelarEdicionLinea();
    }

    private void QuitarLinea(int indice) => _nueva.Lineas.RemoveAt(indice);

    private async Task AbrirImportadorPdf()
    {
        _pdfCandidatas.Clear();
        _pdfIntentado = false;
        await _modalImportarPdf.ShowAsync();
    }

    private async Task ImportarPdf(InputFileChangeEventArgs e)
    {
        _extrayendoPdf = true;
        _pdfCandidatas.Clear();
        _pdfIntentado = false;
        StateHasChanged();
        try
        {
            await using var flujo = e.File.OpenReadStream(20 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await flujo.CopyToAsync(memoria);
            var resultado = await Respuestas.DatoAsync(await Api.ExtraerPdf(new ExtraerLineasFacturaPdfWebDTO { NombreArchivo = e.File.Name, Contenido = memoria.ToArray() }), "leer el PDF");
            _pdfIntentado = true;
            if (resultado is not null)
            {
                _pdfTextoExtraido = resultado.TextoExtraido;
                _pdfCandidatas = resultado.Lineas;
            }
        }
        finally { _extrayendoPdf = false; }
    }

    private async Task AsociarCandidataPdf(LineaCandidataFacturaPdfWebDTO candidata)
    {
        await _modalImportarPdf.HideAsync();
        _pdfCandidatasPendiente = candidata;
        await _buscadorArticulo.AbrirAsync(candidata.DescripcionProveedor);
    }

    private LineaCandidataFacturaPdfWebDTO? _pdfCandidatasPendiente;

    private async Task Crear()
    {
        _guardando = true;
        try
        {
            var dato = await Respuestas.DatoAsync(await Api.Crear(_nueva), "crear el expediente de importación");
            if (dato is not null)
            {
                _actual = dato;
                Navegacion.NavigateTo($"/buys/importations/{dato.IdImportacion}");
            }
        }
        finally { _guardando = false; }
    }

    private async Task AgregarCosto()
    {
        if (_actual is null) return;
        var dato = await Respuestas.DatoAsync(await Api.AgregarCosto(_actual.IdImportacion, _costo), "agregar el costo");
        if (dato is not null) { _actual = dato; _costo = new() { Categoria = 2 }; }
    }

    private ImportacionLineaResultadoWebDTO? _lineaTributoDua;
    private void PrepararTributoDua(ImportacionLineaResultadoWebDTO item)
    {
        _lineaTributoDua = item;
        _tributoDua = new() { IdImportacionLinea = item.IdImportacionLinea, TributoDuaUnitario = item.TributoDuaUnitario };
    }
    private async Task GuardarTributoDua()
    {
        if (_actual is null || _lineaTributoDua is null) return;
        var dato = await Respuestas.DatoAsync(await Api.ActualizarTributoDua(_actual.IdImportacion, _tributoDua), "actualizar el tributo DUA");
        if (dato is not null) { _actual = dato; _lineaTributoDua = null; }
    }
    private async Task SeleccionarArchivo(InputFileChangeEventArgs e) => _archivo = e.File;
    private async Task Adjuntar()
    {
        if (_actual is null || _archivo is null) return;
        if (_tipoDocumento == 4 && _idProveedorLocalDocumento is null) return;
        await using var flujo = _archivo.OpenReadStream(20 * 1024 * 1024);
        using var memoria = new MemoryStream();
        await flujo.CopyToAsync(memoria);
        var dato = await Respuestas.DatoAsync(await Api.AgregarDocumento(_actual.IdImportacion, new ImportacionDocumentoCargaWebDTO { Tipo = _tipoDocumento, NombreArchivo = _archivo.Name, TipoMime = _archivo.ContentType, Contenido = memoria.ToArray(), ClaveFiscal = _claveFiscal, IdProveedorLocal = _tipoDocumento == 4 ? _idProveedorLocalDocumento : null }), "adjuntar el documento");
        if (dato is not null) { _actual = dato; _archivo = null; _claveFiscal = null; _idProveedorLocalDocumento = null; }
    }
    private async Task Cerrar()
    {
        if (_actual is null) return;
        _guardando = true;
        try
        {
            var dato = await Respuestas.DatoAsync(await Api.Cerrar(_actual.IdImportacion, _cierre), "cerrar la importación");
            if (dato is not null) _actual = dato;
        }
        finally { _guardando = false; }
    }
    private async Task EnviarMensajeReceptor(long idDocumento)
    {
        if (_actual is null) return;
        var dato = await Respuestas.DatoAsync(await Api.EnviarMensajeReceptor(_actual.IdImportacion, idDocumento), "enviar el Mensaje Receptor");
        if (dato is not null) _actual = dato;
    }
    private void Nueva()
    {
        _actual = null;
        _nueva = new() { TipoCambioDua = 1 };
        if (_emisores.Count == 1) _nueva.IdEmisor = _emisores[0].Id;
        CancelarEdicionLinea();
        _cierre = new();
        _articulosPorCodigo.Clear();
        _lineaTributoDua = null;
        _idProveedorLocalDocumento = null;
        Navegacion.NavigateTo("/buys/importations");
    }
}
