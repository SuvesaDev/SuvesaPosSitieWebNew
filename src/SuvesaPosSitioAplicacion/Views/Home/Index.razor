@page "/"
@page "/initial"
@using SuvesaPosSitioAplicacion.Services
@inject IContextoSesion Sesion
@inject IEstadoEspacioTrabajo Espacio
@inject NavigationManager Navegacion

<PageTitle>Inicio — SeePOS</PageTitle>

<section class="seepos-inicio" aria-labelledby="inicio-titulo">
    <header class="seepos-inicio-bienvenida">
        <div>
            <p class="seepos-inicio-eyebrow"><i class="bi bi-shop-window" aria-hidden="true"></i> @Sesion.NombreSucursal</p>
            <h1 id="inicio-titulo">Inicio</h1>
            <p class="mb-0">Hola@(string.IsNullOrWhiteSpace(Sesion.Usuario) ? string.Empty : $", {Sesion.Usuario}"). Seleccione una tarea para comenzar su jornada.</p>
        </div>
        <i class="bi bi-grid-1x2-fill seepos-inicio-bienvenida-icono" aria-hidden="true"></i>
    </header>

    <section aria-labelledby="tareas-frecuentes">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
            <div>
                <h2 class="h5 mb-1" id="tareas-frecuentes">Tareas frecuentes</h2>
                <p class="text-secondary small mb-0">Accesos directos a las operaciones más usadas.</p>
            </div>
            @if (Espacio.Pestanas.Count > 0)
            {
                <span class="seepos-inicio-pestanas"><i class="bi bi-window-stack" aria-hidden="true"></i> @Espacio.Pestanas.Count abierta@(Espacio.Pestanas.Count == 1 ? string.Empty : "s")</span>
            }
        </div>

        @if (AccionesDisponibles.Length > 0)
        {
            <div class="seepos-inicio-acciones">
                @foreach (var accion in AccionesDisponibles)
                {
                <button type="button" class="seepos-inicio-accion" @onclick="() => Abrir(accion)">
                    <span class="seepos-inicio-accion-icono"><i class="bi @accion.Icono" aria-hidden="true"></i></span>
                    <span class="seepos-inicio-accion-texto">
                        <strong>@accion.Titulo</strong>
                        <small>@accion.Descripcion</small>
                    </span>
                    <i class="bi bi-arrow-right seepos-inicio-accion-flecha" aria-hidden="true"></i>
                </button>
                }
            </div>
        }
        else
        {
            <p class="seepos-inicio-sin-acciones mb-0">No tiene tareas frecuentes asignadas. Use el menú lateral para consultar las funciones disponibles.</p>
        }
    </section>

    <section class="seepos-inicio-ayuda" aria-labelledby="inicio-ayuda">
        <i class="bi bi-lightbulb-fill" aria-hidden="true"></i>
        <div>
            <h2 class="h6 mb-1" id="inicio-ayuda">Una navegación más rápida</h2>
            <p class="mb-0">Use el menú lateral para todas las funciones disponibles; las pantallas que abra permanecerán en las pestañas superiores.</p>
        </div>
    </section>
</section>

@code {
    private sealed record AccionInicio(string Titulo, string Descripcion, string Codigo, string Ruta, string Icono);

    private static readonly AccionInicio[] Acciones =
    {
        new("Facturar", "Registrar una venta", "INICIO.FACTURACION", "/initial/billing", "bi-receipt"),
        new("Abrir caja", "Iniciar la jornada de caja", "CAJA.APERTURA_CAJA", "/initial/cash/opencash", "bi-cash-stack"),
        new("Clientes", "Consultar y mantener clientes", "INICIO.CLIENTES", "/initial/customers", "bi-people-fill"),
        new("Inventario", "Buscar artículos y existencias", "INICIO.INVENTARIOS", "/initial/inventory", "bi-box-seam")
    };

    private AccionInicio[] AccionesDisponibles => Acciones.Where(a => Sesion.PuedeVer(a.Codigo)).ToArray();

    protected override async Task OnInitializedAsync() => await Sesion.CargarAsync();

    private void Abrir(AccionInicio accion)
    {
        var pestana = Espacio.Abrir(accion.Titulo, accion.Ruta);
        Navegacion.NavigateTo(pestana.Ruta);
    }
}
