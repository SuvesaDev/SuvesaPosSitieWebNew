@page "/"
@inject IContextoSesion Sesion

<PageTitle>SeePOS</PageTitle>

<div class="row g-4">

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h1 class="h5 card-title">Ola 0 &mdash; Cimientos</h1>
                <p class="card-text text-secondary">
                    Estructura base del sitio, con la organizacion estandar de la casa.
                    Todavia no hay ninguna pantalla de negocio: eso empieza en la Ola 1.
                </p>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        Semana 1 &mdash; Proyecto, estructura y contratos del API
                        <span class="badge text-bg-success">hecho</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        Semana 2 &mdash; Sesion, sucursal y permisos en servidor
                        <span class="badge text-bg-success">hecho</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        Semana 3 &mdash; Shell y espacio de trabajo por pestanas
                        <span class="badge text-bg-light text-secondary">pendiente</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        Semana 4 &mdash; Convivencia con la SPA React
                        <span class="badge text-bg-light text-secondary">pendiente</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header">Sesion</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-secondary fw-normal">Usuario</dt>
                    <dd class="col-7">@Sesion.Usuario</dd>

                    <dt class="col-5 text-secondary fw-normal">Centro</dt>
                    <dd class="col-7">@Sesion.NombreSucursal (@Sesion.IdSucursal)</dd>

                    <dt class="col-5 text-secondary fw-normal">Administrador</dt>
                    <dd class="col-7">@(Sesion.EsAdministrador ? "si" : "no")</dd>

                    <dt class="col-5 text-secondary fw-normal">Menus</dt>
                    <dd class="col-7">@Sesion.Menus.Count</dd>

                    <dt class="col-5 text-secondary fw-normal">Pantallas</dt>
                    <dd class="col-7">@Sesion.Permisos.Count</dd>
                </dl>

                <hr />
                <p class="small text-secondary mb-0">
                    El token del API no aparece aqui a proposito: vive en el ticket de
                    sesion, en servidor, y el navegador solo tiene la llave.
                </p>
            </div>
        </div>
    </div>

</div>

@code {
    protected override async Task OnInitializedAsync() => await Sesion.CargarAsync();
}
