@page "/comercial/clasificacion-clientes"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.DTOs.Comercial
@using SuvesaPosSitioAplicacion.Services
@inject IClasificacionComercial Api
@inject ICatalogosComerciales Catalogos
@inject IContextoSesion Sesion
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="Clasificación de clientes" Codigo="@Codigo" Nivel="NivelPantalla.Escritorio" Icono="bi-people"
             Subtitulo="Asigne el canal comercial de cada cliente. Una sucursal usa el canal del cliente salvo que tenga uno propio. No cambia el tipo de cliente de siempre.">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar" title="Actualizar"><i class="bi bi-arrow-clockwise"></i></button>
    </Acciones>
    <ChildContent>
        <div class="card mb-3"><div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1" for="cc-texto">Cliente</label>
                    <input id="cc-texto" class="form-control form-control-sm" placeholder="Nombre o cédula" @bind="_filtro.Texto" @bind:event="onchange" @onkeydown="TeclaBuscar" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1" for="cc-canal">Canal</label>
                    <select id="cc-canal" class="form-select form-select-sm" @bind="_idCanalFiltro">
                        <option value="0">Todos</option>
                        @foreach (var c in _canalesActivos) { <option value="@c.Id">@c.Nombre</option> }
                    </select>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-end">
                    <div class="form-check form-switch mb-1">
                        <input id="cc-pendientes" class="form-check-input" type="checkbox" @bind="_filtro.SoloPendientes" />
                        <label class="form-check-label small" for="cc-pendientes">Solo sin canal</label>
                    </div>
                </div>
                <div class="col-12 col-md-2 text-md-end">
                    <button class="btn btn-sm btn-primary" @onclick="Buscar"><i class="bi bi-search me-1"></i>Buscar</button>
                </div>
            </div>
        </div></div>

        @if (Seleccionados > 0 && Sesion.Puede(Codigo, AccionPantalla.Editar))
        {
            <div class="alert alert-primary d-flex flex-wrap align-items-center gap-2 py-2">
                <span><strong>@Seleccionados</strong> seleccionado(s)</span>
                <select class="form-select form-select-sm w-auto" @bind="_idCanalMasivo" aria-label="Canal a asignar">
                    <option value="0">Elija un canal…</option>
                    @foreach (var c in _canalesActivos) { <option value="@c.Id">@c.Nombre</option> }
                </select>
                <button class="btn btn-sm btn-primary" disabled="@(_idCanalMasivo == 0 || _guardando)" @onclick="AsignarMasivo"><i class="bi bi-check2 me-1"></i>Asignar</button>
                <button class="btn btn-sm btn-outline-danger" disabled="@_guardando" @onclick="QuitarMasivo"><i class="bi bi-x-lg me-1"></i>Quitar canal</button>
                <button class="btn btn-sm btn-link ms-auto" @onclick="LimpiarSeleccion">Limpiar selección</button>
            </div>
        }

        <div class="card"><div class="card-body p-0">
            <AppCargable Cargando="_cargando" Vacio="@(!_cargando && _pagina.Items.Count == 0)" TextoVacio="No hay clientes con esos filtros.">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:2.5rem"><input class="form-check-input" type="checkbox" checked="@TodosSeleccionados" @onchange="e => SeleccionarTodos((bool)(e.Value ?? false))" aria-label="Seleccionar todos" /></th>
                                <th>Cliente</th>
                                <th style="width:16rem">Canal</th>
                                <th class="text-end" style="width:9rem">Sucursales</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _pagina.Items)
                            {
                                <tr class="@(c.Pendiente ? "table-warning" : null)">
                                    <td><input class="form-check-input" type="checkbox" checked="@_clientesSel.Contains(c.IdCliente)" @onchange="e => AlternarCliente(c.IdCliente, (bool)(e.Value ?? false))" aria-label="Seleccionar @c.Nombre" /></td>
                                    <td>@c.Nombre<div class="small text-muted">@c.Cedula</div></td>
                                    <td>
                                        <select class="form-select form-select-sm" value="@(c.IdCanal ?? 0)" disabled="@(!PuedeEditar || _guardando)" @onchange="e => CambiarCanalCliente(c, e.Value?.ToString())" aria-label="Canal de @c.Nombre">
                                            <option value="0">(sin canal)</option>
                                            @foreach (var o in OpcionesCanal(c.IdCanal)) { <option value="@o.Id">@o.Nombre@(o.Activo ? "" : " (inactivo)")</option> }
                                        </select>
                                    </td>
                                    <td class="text-end">
                                        @if (c.Sucursales.Count > 0)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AlternarExpandido(c.IdCliente)">
                                                @c.Sucursales.Count <i class="bi @(_expandidos.Contains(c.IdCliente) ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>
                                            </button>
                                        }
                                        else { <span class="text-muted small">—</span> }
                                    </td>
                                </tr>
                                @if (_expandidos.Contains(c.IdCliente))
                                {
                                    @foreach (var s in c.Sucursales)
                                    {
                                        <tr class="bg-body-tertiary">
                                            <td class="text-end"><input class="form-check-input" type="checkbox" checked="@_sucursalesSel.Contains((c.IdCliente, s.IdClienteSucursal))" @onchange="e => AlternarSucursal(c.IdCliente, s.IdClienteSucursal, (bool)(e.Value ?? false))" aria-label="Seleccionar @s.Sucursal" /></td>
                                            <td class="ps-4"><i class="bi bi-arrow-return-right me-1 text-muted"></i>@s.Sucursal<div class="small text-muted ps-4">@s.NombreComercial</div></td>
                                            <td>
                                                <select class="form-select form-select-sm" value="@(s.IdCanalPropio ?? 0)" disabled="@(!PuedeEditar || _guardando)" @onchange="e => CambiarCanalSucursal(c, s, e.Value?.ToString())" aria-label="Canal de @s.Sucursal">
                                                    <option value="0">@TextoHereda(c)</option>
                                                    @foreach (var o in OpcionesCanal(s.IdCanalPropio)) { <option value="@o.Id">@o.Nombre@(o.Activo ? "" : " (inactivo)")</option> }
                                                </select>
                                            </td>
                                            <td></td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </AppCargable>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">@Resumen</span>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" disabled="@(_pagina.Pagina <= 1 || _cargando)" @onclick="() => CambiarPagina(-1)"><i class="bi bi-chevron-left"></i> Anterior</button>
                <button class="btn btn-outline-secondary" disabled="@(!HaySiguiente || _cargando)" @onclick="() => CambiarPagina(1)">Siguiente <i class="bi bi-chevron-right"></i></button>
            </div>
        </div></div>
    </ChildContent>
</AppPantalla>

@code {
    private const string Codigo = "COMERCIAL.CLASIFICACION_CLIENTES";

    private sealed record OpcionCanal(int Id, string Nombre, bool Activo);

    private readonly FiltroClasificacionClientesDTO _filtro = new();
    private PaginaClientesClasificacionDTO _pagina = new();
    private List<CatalogoComercialDTO> _canales = new();
    private List<CatalogoComercialDTO> _canalesActivos = new();
    private readonly HashSet<long> _clientesSel = new();
    private readonly HashSet<(long Cliente, long Sucursal)> _sucursalesSel = new();
    private readonly HashSet<long> _expandidos = new();
    private int _idCanalFiltro, _idCanalMasivo;
    private bool _cargando = true, _guardando;

    private bool PuedeEditar => Sesion.Puede(Codigo, AccionPantalla.Editar);
    private int Seleccionados => _clientesSel.Count + _sucursalesSel.Count;
    private bool TodosSeleccionados => _pagina.Items.Count > 0 && _pagina.Items.All(c => _clientesSel.Contains(c.IdCliente));
    private bool HaySiguiente => _pagina.Pagina * _pagina.Tamano < _pagina.Total;
    private string Resumen => _pagina.Total == 0 ? "Sin resultados" : $"Mostrando {(_pagina.Pagina - 1) * _pagina.Tamano + 1}–{Math.Min(_pagina.Pagina * _pagina.Tamano, _pagina.Total)} de {_pagina.Total}";

    protected override async Task OnInitializedAsync()
    {
        var todos = await Respuestas.DatoAsync(await Catalogos.Listar(TipoCatalogoComercial.Canales, incluirInactivos: true), "consultar los canales");
        _canales = (todos ?? Array.Empty<CatalogoComercialDTO>()).ToList();
        _canalesActivos = _canales.Where(c => c.Activo).ToList();
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        _filtro.IdCanal = _idCanalFiltro > 0 ? _idCanalFiltro : null;
        var datos = await Respuestas.DatoAsync(await Api.ListarClientes(_filtro), "consultar los clientes");
        _pagina = datos ?? new PaginaClientesClasificacionDTO();
        _cargando = false;
    }

    private async Task Buscar() { _filtro.Pagina = 1; LimpiarSeleccion(); await Cargar(); }
    private async Task Recargar() => await Cargar();
    private async Task TeclaBuscar(KeyboardEventArgs e) { if (e.Key == "Enter") await Buscar(); }

    private async Task CambiarPagina(int delta)
    {
        _filtro.Pagina = Math.Max(1, _pagina.Pagina + delta);
        await Cargar();
    }

    // El canal inactivo que un cliente ya tiene se sigue mostrando; no se ofrece para asignarlo a otros.
    private IEnumerable<OpcionCanal> OpcionesCanal(int? actual)
    {
        foreach (var c in _canalesActivos) yield return new OpcionCanal(c.Id, c.Nombre, true);
        if (actual is int id && _canalesActivos.All(c => c.Id != id))
        {
            var inactivo = _canales.FirstOrDefault(c => c.Id == id);
            if (inactivo is not null) yield return new OpcionCanal(inactivo.Id, inactivo.Nombre, false);
        }
    }

    private string TextoHereda(ClienteClasificacionDTO c)
    {
        var nombre = c.IdCanal is int id ? _canales.FirstOrDefault(x => x.Id == id)?.Nombre : null;
        return nombre is null ? "Hereda del cliente (sin canal)" : $"Hereda del cliente: {nombre}";
    }

    // ---- selección ----
    private void AlternarCliente(long id, bool marcado) { if (marcado) _clientesSel.Add(id); else _clientesSel.Remove(id); }
    private void AlternarSucursal(long cliente, long sucursal, bool marcado) { if (marcado) _sucursalesSel.Add((cliente, sucursal)); else _sucursalesSel.Remove((cliente, sucursal)); }
    private void AlternarExpandido(long id) { if (!_expandidos.Add(id)) _expandidos.Remove(id); }
    private void SeleccionarTodos(bool marcado) { foreach (var c in _pagina.Items) AlternarCliente(c.IdCliente, marcado); }
    private void LimpiarSeleccion() { _clientesSel.Clear(); _sucursalesSel.Clear(); }

    // ---- asignación ----
    private async Task CambiarCanalCliente(ClienteClasificacionDTO c, string? valor)
        => await Asignar(new() { new AsignarCanalItemDTO { IdCliente = c.IdCliente } }, Interpretar(valor));

    private async Task CambiarCanalSucursal(ClienteClasificacionDTO c, SucursalClasificacionDTO s, string? valor)
        => await Asignar(new() { new AsignarCanalItemDTO { IdCliente = c.IdCliente, IdClienteSucursal = s.IdClienteSucursal } }, Interpretar(valor));

    private static int? Interpretar(string? valor) => int.TryParse(valor, out var id) && id > 0 ? id : null;

    private List<AsignarCanalItemDTO> ItemsSeleccionados()
        => _clientesSel.Select(id => new AsignarCanalItemDTO { IdCliente = id })
            .Concat(_sucursalesSel.Select(s => new AsignarCanalItemDTO { IdCliente = s.Cliente, IdClienteSucursal = s.Sucursal })).ToList();

    private async Task AsignarMasivo()
    {
        if (await Asignar(ItemsSeleccionados(), _idCanalMasivo)) LimpiarSeleccion();
    }

    private async Task QuitarMasivo()
    {
        if (!await Dialogos.ConfirmarAsync($"¿Quitar el canal a los {Seleccionados} seleccionados? Las sucursales volverán a heredar el del cliente.", "Quitar canal")) return;
        if (await Asignar(ItemsSeleccionados(), null)) LimpiarSeleccion();
    }

    private async Task<bool> Asignar(List<AsignarCanalItemDTO> items, int? idCanal)
    {
        _guardando = true;
        var r = await Api.AsignarCanal(new AsignarCanalRequest { Items = items, IdCanal = idCanal });
        _guardando = false;
        var ok = await Respuestas.CorrectaAsync(r, "asignar el canal");
        // Se recarga siempre: si falló, la lista vuelve a mostrar el valor real.
        await Cargar();
        if (ok && items.Count > 1) Dialogos.Exito($"Canal actualizado en {r.Responses?.Actualizados ?? 0} registro(s).");
        return ok;
    }
}
