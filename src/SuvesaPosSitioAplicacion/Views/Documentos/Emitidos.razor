@page "/initial/documents"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IDocumentosEmitidos Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

@*  OLA 1 — replica del ARQUETIPO 02, con busqueda por criterio.
    A diferencia de las otras consultas, aqui el API ofrece TRES busquedas distintas
    y no una: por fechas, por cliente y por numero. La pantalla elige cual llamar
    segun lo que el usuario rellene, igual que hace hoy documentsEmitedAction.js.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Movil">
    <ChildContent>

        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="desde">Desde</label>
                        <input id="desde" type="date" class="form-control form-control-sm"
                               value="@_desde.ToString("yyyy-MM-dd")"
                               @onchange="e => _desde = Fecha(e, _desde)" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="hasta">Hasta</label>
                        <input id="hasta" type="date" class="form-control form-control-sm"
                               value="@_hasta.ToString("yyyy-MM-dd")"
                               @onchange="e => _hasta = Fecha(e, _hasta)" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small" for="numero">Numero</label>
                        <input id="numero" type="search" class="form-control form-control-sm"
                               placeholder="Opcional"
                               value="@_numero" @onchange="e => _numero = Texto(e)" />
                    </div>
                    <div class="col-12 col-md-3">
                        <button class="btn btn-primary btn-sm w-100" @onclick="Buscar"
                                disabled="@_buscando">
                            @(_buscando ? "Buscando..." : "Buscar")
                        </button>
                    </div>
                </div>
                <div class="form-text mt-2">
                    Con numero se busca ese documento; si no, por el rango de fechas.
                </div>
            </div>
        </div>

        @if (_buscando)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Buscando</span>
                </div>
            </div>
        }
        else if (!_hayBusqueda)
        {
            <div class="text-center text-secondary py-5 small">
                Indique un rango de fechas o un numero y pulse Buscar.
            </div>
        }
        else if (_documentos.Count == 0)
        {
            <div class="text-center text-secondary py-5 small">
                No se encontraron documentos con esos criterios.
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small">
                    @_documentos.Count @(_documentos.Count == 1 ? "documento" : "documentos")
                </span>
                <span class="small fw-semibold">
                    Total: <span class="seepos-importe">@Formato.Importe(_total)</span>
                </span>
            </div>

            @* Movil: tarjetas. *@
            <div class="d-md-none d-flex flex-column gap-2">
                @foreach (var d in _documentos)
                {
                    <button type="button" class="card text-start border-0 shadow-sm p-0"
                            @onclick="() => Ver(d)">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span class="fw-semibold small">@d.NombreCliente</span>
                                <span class="seepos-importe small">@Formato.Importe(d.Total)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                <code class="small text-secondary">@d.NumFactura</code>
                                <span class="small text-secondary">@d.Fecha</span>
                            </div>
                        </div>
                    </button>
                }
            </div>

            @* Escritorio y tableta: rejilla. *@
            <div class="d-none d-md-block card">
                <div class="card-body">
                    <AppRejilla TItem="FacturaDTO" Datos="Servir"
                                Nivel="NivelPantalla.Tableta" @ref="_rejilla">
                        <Columnas>
                            <HxGridColumn TItem="FacturaDTO" HeaderText="Numero"
                                          ItemTextSelector="d => d.NumFactura"
                                          SortKeySelector="d => d.NumFactura" />
                            <HxGridColumn TItem="FacturaDTO" HeaderText="Fecha"
                                          ItemTextSelector="d => d.Fecha"
                                          SortKeySelector="d => d.Fecha" />
                            <HxGridColumn TItem="FacturaDTO" HeaderText="Cliente"
                                          ItemTextSelector="d => d.NombreCliente"
                                          SortKeySelector="d => d.NombreCliente" />
                            <HxGridColumn TItem="FacturaDTO" HeaderText="Tipo"
                                          ItemTextSelector="d => d.TipoFacturaDescripcion" />
                            <HxGridColumn TItem="FacturaDTO" HeaderText="Cajero"
                                          ItemTextSelector="d => d.Cajero" />
                            <HxGridColumn TItem="FacturaDTO" HeaderText="Total"
                                          ItemTextSelector="@(d => Formato.Importe(d.Total))"
                                          SortKeySelector="d => d.Total"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="FacturaDTO" HeaderText="">
                                <ItemTemplate Context="d">
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => Ver(d)">Ver</button>
                                </ItemTemplate>
                            </HxGridColumn>
                        </Columnas>
                    </AppRejilla>
                </div>
            </div>
        }

    </ChildContent>
</AppPantalla>

<HxOffcanvas @ref="_detalle" Title="@(_elegido?.NumFactura ?? "Documento")"
             Placement="OffcanvasPlacement.End">
    <BodyTemplate>
        @if (_elegido is not null)
        {
            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Cliente</dt>
                <dd class="col-7">@(_elegido.NombreCliente ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Fecha</dt>
                <dd class="col-7">@(_elegido.Fecha ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Tipo</dt>
                <dd class="col-7">@(_elegido.TipoFacturaDescripcion ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Caja</dt>
                <dd class="col-7">@(_elegido.NumCaja ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Cajero</dt>
                <dd class="col-7">@(_elegido.Cajero ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Sucursal</dt>
                <dd class="col-7">@(_elegido.Sucursal ?? "—")</dd>
            </dl>

            <hr />

            <dl class="row small mb-0">
                <dt class="col-7 fw-normal text-secondary">Subtotal gravado</dt>
                <dd class="col-5 seepos-importe">@Formato.Importe(_elegido.SubTotalGravada)</dd>

                <dt class="col-7 fw-normal text-secondary">Subtotal exento</dt>
                <dd class="col-5 seepos-importe">@Formato.Importe(_elegido.SubTotalExento)</dd>

                <dt class="col-7 fw-normal text-secondary">Descuento</dt>
                <dd class="col-5 seepos-importe">@Formato.Importe(_elegido.Descuento)</dd>

                <dt class="col-7 fw-semibold">Total</dt>
                <dd class="col-5 seepos-importe fw-semibold">@Formato.Importe(_elegido.Total)</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_elegido.Clave))
            {
                <hr />
                <p class="small text-secondary mb-1">Clave del comprobante electronico</p>
                <code class="small" style="word-break:break-all">@_elegido.Clave</code>
            }
        }
    </BodyTemplate>
</HxOffcanvas>

@code {
    private const string Titulo = "Documentos Emitidos";

    private AppRejilla<FacturaDTO>? _rejilla;
    private HxOffcanvas _detalle = default!;

    private DateTime _desde = DateTime.Today.AddDays(-7);
    private DateTime _hasta = DateTime.Today;
    private string _numero = string.Empty;

    private List<FacturaDTO> _documentos = new();
    private FacturaDTO? _elegido;
    private decimal _total;
    private bool _buscando;
    private bool _hayBusqueda;

    private static DateTime Fecha(ChangeEventArgs e, DateTime actual)
        => DateTime.TryParse(e.Value?.ToString(), out var v) ? v : actual;

    private static string Texto(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    private async Task Buscar()
    {
        if (_buscando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_numero) && _desde > _hasta)
        {
            await Dialogos.ErrorAsync("La fecha inicial no puede ser posterior a la final.");
            return;
        }

        _buscando = true;
        _hayBusqueda = true;

        // El API tiene una busqueda por criterio, no una general con filtros.
        if (!string.IsNullOrWhiteSpace(_numero))
        {
            var uno = await Respuestas.DatoAsync(
                await Api.PorNumero(_numero.Trim()), "consultar el documento");

            _documentos = uno is null ? new List<FacturaDTO>() : new List<FacturaDTO> { uno };
        }
        else
        {
            _documentos = (await Respuestas.DatoAsync(
                await Api.PorFechas(_desde, _hasta), "consultar los documentos"))
                ?.ToList() ?? new List<FacturaDTO>();
        }

        // Los totales llegan en float: se convierten en el borde y se suman en decimal.
        _total = CalculoDocumento.Redondear(
            _documentos.Sum(d => Formato.AImporte(d.Total)));

        _buscando = false;

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private Task<GridDataProviderResult<FacturaDTO>> Servir(
        GridDataProviderRequest<FacturaDTO> peticion)
        => Task.FromResult(peticion.ApplyTo(_documentos));

    private async Task Ver(FacturaDTO documento)
    {
        _elegido = documento;
        await _detalle.ShowAsync();
    }
}
