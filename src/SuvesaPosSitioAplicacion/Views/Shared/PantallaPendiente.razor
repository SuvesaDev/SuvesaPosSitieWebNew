@page "/{*Ruta}"
@using SuvesaPosSitioAplicacion.Services
@inject IEstadoEspacioTrabajo Espacio
@inject IConfiguration Config

@* Ruta comodin: recoge las 78 pantallas del sistema actual que todavia no se migran.
   Las rutas concretas tienen prioridad, asi que cada pantalla migrada la va vaciando.

   Si hay SPA configurada, la pantalla se sirve dentro de la pestana. Si no,
   se explica que esta pendiente. *@

<PageTitle>@(Espacio.Actual?.Titulo ?? "Pendiente") &mdash; SeePOS</PageTitle>

@if (HayLegado && Ruta is not null)
{
    <PantallaLegado Ruta="@Ruta" Titulo="@(Espacio.Actual?.Titulo ?? Ruta)" />
}
else
{
    <div class="d-flex align-items-center justify-content-center h-100">
        <div class="text-center" style="max-width: 30rem;">
            <i class="bi bi-hourglass-split display-5 text-secondary opacity-50" aria-hidden="true"></i>

            <h1 class="h5 mt-3">@(Espacio.Actual?.Titulo ?? "Pantalla pendiente")</h1>

            <p class="text-secondary small mb-1">Esta pantalla todavia no se migra.</p>
            <p class="text-secondary small mb-0">
                Tampoco hay una SPA configurada para servirla, asi que no se puede
                mostrar aqui. Revise <code>SeePos:LegacySpaUrl</code>.
            </p>

            <p class="mt-3 mb-0"><code class="small">/@Ruta</code></p>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? Ruta { get; set; }

    private bool HayLegado =>
        !string.IsNullOrWhiteSpace(Config["SeePos:LegacySpaUrl"]);
}
