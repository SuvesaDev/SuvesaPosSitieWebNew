@using SuvesaPosSitioAplicacion.Class
@inject IContextoSesion Sesion

@* Envoltura de toda pantalla de negocio. Resuelve de una vez lo que si no se
   repetiria 78 veces: comprobar el permiso, poner el titulo, y avisar cuando la
   pantalla no esta pensada para el ancho del dispositivo.

   El permiso se comprueba por CODIGO de funcion (rediseno V2). Si la View no pasa
   Codigo, se resuelve desde el titulo (MenuSeePos.ResolverCodigo). Las pantallas
   con titulo ambiguo ("Devoluciones") deben pasar Codigo explicito. *@

@if (!_cargada)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando</span>
        </div>
    </div>
}
else if (!Sesion.PuedeVer(Codigo ?? Pantalla))
{
    <div class="alert alert-danger">
        <p class="h5 alert-heading">Sin permiso</p>
        <p class="mb-0">
            Su rol no tiene acceso a <strong>@Pantalla</strong>. Si cree que es un
            error, consulte con el administrador del sistema.
        </p>
    </div>
}
else
{
    <PageTitle>@Pantalla &mdash; SeePOS</PageTitle>

    <div class="@ClaseNivel">
        <div class="seepos-solo-escritorio-aviso alert alert-warning">
            <p class="h6 alert-heading">Pantalla de escritorio</p>
            <p class="mb-0 small">
                <strong>@Pantalla</strong> muestra demasiado dato para esta pantalla.
                Abrala desde un equipo de escritorio.
            </p>
        </div>

        <div class="seepos-solo-escritorio-contenido">
            <header class="seepos-encabezado-pagina">
                <div class="seepos-encabezado-pagina-info">
                    @if (!string.IsNullOrWhiteSpace(Icono))
                    {
                        <span class="seepos-encabezado-pagina-icono" aria-hidden="true">
                            <i class="bi @Icono"></i>
                        </span>
                    }
                    <div>
                        <h1>@Pantalla</h1>
                        @if (!string.IsNullOrWhiteSpace(Subtitulo))
                        {
                            <p class="seepos-encabezado-pagina-sub">@Subtitulo</p>
                        }
                    </div>
                </div>
                @if (Acciones is not null)
                {
                    <div class="seepos-encabezado-pagina-acciones">@Acciones</div>
                }
            </header>

            @ChildContent
        </div>
    </div>
}

@code {
    /// <summary>Titulo de la pantalla en el menu (rotulo visible).</summary>
    [Parameter, EditorRequired]
    public string Pantalla { get; set; } = default!;

    /// <summary>
    /// Codigo de funcion para el permiso (MODULO.SLUG). Opcional: si no se pasa, se
    /// resuelve desde <see cref="Pantalla"/>. Obligatorio en pantallas de titulo ambiguo.
    /// </summary>
    [Parameter] public string? Codigo { get; set; }

    /// <summary>Desde que ancho tiene sentido. Por debajo se avisa en lugar de romperse.</summary>
    [Parameter]
    public NivelPantalla Nivel { get; set; } = NivelPantalla.Escritorio;

    /// <summary>Linea de contexto bajo el titulo. Opcional.</summary>
    [Parameter] public string? Subtitulo { get; set; }

    /// <summary>Clase de Bootstrap Icons para el encabezado (p.ej. "bi-people-fill"). Opcional.</summary>
    [Parameter] public string? Icono { get; set; }

    /// <summary>Botones de la cabecera.</summary>
    [Parameter] public RenderFragment? Acciones { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _cargada;

    private string ClaseNivel => Nivel switch
    {
        NivelPantalla.Movil => "seepos-nivel-a",
        NivelPantalla.Tableta => "seepos-nivel-b",
        _ => "seepos-nivel-c"
    };

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        _cargada = true;
    }
}
