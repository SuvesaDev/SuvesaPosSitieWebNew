@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Services
@inject ICajaOperaciones Caja
@inject IManejadorRespuestas Respuestas

@if (!Desbloqueado)
{
    <div class="seepos-desbloqueo-clave alert mb-3" role="status">
        <span class="seepos-desbloqueo-clave-icono"><i class="bi bi-key-fill" aria-hidden="true"></i></span>
        <div class="flex-grow-1">
            <strong>Validación requerida</strong>
            <span>Ingrese la clave interna para activar @Titulo.</span>
        </div>
        <div class="input-group seepos-desbloqueo-clave-campo">
            <input type="password" class="form-control" placeholder="Clave interna" aria-label="Clave interna"
                   @bind="_clave" @onkeydown="AlPresionarTecla" disabled="@_validando" />
            <button type="button" class="btn btn-primary" @onclick="Validar" disabled="@(_validando || string.IsNullOrWhiteSpace(_clave))">
                @(_validando ? "Validando..." : "Activar")
            </button>
        </div>
    </div>
}
else
{
    <div class="seepos-desbloqueo-clave seepos-desbloqueo-clave-listo mb-3" role="status">
        <i class="bi bi-shield-check-fill" aria-hidden="true"></i><span>@Titulo está activado.</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = default!;
    [Parameter] public EventCallback<bool> AlCambiar { get; set; }
    public bool Desbloqueado { get; private set; }
    public Usuario? UsuarioValidado { get; private set; }
    private string _clave = string.Empty;
    private bool _validando;

    private async Task AlPresionarTecla(KeyboardEventArgs evento)
    {
        if (evento.Key == "Enter") await Validar();
    }

    private async Task Validar()
    {
        if (_validando || string.IsNullOrWhiteSpace(_clave)) return;
        _validando = true;
        var usuario = await Respuestas.DatoAsync(await Caja.ValidarClaveInterna(_clave), "validar la clave interna");
        _validando = false;
        if (usuario is null) { _clave = string.Empty; return; }
        _clave = string.Empty;
        UsuarioValidado = usuario;
        Desbloqueado = true;
        await AlCambiar.InvokeAsync(true);
    }
}
