@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Security
@inject ICajaOperaciones Caja
@inject IManejadorRespuestas Respuestas
@inject IContextoSesion Sesion

@if (!Desbloqueado)
{
    <div class="seepos-desbloqueo-clave alert mb-3" role="status">
        <span class="seepos-desbloqueo-clave-icono"><i class="bi bi-key-fill" aria-hidden="true"></i></span>
        <div class="flex-grow-1">
            <strong>Validación requerida</strong>
            <span>Ingrese la clave interna para activar @Titulo.</span>
            @if (_error is not null)
            {
                <span class="d-block text-danger mt-1"><i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>@_error</span>
            }
        </div>
        <div class="input-group seepos-desbloqueo-clave-campo">
            <input type="password" class="form-control" placeholder="Clave interna" aria-label="Clave interna"
                   @bind="_clave" @onkeydown="AlPresionarTecla" disabled="@_validando" />
            <button type="button" class="btn btn-primary" @onclick="Validar" disabled="@(_validando || string.IsNullOrWhiteSpace(_clave))">
                @(_validando ? "Validando..." : "Activar")
            </button>
        </div>
    </div>
}
else
{
    <div class="seepos-desbloqueo-clave seepos-desbloqueo-clave-listo mb-3" role="status">
        <i class="bi bi-shield-check-fill" aria-hidden="true"></i>
        <span>@Titulo está activado.@(RequiereCajaAbierta && NumApertura > 0 ? $" Cajero: {UsuarioValidado?.Nombre} · Apertura #{NumApertura}." : "")</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = default!;
    [Parameter] public EventCallback<bool> AlCambiar { get; set; }

    /// <summary>
    /// Si es true, además de validar la clave se busca la caja abierta del cajero.
    /// Sin caja abierta la pantalla NO se desbloquea y se muestra el motivo en el mismo banner.
    /// </summary>
    [Parameter] public bool RequiereCajaAbierta { get; set; }

    public bool Desbloqueado { get; private set; }
    public Usuario? UsuarioValidado { get; private set; }

    /// <summary>Apertura de caja del cajero validado (solo con <see cref="RequiereCajaAbierta"/>).</summary>
    public long NumApertura { get; private set; }

    private string _clave = string.Empty;
    private bool _validando;
    private string? _error;

    private async Task AlPresionarTecla(KeyboardEventArgs evento)
    {
        if (evento.Key == "Enter") await Validar();
    }

    private static bool CoincideNombre(string? a, string? b)
    {
        static string N(string? s) => new string((s ?? "")
            .Trim()
            .Normalize(System.Text.NormalizationForm.FormD)
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray())
            .ToUpperInvariant();
        return N(a).Length > 0 && N(a) == N(b);
    }

    private async Task Validar()
    {
        if (_validando || string.IsNullOrWhiteSpace(_clave)) return;
        _validando = true;
        _error = null;
        var usuario = await Respuestas.DatoAsync(await Caja.ValidarClaveInterna(_clave), "validar la clave interna");
        if (usuario is null) { _validando = false; _clave = string.Empty; return; }

        UsuarioValidado = usuario;
        NumApertura = 0;

        if (RequiereCajaAbierta)
        {
            var abiertas = await Respuestas.DatoAsync(await Caja.CajerosConCajaAbierta(), "consultar la caja abierta");
            // El Id de CajerosConCajaAbierta se deriva del login (no es la PK que devuelve
            // ValidarClaveInterna), así que el emparejamiento fiable es por nombre —
            // recortado, sin distinción de mayúsculas ni tildes. Se prueba contra el
            // nombre y el login del usuario validado y contra Sesion.Usuario (el login
            // con que se abrió la caja desde el sitio). El Id queda como respaldo.
            bool Calza(User c) =>
                CoincideNombre(c.Nombre, usuario.Nombre)
                || CoincideNombre(c.Nombre, usuario.IdUsuario)
                || CoincideNombre(c.Nombre, Sesion.Usuario)
                || (usuario.Id > 0 && c.Id == usuario.Id);
            var mia = abiertas?.FirstOrDefault(Calza);
            if (mia is null)
            {
                _validando = false;
                _clave = string.Empty;
                _error = "Este usuario no tiene ninguna caja abierta.";
                return;
            }
            NumApertura = mia.IdApertura;
        }

        _validando = false;
        _clave = string.Empty;
        Desbloqueado = true;
        await AlCambiar.InvokeAsync(true);
    }
}
