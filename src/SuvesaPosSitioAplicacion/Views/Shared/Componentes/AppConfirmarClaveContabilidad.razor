@using Havit.Blazor.Components.Web.Bootstrap
@using SuvesaPosSitioAplicacion.ApiConexion.ProxyInterface

@* Reautenticación única de Contabilidad (W1) — componente modal reutilizable para toda
   acción sensible del módulo (reverso, cierre, resolución de diferencia, reapertura...).
   Es un mecanismo NUEVO y SEPARADO del PIN corto de ClaveInterna que ya usa Agente/SAC
   en Ventas (decisión ya cerrada del plan Web): pide de nuevo la contraseña de Identity
   contra POST api/contabilidad/confirmar-clave (ya existente desde A1).

   Uso:
     <AppConfirmarClaveContabilidad @ref="_confirmarClave" />

     var clave = await _confirmarClave.MostrarAsync();
     if (clave is not null)
     {
         // El API no "recuerda" esta confirmación (sin sesión de reautenticación,
         // decisión ya cerrada de A1/W1) — cada acción sensible exige la contraseña
         // inline en su propio request. Por eso este componente devuelve la contraseña
         // YA verificada aquí, para que el llamador la reenvíe tal cual en el comando
         // de la acción real (ReversarAsientoDTO.Contrasena, AprobarRepolinizacionDTO.
         // Contrasena, etc.) — nunca null si el usuario canceló o falló la verificación.
     }
*@

<AppModal @ref="_modal" Titulo="Confirmar contraseña" Subtitulo="Esta acción de Contabilidad requiere reautenticación"
          Tamano="ModalSize.Regular" AlGuardar="Confirmar" Guardando="_validando"
          PuedeGuardar="!string.IsNullOrWhiteSpace(_clave)"
          TextoGuardar="Confirmar" TextoGuardando="Verificando..." IconoGuardar="bi-shield-lock"
          AlCerrar="AlCerrarModal">
    <div class="mb-2">
        <label class="form-label" for="app-confirmar-clave-contabilidad">Contraseña</label>
        <input id="app-confirmar-clave-contabilidad" type="password"
               class="form-control @(_error is not null ? "is-invalid" : "")"
               @bind="_clave" @bind:event="oninput" @onkeydown="AlPresionarTecla" autocomplete="current-password" />
        @if (_error is not null)
        {
            <div class="invalid-feedback d-block">@_error</div>
        }
    </div>
</AppModal>

@code {
    [Inject] private IContabilidad Contabilidad { get; set; } = default!;

    private AppModal _modal = default!;
    private string _clave = "";
    private bool _validando;
    private string? _error;
    private TaskCompletionSource<string?>? _pendiente;

    /// <summary>Muestra el modal y espera la confirmación. Devuelve la contraseña YA
    /// verificada contra Identity si el usuario la confirmó correctamente; null si
    /// canceló, cerró el modal, o la contraseña fue incorrecta.</summary>
    public async Task<string?> MostrarAsync()
    {
        _clave = "";
        _error = null;
        _validando = false;
        _pendiente = new TaskCompletionSource<string?>();
        await _modal.MostrarAsync();
        return await _pendiente.Task;
    }

    private async Task Confirmar()
    {
        if (string.IsNullOrWhiteSpace(_clave)) return;

        _validando = true;
        _error = null;
        var respuesta = await Contabilidad.ConfirmarClave(_clave);
        _validando = false;

        if (respuesta.Responses == true)
        {
            _pendiente?.TrySetResult(_clave);
            await _modal.OcultarAsync();
        }
        else
        {
            _error = "Contraseña incorrecta.";
        }
    }

    private async Task AlPresionarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Confirmar();
    }

    private Task AlCerrarModal()
    {
        _pendiente?.TrySetResult(null);
        return Task.CompletedTask;
    }
}
