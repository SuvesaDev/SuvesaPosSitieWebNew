@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Security
@using SuvesaPosSitioAplicacion.Services
@implements IDisposable
@inject IContextoSesion Sesion
@inject IEstadoEspacioTrabajo Espacio
@inject NavigationManager Navegacion
@inject IJSRuntime JS

@* Menu lateral. A diferencia del sistema actual, que solo filtra por permisos en la
   variante CostaPets, aqui se filtra siempre: una pantalla que el rol no puede ver
   no aparece. *@

<nav class="seepos-lateral @(Compacto ? "seepos-lateral-compacto" : "") border-end bg-body-tertiary d-flex flex-column" aria-label="Menu principal">
    <div class="seepos-lateral-marca">
        <img src="img/costavet-logo-compact.png" alt="CostaVet - Soluciones de salud veterinaria" />
        <span>Menu principal</span>
    </div>

    <ul class="seepos-lista-menu nav flex-column flex-grow-1 px-2 pb-2 mb-0">
        @foreach (var raiz in FiltroMenu.Visibles(MenuSeePos.Items, Sesion))
        {
            <li @key="raiz.Titulo" id="@IdRaiz(raiz)" class="nav-item" title="@(Compacto ? raiz.Titulo : null)">
                @if (raiz.EsGrupo)
                {
                    <button class="btn btn-link nav-link text-start w-100 d-flex align-items-center gap-2 px-2 @(ContieneRutaActiva(raiz) ? "seepos-menu-activo" : "")"
                            @onclick="() => Alternar(raiz)"
                            aria-expanded="@(Abierto(raiz.Titulo) ? "true" : "false")">
                        <i class="bi @IconoDe(raiz)" aria-hidden="true"></i>
                        <span class="seepos-menu-text flex-grow-1">@raiz.Titulo</span>
                        <i class="seepos-menu-flecha bi @(Abierto(raiz.Titulo) ? "bi-chevron-up" : "bi-chevron-down") small" aria-hidden="true"></i>
                    </button>

                    @if (!Compacto && Abierto(raiz.Titulo))
                    {
                        <ul class="seepos-menu-nivel nav flex-column border-start">
                            @foreach (var hijo in FiltroMenu.Visibles(raiz.Hijos, Sesion))
                            {
                                <RamaMenu @key="hijo.Titulo" Item="hijo" AlAbrir="Abrir" RutaActual="@RutaActual"
                                          Abierto="@(_hijoAbierto == hijo.Titulo)" AlAlternar="AlternarHijo" />
                            }
                        </ul>
                    }
                }
                else
                {
                    <button class="btn btn-link nav-link text-start w-100 d-flex align-items-center gap-2 px-2 @(EstaActiva(raiz) ? "seepos-menu-activo" : "")"
                            @onclick="() => Abrir(raiz)">
                        <i class="bi @IconoDe(raiz)" aria-hidden="true"></i>
                        <span class="seepos-menu-text">@raiz.Titulo</span>
                    </button>
                }
            </li>
        }
    </ul>

    <div class="seepos-lateral-control">
        <button type="button" class="btn seepos-lateral-control-boton w-100" @onclick="AlAlternar"
                title="@TextoAlternar" aria-label="@TextoAlternar">
            <i class="bi @IconoAlternar" aria-hidden="true"></i>
            <span class="seepos-menu-text">@TextoAlternar</span>
        </button>
    </div>
</nav>

@code {
    [Parameter] public EventCallback AlNavegar { get; set; }
    [Parameter] public EventCallback AlExpandir { get; set; }
    [Parameter] public EventCallback AlAlternar { get; set; }
    [Parameter] public bool Compacto { get; set; }
    [Parameter, EditorRequired] public string TextoAlternar { get; set; } = default!;
    [Parameter, EditorRequired] public string IconoAlternar { get; set; } = default!;

    // Acordeon: solo una raiz (y, dentro de ella, solo una rama por nivel) permanece
    // abierta a la vez. Antes cada nodo guardaba su propio estado "abierto" de forma
    // independiente (HashSet aqui, un bool por instancia en RamaMenu), asi que con
    // menus largos como Compras se podian abrir varias ramas a la vez, la lista
    // crecia sin limite y los items mas de abajo quedaban fuera de vista.
    private string? _raizAbierta;
    private string? _hijoAbierto;
    private string? _idPendienteDeMostrar;

    private string RutaActual => Navegacion.ToBaseRelativePath(Navegacion.Uri).Trim('/');

    protected override void OnInitialized() => Navegacion.LocationChanged += AlCambiarUbicacion;

    public void Dispose() => Navegacion.LocationChanged -= AlCambiarUbicacion;

    private bool Abierto(string titulo) => _raizAbierta == titulo;

    private async Task Alternar(ItemMenu item)
    {
        if (Compacto)
        {
            _raizAbierta = item.Titulo;
            _hijoAbierto = null;
            await AlExpandir.InvokeAsync();
            return;
        }

        if (_raizAbierta == item.Titulo)
        {
            _raizAbierta = null;
        }
        else
        {
            _raizAbierta = item.Titulo;
            _idPendienteDeMostrar = IdRaiz(item);
        }

        _hijoAbierto = null;
    }

    private void AlternarHijo(ItemMenu hijo)
        => _hijoAbierto = _hijoAbierto == hijo.Titulo ? null : hijo.Titulo;

    private async Task Abrir(ItemMenu item)
    {
        if (item.Ruta is null)
        {
            return;
        }

        var pestana = Espacio.Abrir(item.Titulo, item.Ruta);
        await AlNavegar.InvokeAsync();
        Navegacion.NavigateTo(pestana.Ruta);
    }

    private bool EstaActiva(ItemMenu item)
        => item.Ruta is not null
           && (RutaActual.Equals(item.Ruta.Trim('/'), StringComparison.OrdinalIgnoreCase)
               || RutaActual.StartsWith($"{item.Ruta.Trim('/')}/", StringComparison.OrdinalIgnoreCase));

    private bool ContieneRutaActiva(ItemMenu item)
        => EstaActiva(item) || item.Hijos.Any(ContieneRutaActiva);

    private static string IconoDe(ItemMenu item)
        => item.Icono ?? (item.Titulo == "Consignación" ? "bi-arrow-left-right" : "bi-circle");

    private static string IdRaiz(ItemMenu item)
        => $"seepos-menu-raiz-{item.Titulo.ToLowerInvariant().Replace(' ', '-') }";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_idPendienteDeMostrar is null)
        {
            return;
        }

        var id = _idPendienteDeMostrar;
        _idPendienteDeMostrar = null;
        var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tema.js");
        await modulo.InvokeVoidAsync("desplazarMenuAVista", id);
        await modulo.DisposeAsync();
    }

    private void AlCambiarUbicacion(object? sender, LocationChangedEventArgs args)
        => InvokeAsync(StateHasChanged);

}
