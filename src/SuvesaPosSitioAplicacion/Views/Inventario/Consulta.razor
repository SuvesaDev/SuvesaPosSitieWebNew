        if (await Respuestas.CorrectaAsync(await ArticuloBonificacion.Eliminar(bonificacion.IdConfiguracion), "quitar la bonificación"))
        {
            _bonificacionesArticulo.Remove(bonificacion);
            Dialogos.Exito("Bonificación eliminada.");
        }
    }

