    // El API entrega solo Base64; el navegador necesita un data URI para mostrarlo.
    private static string? FuenteImagen(ArticulosImagenesDTO? imagen)
    {
        if (string.IsNullOrWhiteSpace(imagen?.Imagen)) return null;
        if (imagen.Imagen.StartsWith("data:", StringComparison.OrdinalIgnoreCase)) return imagen.Imagen;
        var tipo = string.Equals(imagen.Tipo, "jpg", StringComparison.OrdinalIgnoreCase) ? "jpeg" : imagen.Tipo;
        return $"data:image/{tipo};base64,{imagen.Imagen}";
    }

    private async Task CargarImagenEditor(long codigoArticulo)
    {
        var respuesta = await Imagenes.Obtener(codigoArticulo);
        _imagenEditor = respuesta.EsCorrecta ? respuesta.Responses : null;
    }

    private async Task SeleccionarImagenEditor(InputFileChangeEventArgs evento)
    {
        var archivo = evento.File;
        const long maximo = 5 * 1024 * 1024;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size > maximo || extension is not (".jpg" or ".jpeg" or ".png" or ".webp"))
        {
            _errorImagenEditor = "La imagen debe ser JPG, PNG o WebP y no superar 5 MB.";
            return;
        }

        await using var entrada = archivo.OpenReadStream(maximo);
        await using var memoria = new MemoryStream();
        await entrada.CopyToAsync(memoria);
        _imagenEditor = new ArticulosImagenesDTO
        {
            IdImagenArticulo = _imagenEditor?.IdImagenArticulo ?? 0,
            IdInventario = _edicion?.Codigo ?? 0,
            Imagen = Convert.ToBase64String(memoria.ToArray()),
            Tipo = extension.TrimStart('.'),
            Extencion = archivo.Name
        };
        _eliminarImagenEditor = false;
        _imagenEditorModificada = true;
        _errorImagenEditor = null;
    }

    private void QuitarImagenEditor()
    {
        _idImagenEditorAEliminar = _imagenEditor?.IdImagenArticulo ?? 0;
        _eliminarImagenEditor = _idImagenEditorAEliminar > 0;
        _imagenEditor = null;
        _imagenEditorModificada = true;
        _errorImagenEditor = null;
    }

    private async Task<bool> GuardarCambiosImagen(long codigoArticulo)
    {
        if (!_imagenEditorModificada) return true;

        if (_eliminarImagenEditor)
        {
            return await Respuestas.CorrectaAsync(await Imagenes.Eliminar(_idImagenEditorAEliminar), "eliminar la imagen");
        }

        if (_imagenEditor is null) return true;

        _imagenEditor.IdInventario = codigoArticulo;
        var respuesta = _imagenEditor.IdImagenArticulo > 0
            ? await Imagenes.Actualizar(_imagenEditor)
            : await Imagenes.Guardar(_imagenEditor);
        if (!await Respuestas.CorrectaAsync(respuesta, "guardar la imagen")) return false;

        _imagenEditor = respuesta.Responses ?? _imagenEditor;
        _imagenEditorModificada = false;
        return true;
    }

    private async Task GuardarImagen(InputFileChangeEventArgs evento)
    {
        if (_elegido is null) return;
        var archivo = evento.File;
        const long maximo = 5 * 1024 * 1024;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size > maximo || extension is not (".jpg" or ".jpeg" or ".png" or ".webp")) { await Dialogos.ErrorAsync("La imagen debe ser JPG, PNG o WebP y no superar 5 MB."); return; }
        await using var entrada = archivo.OpenReadStream(maximo);
        await using var memoria = new MemoryStream();
        await entrada.CopyToAsync(memoria);
        var imagen = new ArticulosImagenesDTO
        {
            IdImagenArticulo = _imagen?.IdImagenArticulo ?? 0,
            IdInventario = _elegido.Codigo,
            Imagen = Convert.ToBase64String(memoria.ToArray()),
            Tipo = extension.TrimStart('.'),
            Extencion = archivo.Name
        };
        var respuesta = imagen.IdImagenArticulo > 0 ? await Imagenes.Actualizar(imagen) : await Imagenes.Guardar(imagen);
        if (await Respuestas.CorrectaAsync(respuesta, "guardar la imagen")) { _imagen = respuesta.Responses ?? imagen; Dialogos.Exito("Imagen guardada."); }
    }

    private async Task EliminarImagen()
    {
        if (_imagen is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea eliminar la imagen del artículo?")) return;
        if (await Respuestas.CorrectaAsync(await Imagenes.Eliminar(_imagen.IdImagenArticulo), "eliminar la imagen")) { _imagen = null; Dialogos.Exito("Imagen eliminada."); }
    }

