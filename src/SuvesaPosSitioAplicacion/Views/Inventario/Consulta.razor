    private float PrecioTarifaActual
    {
        get => _edicion is null ? 0 : _tarifaPrecio switch
        {
            "B" => _edicion.Precio_B,
            "C" => _edicion.Precio_C,
            "D" => _edicion.Precio_D,
            "P" => _edicion.Precio_Promo,
            _ => _edicion.Precio_A
        };
        set
        {
            if (_edicion is null) return;
            switch (_tarifaPrecio)
            {
                case "B": _edicion.Precio_B = value; break;
                case "C": _edicion.Precio_C = value; break;
                case "D": _edicion.Precio_D = value; break;
                case "P": _edicion.Precio_Promo = value; break;
                default: _edicion.Precio_A = value; break;
            }
        }
    }

    private decimal PrecioConImpuesto
        => Math.Round((decimal)PrecioTarifaActual * (1 + (decimal)(_edicion?.IVenta ?? 0) / 100), 2);

    private string PrecioConImpuestoTexto => PrecioConImpuesto.ToString("N2");

    /// <summary>Replica el cálculo de utilidad del inventario anterior sin usar float para operar.</summary>
    private async Task CalcularPrecio()
    {
        if (_edicion is null) return;
        var basePrecio = (decimal)_edicion.PrecioBase;
        var utilidad = (decimal)_utilidadPrecio / 100;
        if (Sesion.EsCostaPets && utilidad >= 1)
        {
            await Dialogos.ErrorAsync("La utilidad debe ser menor al 100 % para calcular el precio CostaPets.");
            return;
        }
        var precio = Sesion.EsCostaPets
            ? basePrecio / (1 - utilidad)
            : basePrecio * (1 + utilidad) + (decimal)_edicion.Fletes + (decimal)_edicion.OtrosCargos;
        PrecioTarifaActual = (float)Math.Round(precio, 2);
    }

