    private async Task GuardarBonificacionArticulo()
    {
        if (_edicion is null || _tipoBonificacionArticuloSeleccionado <= 0) return;

        _guardandoBonificacionArticulo = true;

        var configuracion = new ArticuloBonificacionConfiguracion
        {
            IdConfiguracion = _idBonificacionArticuloEnEdicion,
            IdConfiguracionBonificacion = _tipoBonificacionArticuloSeleccionado,
            IdInventario = _edicion.Codigo
        };

        var respuesta = _idBonificacionArticuloEnEdicion > 0
            ? await ArticuloBonificacion.Editar(configuracion)
            : await ArticuloBonificacion.Crear(configuracion);

        var guardada = await Respuestas.DatoAsync(respuesta, "guardar la bonificación del artículo");
        _guardandoBonificacionArticulo = false;

        if (guardada is null) return;

        if (_idBonificacionArticuloEnEdicion > 0)
        {
            var indice = _bonificacionesArticulo.FindIndex(b => b.IdConfiguracion == _idBonificacionArticuloEnEdicion);
            if (indice >= 0) _bonificacionesArticulo[indice] = guardada;
        }
        else
        {
            _bonificacionesArticulo.Add(guardada);
        }

        _tipoBonificacionArticuloSeleccionado = 0;
        _idBonificacionArticuloEnEdicion = 0;
        Dialogos.Exito("Bonificación guardada.");
    }

