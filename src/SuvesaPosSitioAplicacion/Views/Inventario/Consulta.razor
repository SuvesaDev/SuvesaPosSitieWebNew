    private async Task CargarLotesEdicion()
    {
        if (_edicion is null || _esNuevo) return;
        _lotesEdicion = (await Respuestas.DatoAsync(await Api.Lotes(_edicion.Codigo), "consultar los lotes del artículo"))?.OrderBy(x => x.Vencimiento).ToList() ?? new();
    }

    private async Task AgregarLote()
    {
        if (_edicion is null || _esNuevo || string.IsNullOrWhiteSpace(_nuevoLote) || _cantidadNuevoLote < 0)
        {
            await Dialogos.ErrorAsync("Indique un número de lote y una existencia válida.");
            return;
        }
        if (_lotesEdicion.Any(x => string.Equals(x.Lote, _nuevoLote.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            await Dialogos.ErrorAsync("Ese número de lote ya está registrado para el artículo.");
            return;
        }
        var lote = new StockLoteDTO
        {
            IdArticulo = _edicion.Codigo,
            Lote = _nuevoLote.Trim(),
            Vencimiento = _vencimientoLote,
            Cantidad = _cantidadNuevoLote,
            Activo = true
        };
        if (await Respuestas.CorrectaAsync(await Api.CrearLote(lote), "crear el lote"))
        {
            await CargarLotesEdicion();
            _nuevoLote = string.Empty;
            _vencimientoLote = DateTime.Today;
            _cantidadNuevoLote = 0;
            Dialogos.Exito("Lote agregado.");
