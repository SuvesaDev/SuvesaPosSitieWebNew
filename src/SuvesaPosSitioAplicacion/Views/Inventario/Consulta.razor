        _codigoFormula = 0;
        _insumoFormulaEtiqueta = string.Empty;
        if (_edicion is null || _esNuevo || _tipoArticulo != 3) { _formula = new(); return; }
        var r = await ProduccionApi.FormulaAsync(_edicion.Codigo);
        _formula = r.Status == DTOs.Generated.ResponseStatus._0
            ? (r.Responses ?? new List<SuvesaPosSitioAplicacion.DTOs.Produccion.FormulaComponente>())
            : new();
    }

    /// <summary>Busca artículos de tipo Materia prima (TipoArticulo == 2) para la fórmula.</summary>
    private async Task BuscarInsumoFormula()
    {
        _codigoFormula = 0;
        _insumoFormulaEtiqueta = string.Empty;
        var texto = _textoInsumoFormula?.Trim() ?? string.Empty;
        if (texto.Length < 2)
        {
            _insumosFormula = new();
            _insumoFormulaBuscado = false;
            return;
        }
        _buscandoInsumoFormula = true;
        var r = await Api.Buscar(texto);
        _buscandoInsumoFormula = false;
        _insumoFormulaBuscado = true;
        _insumosFormula = r.EsCorrecta && r.Responses is not null
            ? r.Responses
                .Where(x => x.TipoArticulo == 2
                            && x.Codigo != _edicion!.Codigo
                            && _formula.All(f => f.IdInsumo != x.Codigo))
                .Take(20)
                .ToList()
            : new();
    }

    private void ElegirInsumoFormula(InventarioDTO item)
    {
        _codigoFormula = item.Codigo;
        _insumoFormulaEtiqueta = $"{item.Cod_Articulo} — {item.Descripcion}";
        _textoInsumoFormula = item.Cod_Articulo ?? string.Empty;
        _insumosFormula = new();
        _errorFormula = null;
    }

    private async Task AgregarFormula()
    {
        _errorFormula = null;
        if (_edicion is null || _codigoFormula <= 0 || _cantidadFormula <= 0)
        {
            _errorFormula = "Busque y seleccione una materia prima e indique una cantidad válida.";
            return;
        }
        if (_codigoFormula == _edicion.Codigo || _formula.Any(x => x.IdInsumo == _codigoFormula))
        {
            _errorFormula = "El insumo ya está en la fórmula o corresponde al producto terminado.";
            return;
        }
        var insumo = await Respuestas.DatoAsync(await Api.Uno(_codigoFormula), "consultar el insumo");
        if (insumo is null)
        {
            _errorFormula = "No existe un artículo con ese código.";
            return;
        }
        if (insumo.TipoArticulo != 2)
        {
            _errorFormula = "La fórmula de un producto terminado sólo admite insumos de tipo Materia prima.";
            return;
        }
        var r = await ProduccionApi.GuardarComponenteAsync(new SuvesaPosSitioAplicacion.DTOs.Produccion.GuardarComponenteFormula
        {
            IdArticuloTerminado = _edicion.Codigo,
            IdInsumo = _codigoFormula,
            Cantidad = _cantidadFormula,
            Activo = true
        });
        if (r.Status != DTOs.Generated.ResponseStatus._0)
        {
            _errorFormula = r.CurrentException ?? r.ValidationErrors?.FirstOrDefault() ?? "No se pudo agregar el insumo a la fórmula.";
            return;
        }
        await CargarFormula();
        _cantidadFormula = 1;
        Dialogos.Exito("Insumo agregado a la fórmula.");
    }

    private async Task QuitarFormula(SuvesaPosSitioAplicacion.DTOs.Produccion.FormulaComponente item)
    {
        if (_edicion is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este insumo de la fórmula?")) return;
        var r = await ProduccionApi.GuardarComponenteAsync(new SuvesaPosSitioAplicacion.DTOs.Produccion.GuardarComponenteFormula
        {
            IdArticuloTerminado = _edicion.Codigo,
            IdInsumo = item.IdInsumo,
            Activo = false
        });
        if (r.Status != DTOs.Generated.ResponseStatus._0)
        {
            _errorFormula = r.CurrentException ?? r.ValidationErrors?.FirstOrDefault() ?? "No se pudo quitar el insumo de la fórmula.";
            return;
        }
        await CargarFormula();
        Dialogos.Exito("Insumo quitado de la fórmula.");
    }


