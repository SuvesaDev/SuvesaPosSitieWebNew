            await Dialogos.ErrorAsync("Ese número de lote ya está registrado para el artículo.");
            return;
        }
        var lote = new StockLoteDTO
        {
            IdArticulo = _edicion.Codigo,
            Lote = _nuevoLote.Trim(),
            Vencimiento = _vencimientoLote,
