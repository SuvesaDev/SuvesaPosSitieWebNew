    private async Task AgregarFormula()
    {
        if (_edicion is null || _codigoFormula <= 0 || _cantidadFormula <= 0)
        {
            await Dialogos.ErrorAsync("Indique un código y una cantidad válida para el insumo.");
            return;
        }
        if (_codigoFormula == _edicion.Codigo || _formula.Any(x => x.Codigo == _codigoFormula))
        {
            await Dialogos.ErrorAsync("El insumo ya está en la fórmula o corresponde al producto terminado.");
            return;
        }
        var insumo = await Respuestas.DatoAsync(await Api.Uno(_codigoFormula), "consultar el insumo");
        if (insumo is null)
        {
            await Dialogos.ErrorAsync("No existe un artículo con ese código.");
            return;
        }
        if (await Respuestas.CorrectaAsync(await Produccion.GuardarFormula(_edicion.Codigo, _codigoFormula, _cantidadFormula, true), "agregar el insumo a la fórmula"))
        {
            _formula = (await Respuestas.DatoAsync(await Produccion.Formula(_edicion.Codigo), "actualizar la fórmula"))?.ToList() ?? new();
            _codigoFormula = 0;
            _cantidadFormula = 1;
            _produccionDisponible = null;
            Dialogos.Exito("Insumo agregado a la fórmula.");
        }
