@page "/initial/inventory"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@using System.Text.Json
@inject IInventarioConsulta Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion
@inject IImagenesArticulo Imagenes
@inject IArticulosRelacionados Relacionados

@*  RUTA DEL MENU, no una propia.
    Esta pantalla ocupa la ruta del sistema actual, asi que a partir de aqui el menu
    llega al sitio nuevo y ya no al iframe de la SPA React.

    CONSECUENCIA: la version anterior tenia ademas EDICION, y esta es solo consulta.
    Quien necesite editar entra por la SPA React mientras dure la convivencia.
    Se cierra cuando esta pantalla incorpore el mantenimiento.
*@

@*  ARQUETIPO 02 - CONSULTA DE NIVEL A, MOVIL PRIMERO
    ==================================================
    Modelo para las ~15 pantallas de consulta de la Ola 1. Es el patron que entrega
    el acceso desde movil y tableta. Que copiar:

      1. Nivel Movil en <AppPantalla>: se abre desde 360 px, sin avisos de ancho.
      2. UNA sola consulta alimenta DOS presentaciones: tarjetas por debajo de 768 px
         y rejilla por encima. Nunca dos consultas ni dos estados.
      3. La busqueda espera a que el usuario deje de escribir. Sin eso, cada tecla
         seria una llamada al API.
      4. Solo lectura: aqui no se calcula nada, solo se formatea. Ver la nota sobre
         float mas abajo.

    Que adaptar: el proxy, los campos de la tarjeta y las columnas de la rejilla.

    NOTA SOBRE IMPORTES
    El API entrega el dinero en float (formato declarado en el propio swagger).
    En una pantalla de consulta eso solo afecta al formateo, que es inofensivo.
    En cuanto una pantalla tenga que SUMAR, hay que convertir a decimal en el borde
    y operar ahi. Nunca aritmetica en float.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Movil">
    <Acciones>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Agregar">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
            </button>
        }
    </Acciones>
    <ChildContent>

        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search"
                       class="form-control"
                       placeholder="Codigo o descripcion..."
                       aria-label="Buscar articulo"
                       value="@_texto"
                       @oninput="AlEscribir" />
            </div>
            <div class="form-text">
                Escriba al menos dos caracteres. Solo digitos busca por codigo.
            </div>
        </div>

        @if (_buscando)
        {
            <div class="d-flex justify-content-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Buscando</span>
                </div>
            </div>
        }
        else if (_resultados.Count == 0)
        {
            <div class="text-center text-secondary py-5 small">
                @(string.IsNullOrWhiteSpace(_texto)
                    ? "Escriba para buscar en el inventario."
                    : "Ningun articulo coincide con la busqueda.")
            </div>
        }
        else
        {
            <p class="text-secondary small">
                @_resultados.Count @(_resultados.Count == 1 ? "articulo" : "articulos")
            </p>

            @* Movil: tarjetas. Una tabla de siete columnas no se lee en 360 px. *@
            <div class="d-md-none d-flex flex-column gap-2">
                @foreach (var a in _resultados)
                {
                    <button type="button" class="card text-start border-0 shadow-sm p-0"
                            @onclick="() => Ver(a)">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span class="fw-semibold small">@a.Descripcion</span>
                                <span class="seepos-importe small">@Formato.Importe(a.Precio_A)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                <code class="small text-secondary">@a.Cod_Articulo</code>
                                <span class="badge @(a.Existencia > 0 ? "text-bg-light text-secondary" : "text-bg-warning")">
                                    @Formato.Cantidad(a.Existencia) en existencia
                                </span>
                            </div>
                        </div>
                    </button>
                }
            </div>

            @* Escritorio y tableta: rejilla. *@
            <div class="d-none d-md-block card">
                <div class="card-body">
                    <AppRejilla TItem="InventarioDTO" Datos="Servir" Nivel="NivelPantalla.Tableta"
                                @ref="_rejilla">
                        <Columnas>
                            <HxGridColumn TItem="InventarioDTO" HeaderText="Codigo"
                                          ItemTextSelector="a => a.Cod_Articulo"
                                          SortKeySelector="a => a.Cod_Articulo" />
                            <HxGridColumn TItem="InventarioDTO" HeaderText="Descripcion"
                                          ItemTextSelector="a => a.Descripcion"
                                          SortKeySelector="a => a.Descripcion" />
                            <HxGridColumn TItem="InventarioDTO" HeaderText="Ubicacion"
                                          ItemTextSelector="a => a.SubUbicacion" />
                            <HxGridColumn TItem="InventarioDTO" HeaderText="Existencia"
                                          ItemTextSelector="@(a => Formato.Cantidad(a.Existencia))"
                                          SortKeySelector="a => a.Existencia"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="InventarioDTO" HeaderText="Precio"
                                          ItemTextSelector="@(a => Formato.Importe(a.Precio_A))"
                                          SortKeySelector="a => a.Precio_A"
                                          HeaderCssClass="seepos-importe" ItemCssClass="seepos-importe" />
                            <HxGridColumn TItem="InventarioDTO" HeaderText="">
                                <ItemTemplate Context="a">
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => Ver(a)">Ver</button>
                                    @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                                    {
                                        <button class="btn btn-sm btn-link p-0 ms-3" @onclick="() => Editar(a)">Editar</button>
                                    }
                                </ItemTemplate>
                            </HxGridColumn>
                        </Columnas>
                    </AppRejilla>
                </div>
            </div>
        }

    </ChildContent>
</AppPantalla>

<HxOffcanvas @ref="_detalle" Title="@(_elegido?.Descripcion ?? "Articulo")" Placement="OffcanvasPlacement.End">
    <BodyTemplate>
        @if (_elegido is not null)
        {
            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Codigo</dt>
                <dd class="col-7"><code>@_elegido.Cod_Articulo</code></dd>

                <dt class="col-5 fw-normal text-secondary">Codigo de barras</dt>
                <dd class="col-7"><code>@(_elegido.Barras ?? "—")</code></dd>

                <dt class="col-5 fw-normal text-secondary">Ubicacion</dt>
                <dd class="col-7">@(_elegido.SubUbicacion ?? "—")</dd>

                <dt class="col-5 fw-normal text-secondary">Existencia</dt>
                <dd class="col-7 seepos-importe">@Formato.Cantidad(_elegido.Existencia)</dd>

                <dt class="col-5 fw-normal text-secondary">Minima</dt>
                <dd class="col-7 seepos-importe">@Formato.Cantidad(_elegido.Minima)</dd>

                <dt class="col-5 fw-normal text-secondary">Maxima</dt>
                <dd class="col-7 seepos-importe">@Formato.Cantidad(_elegido.Maxima)</dd>
            </dl>

            <hr />

            <dl class="row small mb-0">
                <dt class="col-5 fw-normal text-secondary">Precio A</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Precio_A)</dd>

                <dt class="col-5 fw-normal text-secondary">Precio B</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Precio_B)</dd>

                <dt class="col-5 fw-normal text-secondary">Precio C</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Precio_C)</dd>

                <dt class="col-5 fw-normal text-secondary">Precio D</dt>
                <dd class="col-7 seepos-importe">@Formato.Importe(_elegido.Precio_D)</dd>

                @if (_elegido.Promo_Activa)
                {
                    <dt class="col-5 fw-normal text-secondary">Promocion</dt>
                    <dd class="col-7 seepos-importe text-success">@Formato.Importe(_elegido.Precio_Promo)</dd>
                }
            </dl>

            <hr />

            <p class="small text-secondary mb-2">Lotes</p>

            @if (_cargandoLotes)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Cargando lotes</span>
                </div>
            }
            else if (_lotes.Count == 0)
            {
                <p class="small text-secondary mb-0">Este articulo no maneja lotes.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm small mb-0">
                        <thead>
                            <tr>
                                <th>Lote</th>
                                <th>Vence</th>
                                <th class="seepos-importe">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _lotes)
                            {
                                <tr class="@(Vencido(l) ? "table-warning" : null)">
                                    <td>
                                        <code>@l.Lote</code>
                                        @if (Vencido(l))
                                        {
                                            <span class="badge text-bg-warning ms-1">Vencido</span>
                                        }
                                    </td>
                                    <td>@l.Vencimiento.ToString("dd/MM/yyyy")</td>
                                    <td class="seepos-importe">@Formato.Cantidad(l.Cantidad)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_elegido.Observaciones))
            {
                <hr />
                <p class="small text-secondary mb-0">@_elegido.Observaciones</p>
            }

            <div class="d-flex gap-2 border-top pt-3 mt-3">
                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => Editar(_elegido)">Editar</button>
                }
                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                {
                    <button class="btn btn-sm @(_elegido.Inhabilitado ? "btn-outline-success" : "btn-outline-danger")"
                            @onclick="() => CambiarEstado(_elegido)">
                        @(_elegido.Inhabilitado ? "Activar" : "Desactivar")
                    </button>
                }
            </div>

            <hr />
            <h3 class="h6">Artículos relacionados</h3>
            <div class="input-group input-group-sm mb-2"><input type="number" class="form-control" placeholder="Código relacionado" @bind="_codigoRelacionado" @bind:event="onchange" /><input type="number" class="form-control" min="0.01" step="0.01" @bind="_cantidadRelacionada" @bind:event="onchange" /><button class="btn btn-outline-primary" @onclick="AgregarRelacionado">Agregar</button></div>
            @if (_relacionados.Count > 0) { <ul class="list-group list-group-flush small">@foreach (var relacionado in _relacionados) { <li class="list-group-item px-0 d-flex justify-content-between"><span>@relacionado.Descripcion · @Formato.Cantidad(relacionado.Cantidad)</span><button class="btn btn-sm btn-link text-danger p-0" @onclick="() => QuitarRelacionado(relacionado)">Quitar</button></li> }</ul> }

            <hr />
            <h3 class="h6">Imagen del artículo</h3>
            @if (_cargandoImagen)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando imagen</span></div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_imagen?.Imagen))
                {
                    <img class="img-fluid rounded border mb-2" style="max-height: 180px" src="@_imagen.Imagen" alt="Imagen de @_elegido.Descripcion" />
                    @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                    {
                        <button class="btn btn-sm btn-link text-danger d-block p-0 mb-2" @onclick="EliminarImagen">Eliminar imagen</button>
                    }
                }
                <InputFile class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" OnChange="GuardarImagen" />
                <p class="form-text mb-0">JPG, PNG o WebP; máximo 5 MB.</p>
            }
        }
    </BodyTemplate>
</HxOffcanvas>

<HxModal @ref="_modal" Title="@(_esNuevo ? "Nuevo artículo" : "Editar artículo")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formArticulo">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <AppCampoTexto Etiqueta="Código" @bind-Valor="_edicion.Cod_Articulo" Deshabilitado="@(!_esNuevo)" />
                    </div>
                    <div class="col-12 col-md-8">
                        <AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion" />
                    </div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Código de barras" @bind-Valor="_edicion.Barras" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Ubicación" @bind-Valor="_edicion.SubUbicacion" /></div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="articulo-minima">Existencia mínima</label>
                        <input id="articulo-minima" type="number" min="0" step="0.01" class="form-control" @bind="_edicion.Minima" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="articulo-maxima">Existencia máxima</label>
                        <input id="articulo-maxima" type="number" min="0" step="0.01" class="form-control" @bind="_edicion.Maxima" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="articulo-impuesto">Impuesto (%)</label>
                        <input id="articulo-impuesto" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_edicion.IVenta" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="articulo-precio-a">Precio A</label>
                        <input id="articulo-precio-a" type="number" min="0" step="0.01" class="form-control" @bind="_edicion.Precio_A" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="articulo-precio-b">Precio B</label>
                        <input id="articulo-precio-b" type="number" min="0" step="0.01" class="form-control" @bind="_edicion.Precio_B" @bind:event="onchange" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="articulo-precio-c">Precio C</label>
                        <input id="articulo-precio-c" type="number" min="0" step="0.01" class="form-control" @bind="_edicion.Precio_C" @bind:event="onchange" />
                    </div>
                    <div class="col-12">
                        <AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_edicion.Observaciones" />
                    </div>
                    <div class="col-12 d-flex flex-wrap gap-3">
                        <div class="form-check">
                            <input id="articulo-servicio" class="form-check-input" type="checkbox" @bind="_edicion.Servicio" />
                            <label class="form-check-label" for="articulo-servicio">Servicio</label>
                        </div>
                        <div class="form-check">
                            <input id="articulo-lote" class="form-check-input" type="checkbox" @bind="_edicion.Lote" />
                            <label class="form-check-label" for="articulo-lote">Maneja lotes</label>
                        </div>
                        <div class="form-check">
                            <input id="articulo-mag" class="form-check-input" type="checkbox" @bind="_edicion.Mag" />
                            <label class="form-check-label" for="articulo-mag">MAG</label>
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-1" /><h3 class="h6 mb-0">Códigos de barras alternos</h3></div>
                    <div class="col-12 col-md-7"><AppCampoTexto Etiqueta="Código de barras" @bind-Valor="_nuevoCodigoBarras" /></div>
                    <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Tarifa" @bind-Valor="_tarifaCodigoBarras" /></div>
                    <div class="col-12 col-md-2 d-grid align-self-end"><button type="button" class="btn btn-outline-primary" @onclick="AgregarCodigoBarras">Agregar</button></div>
                    @if (_edicion.CodigoBarras is { Count: > 0 })
                    {
                        <div class="col-12 table-responsive">
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Código</th><th>Tarifa</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var codigo in _edicion.CodigoBarras)
                                    {
                                        <tr>
                                            <td><code>@codigo.Descripcion</code></td><td>@codigo.Tarifa</td>
                                            <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => QuitarCodigoBarras(codigo)">Quitar</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formArticulo" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Titulo = "Inventarios";

    /// <summary>Lo que se espera desde la ultima tecla antes de consultar al API.</summary>
    private static readonly TimeSpan Espera = TimeSpan.FromMilliseconds(400);

    private AppRejilla<InventarioDTO>? _rejilla;
    private HxOffcanvas _detalle = default!;
    private HxModal _modal = default!;

    private string _texto = string.Empty;
    private List<InventarioDTO> _resultados = new();
    private InventarioDTO? _elegido;
    private bool _buscando;
    private InventarioDTO? _edicion;
    private bool _esNuevo;
    private bool _guardando;
    private ArticulosImagenesDTO? _imagen;
    private bool _cargandoImagen;
    private List<ArticulosRelacionadosDTO> _relacionados = new();
    private long? _codigoRelacionado;
    private float _cantidadRelacionada = 1;
    private string _nuevoCodigoBarras = string.Empty;
    private string _tarifaCodigoBarras = string.Empty;

    private List<StockLoteDTO> _lotes = new();
    private bool _cargandoLotes;

    private CancellationTokenSource? _pendiente;

    private async Task AlEscribir(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? string.Empty;

        // Cada tecla cancela la busqueda anterior: solo se consulta cuando el
        // usuario para. Sin esto, escribir "shampoo" serian siete llamadas.
        _pendiente?.Cancel();
        _pendiente = new CancellationTokenSource();
        var token = _pendiente.Token;

        try
        {
            await Task.Delay(Espera, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await Buscar(token);
    }

    private async Task Buscar(CancellationToken token)
    {
        _buscando = true;
        StateHasChanged();

        var r = await Api.Buscar(_texto);

        if (token.IsCancellationRequested)
        {
            return;
        }

        _resultados = (await Respuestas.DatoAsync(r, "buscar en el inventario"))
                      ?.ToList() ?? new List<InventarioDTO>();

        _buscando = false;

        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }

        StateHasChanged();
    }

    /// <summary>La rejilla sirve de lo ya consultado; no vuelve a llamar al API.</summary>
    private Task<GridDataProviderResult<InventarioDTO>> Servir(
        GridDataProviderRequest<InventarioDTO> peticion)
        => Task.FromResult(peticion.ApplyTo(_resultados));

    private async Task Ver(InventarioDTO articulo)
    {
        _elegido = articulo;
        _lotes = new List<StockLoteDTO>();
        _cargandoLotes = true;
        _imagen = null;
        _cargandoImagen = true;
        _relacionados = new List<ArticulosRelacionadosDTO>();

        await _detalle.ShowAsync();

        // Los lotes se piden aparte: la busqueda de inventario no los trae.
        _lotes = (await Respuestas.DatoAsync(await Api.Lotes(articulo.Codigo), "consultar los lotes"))
                 ?.OrderBy(l => l.Vencimiento).ToList() ?? new List<StockLoteDTO>();

        _cargandoLotes = false;
        _imagen = await Respuestas.DatoAsync(await Imagenes.Obtener(articulo.Codigo), "consultar la imagen del artículo");
        _relacionados = (await Respuestas.DatoAsync(await Relacionados.Buscar(articulo.Codigo), "consultar los artículos relacionados"))?.ToList() ?? new List<ArticulosRelacionadosDTO>();
        _cargandoImagen = false;
        StateHasChanged();
    }

    /// <summary>Un lote vencido sigue apareciendo, pero marcado: es informacion util.</summary>
    private static bool Vencido(StockLoteDTO l) => l.Vencimiento.Date < DateTime.Today;

    private async Task Agregar()
    {
        _esNuevo = true;
        _edicion = new InventarioDTO
        {
            Cod_Articulo = string.Empty,
            Descripcion = string.Empty,
            MonedaCosto = 1,
            MonedaVenta = 1,
            Estado = true,
            IdUsuarioCreacion = Sesion.Usuario
        };
        await _modal.ShowAsync();
    }

    private async Task Editar(InventarioDTO articulo)
    {
        _esNuevo = false;
        var completo = await Respuestas.DatoAsync(await Api.Uno(articulo.Codigo), "abrir el artículo");
        _edicion = Copiar(completo ?? articulo);
        _nuevoCodigoBarras = string.Empty;
        _tarifaCodigoBarras = string.Empty;
        await _modal.ShowAsync();
    }

    private async Task Guardar()
    {
        if (_edicion is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_edicion.Cod_Articulo) || string.IsNullOrWhiteSpace(_edicion.Descripcion))
        {
            await Dialogos.ErrorAsync("Código y descripción son obligatorios.");
            return;
        }

        if (!await Dialogos.ConfirmarAsync(_esNuevo ? "Se registrará el nuevo artículo." : "Se actualizarán los datos del artículo."))
        {
            return;
        }

        _edicion.IdUsuarioModificacion = Sesion.Usuario;
        _guardando = true;
        var respuesta = _esNuevo ? await Api.Crear(_edicion) : await Api.Editar(_edicion);
        _guardando = false;

        if (await Respuestas.CorrectaAsync(respuesta, _esNuevo ? "crear el artículo" : "editar el artículo"))
        {
            await _modal.HideAsync();
            Dialogos.Exito(_esNuevo ? "Artículo creado." : "Artículo actualizado.");
            await Buscar(CancellationToken.None);
        }
    }

    private async Task CambiarEstado(InventarioDTO articulo)
    {
        var activar = articulo.Inhabilitado;
        var accion = activar ? "activar" : "desactivar";
        if (!await Dialogos.ConfirmarPeligroAsync($"¿Desea {accion} {articulo.Descripcion}?"))
        {
            return;
        }

        var respuesta = await Api.CambiarEstado(new EliminarInventarioDTO
        {
            Cod_Articulo = articulo.Cod_Articulo,
            Descripcion = articulo.Descripcion,
            IdUsuarioModificacion = Sesion.Usuario
        }, activar);

        if (await Respuestas.CorrectaAsync(respuesta, $"{accion} el artículo"))
        {
            await _detalle.HideAsync();
            Dialogos.Exito(activar ? "Artículo activado." : "Artículo desactivado.");
            await Buscar(CancellationToken.None);
        }
    }

    private static InventarioDTO Copiar(InventarioDTO articulo)
        => JsonSerializer.Deserialize<InventarioDTO>(JsonSerializer.Serialize(articulo))!;

    private async Task AgregarCodigoBarras()
    {
        if (_edicion is null || string.IsNullOrWhiteSpace(_nuevoCodigoBarras))
        {
            await Dialogos.ErrorAsync("Indique el código de barras.");
            return;
        }

        if ((_edicion.CodigoBarras ?? Array.Empty<CodigoBarrasInventarioDTO>())
            .Any(c => string.Equals(c.Descripcion, _nuevoCodigoBarras, StringComparison.OrdinalIgnoreCase)))
        {
            await Dialogos.ErrorAsync("Ese código de barras ya está registrado en el artículo.");
            return;
        }

        _edicion.CodigoBarras ??= new List<CodigoBarrasInventarioDTO>();
        _edicion.CodigoBarras.Add(new CodigoBarrasInventarioDTO
        {
            IdInventario = checked((int)_edicion.Codigo),
            Descripcion = _nuevoCodigoBarras.Trim(),
            Tarifa = _tarifaCodigoBarras,
            Estado = true,
            FechaCreacion = DateTime.Now,
            IdUsuarioCreacion = Sesion.Usuario
        });
        _nuevoCodigoBarras = string.Empty;
        _tarifaCodigoBarras = string.Empty;
    }

    private async Task QuitarCodigoBarras(CodigoBarrasInventarioDTO codigo)
    {
        if (_edicion?.CodigoBarras is null
            || !await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este código de barras?"))
        {
            return;
        }

        if (codigo.IdCodigoBarrasInventario == 0)
        {
            _edicion.CodigoBarras.Remove(codigo);
            return;
        }

        if (await Respuestas.CorrectaAsync(await Api.EliminarCodigoBarras(codigo), "eliminar el código de barras"))
        {
            _edicion.CodigoBarras.Remove(codigo);
            Dialogos.Exito("Código de barras eliminado.");
        }
    }

    private async Task GuardarImagen(InputFileChangeEventArgs evento)
    {
        if (_elegido is null) return;
        var archivo = evento.File;
        const long maximo = 5 * 1024 * 1024;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size > maximo || extension is not (".jpg" or ".jpeg" or ".png" or ".webp")) { await Dialogos.ErrorAsync("La imagen debe ser JPG, PNG o WebP y no superar 5 MB."); return; }
        await using var entrada = archivo.OpenReadStream(maximo); await using var memoria = new MemoryStream(); await entrada.CopyToAsync(memoria);
        var imagen = new ArticulosImagenesDTO { IdInventario = _elegido.Codigo, Imagen = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}", Tipo = extension.TrimStart('.'), Extencion = archivo.Name };
        if (await Respuestas.CorrectaAsync(await Imagenes.Guardar(imagen), "guardar la imagen")) { _imagen = imagen; Dialogos.Exito("Imagen guardada."); }
    }

    private async Task EliminarImagen()
    {
        if (_imagen is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea eliminar la imagen del artículo?")) return;
        if (await Respuestas.CorrectaAsync(await Imagenes.Eliminar(_imagen.IdImagenArticulo), "eliminar la imagen")) { _imagen = null; Dialogos.Exito("Imagen eliminada."); }
    }

    private async Task AgregarRelacionado() { if (_elegido is null || _codigoRelacionado is not > 0 || _cantidadRelacionada <= 0) { await Dialogos.ErrorAsync("Indique un código y cantidad válidos."); return; } if (await Respuestas.CorrectaAsync(await Relacionados.Guardar(_elegido.Codigo, _codigoRelacionado.Value, _cantidadRelacionada, true), "agregar el artículo relacionado")) { _relacionados = (await Respuestas.DatoAsync(await Relacionados.Buscar(_elegido.Codigo), "consultar los artículos relacionados"))?.ToList() ?? new(); _codigoRelacionado = null; _cantidadRelacionada = 1; Dialogos.Exito("Artículo relacionado agregado."); } }
    private async Task QuitarRelacionado(ArticulosRelacionadosDTO relacionado) { if (_elegido is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este artículo relacionado?")) return; if (await Respuestas.CorrectaAsync(await Relacionados.Guardar(_elegido.Codigo, relacionado.Codigo, relacionado.Cantidad, false), "quitar el artículo relacionado")) { _relacionados.Remove(relacionado); Dialogos.Exito("Artículo relacionado quitado."); } }
}
