    private async Task QuitarFormula(ArticulosRelacionadosDTO item)
    {
        if (_edicion is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este insumo de la fórmula?")) return;
        if (await Respuestas.CorrectaAsync(await Produccion.GuardarFormula(_edicion.Codigo, item.Codigo, item.Cantidad, false), "quitar el insumo de la fórmula"))
        {
            _formula.Remove(item);
            _seleccionLotesFormula.RemoveAll(lote => lote.IdArticulo == item.Codigo);
            _produccionDisponible = null;
            Dialogos.Exito("Insumo quitado de la fórmula.");
        }
    }

    private async Task CargarLotesFormula()
    {
        _loteFormula = 0;
        _lotesFormula = _articuloLoteFormula <= 0
            ? new()
            : (await Respuestas.DatoAsync(await Api.Lotes(_articuloLoteFormula), "consultar los lotes del insumo"))?.Where(x => x.Activo != false).ToList() ?? new();
    }

    private async Task AgregarLoteFormula()
    {
        var lote = _lotesFormula.FirstOrDefault(x => x.Id == _loteFormula);
        var insumo = _formula.FirstOrDefault(x => x.Codigo == _articuloLoteFormula);
        var bodega = _bodegas.FirstOrDefault(x => x.IdBodega == _bodegaFormula);
        if (lote is null || insumo is null || bodega is null || _cantidadLoteFormula <= 0)
        {
            await Dialogos.ErrorAsync("Seleccione el insumo, lote, bodega y una cantidad válida.");
            return;
        }
        if (_cantidadLoteFormula > lote.Cantidad)
        {
            await Dialogos.ErrorAsync("La cantidad a consumir no puede exceder la disponibilidad del lote.");
            return;
        }
        if (_seleccionLotesFormula.Any(x => x.IdArticulo == insumo.Codigo && x.IdLote == lote.Id))
        {
            await Dialogos.ErrorAsync("Ese lote ya fue agregado para este insumo.");
            return;
        }
        _seleccionLotesFormula.Add(new LoteFormulaSeleccionado(insumo.Codigo, lote.Id, bodega.IdBodega, insumo.Descripcion ?? insumo.CodArticulo ?? "Insumo", lote.Lote ?? "Sin lote", bodega.NombreBodega ?? "Bodega", lote.Cantidad, _cantidadLoteFormula));
        _loteFormula = 0;
        _cantidadLoteFormula = 1;
        _produccionDisponible = null;
    }

    private bool FormulaCompleta()
        => _formula.Count > 0 && _formula.All(item => _seleccionLotesFormula.Any(lote => lote.IdArticulo == item.Codigo));

    private CalculadoraDTO SolicitudProduccion(bool convertir, int cantidad)
        => new()
        {
            IdArticuloPrincipal = _edicion!.Codigo,
            ConvertirCantidad = convertir,
            CantidadConvertir = cantidad,
            ListaDeLotes = _seleccionLotesFormula.Select(lote => new LotesCalcularDTO
            {
                IdArticulo = lote.IdArticulo,
                IdLote = lote.IdLote,
                IdBodega = lote.IdBodega,
                CantidadLote = lote.Cantidad
            }).ToList()
        };

    private async Task CalcularProduccion()
    {
        if (!FormulaCompleta())
        {
            await Dialogos.ErrorAsync("Seleccione al menos un lote para cada insumo de la fórmula.");
            return;
        }
        _produccionDisponible = await Respuestas.DatoAsync(await Produccion.Calcular(SolicitudProduccion(false, 0)), "calcular la producción disponible");
        if (_produccionDisponible is 0) await Dialogos.ErrorAsync("Los lotes seleccionados no permiten producir unidades completas.");
    }

    private async Task ConvertirProduccion()
    {
        if (_produccionDisponible is null || _cantidadConvertir <= 0 || _cantidadConvertir > _produccionDisponible)
        {
            await Dialogos.ErrorAsync("Indique una cantidad mayor que cero y no superior a la producción disponible.");
            return;
        }
        if (!await Dialogos.ConfirmarPeligroAsync($"Se convertirán {_cantidadConvertir} unidades y se descontarán los lotes seleccionados. ¿Desea continuar?")) return;
        if (await Respuestas.CorrectaAsync(await Produccion.Calcular(SolicitudProduccion(true, _cantidadConvertir)), "convertir la producción"))
        {
            _seleccionLotesFormula.Clear();
            _produccionDisponible = null;
            _cantidadConvertir = 0;
            Dialogos.Exito("Conversión registrada correctamente.");
        }
    }

    private async Task AgregarCodigoBarras()
    {
        if (_edicion is null || string.IsNullOrWhiteSpace(_nuevoCodigoBarras))
        {
            await Dialogos.ErrorAsync("Indique el código de barras.");
            return;
        }

        if ((_edicion.CodigoBarras ?? Array.Empty<CodigoBarrasInventarioDTO>())
            .Any(c => string.Equals(c.Descripcion, _nuevoCodigoBarras, StringComparison.OrdinalIgnoreCase)))
        {
            await Dialogos.ErrorAsync("Ese código de barras ya está registrado en el artículo.");
            return;
        }

        _edicion.CodigoBarras ??= new List<CodigoBarrasInventarioDTO>();
        _edicion.CodigoBarras.Add(new CodigoBarrasInventarioDTO
        {
            IdInventario = checked((int)_edicion.Codigo),
            Descripcion = _nuevoCodigoBarras.Trim(),
            Tarifa = _tarifaCodigoBarras,
            Estado = true,
            FechaCreacion = DateTime.Now,
            IdUsuarioCreacion = Sesion.Usuario
        });
        _nuevoCodigoBarras = string.Empty;
        _tarifaCodigoBarras = string.Empty;
    }

    private async Task QuitarCodigoBarras(CodigoBarrasInventarioDTO codigo)
    {
        if (_edicion?.CodigoBarras is null
            || !await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este código de barras?"))
        {
            return;
        }

        if (codigo.IdCodigoBarrasInventario == 0)
        {
            _edicion.CodigoBarras.Remove(codigo);
            return;
        }

        if (await Respuestas.CorrectaAsync(await Api.EliminarCodigoBarras(codigo), "eliminar el código de barras"))
        {
            _edicion.CodigoBarras.Remove(codigo);
            Dialogos.Exito("Código de barras eliminado.");
        }
    }

    private async Task GuardarImagen(InputFileChangeEventArgs evento)
    {
        if (_elegido is null) return;
        var archivo = evento.File;
        const long maximo = 5 * 1024 * 1024;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size > maximo || extension is not (".jpg" or ".jpeg" or ".png" or ".webp")) { await Dialogos.ErrorAsync("La imagen debe ser JPG, PNG o WebP y no superar 5 MB."); return; }
        await using var entrada = archivo.OpenReadStream(maximo); await using var memoria = new MemoryStream(); await entrada.CopyToAsync(memoria);
        var imagen = new ArticulosImagenesDTO { IdInventario = _elegido.Codigo, Imagen = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}", Tipo = extension.TrimStart('.'), Extencion = archivo.Name };
        if (await Respuestas.CorrectaAsync(await Imagenes.Guardar(imagen), "guardar la imagen")) { _imagen = imagen; Dialogos.Exito("Imagen guardada."); }
    }

    private async Task EliminarImagen()
    {
        if (_imagen is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea eliminar la imagen del artículo?")) return;
        if (await Respuestas.CorrectaAsync(await Imagenes.Eliminar(_imagen.IdImagenArticulo), "eliminar la imagen")) { _imagen = null; Dialogos.Exito("Imagen eliminada."); }
    }

    /// <summary>Lote elegido temporalmente para una conversión; no se guarda hasta confirmar.</summary>
    private sealed record LoteFormulaSeleccionado(
        long IdArticulo,
        long IdLote,
        int IdBodega,
        string Articulo,
        string Lote,
        string Bodega,
        double Disponible,
        int Cantidad);

    private async Task AgregarRelacionado() { if (_elegido is null || _codigoRelacionado is not > 0 || _cantidadRelacionada <= 0) { await Dialogos.ErrorAsync("Indique un código y cantidad válidos."); return; } if (await Respuestas.CorrectaAsync(await Relacionados.Guardar(_elegido.Codigo, _codigoRelacionado.Value, _cantidadRelacionada, true), "agregar el artículo relacionado")) { _relacionados = (await Respuestas.DatoAsync(await Relacionados.Buscar(_elegido.Codigo), "consultar los artículos relacionados"))?.ToList() ?? new(); _codigoRelacionado = null; _cantidadRelacionada = 1; Dialogos.Exito("Artículo relacionado agregado."); } }
    private async Task QuitarRelacionado(ArticulosRelacionadosDTO relacionado) { if (_elegido is null || !await Dialogos.ConfirmarPeligroAsync("¿Desea quitar este artículo relacionado?")) return; if (await Respuestas.CorrectaAsync(await Relacionados.Guardar(_elegido.Codigo, relacionado.Codigo, relacionado.Cantidad, false), "quitar el artículo relacionado")) { _relacionados.Remove(relacionado); Dialogos.Exito("Artículo relacionado quitado."); } }
}
