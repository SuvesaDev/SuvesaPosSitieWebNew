@page "/buys/warehouse-transfer"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.DTOs.Lotes
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ILotesApiCliente Api
@inject IInventarioConsulta Inventario
@inject IServicioDialogos Dialogos
@inject SuvesaPosSitioAplicacion.Security.IContextoSesion Sesion

@*  Traslado de existencias entre bodegas del MISMO centro
    (BODEGAS_POR_CENTRO_Y_TRASLADOS_WEB.md §3.4). Origen y destino sólo listan
    bodegas del centro de la sesión; no hay traslado inter-centro. *@

<AppPantalla Pantalla="Traslado entre bodegas" Codigo="COMPRAS.TRASLADO_ENTRE_BODEGAS" Icono="bi-arrow-left-right"
             Subtitulo="Pasar existencias de una bodega a otra del mismo centro" Nivel="NivelPantalla.Tableta">
 <ChildContent>
  @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }

  <div class="card mb-3"><div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-md-4"><label class="form-label">Bodega de origen <span class="text-danger">*</span></label>
        <select class="form-select" @bind="_origen">
          <option value="0">Seleccione...</option>
          @foreach (var b in _bodegas) { <option value="@b.IdBodega">@b.NombreBodega</option> }
        </select></div>
      <div class="col-md-4"><label class="form-label">Bodega de destino <span class="text-danger">*</span></label>
        <select class="form-select" @bind="_destino">
          <option value="0">Seleccione...</option>
          @foreach (var b in _bodegas.Where(b => b.IdBodega != _origen)) { <option value="@b.IdBodega">@b.NombreBodega</option> }
        </select></div>
      <div class="col-md-4"><label class="form-label">Documento / referencia</label><input class="form-control" @bind="_documento" /></div>
    </div>
    <p class="form-text mb-0">Sólo bodegas del centro actual. El traslado entre centros distintos no está permitido.</p>
  </div></div>

  @if (_origen > 0 && _destino > 0)
  {
    <div class="card mb-3"><div class="card-header">Artículos a trasladar</div><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-md-5 position-relative">
          <label class="form-label">Artículo</label>
          <input class="form-control" @bind="_texArt" @bind:event="oninput" @bind:after="BuscarArt" placeholder="Código o descripción" />
          @if (_arts.Count > 0)
          {
            <div class="list-group position-absolute shadow w-100" style="z-index:5; max-height:14rem; overflow-y:auto;">
              @foreach (var a in _arts) { <button type="button" class="list-group-item list-group-item-action" @onclick="() => ElegirArt(a)"><strong>@a.Cod_Articulo</strong> @a.Descripcion</button> }
            </div>
          }
        </div>
        <div class="col-md-3"><label class="form-label">Lote</label>
          <select class="form-select" @bind="_loteSel"><option value="0">Sin lote</option>@foreach (var l in _lotes){<option value="@l.Id">@l.Numero</option>}</select></div>
        <div class="col-md-2"><label class="form-label">Cantidad</label><input type="number" min="0.001" step="0.001" class="form-control" @bind="_cant" /></div>
        <div class="col-md-2 d-grid"><button class="btn btn-outline-primary" @onclick="AgregarLinea" disabled="@(_artSel is null || _cant <= 0)">Agregar</button></div>
      </div>

      <table class="table table-sm mt-3">
        <thead><tr><th>Artículo</th><th>Lote</th><th class="text-end">Cantidad</th><th></th></tr></thead>
        <tbody>
          @foreach (var l in _lineas)
          {
            <tr><td><code>@l.CodArticulo</code> @l.Descripcion</td><td>@l.NumeroLote</td><td class="text-end">@l.Cantidad.ToString("N3")</td>
              <td class="text-end"><button class="btn btn-sm btn-link text-danger" @onclick="() => _lineas.Remove(l)">Quitar</button></td></tr>
          }
          @if (!_lineas.Any()) { <tr><td colspan="4" class="text-secondary">Aún no hay líneas.</td></tr> }
        </tbody>
      </table>

      <div class="row g-2 align-items-end">
        <div class="col-md-6"><label class="form-label">Motivo / observaciones</label><input class="form-control" @bind="_motivo" /></div>
        <div class="col-md-3 offset-md-3 d-grid"><button class="btn btn-primary" @onclick="Registrar" disabled="@(!_lineas.Any() || _guardando)">@(_guardando ? "Registrando..." : "Registrar traslado")</button></div>
      </div>
    </div></div>
  }

  @if (_hecho is not null)
  {
    <div class="card mb-3"><div class="card-header text-bg-success">Traslado #@_hecho.Id · @_hecho.NombreBodegaOrigen → @_hecho.NombreBodegaDestino · costo @_hecho.CostoTotal.ToString("N2")</div>
      <div class="card-body"><table class="table table-sm mb-0">
        <thead><tr><th>Artículo</th><th>Lote</th><th class="text-end">Cantidad</th></tr></thead>
        <tbody>@foreach (var l in _hecho.Lineas){<tr><td><code>@l.CodArticulo</code> @l.Descripcion</td><td>@l.NumeroLote</td><td class="text-end">@l.Cantidad.ToString("N3")</td></tr>}</tbody>
      </table></div></div>
  }

  <div class="card"><div class="card-header d-flex justify-content-between align-items-center">
    <span>Traslados recientes</span>
    <button class="btn btn-sm btn-outline-secondary" @onclick="CargarRecientes">Refrescar</button>
  </div><div class="card-body p-0">
    <table class="table table-sm mb-0">
      <thead><tr><th>#</th><th>Fecha</th><th>Origen → Destino</th><th class="text-end">Líneas</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        @foreach (var t in _recientes)
        {
          <tr class="@(t.Estado == 2 ? "text-secondary" : null)">
            <td>@t.Id</td><td>@t.Fecha.ToString("dd/MM/yy HH:mm")</td>
            <td>@t.NombreBodegaOrigen → @t.NombreBodegaDestino</td>
            <td class="text-end">@t.CantidadLineas</td>
            <td>@t.EstadoDescripcion</td>
            <td class="text-end">
              <button class="btn btn-sm btn-link p-0" @onclick="() => Ver(t.Id)">Ver</button>
              @if (t.Estado != 2) { <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => AbrirAnular(t.Id)">Anular</button> }
            </td>
          </tr>
        }
        @if (!_recientes.Any()) { <tr><td colspan="6" class="text-secondary">Sin traslados.</td></tr> }
      </tbody>
    </table>
  </div></div>
 </ChildContent>
</AppPantalla>

<HxModal @ref="_modalAnular" Title="Anular traslado">
 <BodyTemplate>
  <label class="form-label">Motivo <span class="text-danger">*</span></label>
  <textarea class="form-control" @bind="_motivoAnular"></textarea>
 </BodyTemplate>
 <FooterTemplate>
  <button class="btn btn-secondary" @onclick="() => _modalAnular.HideAsync()">Cancelar</button>
  <button class="btn btn-danger" @onclick="ConfirmarAnular">Anular</button>
 </FooterTemplate>
</HxModal>

@code {
 private List<BodegaOperativa> _bodegas = new();
 private int _origen, _destino;
 private string _documento = "", _motivo = "", _texArt = "", _error = "";
 private List<InventarioDTO> _arts = new();
 private InventarioDTO? _artSel;
 private List<LoteExistencia> _lotes = new();
 private long _loteSel;
 private double _cant = 1;
 private bool _guardando;
 private readonly List<TrasladoBodegaLinea> _lineas = new();
 private TrasladoBodega? _hecho;
 private List<TrasladoBodegaResumen> _recientes = new();
 private HxModal _modalAnular = default!;
 private long _idAnular;
 private string _motivoAnular = "";

 protected override async Task OnInitializedAsync()
 {
     var r = await Api.BodegasOperativasAsync(Sesion.IdSucursal > 0 ? Sesion.IdSucursal : null);
     _bodegas = r.Status == ResponseStatus._0 ? (r.Responses ?? new()) : new();
     await CargarRecientes();
 }

 private static bool Ok<T>(LoteEnvelope<T> r) => r.Status == ResponseStatus._0 && r.Responses is not null;

 private async Task Fallo<T>(LoteEnvelope<T> r, string alterno)
 {
     _error = r.CurrentException ?? r.ValidationErrors?.FirstOrDefault() ?? alterno;
     await Dialogos.ErrorAsync(_error);
 }

 private async Task BuscarArt()
 {
     var t = _texArt?.Trim() ?? "";
     _artSel = null;
     if (t.Length < 2) { _arts = new(); return; }
     var r = await Inventario.Buscar(t);
     _arts = r.EsCorrecta ? (r.Responses ?? new List<InventarioDTO>()).Take(20).ToList() : new();
 }

 private async Task ElegirArt(InventarioDTO a)
 {
     _artSel = a; _texArt = $"{a.Cod_Articulo} — {a.Descripcion}"; _arts = new(); _loteSel = 0; _lotes = new();
     var r = await Api.ExistenciaConsolidadaAsync(a.Codigo);
     if (Ok(r)) _lotes = (r.Responses?.Lotes ?? new()).Where(l => !l.Vencido && !l.Bloqueado).ToList();
 }

 private void AgregarLinea()
 {
     if (_artSel is null || _cant <= 0) return;
     if (_lineas.Any(x => x.IdArticulo == _artSel.Codigo && x.IdStockLote == (_loteSel > 0 ? _loteSel : null)))
     { _ = Dialogos.ErrorAsync("Ese artículo/lote ya está en la lista."); return; }
     _lineas.Add(new TrasladoBodegaLinea
     {
         IdArticulo = _artSel.Codigo,
         CodArticulo = _artSel.Cod_Articulo ?? "",
         Descripcion = _artSel.Descripcion ?? "",
         IdStockLote = _loteSel > 0 ? _loteSel : null,
         NumeroLote = _loteSel > 0 ? _lotes.FirstOrDefault(l => l.Id == _loteSel)?.Numero : null,
         Cantidad = _cant
     });
     _artSel = null; _texArt = ""; _loteSel = 0; _lotes = new(); _cant = 1;
 }

 private async Task Registrar()
 {
     if (!_lineas.Any()) return;
     if (_origen == _destino) { await Dialogos.ErrorAsync("El origen y el destino deben ser distintos."); return; }
     _error = ""; _guardando = true;
     var r = await Api.TrasladoRegistrarAsync(new TrasladoBodegaRequest
     {
         IdBodegaOrigen = _origen,
         IdBodegaDestino = _destino,
         Documento = string.IsNullOrWhiteSpace(_documento) ? null : _documento.Trim(),
         Motivo = string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim(),
         Lineas = _lineas.Select(l => new TrasladoBodegaLineaEntrada { IdArticulo = l.IdArticulo, IdStockLote = l.IdStockLote, Cantidad = l.Cantidad }).ToList()
     });
     _guardando = false;
     if (!Ok(r)) { await Fallo(r, "No se pudo registrar el traslado."); return; }
     _hecho = r.Responses;
     _lineas.Clear(); _documento = ""; _motivo = "";
     Dialogos.Exito($"Traslado #{_hecho!.Id} registrado.");
     await CargarRecientes();
 }

 private async Task CargarRecientes()
 {
     var r = await Api.TrasladoListarAsync(new TrasladoBodegaFiltro { IdSucursal = Sesion.IdSucursal > 0 ? Sesion.IdSucursal : null, Tope = 50 });
     _recientes = r.Status == ResponseStatus._0 ? (r.Responses ?? new()) : new();
 }

 private async Task Ver(long id)
 {
     var r = await Api.TrasladoObtenerAsync(id);
     if (Ok(r)) _hecho = r.Responses;
     else await Fallo(r, "No se pudo abrir el traslado.");
 }

 private async Task AbrirAnular(long id) { _idAnular = id; _motivoAnular = ""; await _modalAnular.ShowAsync(); }

 private async Task ConfirmarAnular()
 {
     if (string.IsNullOrWhiteSpace(_motivoAnular)) { await Dialogos.ErrorAsync("Indique el motivo."); return; }
     var r = await Api.TrasladoAnularAsync(new AnularTrasladoBodega { Id = _idAnular, Motivo = _motivoAnular.Trim() });
     if (Ok(r)) { await _modalAnular.HideAsync(); _hecho = r.Responses; Dialogos.Exito("Traslado anulado."); await CargarRecientes(); }
     else await Fallo(r, "No se pudo anular el traslado.");
 }
}
