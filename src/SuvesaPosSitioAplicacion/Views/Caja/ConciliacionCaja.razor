@page "/initial/cash/reconciliation"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Caja
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IConciliacionCaja Api
@inject ICajaOperaciones CajaApi
@inject IInstrumentosConfirmacion InstrumentosApi
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Codigo="CAJA.CONCILIACION" Nivel="NivelPantalla.Tableta"
             Subtitulo="Saldo esperado por forma de pago y moneda, calculado desde el mayor de caja (no desde documentos fiscales).">
    <ChildContent>
        <AppDesbloqueoClave @ref="_bloqueo" Titulo="la conciliación y cierre de caja" AlCambiar="AlDesbloquear" />
        <fieldset disabled="@Bloqueada" class="border-0 p-0 m-0">
        <div class="card mb-3">
            <div class="card-body row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label small">Apertura</label>
                    <select class="form-select form-select-sm" @bind="_napertura" @bind:after="Cargar">
                        <option value="0">— Seleccione —</option>
                        @foreach (var a in _aperturas)
                        {
                            <option value="@a.Napertura">
                                N.º @a.Napertura — @a.Nombre (caja @a.NumCaja) @a.Fecha
                            </option>
                        }
                    </select>
                    <div class="form-text">Sólo aperturas sin cerrar.</div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Cargar" disabled="@(_napertura <= 0 || _cargando)">
                        <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                    </button>
                </div>
            </div>
        </div>

        @if (_cargando)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (_datos is not null)
        {
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-secondary small text-uppercase">Fondo inicial</div>
                        <div class="fs-5">@Money(_datos.FondoInicial)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-secondary small text-uppercase">Total esperado</div>
                        <div class="fs-5 fw-semibold">@Money(_datos.TotalEsperado)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-secondary small text-uppercase">Estado</div>
                        <div class="fs-5">@EstadoTexto(_datos.Estado)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 h-100 bg-light">
                        <div class="text-secondary small text-uppercase">Ventas del período</div>
                        <div class="fs-6">@Money(_datos.VentasComercialInformativo)</div>
                        <div class="form-text">Informativo. No entra en la fórmula.</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-secondary small text-uppercase">Total cajero (arqueo)</div>
                        @if (_datos.TieneArqueo)
                        {
                            <div class="fs-5">@Money(_datos.TotalCajero!.Value)</div>
                        }
                        else
                        {
                            <div class="fs-6 text-secondary">Sin arqueo</div>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 h-100 @(_datos.Diferencia is { } d && Math.Abs(d) > 0.009m ? "border-danger" : null)">
                        <div class="text-secondary small text-uppercase">Diferencia</div>
                        @if (_datos.Diferencia is { } dif)
                        {
                            <div class="fs-5 fw-semibold @(Math.Abs(dif) <= 0.009m ? "text-success" : dif < 0 ? "text-danger" : "text-warning")">
                                @Money(dif)
                            </div>
                            <div class="form-text">@(Math.Abs(dif) <= 0.009m ? "Cuadra" : dif < 0 ? "Faltante" : "Sobrante")</div>
                        }
                        else
                        {
                            <div class="fs-6 text-secondary">—</div>
                            <div class="form-text">Requiere arqueo</div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 mb-3">
                @if (_instrumentos?.TienePendientes == true)
                {
                    <div class="alert alert-warning w-100 mb-0"><strong>Conciliación pendiente.</strong> Hay @Money(_instrumentos.Pendientes) en depósitos y @Money(_instrumentos.ChequesPendientes) en cheques por confirmar. Puede realizar el cierre operativo, pero no la conciliación final.</div>
                }
                @if (_datos.Estado is "A" or "M")
                {
                    <button class="btn btn-danger" @onclick="Cerrar" disabled="@(_cerrando || _instrumentos?.TienePendientes == true)">
                        <i class="bi bi-lock-fill me-1"></i>@(_cerrando ? "Cerrando..." : "Cerrar caja con este total")
                    </button>
                    <span class="form-text mb-0">
                        Registra el cierre con <strong>@Money(_datos.TotalEsperado)</strong> como total de sistema. Idempotente.
                    </span>
                }
                else
                {
                    <span class="badge text-bg-secondary">@EstadoTexto(_datos.Estado)</span>
                    <span class="form-text mb-0">La apertura ya no se puede cerrar.</span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Forma de pago</th>
                            <th class="text-center">Moneda</th>
                            <th class="text-end">Ingresos</th>
                            <th class="text-end">Egresos</th>
                            <th class="text-end">Saldo esperado</th>
                            <th class="text-center">Movs.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _datos.Lineas)
                        {
                            <tr>
                                <td>@l.CodigoFormaPago</td>
                                <td class="text-center">@MonedaTexto(l.CodMoneda)</td>
                                <td class="text-end">@Money(l.Ingresos)</td>
                                <td class="text-end">@Money(l.Egresos)</td>
                                <td class="text-end fw-semibold">@Money(l.SaldoEsperado)</td>
                                <td class="text-center">@l.Movimientos</td>
                            </tr>
                        }
                        @if (_datos.Lineas.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">Sin movimientos de caja para esta apertura.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="border-top">
                            <th colspan="4" class="text-end">Fondo inicial + saldos</th>
                            <th class="text-end">@Money(_datos.TotalEsperado)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="card mt-3">
                <div class="card-header"><strong>Documentos del sistema</strong><span class="text-secondary small ms-2">Lo que el sistema registró durante esta apertura, para comparar.</span></div>
                @if (_documentos.Count == 0)
                {
                    <div class="card-body"><p class="text-secondary small mb-0">Sin documentos registrados en esta apertura.</p></div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 18rem; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="sticky-top bg-body"><tr><th>Factura</th><th>Tipo</th><th>Moneda</th><th>Forma de pago</th><th class="text-end">Pago</th></tr></thead>
                            <tbody>
                                @foreach (var doc in _documentos)
                                {
                                    <tr><td>@doc.Factura</td><td>@doc.Tipo</td><td>@doc.Moneda</td><td>@doc.FormaPago</td><td class="text-end">@Money((decimal)doc.Pago)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        </fieldset>
    </ChildContent>
</AppPantalla>
