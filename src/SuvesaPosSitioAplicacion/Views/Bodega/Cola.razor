@page "/bodega/cola"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Bodega
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.Services
@inject IAlistamientoApiCliente Api
@inject NavigationManager Nav
@inject IServicioDialogos Dialogos
@inject IJSRuntime JS
@inject IContextoSesion Sesion
@inject IConfiguration Config

<AppPantalla Pantalla="Cola de alistamiento" Codigo="BODEGA.COLA_DE_ALISTAMIENTO" Icono="bi-list-check"
             Subtitulo="Al emitir la venta o la preventa entra sola, de cualquier serie. Solo la serie de Ferias no entra." Nivel="NivelPantalla.Tableta">
 <Acciones>
  <button class="btn btn-sm btn-outline-secondary" @onclick="Cargar">Actualizar</button>
 </Acciones>
 <ChildContent>
  @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
  @if (!string.IsNullOrWhiteSpace(_aviso)) { <div class="alert alert-success">@_aviso</div> }

  <div class="card mb-3"><div class="card-body row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label">Buscar</label>
      <input class="form-control" @bind="_texto" @bind:event="onchange" placeholder="Cliente o factura" /></div>
    <div class="col-md-2"><label class="form-label">Estado</label>
      <select class="form-select" @bind="_estado">
        <option value="0">Abiertos y en curso</option>
        <option value="1">Pendiente</option>
        <option value="2">En alistamiento</option>
        <option value="3">Empacado</option>
        <option value="4">En ruta</option>
        <option value="5">Entregado</option>
        <option value="6">No entregado</option>
      </select></div>
    <div class="col-md-2"><label class="form-label">Tipo</label>
      <select class="form-select" @bind="_tipo">
        <option value="0">Todos</option>
        <option value="1">Preventa</option>
        <option value="2">Crédito</option>
        <option value="3">Contado</option>
      </select></div>
    <div class="col-md-2"><label class="form-label">Prioridad</label>
      <select class="form-select" @bind="_prioridad">
        <option value="-1">Todas</option>
        <option value="1">Alta (crédito)</option>
        <option value="0">Normal</option>
      </select></div>
    <div class="col-md-2"><label class="form-label">Documento</label>
      <select class="form-select" @bind="_documento">
        <option value="0">Todos</option>
        <option value="1">Factura</option>
        <option value="2">Tiquete</option>
      </select></div>
    <div class="col-md-2 d-grid"><button class="btn btn-primary" @onclick="Cargar">Filtrar</button></div>
    <div class="col-md-3"><label class="form-label">Traer factura</label>
      <div class="input-group">
        <input class="form-control" @bind="_idVenta" placeholder="Número o id" />
        <button class="btn btn-outline-primary" @onclick="Forzar">Crear</button>
      </div></div>
  </div></div>

  <div class="card"><div class="table-responsive"><table class="table table-sm align-middle mb-0">
    <thead><tr><th>Hora</th><th>Espera</th><th>Pri.</th><th>Documento</th><th>Cliente</th><th>Estado</th><th class="text-end">Avance</th><th></th></tr></thead>
    <tbody>
      @foreach (var o in Visibles)
      {
        <tr>
          <td>@o.Fecha.ToString("HH:mm")</td>
          <td><span class="badge @ClaseEspera(o)" title="@TituloEspera(o)">@TextoEspera(o)</span></td>
          <td>@(o.Prioridad >= 2 ? "Alta" : "—")</td>
          <td><code>@o.NumeroDocumento</code> @(o.EsTiquete ? "tiquete " : "")@(o.EsPreventa ? "preventa" : o.EsCredito ? "crédito" : "contado")</td>
          <td>@o.NombreCliente</td>
          <td><span class="badge @Badge(o.Estado)">@o.EstadoDescripcion</span></td>
          <td class="text-end">@o.LineasCompletas / @o.Lineas · @o.CantidadAlistada.ToString("N2") / @o.CantidadFacturada.ToString("N2")</td>
          <td class="text-end">
            @if (o.Estado is 1 or 2)
            {
              <button class="btn btn-sm btn-primary" @onclick="() => Empacar(o.Id)">Empacar</button>
              <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Anular(o.Id)">Anular</button>
            }
            else
            {
              <button class="btn btn-sm btn-outline-secondary" @onclick="() => Empacar(o.Id)">Ver</button>
            }
          </td>
        </tr>
      }
      @if (!Visibles.Any()) { <tr><td colspan="8" class="text-secondary">No hay órdenes en cola. Al facturar o guardar una preventa aparecen aquí.</td></tr> }
    </tbody>
  </table></div></div>
 </ChildContent>
</AppPantalla>

@code {
 private List<AlistamientoResumen> _cola = new();
 private readonly HashSet<long> _vistos = new();
 private string _error = "", _texto = "", _idVenta = "", _aviso = "";
 private int _estado, _tipo, _prioridad = -1, _documento;
 private PeriodicTimer? _timer;
 private CancellationTokenSource? _cts;
 private IJSObjectReference? _js;

 private IEnumerable<AlistamientoResumen> Visibles => _tipo switch
 {
     1 => _cola.Where(o => o.EsPreventa),
     2 => _cola.Where(o => o.EsCredito && !o.EsPreventa),
     3 => _cola.Where(o => !o.EsCredito && !o.EsPreventa),
     _ => _cola
 };

 protected override async Task OnInitializedAsync()
 {
     await Cargar();
     _cts = new CancellationTokenSource();
     _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
     _ = Poll(_cts.Token);
 }

 private async Task Poll(CancellationToken ct)
 {
     try
     {
         while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
         {
             await Cargar();
             await InvokeAsync(StateHasChanged);
         }
     }
     catch (OperationCanceledException) { }
 }

 private async Task Cargar()
 {
     _error = "";
     var r = await Api.ColaAsync(new AlistamientoFiltro
     {
         Estado = _estado == 0 ? null : _estado,
         Texto = string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(),
         IdSucursal = Sesion.IdSucursal > 0 ? Sesion.IdSucursal : null,
         Prioridad = _prioridad < 0 ? null : _prioridad,
         EsTiquete = _documento == 0 ? null : _documento == 2
     });
     if (r.Status != ResponseStatus._0) { _error = r.CurrentException ?? "No se pudo cargar la cola."; return; }
     var lista = r.Responses ?? new();
     if (_vistos.Count > 0)
     {
         var nuevas = lista.Where(o => !_vistos.Contains(o.Id)).ToList();
         if (nuevas.Count > 0)
         {
             _aviso = "Pendiente de alistamiento: " + string.Join(" · ", nuevas.Select(n => $"{n.NumeroDocumento} {n.NombreCliente}"));
             _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bodega.js");
             await _js.InvokeVoidAsync("avisarNuevo");
         }
     }
     foreach (var o in lista) _vistos.Add(o.Id);
     _cola = lista;
 }

 private async Task Forzar()
 {
     var texto = _idVenta.Trim();
     if (texto.Length == 0)
     {
         await Dialogos.ErrorAsync("Indique el número de factura o el id de la venta.");
         return;
     }
     long.TryParse(texto, out var id);
     var r = await Api.AsegurarAsync(id, true, texto);
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo crear la orden."); return; }
     Nav.NavigateTo($"/bodega/empaque/{r.Responses!.Id}");
 }

 private async Task Anular(long id)
 {
     if (!await Dialogos.ConfirmarPeligroAsync("¿Anular esta orden de alistamiento? La factura no se toca.")) return;
     var r = await Api.AnularAsync(id, "Anulada en cola de bodega");
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo anular."); return; }
     await Cargar();
 }

 private void Empacar(long id) => Nav.NavigateTo($"/bodega/empaque/{id}");

 // Tiempo desde la facturación hasta que bodega inicia el alistamiento (o hasta ahora si sigue pendiente).
 // Umbrales en minutos: SeePos:Alistamiento:MinutosAmarillo (5) y MinutosRojo (15).
 private TimeSpan Espera(AlistamientoResumen o) => (o.FechaAceptacion ?? DateTime.Now) - o.Fecha;
 private int MinutosAmarillo => Config.GetValue("SeePos:Alistamiento:MinutosAmarillo", 5);
 private int MinutosRojo => Config.GetValue("SeePos:Alistamiento:MinutosRojo", 15);
 private static string TextoEspera(TimeSpan t)
     => t.TotalHours >= 1 ? $"{(int)t.TotalHours} h {t.Minutes} min" : $"{Math.Max(0, (int)t.TotalMinutes)} min";
 private string TextoEspera(AlistamientoResumen o) => TextoEspera(Espera(o));
 private string TituloEspera(AlistamientoResumen o) => o.FechaAceptacion is null ? "Esperando que bodega inicie el alistamiento" : "Tiempo que tardó bodega en iniciar el alistamiento";
 private string ClaseEspera(AlistamientoResumen o)
 {
     if (o.Estado != 1 && o.FechaAceptacion is null) return "text-bg-light";
     var min = Espera(o).TotalMinutes;
     return min >= MinutosRojo ? "text-bg-danger" : min >= MinutosAmarillo ? "text-bg-warning" : "text-bg-success";
 }

 private static string Badge(int e) => e switch
 {
     1 => "text-bg-warning",
     2 => "text-bg-primary",
     3 => "text-bg-info",
     4 => "text-bg-secondary",
     5 => "text-bg-success",
     6 => "text-bg-dark",
     _ => "text-bg-light"
 };

 public void Dispose()
 {
     _cts?.Cancel();
     _timer?.Dispose();
     _cts?.Dispose();
     _ = DisposeJs();
 }

 private async Task DisposeJs()
 {
     if (_js is not null) await _js.DisposeAsync();
 }
}
