@page "/bodega/despacho"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SuvesaPosSitioAplicacion.ApiConexion
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Bodega
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.Services
@inject IAlistamientoApiCliente Api
@inject IServicioDialogos Dialogos
@inject IJSRuntime JS
@inject IContextoSesion Sesion

<AppPantalla Pantalla="Despacho" Codigo="BODEGA.DESPACHO" Icono="bi-truck"
             Subtitulo="Arme el manifiesto con bultos empacados, escanee al camión y salga a ruta." Nivel="NivelPantalla.Escritorio">
 <ChildContent>
  @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card mb-3"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>Bultos empacados sin manifiesto</span>
          @if (RutaElegida is { Zonas.Count: > 0 })
          {
            <div class="form-check mb-0">
              <input id="solo-zona" class="form-check-input" type="checkbox" @bind="_soloZona" />
              <label class="form-check-label small" for="solo-zona">Solo bultos de la ruta «@RutaElegida.Nombre»</label>
            </div>
          }
        </div>
        <div class="list-group list-group-flush">
          @foreach (var b in BultosVisibles)
          {
            <label class="list-group-item d-flex gap-2 align-items-center">
              <input class="form-check-input" type="checkbox" checked="@_elegidos.Contains(b.Id)" @onchange="e => Toggle(b.Id, e)" />
              <span>
                <code>@b.Codigo</code> @b.NombreCliente · factura @b.NumeroDocumento
                <span class="d-block small text-secondary">@(string.IsNullOrWhiteSpace(b.Zona) ? "Sin zona en la ficha del cliente" : b.Zona)@(string.IsNullOrWhiteSpace(b.DireccionCliente) ? "" : " · " + b.DireccionCliente)</span>
                @if (RutaElegida is { Zonas.Count: > 0 } && _elegidos.Contains(b.Id) && !RutaElegida.CubreA(b))
                {
                  <span class="badge text-bg-warning">Fuera de las zonas de la ruta</span>
                }
              </span>
            </label>
          }
          @if (_bultos.Count == 0) { <div class="list-group-item text-secondary">No hay bultos listos.</div> }
          else if (!BultosVisibles.Any()) { <div class="list-group-item text-secondary">Ningún bulto listo cae en las zonas de esta ruta.</div> }
        </div>
        <div class="card-body row g-2 align-items-end">
          <div class="col-md-4"><label class="form-label" for="despacho-ruta">Ruta <span class="text-danger">*</span></label>
            <select id="despacho-ruta" class="form-select" @bind="_idRuta">
              <option value="0">@(_rutas.Count == 0 ? "No hay rutas activas" : "Seleccione...")</option>
              @foreach (var r in _rutas) { <option value="@r.Id">@r.Nombre</option> }
            </select>
            @if (_rutas.Count == 0) { <div class="form-text text-danger">Pida al encargado de bodega que cree una ruta de despacho.</div> }</div>
          <div class="col-md-4"><label class="form-label">Vehículo</label>
            <select class="form-select" @bind="_idVehiculo">
              <option value="0">—</option>
              @foreach (var v in _vehiculos) { <option value="@v.Id">@v.Placa</option> }
            </select></div>
          <div class="col-md-4"><label class="form-label">Chofer</label>
            <select class="form-select" @bind="_idChofer">
              <option value="0">—</option>
              @foreach (var c in _choferes) { <option value="@c.Id">@c.Nombre</option> }
            </select></div>
          <div class="col-12 d-grid"><button class="btn btn-primary" @onclick="Crear" disabled="@(_elegidos.Count == 0 || _idRuta == 0)">Crear manifiesto</button></div>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      @if (_actual is not null)
      {
        <div class="card mb-3"><div class="card-header">Manifiesto @_actual.Id · @_actual.EstadoDescripcion</div>
          <div class="card-body">
            <p class="mb-2">@(_actual.NombreRuta ?? "Sin ruta") · @_actual.Placa · @_actual.NombreChofer</p>
            @if (_actual.Estado == 1 && Sesion.Puede(Titulo, AccionPantalla.Editar))
            {
              <div class="border rounded p-2 mb-3">
                <div class="small fw-semibold mb-2">Corregir el manifiesto (mientras no salga)</div>
                <div class="row g-2">
                  <div class="col-12"><label class="form-label small" for="ed-ruta">Ruta</label>
                    <select id="ed-ruta" class="form-select form-select-sm" @bind="_edRuta">
                      <option value="0">—</option>
                      @foreach (var r in _rutas) { <option value="@r.Id">@r.Nombre</option> }
                      @if (_edRuta > 0 && !_rutas.Any(r => r.Id == _edRuta)) { <option value="@_edRuta">@_actual.NombreRuta (inactiva)</option> }
                    </select></div>
                  <div class="col-6"><label class="form-label small" for="ed-veh">Vehículo</label>
                    <select id="ed-veh" class="form-select form-select-sm" @bind="_edVehiculo">
                      <option value="0">—</option>
                      @foreach (var v in _vehiculos) { <option value="@v.Id">@v.Placa</option> }
                    </select></div>
                  <div class="col-6"><label class="form-label small" for="ed-cho">Chofer</label>
                    <select id="ed-cho" class="form-select form-select-sm" @bind="_edChofer">
                      <option value="0">—</option>
                      @foreach (var c in _choferes) { <option value="@c.Id">@c.Nombre</option> }
                    </select></div>
                  <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-primary" @onclick="GuardarCorreccion">Guardar cambios</button>
                    @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                    {
                      <input class="form-control form-control-sm w-auto" maxlength="200" placeholder="Motivo para anular" aria-label="Motivo para anular el manifiesto" @bind="_motivoAnular" @bind:event="onchange" />
                      <button class="btn btn-sm btn-outline-danger" @onclick="AnularManifiesto">Anular manifiesto</button>
                    }
                  </div>
                </div>
              </div>
            }
            @if (_actual.Estado == 1 && _actual.IdRutaDespacho is not > 0)
            {
              <div class="alert alert-warning py-2 small">Asigne una ruta antes de salir a ruta.</div>
            }
            <label class="form-label" for="scan-bulto">Escanear bulto al camión</label>
            <input id="scan-bulto" @ref="_scanEl" class="form-control mb-2" @bind="_scan" @bind:event="onchange" @bind:after="CargarBulto"
                   placeholder="BULT-…" autocomplete="off" />
            <ul class="list-unstyled mb-3">
              @foreach (var b in _actual.Bultos)
              {
                <li>
                  <code>@b.Codigo</code> @b.EstadoDescripcion · @b.NombreCliente
                  @if (b.Estado == 4) { <BotonImprimir Tipo="entrega-despacho" Id="b.IdOrden" Texto="Comprobante" Clase="btn-sm btn-outline-secondary ms-1" /> }
                  @if (_actual.Estado == 1 && Sesion.Puede(Titulo, AccionPantalla.Editar))
                  {
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1" @onclick="() => QuitarBulto(b.Id)">Quitar</button>
                  }
                </li>
              }
            </ul>
            <div class="d-flex gap-2 flex-wrap">
              <BotonImprimir Tipo="manifiesto-despacho" Id="_actual.Id" Texto="A4" Clase="btn-outline-secondary" />
              <BotonImprimir Tipo="manifiesto-despacho" Id="_actual.Id" Formato="termico80" Texto="80 mm" Clase="btn-outline-secondary" />
              @if (_actual.Estado == 1)
              {
                <button class="btn btn-success" @onclick="Salir" disabled="@(_actual.IdRutaDespacho is not > 0)">Salir a ruta</button>
              }
            </div>
            @if (_actual.Estado == 2)
            {
              <div class="mt-3">
                <div class="form-text mb-2">Cierre cada factura al entregar o al volver el producto.</div>
                @foreach (var b in OrdenesDelManifiesto())
                {
                  <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <span><code>@b.NumeroDocumento</code> @b.NombreCliente</span>
                    <button class="btn btn-sm btn-outline-success" @onclick="() => PedirEntrega(b.IdOrden, false)">Entregado</button>
                    <button class="btn btn-sm btn-outline-dark" @onclick="() => PedirEntrega(b.IdOrden, true)">No entregado</button>
                  </div>
                }
              </div>
            }
          </div>
        </div>
      }

      <div class="card"><div class="card-header">Manifiestos recientes</div>
        <div class="list-group list-group-flush">
          @foreach (var m in _manifiestos)
          {
            <button type="button" class="list-group-item list-group-item-action" @onclick="() => Abrir(m.Id)">
              #@m.Id @m.Fecha.ToString("dd/MM HH:mm") · @m.EstadoDescripcion · @m.Placa
            </button>
          }
        </div>
      </div>
    </div>
  </div>
 </ChildContent>
</AppPantalla>

<CerrarEntregaModal @ref="_entrega" AlCerrar="AlCerrarEntrega" />

@code {
 private string _error = "", _scan = "";
 private List<BultoDespacho> _bultos = new();
 private HashSet<long> _elegidos = new();
 private List<RutaDespacho> _rutas = new();
 private List<VehiculoDespacho> _vehiculos = new();
 private List<ChoferDespacho> _choferes = new();
 private List<ManifiestoDespacho> _manifiestos = new();
 private ManifiestoDespacho? _actual;
 private CerrarEntregaModal _entrega = default!;
 private ElementReference _scanEl;
 private IJSObjectReference? _js;
 // Debe coincidir con el título del menú: de ahí sale el código de permiso de la función.
 private const string Titulo = "Despacho";
 private int _idRuta, _idVehiculo, _idChofer;
 private int _edRuta, _edVehiculo, _edChofer;
 private string _motivoAnular = "";
 private bool _soloZona;
 private RutaDespacho? RutaElegida => _idRuta == 0 ? null : _rutas.FirstOrDefault(r => r.Id == _idRuta);
 // Solo ayuda para armar el manifiesto: el despachador decide y puede cargar un bulto fuera de las zonas.
 private IEnumerable<BultoDespacho> BultosVisibles
     => _soloZona && RutaElegida is { Zonas.Count: > 0 } ruta ? _bultos.Where(ruta.CubreA) : _bultos;
 private bool _focoScan;

 protected override async Task OnInitializedAsync() => await Cargar();

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
     if (!_focoScan) return;
     _focoScan = false;
     try { await _scanEl.FocusAsync(); } catch (Exception) { }
 }

 private async Task AbrirPdf(long id)
 {
     _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bodega.js");
     await _js.InvokeVoidAsync("abrir", $"/documentos/manifiesto-despacho/{id}/pdf");
 }

 private async Task Cargar()
 {
     _error = "";
     var b = await Api.BultosEmpacadosAsync();
     var r = await Api.RutasAsync(soloActivas: true);
     var v = await Api.VehiculosAsync();
     var c = await Api.ChoferesAsync();
     var m = await Api.ManifiestosAsync();
     if (b.Status != ResponseStatus._0) { _error = b.CurrentException ?? ""; return; }
     _bultos = b.Responses ?? new();
     _rutas = r.Responses ?? new();
     _vehiculos = v.Responses ?? new();
     _choferes = c.Responses ?? new();
     _manifiestos = m.Responses ?? new();
 }

 private void Toggle(long id, ChangeEventArgs e)
 {
     var on = e.Value is bool x && x || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
     if (on) _elegidos.Add(id); else _elegidos.Remove(id);
 }

 private async Task Crear()
 {
     var r = await Api.CrearManifiestoAsync(_idRuta == 0 ? null : _idRuta, _idVehiculo == 0 ? null : _idVehiculo, _idChofer == 0 ? null : _idChofer, _elegidos.ToList());
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo crear."); return; }
     _actual = r.Responses;
     SincronizarCorreccion();
     _elegidos.Clear();
     if (_actual is not null) await AbrirPdf(_actual.Id);
     _focoScan = _actual?.Estado == 1;
     await Cargar();
 }

 private async Task Abrir(long id)
 {
     var r = await Api.ManifiestoAsync(id);
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se abrió."); return; }
     _actual = r.Responses;
     _focoScan = _actual?.Estado == 1;
     SincronizarCorreccion();
 }

 private void SincronizarCorreccion()
 {
     _edRuta = _actual?.IdRutaDespacho ?? 0;
     _edVehiculo = _actual?.IdVehiculo ?? 0;
     _edChofer = _actual?.IdChofer ?? 0;
     _motivoAnular = "";
 }

 private async Task GuardarCorreccion()
 {
     if (_actual is null) return;
     var r = await Api.EditarManifiestoAsync(_actual.Id, _edRuta == 0 ? null : _edRuta, _edVehiculo == 0 ? null : _edVehiculo, _edChofer == 0 ? null : _edChofer, _actual.Observaciones);
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo corregir el manifiesto."); return; }
     _actual = r.Responses;
     SincronizarCorreccion();
     Dialogos.Exito("Manifiesto actualizado.");
     await Cargar();
 }

 private async Task QuitarBulto(long idBulto)
 {
     if (_actual is null) return;
     if (!await Dialogos.ConfirmarAsync("¿Sacar este bulto del manifiesto? Queda libre para otro manifiesto.", "Quitar bulto")) return;
     var r = await Api.QuitarBultoAsync(_actual.Id, idBulto);
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo quitar el bulto."); return; }
     _actual = r.Responses;
     await Cargar();
 }

 private async Task AnularManifiesto()
 {
     if (_actual is null) return;
     if (string.IsNullOrWhiteSpace(_motivoAnular)) { await Dialogos.ErrorAsync("Indique el motivo para anular el manifiesto."); return; }
     if (!await Dialogos.ConfirmarPeligroAsync("¿Anular este manifiesto? Sus bultos quedan libres para armar otro.")) return;
     var r = await Api.AnularManifiestoAsync(_actual.Id, _motivoAnular.Trim());
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se pudo anular el manifiesto."); return; }
     _actual = null;
     await Cargar();
 }

 private async Task CargarBulto()
 {
     if (_actual is null || string.IsNullOrWhiteSpace(_scan)) return;
     var codigo = _scan.Trim();
     _scan = "";
     var r = await Api.CargarBultoAsync(_actual.Id, codigo);
     if (r.Status != ResponseStatus._0)
     {
         await Dialogos.ErrorAsync(r.CurrentException ?? "Bulto rechazado.");
         _focoScan = true;
         return;
     }
     _actual = r.Responses;
     _focoScan = _actual?.Estado == 1;
 }

 private async Task Salir()
 {
     if (_actual is null) return;
     var r = await Api.SalirRutaAsync(_actual.Id);
     if (r.Status != ResponseStatus._0) { await Dialogos.ErrorAsync(r.CurrentException ?? "No se puede salir."); return; }
     _actual = r.Responses;
     if (_actual is not null) await AbrirPdf(_actual.Id);
     await Cargar();
 }

 private IEnumerable<BultoDespacho> OrdenesDelManifiesto()
     => (_actual?.Bultos ?? new List<BultoDespacho>())
         .Where(b => b.Estado == 3)
         .GroupBy(b => b.IdOrden)
         .Select(g => g.First());

 private Task PedirEntrega(long idOrden, bool no) => _entrega.PedirAsync(idOrden, no);

 private async Task AlCerrarEntrega(AlistamientoOrden _)
 {
     if (_actual is not null) await Abrir(_actual.Id);
     await Cargar();
 }
}
