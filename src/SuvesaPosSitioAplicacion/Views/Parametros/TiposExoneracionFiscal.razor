@page "/parameters/exemption-types"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ITiposExoneracionFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="TipoExoneracionFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="TipoExoneracionFiscalDTO" HeaderText="Código" ItemTextSelector="x=>x.Codigo"/><HxGridColumn TItem="TipoExoneracionFiscalDTO" HeaderText="Detalle" ItemTextSelector="x=>x.Detalle"/><HxGridColumn TItem="TipoExoneracionFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="()=>Editar(x)">Editar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@ModalTitulo" Size="ModalSize.Regular"><BodyTemplate>@if(_edicion is not null){<EditForm Model="_edicion" OnValidSubmit="Guardar" id="exo"><AppCampoTexto Etiqueta="Código" @bind-Valor="_edicion.Codigo"/><AppCampoTexto Etiqueta="Detalle" @bind-Valor="_edicion.Detalle"/></EditForm>}</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="()=>_modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="exo" type="submit">Guardar</button></FooterTemplate></HxModal>
@code{const string Titulo="Tipos de Exoneración";AppRejilla<TipoExoneracionFiscalDTO>? _grid;HxModal _modal=default!;List<TipoExoneracionFiscalDTO> _items=new();TipoExoneracionFiscalDTO? _edicion;bool _nuevo,_cargado;string ModalTitulo=>_nuevo?"Nuevo tipo de exoneración":"Editar tipo de exoneración";async Task<GridDataProviderResult<TipoExoneracionFiscalDTO>> Cargar(GridDataProviderRequest<TipoExoneracionFiscalDTO> r){if(!_cargado){_items=(await Respuestas.DatoAsync(await Api.Obtener(),"consultar los tipos de exoneración"))?.ToList()??new();_cargado=true;}return r.ApplyTo(_items);}async Task Nuevo(){_nuevo=true;_edicion=new();await _modal.ShowAsync();}async Task Editar(TipoExoneracionFiscalDTO x){_nuevo=false;_edicion=new(){IdTipoExoneracion=x.IdTipoExoneracion,Codigo=x.Codigo,Detalle=x.Detalle};await _modal.ShowAsync();}async Task Guardar(){if(_edicion is null||_edicion.Codigo?.Trim().Length!=2||!_edicion.Codigo.All(char.IsDigit)||string.IsNullOrWhiteSpace(_edicion.Detalle)){await Dialogos.ErrorAsync("Indique código de dos dígitos y detalle.");return;}_edicion.Codigo=_edicion.Codigo.Trim();var r=_nuevo?await Api.Crear(_edicion):await Api.Actualizar(_edicion);if(await Respuestas.CorrectaAsync(r,"guardar el tipo de exoneración")){await _modal.HideAsync();_cargado=false;if(_grid is not null)await _grid.RefrescarAsync();}}}
