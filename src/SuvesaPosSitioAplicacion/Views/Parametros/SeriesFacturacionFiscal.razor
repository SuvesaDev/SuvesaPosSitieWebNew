@page "/parameters/invoice-series"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ISeriesFacturacionFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="SerieFacturacionFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="SerieFacturacionFiscalDTO" HeaderText="Descripción" ItemTextSelector="x => x.Descripcion"/><HxGridColumn TItem="SerieFacturacionFiscalDTO" HeaderText="Emisor" ItemTextSelector="x => x.IdEmisor.ToString()"/><HxGridColumn TItem="SerieFacturacionFiscalDTO" HeaderText="Sucursal FE" ItemTextSelector="x => x.NumeroSucursalFE"/><HxGridColumn TItem="SerieFacturacionFiscalDTO" HeaderText="Terminal" ItemTextSelector="x => x.NumeroTerminal.ToString()"/><HxGridColumn TItem="SerieFacturacionFiscalDTO" HeaderText="Secuencia" ItemTextSelector="x => x.Secuencia.ToString()"/><HxGridColumn TItem="SerieFacturacionFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="() => Editar(x)">Editar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Large"><BodyTemplate>@if (_edicion is not null) { <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formSerie"><div class="row g-3"><div class="col-md-6"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion" /></div><div class="col-md-3"><label class="form-label">Emisor</label><input class="form-control" type="number" min="1" @bind="_edicion.IdEmisor" /></div><div class="col-md-3"><label class="form-label">Sucursal</label><input class="form-control" type="number" min="1" @bind="_edicion.IdSucursal" /></div><div class="col-md-4"><label class="form-label">Terminal</label><input class="form-control" type="number" min="1" @bind="_edicion.NumeroTerminal" /></div><div class="col-md-4"><label class="form-label">Tipo de factura</label><input class="form-control" type="number" min="1" @bind="_edicion.IdTipoFactura" /></div><div class="col-md-4"><label class="form-label">Secuencia</label><input class="form-control" type="number" min="0" @bind="_edicion.Secuencia" /></div><div class="col-12"><div class="form-check"><input id="v44" class="form-check-input" type="checkbox" @bind="_edicion.EmisionV44Habilitada" /><label class="form-check-label" for="v44">Habilitar emisión V4.4</label></div></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formSerie" type="submit">Guardar</button></FooterTemplate></HxModal>
@code { private const string Titulo = "Series de Facturación"; private AppRejilla<SerieFacturacionFiscalDTO>? _grid; private HxModal _modal = default!; private List<SerieFacturacionFiscalDTO> _items = new(); private SerieFacturacionFiscalDTO? _edicion; private bool _nuevo, _cargado; private string TituloModal => _nuevo ? "Nueva serie" : "Editar serie"; private async Task<GridDataProviderResult<SerieFacturacionFiscalDTO>> Cargar(GridDataProviderRequest<SerieFacturacionFiscalDTO> request) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar las series"))?.ToList() ?? new(); _cargado = true; } return request.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_grid is not null) await _grid.RefrescarAsync(); } private async Task Nuevo() { _nuevo = true; _edicion = new(); await _modal.ShowAsync(); } private async Task Editar(SerieFacturacionFiscalDTO serie) { _nuevo = false; _edicion = new() { IdSerie = serie.IdSerie, Secuencia = serie.Secuencia, NumeroTerminal = serie.NumeroTerminal, IdSucursal = serie.IdSucursal, IdEmisor = serie.IdEmisor, Descripcion = serie.Descripcion, IdTipoFactura = serie.IdTipoFactura, EsCredito = serie.EsCredito, EsRecibo = serie.EsRecibo, EsPago = serie.EsPago, EsConsignacion = serie.EsConsignacion, EmisionV44Habilitada = serie.EmisionV44Habilitada }; await _modal.ShowAsync(); } private async Task Guardar() { if (_edicion is null || string.IsNullOrWhiteSpace(_edicion.Descripcion) || _edicion.IdEmisor <= 0 || _edicion.IdSucursal <= 0 || _edicion.NumeroTerminal <= 0 || _edicion.IdTipoFactura <= 0 || _edicion.Secuencia < 0) { await Dialogos.ErrorAsync("Complete descripción, emisor, sucursal, terminal, tipo de factura y secuencia válidos."); return; } _edicion.Descripcion = _edicion.Descripcion.Trim(); var respuesta = _nuevo ? await Api.Crear(_edicion) : await Api.Actualizar(_edicion); if (await Respuestas.CorrectaAsync(respuesta, "guardar la serie")) { await _modal.HideAsync(); await Recargar(); } } }
