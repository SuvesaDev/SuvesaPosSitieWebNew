@page "/parameters/invoice-series"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ISeriesFacturacionFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta">
    <Acciones>
        <button class="btn btn-sm btn-primary" @onclick="Nuevo" disabled="@(_cat is null)">Agregar serie</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button>
    </Acciones>
    <ChildContent>
        <div class="card mb-3">
            <div class="card-body row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small">Emisor</label>
                    <select class="form-select form-select-sm" @bind="_filtroEmisor">
                        <option value="0">Todos</option>
                        @foreach (var e in Emisores) { <option value="@e.Id">@e.Nombre</option> }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small">Sucursal</label>
                    <select class="form-select form-select-sm" @bind="_filtroSucursal">
                        <option value="0">Todas</option>
                        @foreach (var s in Sucursales) { <option value="@s.Id">@s.Nombre</option> }
                    </select>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Emisor</th>
                                <th>Sucursal</th>
                                <th>Tipo de documento</th>
                                <th>Condición</th>
                                <th>Documento electrónico</th>
                                <th class="text-end">Terminal</th>
                                <th class="text-end">Secuencia</th>
                                <th>4.4</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Filtradas.Count == 0) { <tr><td colspan="10" class="text-secondary text-center py-3">No hay series configuradas con esos criterios.</td></tr> }
                            @foreach (var x in Filtradas)
                            {
                                <tr>
                                    <td>@x.Descripcion</td>
                                    <td>@x.EmisorNombre</td>
                                    <td>
                                        @x.SucursalNombre
                                        @if (x.SucursalFEValida) { <span class="badge text-bg-light ms-1">FE @x.NumeroSucursalFE</span> }
                                        else { <span class="badge text-bg-danger ms-1" title="La sucursal no tiene número FE de 3 dígitos">FE sin configurar</span> }
                                    </td>
                                    <td>
                                        @x.TipoFacturaDescripcion
                                        @if (x.EsTiquete) { <span class="badge text-bg-dark ms-1" title="Se cobra y confirma en Facturación, sin preventa">Tiquete</span> }
                                    </td>
                                    <td><span class="small">@x.UsoDescripcion</span></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(x.CodigoFE)) { <span class="badge text-bg-success">FE @x.CodigoFE</span> } else { <span class="badge text-bg-secondary">No</span> }
                                        @if (!string.IsNullOrWhiteSpace(x.Naturaleza)) { <span class="badge text-bg-light ms-1">@x.Naturaleza</span> }
                                    </td>
                                    <td class="text-end">@x.NumeroTerminal.ToString("D5")</td>
                                    <td class="text-end">@x.Secuencia</td>
                                    <td>@if (x.EmisionV44Habilitada) { <span class="badge text-bg-success">Sí</span> } else { <span class="badge text-bg-secondary">No</span> }</td>
                                    <td class="text-end"><button class="btn btn-sm btn-link p-0" @onclick="() => Editar(x)">Editar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Large" Scrollable="true">
    <BodyTemplate>
        @if (_edicion is not null && _cat is not null)
        {
            @if (_edicion.TieneDocumentos)
            {
                <div class="alert alert-warning py-2 small mb-3"><i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Esta serie ya emitió documentos: solo se puede cambiar la descripción, la secuencia y la emisión 4.4.</div>
            }

            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formSerie">
                <div class="mb-4">
                    <h6 class="text-uppercase text-secondary small border-bottom pb-1 mb-2">1 · Identificación</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Emisor <span class="text-secondary small">(empresa que factura)</span></label>
                            <select class="form-select" @bind="_edicion.IdEmisor" @bind:after="RecalcularAvisos" disabled="@_edicion.TieneDocumentos">
                                <option value="0">Seleccione...</option>
                                @foreach (var e in _cat.Emisores) { <option value="@e.Id">@e.Nombre — @e.Identificacion</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Sucursal de facturación <span class="text-secondary small">(centro)</span></label>
                            <select class="form-select" @bind="_edicion.IdSucursal" @bind:after="RecalcularAvisos" disabled="@_edicion.TieneDocumentos">
                                <option value="0">Seleccione...</option>
                                @foreach (var s in _cat.Sucursales) { <option value="@s.Id">@s.Nombre</option> }
                            </select>
                            @if (SucursalSel is { } su)
                            {
                                @if (su.FEValida) { <div class="form-text">Número de sucursal FE: <strong>@su.NumeroFE</strong></div> }
                                else { <div class="text-danger small mt-1">La sucursal no tiene número FE de 3 dígitos. Configúrelo en <a href="/parameters/branch" target="_blank">Sucursales</a> antes de crear la serie.</div> }
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <div class="input-group">
                                <input class="form-control" maxlength="100" @bind="_edicion.Descripcion" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="SugerirDescripcion">Sugerir</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="text-uppercase text-secondary small border-bottom pb-1 mb-2">2 · Documento y condición</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Tipo de documento</label>
                            <select class="form-select" @bind="_edicion.IdTipoFactura" @bind:after="AlCambiarTipo" disabled="@_edicion.TieneDocumentos">
                                <option value="">Seleccione...</option>
                                @foreach (var grupo in _cat.TiposFactura.GroupBy(t => t.Uso).OrderBy(g => g.Key))
                                {
                                    <optgroup label="@GrupoUso(grupo.Key)">
                                        @foreach (var t in grupo)
                                        {
                                            <option value="@t.Id">@t.Descripcion</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            @if (TipoSel is not null)
                            {
                                <div class="form-text">
                                    Modalidad: <strong>@(TipoSel.EsTiquete ? "Tiquete" : "Venta con cobro diferido")</strong>.
                                    @(TipoSel.EsTiquete
                                        ? "Se cobra y confirma en Facturación; la serie debe ser Contado."
                                        : "Genera preventa (contado) o factura a crédito según la condición.")
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Terminal / Caja</label>
                            <input class="form-control" type="number" min="0" max="99999" @bind="_edicion.NumeroTerminal" @bind:after="RecalcularAvisos" disabled="@_edicion.TieneDocumentos" />
                            <div class="form-text">Forma parte del consecutivo fiscal.</div>
                        </div>
                        @if (EsUsoFacturacion)
                        {
                            <div class="col-12 col-md-3">
                                <label class="form-label">Condición de venta</label>
                                <select class="form-select" @bind="EsCreditoTexto" @bind:after="AlCambiarCondicion" disabled="@_edicion.TieneDocumentos">
                                    <option value="false">Contado</option>
                                    <option value="true">Crédito</option>
                                </select>
                                <div class="form-text">Esta serie queda dedicada a esa condición.</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="text-uppercase text-secondary small border-bottom pb-1 mb-2">3 · Documento electrónico (Hacienda 4.4)</h6>
                    <div class="form-check form-switch">
                        <input id="fe" class="form-check-input" type="checkbox" @bind="_requiereElectronico" @bind:after="AlToggleElectronico" />
                        <label class="form-check-label" for="fe">Requiere documento electrónico</label>
                    </div>
                    @if (_requiereElectronico)
                    {
                        <div class="row g-3 mt-1">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Tipo de documento electrónico</label>
                                <select class="form-select" @bind="_edicion.CodigoFE" @bind:after="RecalcularAvisos">
                                    @foreach (var c in CodigosElectronicos) { <option value="@c.Codigo">@c.Nombre (FE @c.Codigo)</option> }
                                </select>
                            </div>
                            <div class="col-12 col-md-6 d-flex align-items-center">
                                <div class="form-check">
                                    <input id="v44" class="form-check-input" type="checkbox" @bind="_edicion.EmisionV44Habilitada" @bind:after="RecalcularAvisos" />
                                    <label class="form-check-label" for="v44">Emitir comprobante electrónico 4.4 automáticamente</label>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="form-text">Documento interno (presupuesto, proforma…): no genera comprobante de Hacienda.</div>
                    }
                </div>

                <div class="mb-2">
                    <h6 class="text-uppercase text-secondary small border-bottom pb-1 mb-2">4 · Numeración</h6>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Secuencia actual</label>
                            <input class="form-control" type="number" min="@_secuenciaMin" max="9999999999" @bind="_edicion.Secuencia" @bind:after="RecalcularAvisos" />
                            <div class="form-text">El próximo documento tomará <strong>@(_edicion.Secuencia + 1)</strong>.@(_secuenciaMin > 0 ? " No puede disminuir." : "")</div>
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label">Próximo consecutivo fiscal (20 dígitos)</label>
                            <div class="font-monospace fs-6">@PreviewConsecutivo()</div>
                        </div>
                    </div>
                </div>

                @if (_avisos.Count > 0)
                {
                    <div class="alert alert-danger py-2 mb-0 mt-2"><ul class="mb-0 ps-3 small">@foreach (var a in _avisos) { <li>@a</li> }</ul></div>
                }
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" form="formSerie" type="submit" disabled="@(_avisos.Count > 0)">Guardar</button>
    </FooterTemplate>
</HxModal>
