@page "/parameters/payment-terms"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IConfiguracionPlazosFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="ConfiguracionPlazoFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="ConfiguracionPlazoFiscalDTO" HeaderText="Descripción" ItemTextSelector="x => x.Descripcion"/><HxGridColumn TItem="ConfiguracionPlazoFiscalDTO" HeaderText="Días" ItemTextSelector="x => x.CantidadDias.ToString()"/><HxGridColumn TItem="ConfiguracionPlazoFiscalDTO" HeaderText="Consignación"><ItemTemplate Context="x">@(x.Consignacion ? "Sí" : "No")</ItemTemplate></HxGridColumn><HxGridColumn TItem="ConfiguracionPlazoFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="() => Editar(x)">Editar</button><button class="btn btn-sm btn-link text-danger" @onclick="() => Deshabilitar(x)">Deshabilitar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Regular"><BodyTemplate>@if (_edicion is not null) { <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formPlazo"><div class="row g-3"><div class="col-md-8"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion" /></div><div class="col-md-4"><label class="form-label">Cantidad de días</label><input class="form-control" type="number" min="1" max="3650" @bind="_edicion.CantidadDias" /></div><div class="col-12"><div class="form-check"><input id="consignacion" class="form-check-input" type="checkbox" @bind="_edicion.Consignacion" /><label class="form-check-label" for="consignacion">Aplica a consignación</label></div></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formPlazo" type="submit" disabled="@_guardando">Guardar</button></FooterTemplate></HxModal>
@code { private const string Titulo = "Configuración de Plazos"; private AppRejilla<ConfiguracionPlazoFiscalDTO>? _grid; private HxModal _modal = default!; private List<ConfiguracionPlazoFiscalDTO> _items = new(); private ConfiguracionPlazoFiscalDTO? _edicion; private bool _nuevo, _cargado, _guardando; private string TituloModal => _nuevo ? "Nuevo plazo" : "Editar plazo"; private async Task<GridDataProviderResult<ConfiguracionPlazoFiscalDTO>> Cargar(GridDataProviderRequest<ConfiguracionPlazoFiscalDTO> request) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los plazos"))?.ToList() ?? new(); _cargado = true; } return request.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_grid is not null) await _grid.RefrescarAsync(); } private async Task Nuevo() { _nuevo = true; _edicion = new() { Activo = true }; await _modal.ShowAsync(); } private async Task Editar(ConfiguracionPlazoFiscalDTO plazo) { _nuevo = false; _edicion = new() { IdPlazo = plazo.IdPlazo, Descripcion = plazo.Descripcion, CantidadDias = plazo.CantidadDias, Consignacion = plazo.Consignacion, Activo = plazo.Activo }; await _modal.ShowAsync(); } private async Task Guardar() { if (_edicion is null || _guardando) return; _edicion.Descripcion = _edicion.Descripcion?.Trim() ?? string.Empty; if (string.IsNullOrWhiteSpace(_edicion.Descripcion) || _edicion.Descripcion.Length > 100 || _edicion.CantidadDias is < 1 or > 3650) { await Dialogos.ErrorAsync("Indique una descripción de hasta 100 caracteres y una cantidad entre 1 y 3650 días."); return; } _guardando = true; var respuesta = _nuevo ? await Api.Crear(_edicion) : await Api.Actualizar(_edicion); _guardando = false; if (await Respuestas.CorrectaAsync(respuesta, "guardar el plazo")) { await _modal.HideAsync(); await Recargar(); } } private async Task Deshabilitar(ConfiguracionPlazoFiscalDTO plazo) { var respuesta = await Api.Deshabilitar(plazo); if (await Respuestas.CorrectaAsync(respuesta, "deshabilitar el plazo")) await Recargar(); } }
