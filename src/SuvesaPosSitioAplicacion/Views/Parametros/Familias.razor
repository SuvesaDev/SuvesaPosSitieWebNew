@page "/parameters/family"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IFamilias Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

<AppPantalla Pantalla="Familias y Sub-Familias" Nivel="NivelPantalla.Tableta">
    <Acciones>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RecargarTodo"><i class="bi bi-arrow-clockwise me-1"></i>Actualizar</button>
    </Acciones>
    <ChildContent>
        <div class="card mb-3">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <strong>Familias</strong>
                @if (Sesion.Puede(Codigo, AccionPantalla.Crear))
                {
                    <button class="btn btn-sm btn-light" @onclick="AgregarFamilia"><i class="bi bi-plus-lg me-1"></i>Nueva familia</button>
                }
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Seleccione una familia para administrar sus sub-familias.</p>
                <AppRejilla TItem="FamiliaDTO" Datos="CargarFamilias" @ref="_rejillaFamilias" TextoVacio="No hay familias registradas.">
                    <Columnas>
                        <HxGridColumn TItem="FamiliaDTO" HeaderText="Descripción" ItemTextSelector="f => f.Descripcion" SortKeySelector="f => f.Descripcion" />
                        <HxGridColumn TItem="FamiliaDTO" HeaderText="Observaciones" ItemTextSelector="f => f.Observaciones" />
                        <HxGridColumn TItem="FamiliaDTO" HeaderText="" HeaderCssClass="text-end" ItemCssClass="text-end">
                            <ItemTemplate Context="f">
                                <button class="btn btn-sm @(EsSeleccionada(f) ? "btn-primary" : "btn-outline-primary") me-2" @onclick="() => SeleccionarFamilia(f)">
                                    @(EsSeleccionada(f) ? "Seleccionada" : "Ver sub-familias")
                                </button>
                                @if (Sesion.Puede(Codigo, AccionPantalla.Modificar))
                                {
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => EditarFamilia(f)">Editar</button>
                                }
                                @if (Sesion.Puede(Codigo, AccionPantalla.Borrar))
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => EliminarFamilia(f)">Eliminar</button>
                                }
                            </ItemTemplate>
                        </HxGridColumn>
                    </Columnas>
                </AppRejilla>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <div><strong>Sub-Familias</strong>@if (_familiaSeleccionada is not null) { <span class="ms-2 small">de @_familiaSeleccionada.Descripcion</span> }</div>
                @if (Sesion.Puede(Codigo, AccionPantalla.Crear))
                {
                    <button class="btn btn-sm btn-light" disabled="@(_familiaSeleccionada is null)" @onclick="AgregarSubFamilia"><i class="bi bi-plus-lg me-1"></i>Nueva sub-familia</button>
                }
            </div>
            <div class="card-body">
                @if (_familiaSeleccionada is null)
                {
                    <div class="text-muted">Seleccione primero una familia.</div>
                }
                else
                {
                    <AppRejilla TItem="SubFamiliaDTO" Datos="CargarSubFamilias" @ref="_rejillaSubFamilias" TextoVacio="La familia seleccionada no tiene sub-familias.">
                        <Columnas>
                            <HxGridColumn TItem="SubFamiliaDTO" HeaderText="Código" ItemTextSelector="s => s.SubCodigo" SortKeySelector="s => s.SubCodigo" />
                            <HxGridColumn TItem="SubFamiliaDTO" HeaderText="Descripción" ItemTextSelector="s => s.Descripcion" SortKeySelector="s => s.Descripcion" />
                            <HxGridColumn TItem="SubFamiliaDTO" HeaderText="Observaciones" ItemTextSelector="s => s.Observaciones" />
                            <HxGridColumn TItem="SubFamiliaDTO" HeaderText="" HeaderCssClass="text-end" ItemCssClass="text-end">
                                <ItemTemplate Context="s">
                                    @if (Sesion.Puede(Codigo, AccionPantalla.Modificar))
                                    {
                                        <button class="btn btn-sm btn-link p-0" @onclick="() => EditarSubFamilia(s)">Editar</button>
                                    }
                                    @if (Sesion.Puede(Codigo, AccionPantalla.Borrar))
                                    {
                                        <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => EliminarSubFamilia(s)">Eliminar</button>
                                    }
                                </ItemTemplate>
                            </HxGridColumn>
                        </Columnas>
                    </AppRejilla>
                }
            </div>
        </div>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modalFamilia" Title="@(_familiaEdicion?.Codigo > 0 ? "Editar familia" : "Nueva familia")" Size="ModalSize.Regular">
    <BodyTemplate>
        @if (_familiaEdicion is not null)
        {
            <EditForm Model="_familiaEdicion" OnValidSubmit="GuardarFamilia" id="formFamilia">
                <DataAnnotationsValidator />
                <div class="mb-3"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_familiaEdicion.Descripcion" Requerido="true" /></div>
                <AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_familiaEdicion.Observaciones" />
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modalFamilia.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formFamilia" disabled="@_guardando">@(_guardando ? "Guardando..." : "Guardar")</button>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_modalSubFamilia" Title="@(_subFamiliaEdicion?.Codigo > 0 ? "Editar sub-familia" : "Nueva sub-familia")" Size="ModalSize.Regular">
    <BodyTemplate>
        @if (_subFamiliaEdicion is not null)
        {
            <EditForm Model="_subFamiliaEdicion" OnValidSubmit="GuardarSubFamilia" id="formSubFamilia">
                <DataAnnotationsValidator />
                <div class="mb-3"><AppCampoTexto Etiqueta="Código" @bind-Valor="_subFamiliaEdicion.SubCodigo" Requerido="true" /></div>
                <div class="mb-3"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_subFamiliaEdicion.Descripcion" Requerido="true" /></div>
                <AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_subFamiliaEdicion.Observaciones" />
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modalSubFamilia.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formSubFamilia" disabled="@_guardando">@(_guardando ? "Guardando..." : "Guardar")</button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Codigo = "PARAMETROS.FAMILIAS";
    private AppRejilla<FamiliaDTO>? _rejillaFamilias;
    private AppRejilla<SubFamiliaDTO>? _rejillaSubFamilias;
    private HxModal _modalFamilia = default!;
    private HxModal _modalSubFamilia = default!;
    private List<FamiliaDTO> _familias = new();
    private List<SubFamiliaDTO> _subFamilias = new();
    private FamiliaDTO? _familiaSeleccionada;
    private FamiliaDTO? _familiaEdicion;
    private SubFamiliaDTO? _subFamiliaEdicion;
    private bool _familiasCargadas;
    private bool _subFamiliasCargadas;
    private bool _guardando;

    private async Task<GridDataProviderResult<FamiliaDTO>> CargarFamilias(GridDataProviderRequest<FamiliaDTO> peticion)
    {
        if (!_familiasCargadas)
        {
            _familias = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar las familias"))?.ToList() ?? new();
            _familiasCargadas = true;
            _familiaSeleccionada ??= _familias.FirstOrDefault();
        }
        return peticion.ApplyTo(_familias);
    }

    private async Task<GridDataProviderResult<SubFamiliaDTO>> CargarSubFamilias(GridDataProviderRequest<SubFamiliaDTO> peticion)
    {
        if (_familiaSeleccionada is not null && !_subFamiliasCargadas)
        {
            _subFamilias = (await Respuestas.DatoAsync(await Api.ObtenerSubFamilias(_familiaSeleccionada.Codigo), "consultar las sub-familias"))?.ToList() ?? new();
            _subFamiliasCargadas = true;
        }
        return peticion.ApplyTo(_subFamilias);
    }

    private bool EsSeleccionada(FamiliaDTO familia) => _familiaSeleccionada?.Codigo == familia.Codigo;

    private async Task SeleccionarFamilia(FamiliaDTO familia)
    {
        _familiaSeleccionada = familia;
        _subFamilias = new();
        _subFamiliasCargadas = false;
        if (_rejillaSubFamilias is not null) await _rejillaSubFamilias.RefrescarAsync();
    }

    private async Task RecargarTodo()
    {
        _familiasCargadas = false;
        _subFamiliasCargadas = false;
        _subFamilias = new();
        if (_rejillaFamilias is not null) await _rejillaFamilias.RefrescarAsync();
        if (_rejillaSubFamilias is not null) await _rejillaSubFamilias.RefrescarAsync();
    }

    private async Task AgregarFamilia()
    {
        _familiaEdicion = new FamiliaDTO { Estado = true };
        await _modalFamilia.ShowAsync();
    }

    private async Task EditarFamilia(FamiliaDTO familia)
    {
        _familiaEdicion = new FamiliaDTO { Codigo = familia.Codigo, Descripcion = familia.Descripcion, Observaciones = familia.Observaciones, Estado = familia.Estado };
        await _modalFamilia.ShowAsync();
    }

    private async Task GuardarFamilia()
    {
        if (_familiaEdicion is null || _guardando) return;
        if (string.IsNullOrWhiteSpace(_familiaEdicion.Descripcion)) { await Dialogos.ErrorAsync("Indique la descripción de la familia."); return; }
        _guardando = true;
        var nueva = _familiaEdicion.Codigo == 0;
        var respuesta = nueva ? await Api.Crear(_familiaEdicion) : await Api.Editar(_familiaEdicion);
        _guardando = false;
        if (await Respuestas.CorrectaAsync(respuesta, nueva ? "crear la familia" : "editar la familia"))
        {
            await _modalFamilia.HideAsync();
            await RecargarTodo();
        }
    }

    private async Task EliminarFamilia(FamiliaDTO familia)
    {
        if (!await Dialogos.ConfirmarPeligroAsync($"¿Eliminar la familia '{familia.Descripcion}'?", "Eliminar familia")) return;
        if (await Respuestas.CorrectaAsync(await Api.Eliminar(familia.Codigo), "eliminar la familia"))
        {
            if (_familiaSeleccionada?.Codigo == familia.Codigo) _familiaSeleccionada = null;
            await RecargarTodo();
        }
    }

    private async Task AgregarSubFamilia()
    {
        if (_familiaSeleccionada is null) return;
        _subFamiliaEdicion = new SubFamiliaDTO { CodigoFamilia = _familiaSeleccionada.Codigo, Estado = true, FechaCreacion = DateTime.Now };
        await _modalSubFamilia.ShowAsync();
    }

    private async Task EditarSubFamilia(SubFamiliaDTO subFamilia)
    {
        _subFamiliaEdicion = new SubFamiliaDTO { Codigo = subFamilia.Codigo, CodigoFamilia = subFamilia.CodigoFamilia, SubCodigo = subFamilia.SubCodigo, Descripcion = subFamilia.Descripcion, Observaciones = subFamilia.Observaciones, Estado = subFamilia.Estado, IdUsuarioCreacion = subFamilia.IdUsuarioCreacion, FechaCreacion = subFamilia.FechaCreacion };
        await _modalSubFamilia.ShowAsync();
    }

    private async Task GuardarSubFamilia()
    {
        if (_subFamiliaEdicion is null || _guardando) return;
        if (string.IsNullOrWhiteSpace(_subFamiliaEdicion.SubCodigo) || string.IsNullOrWhiteSpace(_subFamiliaEdicion.Descripcion)) { await Dialogos.ErrorAsync("Indique el código y la descripción de la sub-familia."); return; }
        _guardando = true;
        var nueva = _subFamiliaEdicion.Codigo == 0;
        var respuesta = nueva ? await Api.CrearSubFamilia(_subFamiliaEdicion) : await Api.EditarSubFamilia(_subFamiliaEdicion);
        _guardando = false;
        if (await Respuestas.CorrectaAsync(respuesta, nueva ? "crear la sub-familia" : "editar la sub-familia"))
        {
            await _modalSubFamilia.HideAsync();
            _subFamiliasCargadas = false;
            if (_rejillaSubFamilias is not null) await _rejillaSubFamilias.RefrescarAsync();
        }
    }

    private async Task EliminarSubFamilia(SubFamiliaDTO subFamilia)
    {
        if (!await Dialogos.ConfirmarPeligroAsync($"¿Eliminar la sub-familia '{subFamilia.Descripcion}'?", "Eliminar sub-familia")) return;
        if (await Respuestas.CorrectaAsync(await Api.EliminarSubFamilia(subFamilia.Codigo), "eliminar la sub-familia"))
        {
            _subFamiliasCargadas = false;
            if (_rejillaSubFamilias is not null) await _rejillaSubFamilias.RefrescarAsync();
        }
    }
}
