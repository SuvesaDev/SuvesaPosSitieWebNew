@page "/parameters/currency-denominations"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IDenominacionesMonedaFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="DenominacionMonedaFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="DenominacionMonedaFiscalDTO" HeaderText="Moneda" ItemTextSelector="x => x.CodMoneda.ToString()"/><HxGridColumn TItem="DenominacionMonedaFiscalDTO" HeaderText="Denominación" ItemTextSelector="x => x.Denominacion.ToString()"/><HxGridColumn TItem="DenominacionMonedaFiscalDTO" HeaderText="Tipo" ItemTextSelector="x => x.Tipo"/><HxGridColumn TItem="DenominacionMonedaFiscalDTO" HeaderText="Estado" ItemTextSelector="x => x.Activo.ToString()"/><HxGridColumn TItem="DenominacionMonedaFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="() => Editar(x)">Editar</button><button class="btn btn-sm btn-link text-danger" @onclick="() => Deshabilitar(x)">Deshabilitar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Regular"><BodyTemplate>@if (_edicion is not null) { <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formDenominacion"><div class="row g-3"><div class="col-md-4"><label class="form-label">Código moneda</label><input class="form-control" type="number" min="1" @bind="_edicion.CodMoneda" /></div><div class="col-md-4"><label class="form-label">Denominación</label><input class="form-control" type="number" min="1" @bind="_edicion.Denominacion" /></div><div class="col-md-4"><label class="form-label">Tipo</label><select class="form-select" @bind="_edicion.Tipo"><option value="">Seleccione</option><option value="Moneda">Moneda</option><option value="Billete">Billete</option></select></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formDenominacion" type="submit" disabled="@_guardando">Guardar</button></FooterTemplate></HxModal>
@code { private const string Titulo = "Denominaciones de Moneda"; private AppRejilla<DenominacionMonedaFiscalDTO>? _grid; private HxModal _modal = default!; private List<DenominacionMonedaFiscalDTO> _items = new(); private DenominacionMonedaFiscalDTO? _edicion; private bool _nuevo, _cargado, _guardando; private string TituloModal => _nuevo ? "Nueva denominación" : "Editar denominación"; private async Task<GridDataProviderResult<DenominacionMonedaFiscalDTO>> Cargar(GridDataProviderRequest<DenominacionMonedaFiscalDTO> request) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar las denominaciones"))?.ToList() ?? new(); _cargado = true; } return request.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_grid is not null) await _grid.RefrescarAsync(); } private async Task Nuevo() { _nuevo = true; _edicion = new(); await _modal.ShowAsync(); } private async Task Editar(DenominacionMonedaFiscalDTO item) { _nuevo = false; _edicion = new() { IdDenominacion = item.IdDenominacion, CodMoneda = item.CodMoneda, Denominacion = item.Denominacion, Tipo = item.Tipo, Activo = item.Activo }; await _modal.ShowAsync(); } private async Task Guardar() { if (_edicion is null || _guardando) return; _edicion.Tipo = _edicion.Tipo?.Trim(); if (_edicion.CodMoneda <= 0 || _edicion.Denominacion <= 0 || string.IsNullOrWhiteSpace(_edicion.Tipo)) { await Dialogos.ErrorAsync("Indique la moneda, denominación y tipo."); return; } _guardando = true; var respuesta = _nuevo ? await Api.Crear(_edicion) : await Api.Actualizar(_edicion); _guardando = false; if (await Respuestas.CorrectaAsync(respuesta, "guardar la denominación")) { await _modal.HideAsync(); await Recargar(); } } private async Task Deshabilitar(DenominacionMonedaFiscalDTO item) { var respuesta = await Api.Deshabilitar(item.IdDenominacion); if (await Respuestas.CorrectaAsync(respuesta, "deshabilitar la denominación")) await Recargar(); } }
