@page "/parameters/bank"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IBancos Api
@inject ICajaOperaciones Caja
@inject IEmpresas Empresas
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

@*  ARQUETIPO 01 - CRUD DE CATALOGO
    ================================
    Modelo para los ~30 catalogos de la Ola 6. Que copiar:

      1. <AppPantalla> envuelve todo: comprueba el permiso por titulo, pone el
         encabezado y decide el aviso por ancho. Nunca comprobar permisos a mano.
      2. Los botones se muestran segun la accion del rol (Crear, Modificar, Borrar),
         pero eso es cortesia: quien autoriza de verdad es el API.
      3. Toda llamada pasa por IManejadorRespuestas. La pantalla no mira EsCorrecta
         ni compone mensajes de error.
      4. Confirmaciones y avisos por IServicioDialogos. Nunca la libreria directamente.
      5. La rejilla es <AppRejilla>, no HxGrid.

    Que adaptar: el DTO, las columnas, los campos del formulario y el titulo.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta">
    <Acciones>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Agregar">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
            </button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </Acciones>

    <ChildContent>
        <div class="card seepos-catalogo-bancos">
            <div class="card-body">
                <AppRejilla TItem="EntidadesBancariasDTO"
                            Datos="Cargar"
                            Nivel="NivelPantalla.Tableta"
                            TextoVacio="No hay bancos registrados."
                            @ref="_rejilla">
                    <Columnas>
                        <HxGridColumn TItem="EntidadesBancariasDTO" HeaderText="Banco"
                                      ItemTextSelector="b => b.Banco"
                                      SortKeySelector="b => b.Banco" />

                        <HxGridColumn TItem="EntidadesBancariasDTO" HeaderText="Estado"
                                      SortKeySelector="b => b.Activo">
                            <ItemTemplate Context="b">
                                <span class="badge @(b.Activo ? "text-bg-success" : "text-bg-secondary")">
                                    @(b.Activo ? "Activo" : "Inactivo")
                                </span>
                            </ItemTemplate>
                        </HxGridColumn>

                        <HxGridColumn TItem="EntidadesBancariasDTO" HeaderText=""
                                      HeaderCssClass="text-end" ItemCssClass="text-end">
                            <ItemTemplate Context="b">
                                @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Editar banco" aria-label="Editar banco"
                                            @onclick="() => Editar(b)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Administrar cuentas" aria-label="Administrar cuentas"
                                            @onclick="() => AbrirCuentas(b)"><i class="bi bi-bank"></i></button>
                                }
                                @if (Sesion.Puede(Titulo, AccionPantalla.Borrar))
                                {
                                    <button class="btn btn-sm @(b.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(b.Activo ? "Desactivar banco" : "Activar banco")" aria-label="@(b.Activo ? "Desactivar banco" : "Activar banco")"
                                            @onclick="() => AlternarEstado(b)">
                                        <i class="bi @(b.Activo ? "bi-slash-circle" : "bi-check-circle")"></i>
                                    </button>
                                }
                            </ItemTemplate>
                        </HxGridColumn>
                    </Columnas>
                </AppRejilla>
            </div>
        </div>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modal" Title="@(_edicion?.Id > 0 ? "Editar banco" : "Nuevo banco")" Size="ModalSize.Regular">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formBanco">
                <DataAnnotationsValidator />
                <AppCampoTexto Etiqueta="Nombre del banco" @bind-Valor="_edicion.Banco" />
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formBanco" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

@* ---------- Cuentas bancarias del banco ---------- *@
<HxModal @ref="_modalCuentas" Title="@($"Cuentas de {_bancoCuentas?.Banco}")" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4"><label class="form-label">Número de cuenta</label><input class="form-control form-control-sm" @bind="_cuentaNueva.Numero" /></div>
            <div class="col-6 col-md-3"><label class="form-label">Empresa</label><select class="form-select form-select-sm" @bind="_cuentaNueva.IdEmpresa"><option value="0">Seleccione...</option>@foreach (var e in _empresas) { <option value="@e.Id">@e.Nombre</option> }</select></div>
            <div class="col-6 col-md-3"><label class="form-label">Moneda</label><select class="form-select form-select-sm" @bind="_cuentaNueva.IdMoneda"><option value="0">Seleccione...</option>@foreach (var m in _monedas) { <option value="@m.CodMoneda">@m.MonedaNombre</option> }</select></div>
            <div class="col-12 col-md-2 d-grid"><button type="button" class="btn btn-outline-primary btn-sm" disabled="@_guardandoCuenta" @onclick="GuardarCuenta">@(_cuentaNueva.Id > 0 ? "Guardar" : "Agregar")</button></div>
        </div>
        @if (_cuentaNueva.Id > 0) { <div class="mt-1"><button type="button" class="btn btn-sm btn-link text-secondary p-0" @onclick="CancelarEdicionCuenta">Cancelar edición</button></div> }

        <div class="table-responsive mt-3">
            <table class="table table-sm">
                <thead><tr><th>Cuenta</th><th>Empresa</th><th>Moneda</th><th></th></tr></thead>
                <tbody>
                    @if (_cuentas.Count == 0) { <tr><td colspan="4" class="text-secondary text-center py-3">Este banco no tiene cuentas registradas.</td></tr> }
                    @foreach (var c in _cuentas)
                    {
                        <tr><td><code>@c.Numero</code></td><td>@c.Empresa</td><td>@c.Moneda</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => EditarCuenta(c)">Editar</button>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => QuitarCuenta(c)">Quitar</button>
                            </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modalCuentas.HideAsync()">Cerrar</button>
    </FooterTemplate>
</HxModal>

@code {
    /// <summary>Titulo del menu. Es la llave de permisos, asi que se escribe una sola vez.</summary>
    private const string Titulo = "Bancos";

    private AppRejilla<EntidadesBancariasDTO>? _rejilla;
    private HxModal _modal = default!;
    private HxModal _modalCuentas = default!;

    private List<EntidadesBancariasDTO> _bancos = new();
    private EntidadesBancariasDTO? _edicion;
    private bool _guardando;
    private bool _cargado;

    private EntidadesBancariasDTO? _bancoCuentas;
    private List<CuentaBancariaDTO> _cuentas = new();
    private CuentaBancariaDTO _cuentaNueva = new();
    private List<EmpresaDTO> _empresas = new();
    private List<Moneda> _monedas = new();
    private bool _guardandoCuenta;

    private async Task<GridDataProviderResult<EntidadesBancariasDTO>> Cargar(
        GridDataProviderRequest<EntidadesBancariasDTO> peticion)
    {
        if (!_cargado)
        {
            _bancos = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los bancos"))
                      ?.ToList() ?? new List<EntidadesBancariasDTO>();
            _cargado = true;
        }

        return peticion.ApplyTo(_bancos);
    }

    private async Task Recargar()
    {
        _cargado = false;
        if (_rejilla is not null)
        {
            await _rejilla.RefrescarAsync();
        }
    }

    private async Task Agregar()
    {
        _edicion = new EntidadesBancariasDTO { Activo = true };
        await _modal.ShowAsync();
    }

    private async Task Editar(EntidadesBancariasDTO banco)
    {
        // Se edita una copia: si el guardado falla, la fila de la rejilla no queda tocada.
        _edicion = new EntidadesBancariasDTO
        {
            Id = banco.Id,
            Banco = banco.Banco,
            Activo = banco.Activo
        };

        await _modal.ShowAsync();
    }

    private async Task Guardar()
    {
        if (_edicion is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_edicion.Banco))
        {
            await Dialogos.ErrorAsync("Indique el nombre del banco.");
            return;
        }

        _guardando = true;

        var r = _edicion.Id > 0
            ? await Api.Editar(_edicion)
            : await Api.Crear(_edicion);

        _guardando = false;

        var esNuevo = _edicion.Id == 0;

        if (await Respuestas.CorrectaAsync(r, esNuevo ? "crear el banco" : "editar el banco"))
        {
            await _modal.HideAsync();
            Dialogos.Exito(esNuevo ? "Banco creado." : "Banco actualizado.");
            await Recargar();
        }
    }

    private async Task AbrirCuentas(EntidadesBancariasDTO banco)
    {
        _bancoCuentas = banco;
        _cuentaNueva = new CuentaBancariaDTO { IdBanco = banco.Id };
        if (_empresas.Count == 0)
            _empresas = (await Respuestas.DatoAsync(await Caja.Empresas(), "consultar las empresas"))?.ToList() ?? new();
        if (_monedas.Count == 0)
            _monedas = (await Respuestas.DatoAsync(await Empresas.Monedas(), "consultar las monedas"))?.ToList() ?? new();
        await RecargarCuentas();
        await _modalCuentas.ShowAsync();
    }

    private async Task RecargarCuentas()
    {
        if (_bancoCuentas is null) return;
        _cuentas = (await Respuestas.DatoAsync(await Api.Cuentas(_bancoCuentas.Id), "consultar las cuentas del banco"))?.ToList() ?? new();
    }

    private void EditarCuenta(CuentaBancariaDTO c)
        => _cuentaNueva = new CuentaBancariaDTO { Id = c.Id, IdBanco = c.IdBanco, Numero = c.Numero, IdEmpresa = c.IdEmpresa, IdMoneda = c.IdMoneda };

    private void CancelarEdicionCuenta()
        => _cuentaNueva = new CuentaBancariaDTO { IdBanco = _bancoCuentas?.Id ?? 0 };

    private async Task GuardarCuenta()
    {
        if (_guardandoCuenta || _bancoCuentas is null) return;
        if (string.IsNullOrWhiteSpace(_cuentaNueva.Numero) || _cuentaNueva.IdEmpresa <= 0 || _cuentaNueva.IdMoneda <= 0)
        {
            await Dialogos.ErrorAsync("Indique número de cuenta, empresa y moneda.");
            return;
        }
        _cuentaNueva.IdBanco = _bancoCuentas.Id;
        _guardandoCuenta = true;
        var r = _cuentaNueva.Id > 0 ? await Api.EditarCuenta(_cuentaNueva) : await Api.CrearCuenta(_cuentaNueva);
        _guardandoCuenta = false;
        if (await Respuestas.CorrectaAsync(r, _cuentaNueva.Id > 0 ? "editar la cuenta" : "crear la cuenta"))
        {
            Dialogos.Exito(_cuentaNueva.Id > 0 ? "Cuenta actualizada." : "Cuenta agregada.");
            CancelarEdicionCuenta();
            await RecargarCuentas();
        }
    }

    private async Task QuitarCuenta(CuentaBancariaDTO c)
    {
        if (!await Dialogos.ConfirmarPeligroAsync($"La cuenta {c.Numero} dejará de estar disponible.", "Quitar cuenta")) return;
        if (await Respuestas.CorrectaAsync(await Api.InactivarCuenta(c.Id), "quitar la cuenta"))
        {
            Dialogos.Exito("Cuenta quitada.");
            await RecargarCuentas();
        }
    }

    private async Task AlternarEstado(EntidadesBancariasDTO banco)
    {
        var desactivar = banco.Activo;

        var confirmado = desactivar
            ? await Dialogos.ConfirmarPeligroAsync(
                $"El banco {banco.Banco} dejara de estar disponible.", "Desactivar banco")
            : await Dialogos.ConfirmarAsync(
                $"El banco {banco.Banco} volvera a estar disponible.", "Activar banco");

        if (!confirmado)
        {
            return;
        }

        var r = desactivar
            ? await Api.Inactivar(banco.Id)
            : await Api.Activar(banco.Id);

        if (await Respuestas.CorrectaAsync(r, desactivar ? "desactivar el banco" : "activar el banco"))
        {
            Dialogos.Exito(desactivar ? "Banco desactivado." : "Banco activado.");
            await Recargar();
        }
    }
}
