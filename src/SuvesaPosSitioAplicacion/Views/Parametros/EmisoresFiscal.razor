@page "/parameters/issuers"
@using Microsoft.AspNetCore.Components.Forms
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IEmisoresFiscales Api
@inject IEmpresas Empresas
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Crear">Crear emisor</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="EmisorFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Identificación" ItemTextSelector="x => x.Identificacion"/><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Nombre" ItemTextSelector="x => x.Nombre"/><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Correo" ItemTextSelector="x => x.Correo"/><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Credenciales"><ItemTemplate Context="x">@if (x.VenceCertificado is { } v) { <span class="badge @(v.Date < DateTime.Today ? "text-bg-danger" : "text-bg-success")">Certificado vence @v.ToString("dd/MM/yyyy")</span> } else { <span class="badge text-bg-secondary">Sin credenciales</span> }</ItemTemplate></HxGridColumn><HxGridColumn TItem="EmisorFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="() => Editar(x)">Datos públicos</button><button class="btn btn-sm btn-link" @onclick="() => Credenciales(x)">Credenciales</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modalPublico" Title="Datos públicos del emisor" Size="ModalSize.Large"><BodyTemplate>@if (_publico is not null) { <EditForm Model="_publico" OnValidSubmit="GuardarPublico" id="formEmisor"><div class="row g-3"><div class="col-md-3"><label class="form-label">Tipo identificación</label><select class="form-select" @bind="_publico.TipoIdentificacion"><option value="0">Seleccione...</option>@foreach (var t in _tiposIdentificacion) { <option value="@t.Id">@t.Descripcion</option> }</select></div><div class="col-md-3"><AppCampoTexto Etiqueta="Identificación" @bind-Valor="_publico.Identificacion" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_publico.Nombre" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Correo" @bind-Valor="_publico.Correo" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_publico.Telefono" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Sucursal" @bind-Valor="_publico.Sucursal" /></div><div class="col-md-6"><label class="form-label">Distrito</label><input class="form-control" type="number" min="1" @bind="_publico.Distrito" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Otras señas" @bind-Valor="_publico.OtrasSeñas" /></div><div class="col-12"><hr class="my-2" /><div class="fw-semibold mb-2">Actividades económicas</div><div class="row g-2 align-items-end"><div class="col-md-3"><AppCampoTexto Etiqueta="Código" @bind-Valor="_actCodigo" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_actDescripcion" /></div><div class="col-md-3 d-flex gap-2"><button type="button" class="btn btn-outline-primary" @onclick="AgregarActividad">Agregar</button><button type="button" class="btn btn-outline-secondary" disabled="@_buscandoActsEmisor" @onclick="BuscarActividadesEmisorHacienda">@(_buscandoActsEmisor ? "..." : "Hacienda")</button></div></div><table class="table table-sm align-middle mt-2"><thead><tr><th style="width:9rem">Código</th><th>Descripción</th><th style="width:6rem" class="text-center">Principal</th><th style="width:4rem"></th></tr></thead><tbody>@if (_publico.Actividades.Count == 0) { <tr><td colspan="4" class="text-secondary">Sin actividades.</td></tr> }@foreach (var a in _publico.Actividades) { <tr><td>@a.Codigo</td><td>@a.Descripcion</td><td class="text-center"><input type="radio" name="emisor-act-principal" checked="@a.Principal" @onchange="() => MarcarPrincipal(a)" /></td><td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => _publico.Actividades.Remove(a)">Quitar</button></td></tr> }</tbody></table></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modalPublico.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formEmisor" type="submit">Guardar</button></FooterTemplate></HxModal>
<HxModal @ref="_modalCredenciales" Title="Credenciales de Hacienda" Size="ModalSize.Regular"><BodyTemplate>@if (_credenciales is not null) { <EditForm Model="_credenciales" OnValidSubmit="GuardarCredenciales" id="formCredenciales"><p class="text-secondary small">Por seguridad, el usuario, la clave y el certificado nunca se muestran después de guardarlos. @if (_venceActual is { } v) { <text>Certificado actual vence el <strong>@v.ToString("dd/MM/yyyy")</strong>.</text> } else { <text>Este emisor no tiene credenciales cargadas.</text> }</p><div class="row g-3"><div class="col-12"><AppCampoTexto Etiqueta="Usuario de Hacienda" @bind-Valor="_credenciales.Usuario" /></div><div class="col-12"><label class="form-label">Clave de Hacienda</label><input class="form-control" type="password" autocomplete="new-password" @bind="_credenciales.Clave" /></div><div class="col-12"><label class="form-label">Certificado (.p12)</label><InputFile class="form-control" OnChange="CargarCertificado" /></div><div class="col-12"><label class="form-label">Contraseña del certificado</label><input class="form-control" type="password" autocomplete="new-password" @bind="_credenciales.ContrasenaCertificado" /></div><div class="col-12"><label class="form-label">Vencimiento del certificado</label><input class="form-control" type="date" @bind="_credenciales.VenceCertificado" /></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modalCredenciales.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formCredenciales" type="submit">Actualizar credenciales</button></FooterTemplate></HxModal>
<HxModal @ref="_modalCrear" Title="Nuevo emisor" Size="ModalSize.Large" Scrollable="true">
    <BodyTemplate>
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button type="button" class="nav-link @(_pestana == 0 ? "active" : null)" @onclick="() => _pestana = 0">Datos del Emisor</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(_pestana == 1 ? "active" : null)" @onclick="() => _pestana = 1">Ubicación</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(_pestana == 2 ? "active" : null)" @onclick="() => _pestana = 2">Hacienda y Firma digital</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(_pestana == 3 ? "active" : null)" @onclick="() => _pestana = 3">Actividades Económicas</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(_pestana == 4 ? "active" : null)" @onclick="() => _pestana = 4">Cuentas Bancarias</button></li>
        </ul>
        <EditForm Model="this" OnValidSubmit="GuardarCrear" id="formCrearEmisor">
            <div class="@(_pestana == 0 ? null : "d-none")">
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_tipoId">Tipo de identificación</label>
                        <select id="c_tipoId" class="form-select" @bind="_tipoIdentificacion">
                            <option value="0">Seleccione...</option>
                            @foreach (var t in _tiposIdentificacion) { <option value="@t.CodigoFe">@t.Descripcion</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Identificación (cédula)" @bind-Valor="_identificacion" Requerido="true" /></div>
                    <div class="col-12 col-md-6"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_nombre" Requerido="true" /></div>
                    <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Correo" @bind-Valor="_correo" /></div>
                    <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_telefono" /></div>
                    <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Sucursal" @bind-Valor="_sucursalNueva" /></div>
                </div>
            </div>
            <div class="@(_pestana == 1 ? null : "d-none")">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="c_provincia">Provincia</label>
                        <select id="c_provincia" class="form-select" @bind="_idProvincia" @bind:after="AlCambiarProvincia">
                            <option value="0">Seleccione...</option>
                            @foreach (var p in _provincias) { <option value="@p.Id">@p.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="c_canton">Cantón</label>
                        <select id="c_canton" class="form-select" @bind="_idCanton" @bind:after="AlCambiarCanton">
                            <option value="0">Seleccione...</option>
                            @foreach (var c in _cantones) { <option value="@c.Id">@c.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="c_distrito">Distrito</label>
                        <select id="c_distrito" class="form-select" @bind="_idDistrito">
                            <option value="0">Seleccione...</option>
                            @foreach (var d in _distritos) { <option value="@d.Id">@d.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-12"><AppCampoTexto Etiqueta="Otras señas" @bind-Valor="_otrasSenas" /></div>
                </div>
            </div>
            <div class="@(_pestana == 2 ? null : "d-none")">
                <div class="row g-3">
                    <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Usuario del API de Hacienda" @bind-Valor="_usuarioHacienda" /></div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="c_claveHacienda">Clave del API de Hacienda</label>
                        <input id="c_claveHacienda" type="password" class="form-control" autocomplete="new-password" @bind="_claveHacienda" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="c_archivoCertificado">Certificado (.p12)</label>
                        <InputFile id="c_archivoCertificado" class="form-control" OnChange="CargarCertificadoCrear" />
                        @if (!string.IsNullOrEmpty(_nombreCertificado)) { <div class="form-text">@_nombreCertificado</div> }
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_claveCertificado">Contraseña del certificado</label>
                        <input id="c_claveCertificado" type="password" class="form-control" autocomplete="new-password" @bind="_contrasenaCertificado" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-3"><AppCampoTexto Etiqueta="Número de resolución" @bind-Valor="_numeroResolucion" /></div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_fechaResolucion">Fecha de resolución</label>
                        <input id="c_fechaResolucion" type="date" class="form-control" @bind="_fechaResolucion" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_venceCertificado">Vence el certificado</label>
                        <input id="c_venceCertificado" type="date" class="form-control" @bind="_venceCertificado" />
                    </div>
                </div>
            </div>
            <div class="@(_pestana == 3 ? null : "d-none")">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-12 col-md-4">
                        <button type="button" class="btn btn-outline-primary" disabled="@_buscandoActividades" @onclick="BuscarActividadesHacienda">
                            @(_buscandoActividades ? "Consultando..." : "Consultar en Hacienda")
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Código</th><th>Descripción</th><th></th></tr></thead>
                        <tbody>
                            @if (_actividades.Count == 0) { <tr><td colspan="3" class="text-secondary">Sin actividades agregadas todavía.</td></tr> }
                            @foreach (var a in _actividades)
                            {
                                <tr>
                                    <td>@a.Codigo</td>
                                    <td>@a.Descripcion</td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => _actividades.Remove(a)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="@(_pestana == 4 ? null : "d-none")">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_bancoNuevo">Banco</label>
                        <select id="c_bancoNuevo" class="form-select" @bind="_idBancoNuevo">
                            <option value="0">Seleccione...</option>
                            @foreach (var b in _bancos) { <option value="@b.Id">@b.Banco</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_monedaNueva">Moneda</label>
                        <select id="c_monedaNueva" class="form-select" @bind="_idMonedaNueva">
                            <option value="0">Seleccione...</option>
                            @foreach (var m in _monedas) { <option value="@m.CodMoneda">@m.MonedaNombre</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="c_numeroNuevo">Número de cuenta</label>
                        <input id="c_numeroNuevo" class="form-control" @bind="_numeroCuentaNueva" />
                    </div>
                    <div class="col-12 col-md-3"><button type="button" class="btn btn-success w-100" @onclick="AgregarCuenta"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar</button></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Banco</th><th>Moneda</th><th>Número</th><th></th></tr></thead>
                        <tbody>
                            @if (_cuentas.Count == 0) { <tr><td colspan="4" class="text-secondary">Sin cuentas agregadas todavía.</td></tr> }
                            @foreach (var c in _cuentas)
                            {
                                <tr>
                                    <td>@c.Banco</td>
                                    <td>@c.Moneda</td>
                                    <td>@c.Numero</td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => _cuentas.Remove(c)"><i class="bi bi-trash" aria-hidden="true"></i> Quitar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => _modalCrear.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" form="formCrearEmisor" type="submit" disabled="@_guardando">@(_guardando ? "Guardando..." : "Registrar emisor")</button>
    </FooterTemplate>
</HxModal>
@code { private const string Titulo = "Emisores"; private const long TamanoMaximoCertificado = 5 * 1024 * 1024; private AppRejilla<EmisorFiscalDTO>? _grid; private HxModal _modalPublico = default!, _modalCredenciales = default!; private List<EmisorFiscalDTO> _items = new(); private EmisorFiscalDTO? _publico; private CredencialesHaciendaFiscalDTO? _credenciales; private DateTime? _venceActual; private bool _cargado; private async Task<GridDataProviderResult<EmisorFiscalDTO>> Cargar(GridDataProviderRequest<EmisorFiscalDTO> request) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los emisores"))?.ToList() ?? new(); _cargado = true; } return request.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_grid is not null) await _grid.RefrescarAsync(); } private async Task Editar(EmisorFiscalDTO e) { _publico = new() { Id = e.Id, TipoIdentificacion = e.TipoIdentificacion, Identificacion = e.Identificacion, Nombre = e.Nombre, Correo = e.Correo, Telefono = e.Telefono, Sucursal = e.Sucursal, Distrito = e.Distrito, OtrasSeñas = e.OtrasSeñas, Actividades = e.Actividades?.Select(a => new ActividadEconomicaEmisorDTO { Codigo = a.Codigo, Descripcion = a.Descripcion, Activo = a.Activo, Principal = a.Principal }).ToList() ?? new() }; _actCodigo = _actDescripcion = string.Empty; await CargarCatalogos(); await _modalPublico.ShowAsync(); } private async Task Credenciales(EmisorFiscalDTO e) { _credenciales = new() { IdEmisor = e.Id, VenceCertificado = e.VenceCertificado }; _venceActual = e.VenceCertificado; await _modalCredenciales.ShowAsync(); } private async Task GuardarPublico() { if (_publico is null || _publico.Id <= 0 || _publico.TipoIdentificacion <= 0 || _publico.Distrito <= 0 || string.IsNullOrWhiteSpace(_publico.Identificacion) || string.IsNullOrWhiteSpace(_publico.Nombre) || string.IsNullOrWhiteSpace(_publico.Correo) || string.IsNullOrWhiteSpace(_publico.Telefono) || string.IsNullOrWhiteSpace(_publico.Sucursal) || string.IsNullOrWhiteSpace(_publico.OtrasSeñas)) { await Dialogos.ErrorAsync("Complete todos los datos públicos requeridos."); return; } if (await Respuestas.CorrectaAsync(await Api.Actualizar(_publico), "actualizar el emisor")) { Dialogos.Exito("Datos del emisor actualizados."); await _modalPublico.HideAsync(); await Recargar(); } } private async Task CargarCertificado(InputFileChangeEventArgs evento) { if (_credenciales is null) return; try { await using var flujo = evento.File.OpenReadStream(TamanoMaximoCertificado); using var memoria = new MemoryStream(); await flujo.CopyToAsync(memoria); _credenciales.Certificado = Convert.ToBase64String(memoria.ToArray()); } catch (Exception ex) when (ex is IOException or InvalidOperationException) { await Dialogos.ErrorAsync("No se pudo leer el certificado."); } } private async Task GuardarCredenciales() { if (_credenciales is null || string.IsNullOrWhiteSpace(_credenciales.Usuario) || string.IsNullOrWhiteSpace(_credenciales.Clave) || string.IsNullOrWhiteSpace(_credenciales.Certificado) || string.IsNullOrWhiteSpace(_credenciales.ContrasenaCertificado)) { await Dialogos.ErrorAsync("Indique usuario, clave, certificado y contraseña del certificado."); return; } if (await Respuestas.CorrectaAsync(await Api.ActualizarCredenciales(_credenciales), "actualizar las credenciales")) { Dialogos.Exito("Credenciales de Hacienda actualizadas."); _credenciales = null; _venceActual = null; await _modalCredenciales.HideAsync(); await Recargar(); } } }
