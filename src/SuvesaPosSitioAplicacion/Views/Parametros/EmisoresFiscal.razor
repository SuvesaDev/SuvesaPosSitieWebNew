@page "/parameters/issuers"
@using Microsoft.AspNetCore.Components.Forms
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IEmisoresFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject NavigationManager Navegacion

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Crear">Crear emisor</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="EmisorFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Identificación" ItemTextSelector="x => x.Identificacion"/><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Nombre" ItemTextSelector="x => x.Nombre"/><HxGridColumn TItem="EmisorFiscalDTO" HeaderText="Correo" ItemTextSelector="x => x.Correo"/><HxGridColumn TItem="EmisorFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="() => Editar(x)">Datos públicos</button><button class="btn btn-sm btn-link" @onclick="() => Credenciales(x)">Credenciales</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modalPublico" Title="Datos públicos del emisor" Size="ModalSize.Large"><BodyTemplate>@if (_publico is not null) { <EditForm Model="_publico" OnValidSubmit="GuardarPublico" id="formEmisor"><div class="row g-3"><div class="col-md-3"><label class="form-label">Tipo identificación</label><input class="form-control" type="number" min="1" @bind="_publico.TipoIdentificacion" /></div><div class="col-md-3"><AppCampoTexto Etiqueta="Identificación" @bind-Valor="_publico.Identificacion" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_publico.Nombre" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Correo" @bind-Valor="_publico.Correo" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_publico.Telefono" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Sucursal" @bind-Valor="_publico.Sucursal" /></div><div class="col-md-6"><label class="form-label">Distrito</label><input class="form-control" type="number" min="1" @bind="_publico.Distrito" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Otras señas" @bind-Valor="_publico.OtrasSeñas" /></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modalPublico.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formEmisor" type="submit">Guardar</button></FooterTemplate></HxModal>
<HxModal @ref="_modalCredenciales" Title="Credenciales de Hacienda" Size="ModalSize.Regular"><BodyTemplate>@if (_credenciales is not null) { <EditForm Model="_credenciales" OnValidSubmit="GuardarCredenciales" id="formCredenciales"><p class="text-secondary small">Por seguridad, estos valores nunca se cargan ni se muestran después de guardarlos.</p><div class="row g-3"><div class="col-12"><AppCampoTexto Etiqueta="Usuario de Hacienda" @bind-Valor="_credenciales.Usuario" /></div><div class="col-12"><label class="form-label">Clave de Hacienda</label><input class="form-control" type="password" autocomplete="new-password" @bind="_credenciales.Clave" /></div><div class="col-12"><label class="form-label">Certificado (.p12)</label><InputFile class="form-control" OnChange="CargarCertificado" /></div><div class="col-12"><label class="form-label">Contraseña del certificado</label><input class="form-control" type="password" autocomplete="new-password" @bind="_credenciales.ContrasenaCertificado" /></div><div class="col-12"><label class="form-label">Vencimiento del certificado</label><input class="form-control" type="date" @bind="_credenciales.VenceCertificado" /></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modalCredenciales.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formCredenciales" type="submit">Actualizar credenciales</button></FooterTemplate></HxModal>
@code { private const string Titulo = "Emisores"; private const long TamanoMaximoCertificado = 5 * 1024 * 1024; private AppRejilla<EmisorFiscalDTO>? _grid; private HxModal _modalPublico = default!, _modalCredenciales = default!; private List<EmisorFiscalDTO> _items = new(); private EmisorFiscalDTO? _publico; private CredencialesHaciendaFiscalDTO? _credenciales; private bool _cargado; private async Task<GridDataProviderResult<EmisorFiscalDTO>> Cargar(GridDataProviderRequest<EmisorFiscalDTO> request) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los emisores"))?.ToList() ?? new(); _cargado = true; } return request.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_grid is not null) await _grid.RefrescarAsync(); } private async Task Editar(EmisorFiscalDTO e) { _publico = new() { Id = e.Id, TipoIdentificacion = e.TipoIdentificacion, Identificacion = e.Identificacion, Nombre = e.Nombre, Correo = e.Correo, Telefono = e.Telefono, Sucursal = e.Sucursal, Distrito = e.Distrito, OtrasSeñas = e.OtrasSeñas }; await _modalPublico.ShowAsync(); } private async Task Credenciales(EmisorFiscalDTO e) { _credenciales = new() { IdEmisor = e.Id }; await _modalCredenciales.ShowAsync(); } private async Task GuardarPublico() { if (_publico is null || _publico.Id <= 0 || _publico.TipoIdentificacion <= 0 || _publico.Distrito <= 0 || string.IsNullOrWhiteSpace(_publico.Identificacion) || string.IsNullOrWhiteSpace(_publico.Nombre) || string.IsNullOrWhiteSpace(_publico.Correo) || string.IsNullOrWhiteSpace(_publico.Telefono) || string.IsNullOrWhiteSpace(_publico.Sucursal) || string.IsNullOrWhiteSpace(_publico.OtrasSeñas)) { await Dialogos.ErrorAsync("Complete todos los datos públicos requeridos."); return; } if (await Respuestas.CorrectaAsync(await Api.Actualizar(_publico), "actualizar el emisor")) { await _modalPublico.HideAsync(); await Recargar(); } } private async Task CargarCertificado(InputFileChangeEventArgs evento) { if (_credenciales is null) return; try { await using var flujo = evento.File.OpenReadStream(TamanoMaximoCertificado); using var memoria = new MemoryStream(); await flujo.CopyToAsync(memoria); _credenciales.Certificado = Convert.ToBase64String(memoria.ToArray()); } catch (Exception ex) when (ex is IOException or InvalidOperationException) { await Dialogos.ErrorAsync("No se pudo leer el certificado."); } } private async Task GuardarCredenciales() { if (_credenciales is null || string.IsNullOrWhiteSpace(_credenciales.Usuario) || string.IsNullOrWhiteSpace(_credenciales.Clave) || string.IsNullOrWhiteSpace(_credenciales.Certificado) || string.IsNullOrWhiteSpace(_credenciales.ContrasenaCertificado)) { await Dialogos.ErrorAsync("Indique usuario, clave, certificado y contraseña del certificado."); return; } if (await Respuestas.CorrectaAsync(await Api.ActualizarCredenciales(_credenciales), "actualizar las credenciales")) { _credenciales = null; await _modalCredenciales.HideAsync(); } } }
