@page "/parameters/payment-methods"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IFormasPagoFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="FormasPagoDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="FormasPagoDTO" HeaderText="Descripción" ItemTextSelector="x=>x.Descripcion"/><HxGridColumn TItem="FormasPagoDTO" HeaderText="Código" ItemTextSelector="x=>x.Codigo"/><HxGridColumn TItem="FormasPagoDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="()=>Editar(x)">Editar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@ModalTitulo" Size="ModalSize.Regular"><BodyTemplate>@if(_edicion is not null){<EditForm Model="_edicion" OnValidSubmit="Guardar" id="forma"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion"/><AppCampoTexto Etiqueta="Código" @bind-Valor="_edicion.Codigo"/><div class="d-flex gap-3 mt-3"><label><input type="checkbox" @bind="_edicion.Efectivo"/> Efectivo</label><label><input type="checkbox" @bind="_edicion.Tarjeta"/> Tarjeta</label><label><input type="checkbox" @bind="_edicion.Deposito"/> Depósito</label><label><input type="checkbox" @bind="_edicion.Cheque"/> Cheque</label></div></EditForm>}</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="()=>_modal.HideAsync()">Cancelar</button><button class="btn btn-primary" type="submit" form="forma">Guardar</button></FooterTemplate></HxModal>
@code{const string Titulo="Formas de Pago";AppRejilla<FormasPagoDTO>? _grid;HxModal _modal=default!;List<FormasPagoDTO> _items=new();FormasPagoDTO? _edicion;bool _nuevo,_cargado;string ModalTitulo=>_nuevo?"Nueva forma de pago":"Editar forma de pago";async Task<GridDataProviderResult<FormasPagoDTO>> Cargar(GridDataProviderRequest<FormasPagoDTO> r){if(!_cargado){_items=(await Respuestas.DatoAsync(await Api.Obtener(),"consultar las formas de pago"))?.ToList()??new();_cargado=true;}return r.ApplyTo(_items);}async Task Nuevo(){_nuevo=true;_edicion=new();await _modal.ShowAsync();}async Task Editar(FormasPagoDTO x){_nuevo=false;_edicion=new(){Id=x.Id,Codigo=x.Codigo,Descripcion=x.Descripcion,Efectivo=x.Efectivo,Tarjeta=x.Tarjeta,Deposito=x.Deposito,Cheque=x.Cheque};await _modal.ShowAsync();}async Task Guardar(){if(_edicion is null||string.IsNullOrWhiteSpace(_edicion.Descripcion)||_edicion.Codigo?.Trim().Length!=2||!_edicion.Codigo.All(char.IsDigit)||!(_edicion.Efectivo||_edicion.Tarjeta||_edicion.Deposito||_edicion.Cheque)){await Dialogos.ErrorAsync("Indique descripción, código de dos dígitos y al menos una clasificación.");return;}_edicion.Codigo=_edicion.Codigo.Trim();var r=_nuevo?await Api.Crear(_edicion):await Api.Actualizar(_edicion);if(await Respuestas.CorrectaAsync(r,"guardar la forma de pago")){await _modal.HideAsync();_cargado=false;if(_grid is not null)await _grid.RefrescarAsync();}}}
