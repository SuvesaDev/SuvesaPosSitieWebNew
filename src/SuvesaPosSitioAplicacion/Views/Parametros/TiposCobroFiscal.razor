@page "/parameters/collection-types"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ITiposCobroFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="TipoCobroFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="TipoCobroFiscalDTO" HeaderText="Descripción" ItemTextSelector="x=>x.Descripcion"/><HxGridColumn TItem="TipoCobroFiscalDTO" HeaderText="Uso"><ItemTemplate Context="x">@(x.EsEntregaCuenta ? "Entrega a cuenta" : x.EsUsoCuenta ? "Uso a cuenta" : "Pago")</ItemTemplate></HxGridColumn><HxGridColumn TItem="TipoCobroFiscalDTO" HeaderText="Estado"><ItemTemplate Context="x">@(x.Activo ? "Activo" : "Inactivo")</ItemTemplate></HxGridColumn><HxGridColumn TItem="TipoCobroFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="()=>Editar(x)">Editar</button>@if(x.Activo){<button class="btn btn-sm btn-link text-danger" @onclick="()=>Deshabilitar(x)">Deshabilitar</button>}</ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@ModalTitulo" Size="ModalSize.Regular"><BodyTemplate>@if(_edicion is not null){<EditForm Model="_edicion" OnValidSubmit="Guardar" id="formCobro"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion"/><div class="form-check mt-3"><input id="entrega" type="checkbox" class="form-check-input" @bind="_edicion.EsEntregaCuenta"/><label class="form-check-label" for="entrega">Entrega a cuenta</label></div><div class="form-check"><input id="uso" type="checkbox" class="form-check-input" @bind="_edicion.EsUsoCuenta"/><label class="form-check-label" for="uso">Uso a cuenta</label></div></EditForm>}</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="()=>_modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formCobro" type="submit">Guardar</button></FooterTemplate></HxModal>
@code{const string Titulo="Tipos de Cobro";AppRejilla<TipoCobroFiscalDTO>? _grid;HxModal _modal=default!;List<TipoCobroFiscalDTO> _items=new();TipoCobroFiscalDTO? _edicion;bool _nuevo,_cargado;string ModalTitulo=>_nuevo?"Nuevo tipo de cobro":"Editar tipo de cobro";async Task<GridDataProviderResult<TipoCobroFiscalDTO>> Cargar(GridDataProviderRequest<TipoCobroFiscalDTO> r){if(!_cargado){_items=(await Respuestas.DatoAsync(await Api.Obtener(),"consultar los tipos de cobro"))?.ToList()??new();_cargado=true;}return r.ApplyTo(_items);}async Task Nuevo(){_nuevo=true;_edicion=new();await _modal.ShowAsync();}async Task Editar(TipoCobroFiscalDTO x){_nuevo=false;_edicion=new(){IdTipoCobro=x.IdTipoCobro,Descripcion=x.Descripcion,Activo=x.Activo,EsEntregaCuenta=x.EsEntregaCuenta,EsUsoCuenta=x.EsUsoCuenta};await _modal.ShowAsync();}async Task Guardar(){if(_edicion is null||string.IsNullOrWhiteSpace(_edicion.Descripcion)){await Dialogos.ErrorAsync("Indique la descripción.");return;}var r=_nuevo?await Api.Crear(_edicion):await Api.Actualizar(_edicion);if(await Respuestas.CorrectaAsync(r,"guardar el tipo de cobro")){await _modal.HideAsync();_cargado=false;if(_grid is not null)await _grid.RefrescarAsync();}}async Task Deshabilitar(TipoCobroFiscalDTO x){var r=await Api.Deshabilitar(x.IdTipoCobro);if(await Respuestas.CorrectaAsync(r,"deshabilitar el tipo de cobro")){_cargado=false;if(_grid is not null)await _grid.RefrescarAsync();}}}
