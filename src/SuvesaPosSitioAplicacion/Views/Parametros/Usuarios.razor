@page "/parameters/users"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Seguridad
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@using System.Text.RegularExpressions
@inject IUsuarios Api
@inject IPerfiles ApiPerfiles
@inject IRolesPermisos ApiRoles
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

@*  Rediseno de seguridad V2.

    - El PERFIL (SUPER_ADMIN / ADMIN / USUARIO / ...) se elige al crear. La opcion
      SUPER_ADMIN solo aparece si el usuario en sesion tambien es Super Administrador
      (la compuerta real la aplica el API).
    - Todo perfil que NO sea SUPER_ADMIN exige un ROL asignado.
    - Las capacidades CostaPets / AgenteCostaPets se HEREDAN del perfil: aqui son de
      solo lectura.
    - El perfil y el rol de un usuario ya creado se cambian desde la tabla, con
      endpoints propios (/seguridad/usuarios/{id}/perfil y /rol).
    - La clave viaja siempre en el cuerpo, nunca en la URL.
*@

<AppPantalla Pantalla="@Titulo" Codigo="@Codigo" Icono="bi-person-badge-fill" Subtitulo="Alta de usuarios y asignación de perfil y rol" Nivel="NivelPantalla.Escritorio">
    <Acciones>
        @if (Sesion.Puede(Codigo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Agregar">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
            </button>
        }
    </Acciones>

    <ChildContent>

        <div class="mb-3">
            <input type="search" class="form-control"
                   placeholder="Nombre de usuario..."
                   aria-label="Buscar usuario"
                   value="@_texto" @onchange="AlEscribir" />
        </div>

        <div class="card">
            <div class="card-body">
                <AppRejilla TItem="BuscarUsuarioDTO" Datos="Cargar" @ref="_rejilla"
                            TextoVacio="No hay usuarios que coincidan.">
                    <Columnas>
                        <HxGridColumn TItem="BuscarUsuarioDTO" HeaderText="Usuario"
                                      ItemTextSelector="u => u.IdUsuario"
                                      SortKeySelector="u => u.IdUsuario" />
                        <HxGridColumn TItem="BuscarUsuarioDTO" HeaderText="Nombre"
                                      ItemTextSelector="u => u.Nombre"
                                      SortKeySelector="u => u.Nombre" />
                        <HxGridColumn TItem="BuscarUsuarioDTO" HeaderText=""
                                      HeaderCssClass="text-end" ItemCssClass="text-end">
                            <ItemTemplate Context="u">
                                @if (Sesion.Puede(Codigo, AccionPantalla.Modificar))
                                {
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => Editar(u)">Editar</button>
                                    <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => AbrirCambioPerfil(u)">Perfil / rol</button>
                                }
                            </ItemTemplate>
                        </HxGridColumn>
                    </Columnas>
                </AppRejilla>
            </div>
        </div>

    </ChildContent>
</AppPantalla>

@* ---------- Modal alta / edicion ---------- *@
<HxModal @ref="_modal" Title="@(_esNuevo ? "Nuevo usuario" : "Editar usuario")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formUsuario">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <AppCampoTexto Etiqueta="Usuario (login)" @bind-Valor="_edicion.IdUsuario"
                                       Deshabilitado="@(!_esNuevo)" Requerido="true" />
                        @if (!_esNuevo)
                        {
                            <div class="form-text">El usuario de acceso no se puede cambiar.</div>
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <AppCampoTexto Etiqueta="Nombre completo" @bind-Valor="_edicion.Nombre" Requerido="true" />
                    </div>

                    @if (_esNuevo)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="perfil">Perfil <span class="text-danger">*</span></label>
                            <select id="perfil" class="form-select" @bind="_idPerfilNuevo" @bind:after="AlCambiarPerfilNuevo">
                                <option value="0">Seleccione...</option>
                                @foreach (var p in PerfilesVisibles())
                                {
                                    <option value="@p.IdPerfil">@p.Descripcion</option>
                                }
                            </select>
                        </div>

                        @if (!PerfilElegidoEsSuper())
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="rol">Rol <span class="text-danger">*</span></label>
                                <select id="rol" class="form-select" @bind="_idRolNuevo">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var r in _roles.Where(r => r.Activo))
                                    {
                                        <option value="@r.IdRol">@r.Nombre</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label">Rol</label>
                                <input class="form-control" disabled value="No aplica (Super Administración)" />
                            </div>
                        }

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="clave">Contraseña <span class="text-danger">*</span></label>
                            <input id="clave" type="password" class="form-control" autocomplete="new-password"
                                   @bind="_clave" @bind:event="oninput" />
                            <div class="form-text">
                                Minimo 8 caracteres, con mayuscula, minuscula, numero y un caracter especial.
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="claveConfirmar">Confirmar contraseña <span class="text-danger">*</span></label>
                            <input id="claveConfirmar" type="password" class="form-control" autocomplete="new-password"
                                   @bind="_claveConfirmar" @bind:event="oninput" />
                        </div>
                    }
                    else
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label">Perfil</label>
                            <input class="form-control" disabled value="@NombrePerfil(_perfilActual)" />
                            <div class="form-text">Se cambia desde la accion "Perfil / rol" de la tabla.</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Rol</label>
                            <input class="form-control" disabled
                                   value="@(_roles.FirstOrDefault(r => r.IdRol == _idRolActual)?.Nombre ?? "—")" />
                        </div>
                    }

                    <div class="col-12">
                        <AppCampoTexto Etiqueta="Correo" @bind-Valor="_edicion.Email" />
                    </div>
                    <div class="col-12">
                        <AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_edicion.Observaciones" />
                    </div>

                    @if (_perfilActual is { } pa && (pa.CostaPets || pa.AgenteCostaPets || pa.AceptaConsignacion))
                    {
                        <div class="col-12">
                            <div class="form-text">
                                Capacidades heredadas del perfil <strong>@pa.Descripcion</strong>:
                                @(string.Join(", ", CapacidadesDe(pa)))
                            </div>
                        </div>
                    }

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="activo" @bind="_edicion.Activo" />
                            <label class="form-check-label" for="activo">Activo</label>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formUsuario" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

@* ---------- Modal cambiar perfil / rol ---------- *@
<HxModal @ref="_modalPerfil" Title="Perfil y rol del usuario" Size="ModalSize.Regular">
    <BodyTemplate>
        <div class="row g-3">
            <div class="col-12">
                <strong>@_perfilUsuario</strong>
            </div>
            <div class="col-12">
                <label class="form-label" for="perfilCambio">Perfil</label>
                <select id="perfilCambio" class="form-select" @bind="_idPerfilCambio" @bind:after="AlCambiarPerfilCambio">
                    @foreach (var p in PerfilesVisibles())
                    {
                        <option value="@p.IdPerfil">@p.Descripcion</option>
                    }
                </select>
            </div>
            @if (!PerfilCambioEsSuper())
            {
                <div class="col-12">
                    <label class="form-label" for="rolCambio">Rol</label>
                    <select id="rolCambio" class="form-select" @bind="_idRolCambio">
                        <option value="0">Seleccione...</option>
                        @foreach (var r in _roles.Where(r => r.Activo))
                        {
                            <option value="@r.IdRol">@r.Nombre</option>
                        }
                    </select>
                </div>
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modalPerfil.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" disabled="@_guardando" @onclick="GuardarCambioPerfil">
            @(_guardando ? "Guardando..." : "Guardar")
        </button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Titulo = "Usuarios";
    private const string Codigo = "PARAMETROS.USUARIOS";

    private static readonly Regex ReglaClave =
        new(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,}$");

    private AppRejilla<BuscarUsuarioDTO>? _rejilla;
    private HxModal _modal = default!;
    private HxModal _modalPerfil = default!;

    private List<PerfilSeguridadDTO> _perfiles = new();
    private List<RolResumenDTO> _roles = new();

    private string _texto = string.Empty;

    private UsuarioBase? _edicion;
    private bool _esNuevo;
    private long _idActual;
    private int _idRolActual;
    private PerfilSeguridadDTO? _perfilActual;

    private int _idPerfilNuevo;
    private int _idRolNuevo;
    private string _clave = string.Empty;
    private string _claveConfirmar = string.Empty;
    private bool _guardando;

    // cambio de perfil/rol desde la tabla
    private long _idUsuarioCambio;
    private string _perfilUsuario = string.Empty;
    private int _idPerfilCambio;
    private int _idRolCambio;

    private sealed class UsuarioBase
    {
        public string? IdUsuario { get; set; }
        public string? Nombre { get; set; }
        public string? Email { get; set; }
        public string? Observaciones { get; set; }
        public bool Activo { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        _perfiles = (await Respuestas.DatoAsync(await ApiPerfiles.Listar(), "consultar los perfiles"))
                    ?.ToList() ?? new List<PerfilSeguridadDTO>();
        _roles = (await Respuestas.DatoAsync(await ApiRoles.Roles(), "consultar los roles"))
                 ?.ToList() ?? new List<RolResumenDTO>();
    }

    private IEnumerable<PerfilSeguridadDTO> PerfilesVisibles()
        => _perfiles.Where(p => p.Activo &&
                                (Sesion.EsSuperAdministrador || !p.EsSuperAdministracion));

    private bool PerfilElegidoEsSuper()
        => _perfiles.FirstOrDefault(p => p.IdPerfil == _idPerfilNuevo)?.EsSuperAdministracion ?? false;

    private bool PerfilCambioEsSuper()
        => _perfiles.FirstOrDefault(p => p.IdPerfil == _idPerfilCambio)?.EsSuperAdministracion ?? false;

    private void AlCambiarPerfilNuevo()
    {
        if (PerfilElegidoEsSuper()) _idRolNuevo = 0;
        _perfilActual = _perfiles.FirstOrDefault(p => p.IdPerfil == _idPerfilNuevo);
    }

    private void AlCambiarPerfilCambio()
    {
        if (PerfilCambioEsSuper()) _idRolCambio = 0;
    }

    private static string NombrePerfil(PerfilSeguridadDTO? p) => p?.Descripcion ?? "—";

    private static IEnumerable<string> CapacidadesDe(PerfilSeguridadDTO p)
    {
        if (p.CostaPets) yield return "CostaPets";
        if (p.AgenteCostaPets) yield return "Agente CostaPets";
        if (p.AceptaConsignacion) yield return "Acepta consignación";
    }

    private async Task<GridDataProviderResult<BuscarUsuarioDTO>> Cargar(
        GridDataProviderRequest<BuscarUsuarioDTO> peticion)
    {
        var r = await Respuestas.DatoAsync(await Api.Buscar(_texto), "buscar usuarios");
        return peticion.ApplyTo(r?.ToList() ?? new List<BuscarUsuarioDTO>());
    }

    private async Task AlEscribir(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? string.Empty;
        if (_rejilla is not null) await _rejilla.RefrescarAsync();
    }

    private async Task Agregar()
    {
        _esNuevo = true;
        _idActual = 0;
        _idPerfilNuevo = 0;
        _idRolNuevo = 0;
        _idRolActual = 0;
        _perfilActual = null;
        _clave = string.Empty;
        _claveConfirmar = string.Empty;
        _edicion = new UsuarioBase();
        await _modal.ShowAsync();
    }

    private async Task Editar(BuscarUsuarioDTO resumen)
    {
        var completo = await Respuestas.DatoAsync(
            await Api.ObtenerUno(resumen.IdUsuario ?? string.Empty), "obtener el usuario");
        if (completo is null) return;

        _esNuevo = false;
        _idActual = completo.Id ?? 0;
        _idRolActual = completo.IdRol ?? 0;
        _perfilActual = _perfiles.FirstOrDefault(p => p.IdPerfil == completo.IdPerfil);

        _edicion = new UsuarioBase
        {
            IdUsuario = completo.IdUsuario,
            Nombre = completo.Nombre,
            Email = completo.Email,
            Observaciones = completo.Observaciones,
            Activo = completo.Activo
        };

        await _modal.ShowAsync();
    }

    private async Task AbrirCambioPerfil(BuscarUsuarioDTO resumen)
    {
        var completo = await Respuestas.DatoAsync(
            await Api.ObtenerUno(resumen.IdUsuario ?? string.Empty), "obtener el usuario");
        if (completo is null) return;

        _idUsuarioCambio = completo.Id ?? 0;
        _perfilUsuario = $"{completo.Nombre} ({completo.IdUsuario})";
        _idPerfilCambio = completo.IdPerfil;
        _idRolCambio = completo.IdRol ?? 0;
        await _modalPerfil.ShowAsync();
    }

    private async Task GuardarCambioPerfil()
    {
        if (_guardando || _idUsuarioCambio == 0) return;
        _guardando = true;

        var okPerfil = await Respuestas.CorrectaAsync(
            await Api.CambiarPerfil(_idUsuarioCambio, _idPerfilCambio), "cambiar el perfil");

        bool okRol = true;
        if (okPerfil && !PerfilCambioEsSuper())
        {
            okRol = await Respuestas.CorrectaAsync(
                await Api.CambiarRol(_idUsuarioCambio, _idRolCambio > 0 ? _idRolCambio : null),
                "cambiar el rol");
        }

        _guardando = false;

        if (okPerfil && okRol)
        {
            await _modalPerfil.HideAsync();
            Dialogos.Exito("Perfil y rol actualizados.");
            if (_rejilla is not null) await _rejilla.RefrescarAsync();
        }
    }

    private async Task Guardar()
    {
        if (_edicion is null || _guardando) return;

        if (string.IsNullOrWhiteSpace(_edicion.IdUsuario) || string.IsNullOrWhiteSpace(_edicion.Nombre))
        {
            await Dialogos.ErrorAsync("Indique el usuario y el nombre.");
            return;
        }

        if (_esNuevo)
        {
            if (_idPerfilNuevo == 0)
            {
                Dialogos.ErrorBreve("Seleccione el perfil.");
                return;
            }
            if (!PerfilElegidoEsSuper() && _idRolNuevo == 0)
            {
                Dialogos.ErrorBreve("Este perfil exige un rol asignado.");
                return;
            }
            if (!ClaveValida()) return;
        }

        _guardando = true;
        var r = _esNuevo ? await GuardarNuevoAsync() : await GuardarEdicionAsync();
        _guardando = false;

        if (r)
        {
            await _modal.HideAsync();
            Dialogos.Exito(_esNuevo ? "Usuario creado." : "Usuario actualizado.");
            if (_rejilla is not null) await _rejilla.RefrescarAsync();
        }
    }

    private bool ClaveValida()
    {
        if (!ReglaClave.IsMatch(_clave))
        {
            Dialogos.ErrorBreve(
                "La contrasena debe tener minimo 8 caracteres, con mayuscula, " +
                "minuscula, numero y caracter especial.");
            return false;
        }
        if (_clave != _claveConfirmar)
        {
            Dialogos.ErrorBreve("Las contrasenas no coinciden.");
            return false;
        }
        return true;
    }

    private async Task<bool> GuardarNuevoAsync()
    {
        var dto = new UsuarioAltaDTO
        {
            IdUsuario = _edicion!.IdUsuario,
            Nombre = _edicion.Nombre,
            IdPerfil = _idPerfilNuevo,
            Email = _edicion.Email,
            Observaciones = _edicion.Observaciones,
            Activo = _edicion.Activo,
            ClaveEntrada = _clave,
            ClaveInterna = _clave,
            IdRol = PerfilElegidoEsSuper() ? null : _idRolNuevo
        };

        return await Respuestas.CorrectaAsync(await Api.Crear(dto), "crear el usuario");
    }

    private async Task<bool> GuardarEdicionAsync()
    {
        var dto = new UsuarioDTO
        {
            Id = _idActual,
            IdUsuario = _edicion!.IdUsuario,
            Nombre = _edicion.Nombre,
            Email = _edicion.Email,
            Observaciones = _edicion.Observaciones,
            Activo = _edicion.Activo
        };

        return await Respuestas.CorrectaAsync(await Api.Editar(_idActual, dto), "editar el usuario");
    }
}
