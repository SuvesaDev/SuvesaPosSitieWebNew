@page "/parameters/company"
@using Microsoft.AspNetCore.Components.Forms
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IEmpresas Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

@*  Ola 4 — alta del emisor electronico. El sistema actual SOLO da de alta (no hay
    edicion ni listado en CompanyAction.js), asi que se replica igual.

    UNA COSA QUE SI SE CORRIGE respecto al original: en CompanyBodyDatosTributarios.jsx
    el selector de archivo del certificado solo guarda el NOMBRE del archivo
    (SetNameFileUploadCompany) — el contenido nunca se lee ni se manda en el campo
    "certificado" del DTO. Es un cable suelto en la version actual (el certificado
    jamas llega al API pese a que el usuario lo selecciona). Aqui si se lee el
    archivo y se manda en base64, que es lo que el campo string "certificado" del
    OpenAPI espera segun su nombre y tipo. Si el equipo del API confirma que debia
    ser as-is (bug intencional o certificado se sube por otro lado), avisar.
*@

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Escritorio">
    <ChildContent>
        @if (!Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <p class="text-secondary">No tiene permiso para registrar empresas.</p>
        }
        else
        {
            <EditForm Model="this" OnValidSubmit="Guardar">
                <div class="card mb-3">
                    <div class="card-header">Datos del emisor</div>
                    <div class="card-body row g-3">
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="tipoId">Tipo de identificación</label>
                            <select id="tipoId" class="form-select" @bind="_tipoIdentificacion">
                                <option value="0">Seleccione...</option>
                                @foreach (var t in _tiposIdentificacion)
                                {
                                    <option value="@t.CodigoFe">@t.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <AppCampoTexto Etiqueta="Identificación (cédula)" @bind-Valor="_identificacion" Requerido="true" />
                        </div>
                        <div class="col-12 col-md-6">
                            <AppCampoTexto Etiqueta="Nombre" @bind-Valor="_nombre" Requerido="true" />
                        </div>
                        <div class="col-12 col-md-4">
                            <AppCampoTexto Etiqueta="Correo" @bind-Valor="_correo" />
                        </div>
                        <div class="col-12 col-md-4">
                            <AppCampoTexto Etiqueta="Teléfono" @bind-Valor="_telefono" />
                        </div>
                        <div class="col-12 col-md-4">
                            <AppCampoTexto Etiqueta="Sucursal" @bind-Valor="_sucursal" />
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Ubicación</div>
                    <div class="card-body row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="provincia">Provincia</label>
                            <select id="provincia" class="form-select" @bind="_idProvincia" @bind:after="AlCambiarProvincia">
                                <option value="0">Seleccione...</option>
                                @foreach (var p in _provincias)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="canton">Cantón</label>
                            <select id="canton" class="form-select" @bind="_idCanton" @bind:after="AlCambiarCanton">
                                <option value="0">Seleccione...</option>
                                @foreach (var c in _cantones)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="distrito">Distrito</label>
                            <select id="distrito" class="form-select" @bind="_idDistrito">
                                <option value="0">Seleccione...</option>
                                @foreach (var d in _distritos)
                                {
                                    <option value="@d.Id">@d.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <AppCampoTexto Etiqueta="Otras señas" @bind-Valor="_otrasSenas" />
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Hacienda y firma digital</div>
                    <div class="card-body row g-3">
                        <div class="col-12 col-md-4">
                            <AppCampoTexto Etiqueta="Usuario del API de Hacienda" @bind-Valor="_usuarioHacienda" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="claveHacienda">Clave del API de Hacienda</label>
                            <input id="claveHacienda" type="password" class="form-control"
                                   autocomplete="new-password" @bind="_claveHacienda" @bind:event="oninput" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="archivoCertificado">Certificado (.p12)</label>
                            <InputFile id="archivoCertificado" class="form-control" OnChange="CargarCertificado" />
                            @if (!string.IsNullOrEmpty(_nombreCertificado))
                            {
                                <div class="form-text">@_nombreCertificado</div>
                            }
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="claveCertificado">Contraseña del certificado</label>
                            <input id="claveCertificado" type="password" class="form-control"
                                   autocomplete="new-password" @bind="_contrasenaCertificado" @bind:event="oninput" />
                        </div>
                        <div class="col-12 col-md-3">
                            <AppCampoTexto Etiqueta="Número de resolución" @bind-Valor="_numeroResolucion" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="fechaResolucion">Fecha de resolución</label>
                            <input id="fechaResolucion" type="date" class="form-control" @bind="_fechaResolucion" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="venceCertificado">Vence el certificado</label>
                            <input id="venceCertificado" type="date" class="form-control" @bind="_venceCertificado" />
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Actividades económicas (Hacienda)</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-12 col-md-4">
                                <button type="button" class="btn btn-outline-primary" disabled="@_buscandoActividades"
                                        @onclick="BuscarActividadesHacienda">
                                    @(_buscandoActividades ? "Consultando..." : "Consultar en Hacienda")
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr><th>Código</th><th>Descripción</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @if (_actividades.Count == 0)
                                    {
                                        <tr><td colspan="3" class="text-secondary">Sin actividades agregadas todavía.</td></tr>
                                    }
                                    @foreach (var a in _actividades)
                                    {
                                        <tr>
                                            <td>@a.Codigo</td>
                                            <td>@a.Descripcion</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                                        @onclick="() => _actividades.Remove(a)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i> Quitar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Cuentas bancarias</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="bancoNuevo">Banco</label>
                                <select id="bancoNuevo" class="form-select" @bind="_idBancoNuevo">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var b in _bancos)
                                    {
                                        <option value="@b.Id">@b.Banco</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="monedaNueva">Moneda</label>
                                <select id="monedaNueva" class="form-select" @bind="_idMonedaNueva">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var m in _monedas)
                                    {
                                        <option value="@m.CodMoneda">@m.MonedaNombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label" for="numeroNuevo">Número de cuenta</label>
                                <input id="numeroNuevo" class="form-control" @bind="_numeroCuentaNueva" />
                            </div>
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-success w-100" @onclick="AgregarCuenta">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr><th>Banco</th><th>Moneda</th><th>Número</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @if (_cuentas.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-secondary">Sin cuentas agregadas todavía.</td></tr>
                                    }
                                    @foreach (var c in _cuentas)
                                    {
                                        <tr>
                                            <td>@c.Banco</td>
                                            <td>@c.Moneda</td>
                                            <td>@c.Numero</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                                        @onclick="() => _cuentas.Remove(c)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i> Quitar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary" type="submit" disabled="@_guardando">
                    @(_guardando ? "Guardando..." : "Registrar empresa")
                </button>
            </EditForm>
        }
    </ChildContent>
</AppPantalla>

@code {
    private const string Titulo = "Empresas";
    private const long TamanoMaximoCertificado = 5 * 1024 * 1024;

    private List<TipoIdentificacionDTO> _tiposIdentificacion = new();
    private List<ProvinciaDTO> _provincias = new();
    private List<CantonDTO> _cantones = new();
    private List<DistritoDTO> _distritos = new();
    private List<EntidadesBancariasDTO> _bancos = new();
    private List<Moneda> _monedas = new();

    private int _tipoIdentificacion;
    private string _identificacion = string.Empty;
    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _telefono = string.Empty;
    private string _sucursal = string.Empty;

    private int _idProvincia;
    private int _idCanton;
    private int _idDistrito;
    private string _otrasSenas = string.Empty;

    private string _usuarioHacienda = string.Empty;
    private string _claveHacienda = string.Empty;
    private string? _certificadoBase64;
    private string _nombreCertificado = string.Empty;
    private string _contrasenaCertificado = string.Empty;
    private string _numeroResolucion = string.Empty;
    private DateTime? _fechaResolucion;
    private DateTime? _venceCertificado;

    private bool _buscandoActividades;
    private List<ActividadesEmpresaDTO> _actividades = new();

    private int _idBancoNuevo;
    private int _idMonedaNueva;
    private string _numeroCuentaNueva = string.Empty;
    private List<CuentaBancariaDTO> _cuentas = new();

    private bool _guardando;

    protected override async Task OnInitializedAsync()
    {
        _tiposIdentificacion = (await Respuestas.DatoAsync(await Api.TiposIdentificacion(), "consultar los tipos de documento"))
                               ?.ToList() ?? new List<TipoIdentificacionDTO>();
        _provincias = (await Respuestas.DatoAsync(await Api.Provincias(), "consultar las provincias"))
                      ?.ToList() ?? new List<ProvinciaDTO>();
        _bancos = (await Respuestas.DatoAsync(await Api.Bancos(), "consultar los bancos"))
                  ?.ToList() ?? new List<EntidadesBancariasDTO>();
        _monedas = (await Respuestas.DatoAsync(await Api.Monedas(), "consultar las monedas"))
                   ?.ToList() ?? new List<Moneda>();
    }

    private async Task AlCambiarProvincia()
    {
        _idCanton = 0;
        _idDistrito = 0;
        _distritos = new List<DistritoDTO>();
        _cantones = _idProvincia > 0
            ? (await Respuestas.DatoAsync(await Api.Cantones(_idProvincia), "consultar los cantones"))
              ?.ToList() ?? new List<CantonDTO>()
            : new List<CantonDTO>();
    }

    private async Task AlCambiarCanton()
    {
        _idDistrito = 0;
        _distritos = _idCanton > 0
            ? (await Respuestas.DatoAsync(await Api.Distritos(_idCanton), "consultar los distritos"))
              ?.ToList() ?? new List<DistritoDTO>()
            : new List<DistritoDTO>();
    }

    private async Task CargarCertificado(InputFileChangeEventArgs evento)
    {
        var archivo = evento.File;
        _nombreCertificado = archivo.Name;

        try
        {
            await using var flujo = archivo.OpenReadStream(TamanoMaximoCertificado);
            using var memoria = new MemoryStream();
            await flujo.CopyToAsync(memoria);
            _certificadoBase64 = Convert.ToBase64String(memoria.ToArray());
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            _nombreCertificado = string.Empty;
            _certificadoBase64 = null;
            await Dialogos.ErrorAsync("No se pudo leer el archivo del certificado.", "Certificado");
        }
    }

    private async Task BuscarActividadesHacienda()
    {
        if (string.IsNullOrWhiteSpace(_identificacion))
        {
            Dialogos.ErrorBreve("Indique la identificacion antes de consultar Hacienda.");
            return;
        }

        _buscandoActividades = true;
        var r = await Respuestas.DatoAsync(await Api.ActividadesHacienda(_identificacion), "consultar las actividades en Hacienda");
        _buscandoActividades = false;

        if (r is null)
        {
            return;
        }

        foreach (var a in r)
        {
            if (_actividades.Any(existente => existente.Codigo == a.Codigo))
            {
                continue;
            }

            _actividades.Add(a);
        }
    }

    private void AgregarCuenta()
    {
        if (_idBancoNuevo <= 0 || _idMonedaNueva <= 0 || string.IsNullOrWhiteSpace(_numeroCuentaNueva))
        {
            Dialogos.ErrorBreve("Seleccione el banco, la moneda e indique el numero de cuenta.");
            return;
        }

        var banco = _bancos.FirstOrDefault(b => b.Id == _idBancoNuevo);
        var moneda = _monedas.FirstOrDefault(m => m.CodMoneda == _idMonedaNueva);

        _cuentas.Add(new CuentaBancariaDTO
        {
            IdBanco = _idBancoNuevo,
            Banco = banco?.Banco,
            IdMoneda = _idMonedaNueva,
            Moneda = moneda?.MonedaNombre,
            Numero = _numeroCuentaNueva
        });

        _numeroCuentaNueva = string.Empty;
        _idBancoNuevo = 0;
        _idMonedaNueva = 0;
    }

    private async Task Guardar()
    {
        if (_guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_identificacion) || string.IsNullOrWhiteSpace(_nombre))
        {
            await Dialogos.ErrorAsync("Indique la identificacion y el nombre de la empresa.");
            return;
        }

        _guardando = true;

        var dto = new EmpresaDTO
        {
            TipoIdentificacion = _tipoIdentificacion,
            Identificacion = _identificacion,
            Nombre = _nombre,
            Correo = _correo,
            Telefono = _telefono,
            Sucursal = _sucursal,
            Distrito = _idDistrito,
            OtrasSeñas = _otrasSenas,
            Usuario = _usuarioHacienda,
            Clave = _claveHacienda,
            Certificado = _certificadoBase64,
            NumeroResolucion = _numeroResolucion,
            FechaResolucion = _fechaResolucion?.ToString("yyyy-MM-dd"),
            VenceCertificado = _venceCertificado,
            ContrasenaCertificado = _contrasenaCertificado,
            // El sistema actual reusa tal cual los campos que devuelve Hacienda
            // (estado/tipo) como activo/principal del emisor - no hay una marca
            // de "actividad principal" separada en la UI original, asi que no se
            // inventa una aqui tampoco.
            Actividades = _actividades.Select(a => new ActividadesEmisorDTO
            {
                Codigo = a.Codigo,
                Descripcion = a.Descripcion,
                Activo = a.Estado,
                Principal = a.Tipo,
                IdEmisor = 0
            }).ToList(),
            CuentaBancarias = _cuentas.ToList()
        };

        var ok = await Respuestas.CorrectaAsync(await Api.Crear(dto), "crear la empresa");

        _guardando = false;

        if (ok)
        {
            Dialogos.Exito($"Empresa {_nombre} creada.");
        }
    }
}
