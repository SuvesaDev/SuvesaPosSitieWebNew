@page "/parameters/wineries"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Generated
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IMantenimientosInventario Api
@inject IManejadorRespuestas Respuestas

@* Solo lectura: el API real no tiene alta/edición/baja de bodegas, solo el listado
   (bodega/ObtenerBodegas). Ver ApiConexion/ProxyClass/MantenimientosInventario.cs. *@

<AppPantalla Pantalla="Bodegas" Codigo="PARAMETROS.BODEGAS" Nivel="NivelPantalla.Tableta">
    <ChildContent><div class="card"><div class="card-body">
        <AppRejilla TItem="Bodega" Datos="Cargar" @ref="_rejilla" TextoVacio="No hay bodegas registradas."><Columnas>
            <HxGridColumn TItem="Bodega" HeaderText="Bodega" ItemTextSelector="b => b.NombreBodega" SortKeySelector="b => b.NombreBodega" />
            <HxGridColumn TItem="Bodega" HeaderText="Observaciones" ItemTextSelector="b => b.Observaciones" />
            <HxGridColumn TItem="Bodega" HeaderText="Estado"><ItemTemplate Context="b"><span class="badge @(b.Estado ? "text-bg-success" : "text-bg-secondary")">@(b.Estado ? "Activa" : "Inactiva")</span></ItemTemplate></HxGridColumn>
            <HxGridColumn TItem="Bodega" HeaderText="Bloqueada"><ItemTemplate Context="b">@((b.Bloqueada ?? false) ? "Sí" : "No")</ItemTemplate></HxGridColumn>
            <HxGridColumn TItem="Bodega" HeaderText="CostaPets"><ItemTemplate Context="b">@((b.EsCostaPets ?? false) ? "Sí" : "No")</ItemTemplate></HxGridColumn>
        </Columnas></AppRejilla>
    </div></div></ChildContent>
</AppPantalla>

@code {
    private AppRejilla<Bodega>? _rejilla;
    private List<Bodega> _bodegas = new();
    private bool _cargado;

    private async Task<GridDataProviderResult<Bodega>> Cargar(GridDataProviderRequest<Bodega> p)
    {
        if (!_cargado)
        {
            _bodegas = (await Respuestas.DatoAsync(await Api.Bodegas(), "consultar las bodegas"))?.ToList() ?? new();
            _cargado = true;
        }
        return p.ApplyTo(_bodegas);
    }
}
