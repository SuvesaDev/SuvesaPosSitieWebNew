@page "/parameters/fiscal-geography"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IGeografiaFiscal Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="NuevaProvincia">Provincia</button><button class="btn btn-sm btn-primary" disabled="@(_provincia is null)" @onclick="NuevoCanton">Cantón</button><button class="btn btn-sm btn-primary" disabled="@(_canton is null)" @onclick="NuevoDistrito">Distrito</button></Acciones><ChildContent><div class="row g-3"><div class="col-md-4"><div class="card"><div class="card-header">Provincias</div><div class="list-group list-group-flush">@foreach(var p in _provincias){<button class="list-group-item list-group-item-action @(_provincia?.IdProvincia==p.IdProvincia?"active":"")" @onclick="()=>SeleccionarProvincia(p)">@p.CodigoFE — @p.Descripcion <span class="float-end" @onclick:stopPropagation="true"><a href="#" @onclick="()=>EditarProvincia(p)">Editar</a></span></button>}</div></div></div><div class="col-md-4"><div class="card"><div class="card-header">Cantones</div><div class="list-group list-group-flush">@foreach(var c in _cantones){<button class="list-group-item list-group-item-action @(_canton?.IdCanton==c.IdCanton?"active":"")" @onclick="()=>SeleccionarCanton(c)">@c.CodigoFE — @c.Descripcion <span class="float-end" @onclick:stopPropagation="true"><a href="#" @onclick="()=>EditarCanton(c)">Editar</a></span></button>}</div></div></div><div class="col-md-4"><div class="card"><div class="card-header">Distritos</div><div class="list-group list-group-flush">@foreach(var d in _distritos){<div class="list-group-item">@d.CodigoFE — @d.Descripcion <span class="float-end"><a href="#" @onclick="()=>EditarDistrito(d)">Editar</a></span></div>}</div></div></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modalProvincia" Title="Provincia" Size="ModalSize.Regular"><BodyTemplate>@if(_edicionProvincia is not null){<EditForm Model="_edicionProvincia" OnValidSubmit="GuardarProvincia" id="p"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicionProvincia.Descripcion"/><AppCampoTexto Etiqueta="Código FE" @bind-Valor="_edicionProvincia.CodigoFE"/></EditForm>}</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="()=>_modalProvincia.HideAsync()">Cancelar</button><button class="btn btn-primary" form="p" type="submit">Guardar</button></FooterTemplate></HxModal>
<HxModal @ref="_modalCanton" Title="Cantón" Size="ModalSize.Regular"><BodyTemplate>@if(_edicionCanton is not null){<EditForm Model="_edicionCanton" OnValidSubmit="GuardarCanton" id="c"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicionCanton.Descripcion"/><AppCampoTexto Etiqueta="Código FE" @bind-Valor="_edicionCanton.CodigoFE"/></EditForm>}</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="()=>_modalCanton.HideAsync()">Cancelar</button><button class="btn btn-primary" form="c" type="submit">Guardar</button></FooterTemplate></HxModal>
<HxModal @ref="_modalDistrito" Title="Distrito" Size="ModalSize.Regular"><BodyTemplate>@if(_edicionDistrito is not null){<EditForm Model="_edicionDistrito" OnValidSubmit="GuardarDistrito" id="d"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicionDistrito.Descripcion"/><AppCampoTexto Etiqueta="Código FE" @bind-Valor="_edicionDistrito.CodigoFE"/></EditForm>}</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="()=>_modalDistrito.HideAsync()">Cancelar</button><button class="btn btn-primary" form="d" type="submit">Guardar</button></FooterTemplate></HxModal>
@code { const string Titulo="Geografía Fiscal"; List<ProvinciaFiscalDTO> _provincias=new();List<CantonFiscalDTO> _cantones=new();List<DistritoFiscalDTO> _distritos=new();ProvinciaFiscalDTO? _provincia,_edicionProvincia;CantonFiscalDTO? _canton,_edicionCanton;DistritoFiscalDTO? _edicionDistrito;HxModal _modalProvincia=default!,_modalCanton=default!,_modalDistrito=default!;protected override async Task OnInitializedAsync()=>await CargarProvincias();async Task CargarProvincias(){_provincias=(await Respuestas.DatoAsync(await Api.Provincias(),"consultar las provincias"))?.ToList()??new();}async Task SeleccionarProvincia(ProvinciaFiscalDTO p){_provincia=p;_canton=null;_distritos=new();_cantones=(await Respuestas.DatoAsync(await Api.Cantones(p.IdProvincia),"consultar los cantones"))?.ToList()??new();}async Task SeleccionarCanton(CantonFiscalDTO c){_canton=c;_distritos=(await Respuestas.DatoAsync(await Api.Distritos(c.IdCanton),"consultar los distritos"))?.ToList()??new();}async Task NuevaProvincia(){_edicionProvincia=new();await _modalProvincia.ShowAsync();}async Task EditarProvincia(ProvinciaFiscalDTO p){_edicionProvincia=new(){IdProvincia=p.IdProvincia,Descripcion=p.Descripcion,CodigoFE=p.CodigoFE};await _modalProvincia.ShowAsync();}async Task NuevoCanton(){_edicionCanton=new(){IdProvincia=_provincia!.IdProvincia};await _modalCanton.ShowAsync();}async Task EditarCanton(CantonFiscalDTO c){_edicionCanton=new(){IdCanton=c.IdCanton,IdProvincia=c.IdProvincia,Descripcion=c.Descripcion,CodigoFE=c.CodigoFE};await _modalCanton.ShowAsync();}async Task NuevoDistrito(){_edicionDistrito=new(){IdCanton=_canton!.IdCanton};await _modalDistrito.ShowAsync();}async Task EditarDistrito(DistritoFiscalDTO d){_edicionDistrito=new(){IdDistrito=d.IdDistrito,IdCanton=d.IdCanton,Descripcion=d.Descripcion,CodigoFE=d.CodigoFE};await _modalDistrito.ShowAsync();}bool Valido(string? d,string? c,int n)=>!string.IsNullOrWhiteSpace(d)&&d.Trim().Length<=150&&c?.Trim().Length==n&&c.All(char.IsDigit);async Task GuardarProvincia(){if(_edicionProvincia is null||!Valido(_edicionProvincia.Descripcion,_edicionProvincia.CodigoFE,1)){await Dialogos.ErrorAsync("Indique descripción y código FE de un dígito.");return;}var r=_edicionProvincia.IdProvincia==0?await Api.Crear(_edicionProvincia):await Api.Actualizar(_edicionProvincia);if(await Respuestas.CorrectaAsync(r,"guardar la provincia")){await _modalProvincia.HideAsync();await CargarProvincias();}}async Task GuardarCanton(){if(_edicionCanton is null||!Valido(_edicionCanton.Descripcion,_edicionCanton.CodigoFE,2)){await Dialogos.ErrorAsync("Indique descripción y código FE de dos dígitos.");return;}var r=_edicionCanton.IdCanton==0?await Api.Crear(_edicionCanton):await Api.Actualizar(_edicionCanton);if(await Respuestas.CorrectaAsync(r,"guardar el cantón")){await _modalCanton.HideAsync();await SeleccionarProvincia(_provincia!);}}async Task GuardarDistrito(){if(_edicionDistrito is null||!Valido(_edicionDistrito.Descripcion,_edicionDistrito.CodigoFE,2)){await Dialogos.ErrorAsync("Indique descripción y código FE de dos dígitos.");return;}var r=_edicionDistrito.IdDistrito==0?await Api.Crear(_edicionDistrito):await Api.Actualizar(_edicionDistrito);if(await Respuestas.CorrectaAsync(r,"guardar el distrito")){await _modalDistrito.HideAsync();await SeleccionarCanton(_canton!);}} }
