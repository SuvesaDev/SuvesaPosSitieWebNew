@page "/parameters/invoice-types"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject ITiposFactura Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta">
    <Acciones>
        @if (Sesion.Puede(Titulo, AccionPantalla.Crear))
        {
            <button class="btn btn-sm btn-primary" @onclick="Agregar"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar</button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="Recargar"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
    </Acciones>
    <ChildContent>
        <div class="card"><div class="card-body">
            <AppRejilla TItem="TipoFacturaFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta"
                        TextoVacio="No hay tipos de factura registrados." @ref="_rejilla">
                <Columnas>
                    <HxGridColumn TItem="TipoFacturaFiscalDTO" HeaderText="Código" ItemTextSelector="t => t.Codigo.ToString()" SortKeySelector="t => t.Codigo" />
                    <HxGridColumn TItem="TipoFacturaFiscalDTO" HeaderText="Descripción" ItemTextSelector="t => t.Descripcion" SortKeySelector="t => t.Descripcion" />
                    <HxGridColumn TItem="TipoFacturaFiscalDTO" HeaderText="Código FE" ItemTextSelector="@(t => t.CodigoFE ?? "—")" />
                    <HxGridColumn TItem="TipoFacturaFiscalDTO" HeaderText="Condición">
                        <ItemTemplate Context="t">@Condicion(t)</ItemTemplate>
                    </HxGridColumn>
                    <HxGridColumn TItem="TipoFacturaFiscalDTO" HeaderText="" HeaderCssClass="text-end" ItemCssClass="text-end">
                        <ItemTemplate Context="t">
                            @if (Sesion.Puede(Titulo, AccionPantalla.Modificar))
                            { <button class="btn btn-sm btn-link p-0" @onclick="() => Editar(t)">Editar</button> }
                        </ItemTemplate>
                    </HxGridColumn>
                </Columnas>
            </AppRejilla>
        </div></div>
    </ChildContent>
</AppPantalla>

<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Regular">
    <BodyTemplate>
        @if (_edicion is not null)
        {
            <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formTipoFactura">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-md-4"><label class="form-label" for="codigo">Código interno</label><input id="codigo" class="form-control" type="number" @bind="_edicion.Codigo" /></div>
                    <div class="col-12 col-md-8"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion" /></div>
                    <div class="col-12 col-md-4"><AppCampoTexto Etiqueta="Código FE" @bind-Valor="_edicion.CodigoFE" /></div>
                    <div class="col-12 col-md-8"><div class="form-text pt-md-4">Dos dígitos del catálogo de Hacienda. Déjelo vacío sólo para tipos no fiscales.</div></div>
                    <div class="col-12 d-flex flex-wrap gap-3">
                        <div class="form-check"><input id="credito" class="form-check-input" type="checkbox" @bind="_edicion.Credito" /><label class="form-check-label" for="credito">Crédito</label></div>
                        <div class="form-check"><input id="compra" class="form-check-input" type="checkbox" @bind="_edicion.Compra" /><label class="form-check-label" for="compra">Compra</label></div>
                        <div class="form-check"><input id="consignacion" class="form-check-input" type="checkbox" @bind="_edicion.Consignacion" /><label class="form-check-label" for="consignacion">Consignación</label></div>
                    </div>
                </div>
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formTipoFactura" disabled="@_guardando">@(_guardando ? "Guardando..." : "Guardar")</button>
    </FooterTemplate>
</HxModal>

@code {
    private const string Titulo = "Tipos de Factura";
    private AppRejilla<TipoFacturaFiscalDTO>? _rejilla;
    private HxModal _modal = default!;
    private List<TipoFacturaFiscalDTO> _tipos = new();
    private TipoFacturaFiscalDTO? _edicion;
    private bool _esNuevo, _guardando, _cargado;

    private string TituloModal => _esNuevo ? "Nuevo tipo de factura" : "Editar tipo de factura";

    private async Task<GridDataProviderResult<TipoFacturaFiscalDTO>> Cargar(GridDataProviderRequest<TipoFacturaFiscalDTO> peticion)
    {
        if (!_cargado) { _tipos = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los tipos de factura"))?.ToList() ?? new(); _cargado = true; }
        return peticion.ApplyTo(_tipos);
    }

    private async Task Recargar() { _cargado = false; if (_rejilla is not null) await _rejilla.RefrescarAsync(); }
    private async Task Agregar() { _esNuevo = true; _edicion = new(); await _modal.ShowAsync(); }
    private async Task Editar(TipoFacturaFiscalDTO tipo)
    {
        _esNuevo = false;
        _edicion = new() { Id = tipo.Id, Codigo = tipo.Codigo, Descripcion = tipo.Descripcion, CodigoFE = tipo.CodigoFE, Credito = tipo.Credito, Compra = tipo.Compra, Consignacion = tipo.Consignacion };
        await _modal.ShowAsync();
    }

    private async Task Guardar()
    {
        if (_edicion is null || _guardando) return;
        _edicion.Descripcion = _edicion.Descripcion?.Trim();
        _edicion.CodigoFE = string.IsNullOrWhiteSpace(_edicion.CodigoFE) ? null : _edicion.CodigoFE.Trim();
        if (string.IsNullOrWhiteSpace(_edicion.Descripcion) || _edicion.Codigo <= 0) { await Dialogos.ErrorAsync("Indique el código interno y la descripción."); return; }
        if (_edicion.CodigoFE is not null && (_edicion.CodigoFE.Length != 2 || !_edicion.CodigoFE.All(char.IsDigit))) { await Dialogos.ErrorAsync("El código FE debe tener exactamente dos dígitos."); return; }
        _guardando = true;
        var resultado = _esNuevo ? await Api.Crear(_edicion) : await Api.Actualizar(_edicion);
        _guardando = false;
        if (await Respuestas.CorrectaAsync(resultado, "guardar el tipo de factura")) { await _modal.HideAsync(); Dialogos.Exito(_esNuevo ? "Tipo de factura creado." : "Tipo de factura actualizado."); await Recargar(); }
    }

    private static string Condicion(TipoFacturaFiscalDTO tipo) => tipo.Compra ? "Compra" : tipo.Consignacion ? "Consignación" : tipo.Credito ? "Crédito" : "Contado";
}
