@page "/parameters/taxes"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IImpuestosFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Agregar">Agregar</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="ImpuestoFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" TextoVacio="No hay impuestos activos." @ref="_rejilla"><Columnas>
<HxGridColumn TItem="ImpuestoFiscalDTO" HeaderText="Impuesto" ItemTextSelector="i => i.Impuesto1" SortKeySelector="i => i.Impuesto1" /><HxGridColumn TItem="ImpuestoFiscalDTO" HeaderText="Código" ItemTextSelector="i => i.CodigoImpuesto" /><HxGridColumn TItem="ImpuestoFiscalDTO" HeaderText="Tarifa" ItemTextSelector="@(i => i.CodigoTarifa ?? "—")" /><HxGridColumn TItem="ImpuestoFiscalDTO" HeaderText="Porcentaje" ItemTextSelector="@(i => i.Porcentaje.ToString("0.##") + "%")" SortKeySelector="i => i.Porcentaje" /><HxGridColumn TItem="ImpuestoFiscalDTO" HeaderText=""><ItemTemplate Context="i"><button class="btn btn-sm btn-link" @onclick="() => Editar(i)">Editar</button><button class="btn btn-sm btn-link text-danger" @onclick="() => Deshabilitar(i)">Deshabilitar</button></ItemTemplate></HxGridColumn>
</Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Regular"><BodyTemplate>@if (_edicion is not null) { <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formImpuesto"><DataAnnotationsValidator /><div class="row g-3"><div class="col-12"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_edicion.Impuesto1" /></div><div class="col-md-4"><AppCampoTexto Etiqueta="Código impuesto" @bind-Valor="_edicion.CodigoImpuesto" /></div><div class="col-md-4"><AppCampoTexto Etiqueta="Código tarifa" @bind-Valor="_edicion.CodigoTarifa" /></div><div class="col-md-4"><AppCampoTexto Etiqueta="Símbolo" @bind-Valor="_edicion.Simbolo" /></div><div class="col-md-4"><label class="form-label">Porcentaje</label><input type="number" step="0.01" min="0" max="100" class="form-control" @bind="_edicion.Porcentaje" /></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formImpuesto" type="submit" disabled="@_guardando">Guardar</button></FooterTemplate></HxModal>
@code { private const string Titulo = "Impuestos"; private AppRejilla<ImpuestoFiscalDTO>? _rejilla; private HxModal _modal = default!; private List<ImpuestoFiscalDTO> _items = new(); private ImpuestoFiscalDTO? _edicion; private bool _nuevo, _guardando, _cargado; private string TituloModal => _nuevo ? "Nuevo impuesto" : "Editar impuesto"; private async Task<GridDataProviderResult<ImpuestoFiscalDTO>> Cargar(GridDataProviderRequest<ImpuestoFiscalDTO> r) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar los impuestos"))?.ToList() ?? new(); _cargado = true; } return r.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_rejilla is not null) await _rejilla.RefrescarAsync(); } private async Task Agregar() { _nuevo = true; _edicion = new() { Estado = true, IdUsuarioCreacion = Sesion.Usuario }; await _modal.ShowAsync(); } private async Task Editar(ImpuestoFiscalDTO i) { _nuevo = false; _edicion = new() { IdImpuesto = i.IdImpuesto, Impuesto1 = i.Impuesto1, CodigoImpuesto = i.CodigoImpuesto, CodigoTarifa = i.CodigoTarifa, Porcentaje = i.Porcentaje, Simbolo = i.Simbolo, Estado = i.Estado, Inactivo = i.Inactivo, IdUsuarioModificacion = Sesion.Usuario }; await _modal.ShowAsync(); } private async Task Guardar() { if (_edicion is null || _guardando) return; _edicion.Impuesto1 = _edicion.Impuesto1?.Trim(); _edicion.CodigoImpuesto = _edicion.CodigoImpuesto?.Trim(); _edicion.CodigoTarifa = string.IsNullOrWhiteSpace(_edicion.CodigoTarifa) ? null : _edicion.CodigoTarifa.Trim(); _edicion.Simbolo = _edicion.Simbolo?.Trim(); if (string.IsNullOrWhiteSpace(_edicion.Impuesto1) || !EsCodigo(_edicion.CodigoImpuesto) || (_edicion.CodigoTarifa is not null && !EsCodigo(_edicion.CodigoTarifa)) || _edicion.Porcentaje is < 0 or > 100 || string.IsNullOrWhiteSpace(_edicion.Simbolo)) { await Dialogos.ErrorAsync("Complete nombre, códigos fiscales de dos dígitos, porcentaje válido y símbolo."); return; } _guardando = true; var r = _nuevo ? await Api.Crear(_edicion) : await Api.Actualizar(_edicion); _guardando = false; if (await Respuestas.CorrectaAsync(r, "guardar el impuesto")) { await _modal.HideAsync(); await Recargar(); } } private async Task Deshabilitar(ImpuestoFiscalDTO i) { var r = await Api.Deshabilitar(i.IdImpuesto, Sesion.Usuario); if (await Respuestas.CorrectaAsync(r, "deshabilitar el impuesto")) await Recargar(); } private static bool EsCodigo(string? codigo) => codigo?.Length == 2 && codigo.All(char.IsDigit); }
