@page "/parameters/areas"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Parametros
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IMantenimientosInventario Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos

<AppPantalla Pantalla="Áreas" Codigo="PARAMETROS.AREAS" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nueva"><i class="bi bi-plus-lg me-1"></i>Nueva área</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="AreaMantenimientoDTO" Datos="Cargar" @ref="_rejilla" TextoVacio="No hay áreas registradas."><Columnas><HxGridColumn TItem="AreaMantenimientoDTO" HeaderText="Descripción" ItemTextSelector="a => a.Descripcion" SortKeySelector="a => a.Descripcion" /><HxGridColumn TItem="AreaMantenimientoDTO" HeaderText="Sucursal" ItemTextSelector="a => a.IdSucursal.ToString()" /><HxGridColumn TItem="AreaMantenimientoDTO" HeaderText="Observaciones" ItemTextSelector="a => a.Observaciones" /><HxGridColumn TItem="AreaMantenimientoDTO" HeaderText="" HeaderCssClass="text-end" ItemCssClass="text-end"><ItemTemplate Context="a"><button class="btn btn-sm btn-link p-0" @onclick="() => Editar(a)">Editar</button><button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => Eliminar(a)">Eliminar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@(_edicion?.IdArea > 0 ? "Editar área" : "Nueva área")" Size="ModalSize.Regular"><BodyTemplate>@if (_edicion is not null) { <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formArea"><DataAnnotationsValidator /><div class="mb-3"><AppCampoTexto Etiqueta="Descripción" @bind-Valor="_edicion.Descripcion" Requerido="true" /></div><div class="mb-3"><label class="form-label">Sucursal</label><InputNumber class="form-control" @bind-Value="_edicion.IdSucursal" /></div><AppCampoTexto Etiqueta="Observaciones" @bind-Valor="_edicion.Observaciones" /></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formArea" type="submit" disabled="@_guardando">Guardar</button></FooterTemplate></HxModal>
@code { private AppRejilla<AreaMantenimientoDTO>? _rejilla; private HxModal _modal = default!; private List<AreaMantenimientoDTO> _areas = new(); private AreaMantenimientoDTO? _edicion; private bool _cargado; private bool _guardando; private async Task<GridDataProviderResult<AreaMantenimientoDTO>> Cargar(GridDataProviderRequest<AreaMantenimientoDTO> p) { if (!_cargado) { _areas = (await Respuestas.DatoAsync(await Api.Areas(), "consultar las áreas"))?.ToList() ?? new(); _cargado = true; } return p.ApplyTo(_areas); } private async Task Nueva() { _edicion = new AreaMantenimientoDTO { IdSucursal = 7 }; await _modal.ShowAsync(); } private async Task Editar(AreaMantenimientoDTO a) { _edicion = new AreaMantenimientoDTO { IdArea = a.IdArea, Descripcion = a.Descripcion, Observaciones = a.Observaciones, IdSucursal = a.IdSucursal }; await _modal.ShowAsync(); } private async Task Guardar() { if (_edicion is null || _guardando) return; if (string.IsNullOrWhiteSpace(_edicion.Descripcion) || _edicion.IdSucursal <= 0) { await Dialogos.ErrorAsync("Indique la descripción y la sucursal del área."); return; } _guardando = true; var nueva = _edicion.IdArea == 0; var r = nueva ? await Api.CrearArea(_edicion) : await Api.EditarArea(_edicion); _guardando = false; if (await Respuestas.CorrectaAsync(r, nueva ? "crear el área" : "editar el área")) { await _modal.HideAsync(); _cargado = false; if (_rejilla is not null) await _rejilla.RefrescarAsync(); } } private async Task Eliminar(AreaMantenimientoDTO a) { if (!await Dialogos.ConfirmarPeligroAsync($"¿Eliminar el área '{a.Descripcion}'?", "Eliminar área")) return; if (await Respuestas.CorrectaAsync(await Api.EliminarArea(a.IdArea), "eliminar el área")) { _cargado = false; if (_rejilla is not null) await _rejilla.RefrescarAsync(); } } }
