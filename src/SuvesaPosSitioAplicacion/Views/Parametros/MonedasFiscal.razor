@page "/parameters/currencies"
@using SuvesaPosSitioAplicacion.Class
@using SuvesaPosSitioAplicacion.DTOs.Fiscal
@using SuvesaPosSitioAplicacion.Services
@using SuvesaPosSitioAplicacion.Views.Shared.Componentes
@inject IMonedasFiscales Api
@inject IManejadorRespuestas Respuestas
@inject IServicioDialogos Dialogos
@inject IContextoSesion Sesion

<AppPantalla Pantalla="@Titulo" Nivel="NivelPantalla.Tableta"><Acciones><button class="btn btn-sm btn-primary" @onclick="Nuevo">Agregar</button><button class="btn btn-sm btn-outline-secondary" @onclick="Recargar">Recargar</button></Acciones><ChildContent><div class="card"><div class="card-body"><AppRejilla TItem="MonedaFiscalDTO" Datos="Cargar" Nivel="NivelPantalla.Tableta" @ref="_grid"><Columnas><HxGridColumn TItem="MonedaFiscalDTO" HeaderText="Código" ItemTextSelector="x => x.CodMoneda.ToString()"/><HxGridColumn TItem="MonedaFiscalDTO" HeaderText="Moneda" ItemTextSelector="x => x.MonedaNombre"/><HxGridColumn TItem="MonedaFiscalDTO" HeaderText="Símbolo" ItemTextSelector="x => x.Simbolo"/><HxGridColumn TItem="MonedaFiscalDTO" HeaderText="Compra" ItemTextSelector="x => x.ValorCompra.ToString()"/><HxGridColumn TItem="MonedaFiscalDTO" HeaderText="Venta" ItemTextSelector="x => x.ValorVenta.ToString()"/><HxGridColumn TItem="MonedaFiscalDTO" HeaderText=""><ItemTemplate Context="x"><button class="btn btn-sm btn-link" @onclick="() => Editar(x)">Editar</button><button class="btn btn-sm btn-link text-danger" @onclick="() => Deshabilitar(x)">Deshabilitar</button></ItemTemplate></HxGridColumn></Columnas></AppRejilla></div></div></ChildContent></AppPantalla>
<HxModal @ref="_modal" Title="@TituloModal" Size="ModalSize.Regular"><BodyTemplate>@if (_edicion is not null) { <EditForm Model="_edicion" OnValidSubmit="Guardar" id="formMoneda"><div class="row g-3"><div class="col-md-3"><label class="form-label">Código</label><input class="form-control" type="number" min="1" @bind="_edicion.CodMoneda" disabled="@(!_nuevo)" /></div><div class="col-md-6"><AppCampoTexto Etiqueta="Nombre" @bind-Valor="_edicion.MonedaNombre" /></div><div class="col-md-3"><AppCampoTexto Etiqueta="Símbolo" @bind-Valor="_edicion.Simbolo" /></div><div class="col-md-6"><label class="form-label">Valor compra</label><input class="form-control" type="number" step="0.0001" min="0" @bind="_edicion.ValorCompra" /></div><div class="col-md-6"><label class="form-label">Valor venta</label><input class="form-control" type="number" step="0.0001" min="0" @bind="_edicion.ValorVenta" /></div><div class="col-12"><AppCampoTexto Etiqueta="Cuenta contable" @bind-Valor="_edicion.CuentaContable" /></div></div></EditForm> }</BodyTemplate><FooterTemplate><button class="btn btn-outline-secondary" @onclick="() => _modal.HideAsync()">Cancelar</button><button class="btn btn-primary" form="formMoneda" type="submit" disabled="@_guardando">Guardar</button></FooterTemplate></HxModal>
@code { private const string Titulo = "Monedas"; private AppRejilla<MonedaFiscalDTO>? _grid; private HxModal _modal = default!; private List<MonedaFiscalDTO> _items = new(); private MonedaFiscalDTO? _edicion; private bool _nuevo, _cargado, _guardando; private string TituloModal => _nuevo ? "Nueva moneda" : "Editar moneda"; private async Task<GridDataProviderResult<MonedaFiscalDTO>> Cargar(GridDataProviderRequest<MonedaFiscalDTO> request) { if (!_cargado) { _items = (await Respuestas.DatoAsync(await Api.Obtener(), "consultar las monedas"))?.ToList() ?? new(); _cargado = true; } return request.ApplyTo(_items); } private async Task Recargar() { _cargado = false; if (_grid is not null) await _grid.RefrescarAsync(); } private async Task Nuevo() { _nuevo = true; _edicion = new() { Estado = true, IdUsuarioCreacion = Sesion.Usuario }; await _modal.ShowAsync(); } private async Task Editar(MonedaFiscalDTO moneda) { _nuevo = false; _edicion = new() { CodMoneda = moneda.CodMoneda, MonedaNombre = moneda.MonedaNombre, Simbolo = moneda.Simbolo, ValorCompra = moneda.ValorCompra, ValorVenta = moneda.ValorVenta, Tccompra = moneda.Tccompra, CuentaContable = moneda.CuentaContable, Estado = moneda.Estado, IdUsuarioModificacion = Sesion.Usuario }; await _modal.ShowAsync(); } private async Task Guardar() { if (_edicion is null || _guardando) return; _edicion.MonedaNombre = _edicion.MonedaNombre?.Trim(); _edicion.Simbolo = _edicion.Simbolo?.Trim(); _edicion.CuentaContable = _edicion.CuentaContable?.Trim(); if (_edicion.CodMoneda <= 0 || string.IsNullOrWhiteSpace(_edicion.MonedaNombre) || string.IsNullOrWhiteSpace(_edicion.Simbolo) || _edicion.ValorCompra < 0 || _edicion.ValorVenta < 0) { await Dialogos.ErrorAsync("Complete código, nombre, símbolo y valores de cambio válidos."); return; } _guardando = true; var respuesta = _nuevo ? await Api.Crear(_edicion) : await Api.Actualizar(_edicion); _guardando = false; if (await Respuestas.CorrectaAsync(respuesta, "guardar la moneda")) { await _modal.HideAsync(); await Recargar(); } } private async Task Deshabilitar(MonedaFiscalDTO moneda) { var respuesta = await Api.Deshabilitar(moneda.CodMoneda, Sesion.Usuario); if (await Respuestas.CorrectaAsync(respuesta, "deshabilitar la moneda")) await Recargar(); } }
